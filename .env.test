# ─── E2E test configuration ────────────────────────────────────────────────────
# Copy this file to .env.test.local and fill in real values.
# .env.test.local is git-ignored.

# Base URL where the dev server is running
TEST_BASE_URL=https://kefaloniabnb.com/

# Admin credentials for admin-panel E2E tests (leave blank to skip those tests)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
# Set to "super_admin" to run super-admin-specific assertions
TEST_ADMIN_ROLE=

# A real listing slug/ID in your dev Supabase database
TEST_LISTING_SLUG=
TEST_LISTING_ID=
# A listing ID that has deposit_percent > 0
TEST_DEPOSIT_LISTING_ID=

# A real booking ID for admin booking detail tests
TEST_BOOKING_ID=
