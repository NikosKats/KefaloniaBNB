# ============================================================
# KefaloniaBNB – Environment Variables
# Copy to .env and fill in your values. Never commit .env!
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
# Project URL from: Supabase Dashboard > Settings > API
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon (public) key – safe to expose in browser
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key – NEVER expose publicly. Server-only.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Stripe ──────────────────────────────────────────────────
# From: Stripe Dashboard > Developers > API Keys
STRIPE_SECRET_KEY=sk_live_...
# From: Stripe Dashboard > Developers > Webhooks > Signing secret (main webhook)
STRIPE_WEBHOOK_SECRET=whsec_...
# Signing secret for the cleaning marketplace webhook (POST /api/webhooks/stripe-cleaning)
# Create a separate webhook endpoint in Stripe Dashboard pointing to that URL
STRIPE_CLEANING_WEBHOOK_SECRET=whsec_...

# ─── Email (Resend) ───────────────────────────────────────────
# From: resend.com > API Keys
RESEND_API_KEY=re_...

# The "From" address for outgoing emails (must be verified domain)
EMAIL_FROM=noreply@kefaloniabnb.com

# Your email address to receive booking notifications
EMAIL_OWNER=owner@kefaloniabnb.com

# ─── Site ────────────────────────────────────────────────────
# Production URL (no trailing slash) – used for emails, OG tags, sitemap
PUBLIC_SITE_URL=https://kefaloniabnb.com

# ─── Optional: Mapbox ────────────────────────────────────────
# For interactive maps on listing pages
# PUBLIC_MAPBOX_TOKEN=pk.eyJ1...
