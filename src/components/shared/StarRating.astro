---
interface Props {
  rating: number;
  size?: 'sm' | 'md' | 'lg';
  showNumber?: boolean;
}
const { rating, size = 'md', showNumber = false } = Astro.props;
const sizes = { sm: 'w-3 h-3', md: 'w-4 h-4', lg: 'w-5 h-5' };
const full = Math.floor(rating);
const half = rating - full >= 0.5;
---

<div class="flex items-center gap-1">
  {Array.from({ length: 5 }, (_, i) => (
    <svg
      class={`${sizes[size]} ${i < full ? 'text-amber-400' : i === full && half ? 'text-amber-300' : 'text-gray-200'} fill-current`}
      viewBox="0 0 24 24"
    >
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
    </svg>
  ))}
  {showNumber && <span class="text-sm font-medium text-gray-700 ml-1">{rating.toFixed(1)}</span>}
</div>
