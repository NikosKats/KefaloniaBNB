---
import { SUPPORTED_LANGS, LANG_LABELS, LANG_FLAGS, type Lang } from '../../i18n/translations.ts';

const currentLang: Lang = (Astro.locals.lang as Lang) ?? 'en';
---

<div class="relative lang-switcher-root">
  <!-- Trigger button -->
  <button
    type="button"
    aria-haspopup="listbox"
    aria-expanded="false"
    class="lang-switcher-btn flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors cursor-pointer select-none"
  >
    <span class="text-base leading-none">{LANG_FLAGS[currentLang]}</span>
    <span class="hidden sm:inline">{LANG_LABELS[currentLang]}</span>
    <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown -->
  <ul
    role="listbox"
    aria-label="Select language"
    class="lang-switcher-menu hidden absolute right-0 mt-1 w-44 bg-white border border-gray-200 rounded-xl shadow-lg py-1 z-50"
  >
    {SUPPORTED_LANGS.map((lang) => (
      <li role="option" aria-selected={lang === currentLang}>
        <button
          type="button"
          data-lang={lang}
          class={`w-full flex items-center gap-2.5 px-3 py-2 text-sm text-left hover:bg-gray-50 transition-colors cursor-pointer ${
            lang === currentLang ? 'font-semibold text-[#1a1a2e]' : 'text-gray-700'
          }`}
        >
          <span class="text-base">{LANG_FLAGS[lang]}</span>
          <span>{LANG_LABELS[lang]}</span>
          {lang === currentLang && (
            <svg class="w-3.5 h-3.5 ml-auto text-[#1a1a2e]" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
          )}
        </button>
      </li>
    ))}
  </ul>
</div>

<script>
  // Scope each switcher instance to its own root — handles multiple instances on the same page
  document.querySelectorAll<HTMLElement>('.lang-switcher-root').forEach((root) => {
    const btn  = root.querySelector<HTMLElement>('.lang-switcher-btn');
    const menu = root.querySelector<HTMLElement>('.lang-switcher-menu');
    if (!btn || !menu) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
    });

    root.querySelectorAll<HTMLElement>('button[data-lang]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const lang = el.dataset.lang ?? 'en';
        const url = new URL(window.location.href);
        url.searchParams.set('lang', lang);
        window.location.href = url.toString();
      });
    });
  });

  // Close all dropdowns on outside click
  document.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('.lang-switcher-menu').forEach((m) => m.classList.add('hidden'));
    document.querySelectorAll<HTMLElement>('.lang-switcher-btn').forEach((b) => b.setAttribute('aria-expanded', 'false'));
  });
</script>
