---
import { t, SUPPORTED_LANGS, type Lang } from '../../i18n/translations.ts';

const lang = (Astro.locals.lang ?? 'en') as Lang;
const isEl = lang === 'el';
const isBg = lang === 'bg';
const isSr = (SUPPORTED_LANGS as readonly string[]).includes('sr') && lang === ('sr' as Lang);
const isTr = lang === 'tr';
const isRo = lang === 'ro';
const year = new Date().getFullYear();
---

<footer class="bg-[#1a1a2e] text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-12">

      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-[#c9a96e] rounded-lg flex items-center justify-center">
            <span class="text-white text-sm font-bold">K</span>
          </div>
          <span class="font-bold text-lg">KefaloniaBNB</span>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed">{t(lang,'footer.tagline')}</p>
        <div class="flex gap-3 mt-6">
          <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram" class="w-9 h-9 bg-white/10 rounded-lg flex items-center justify-center hover:bg-white/20 transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook" class="w-9 h-9 bg-white/10 rounded-lg flex items-center justify-center hover:bg-white/20 transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </div>
      </div>

      <!-- Explore -->
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-wider text-gray-400 mb-4">{t(lang,'footer.explore')}</h4>
        <ul class="space-y-2.5">
          {[
            { href: '/rentals',      label: t(lang,'footer.our_rentals') },
            { href: '/blog',         label: isEl ? 'Ιστολόγιο Ταξιδιών' : isBg ? 'Пътнически блог' : isSr ? 'Путнички блог' : isTr ? 'Seyahat Blogu' : isRo ? 'Blog de Călătorie' : 'Travel Blog' },
            { href: '/services',    label: isEl ? 'Υπηρεσίες μας' : isBg ? 'Нашите услуги' : isSr ? 'Наше услуге' : isTr ? 'Hizmetler' : isRo ? 'Serviciile Noastre' : 'Our Services' },
            { href: '/about',       label: t(lang,'footer.about_us') },
            { href: '/area-guide',  label: t(lang,'footer.area_guide') },
            { href: '/community/restaurants', label: isEl ? 'Εστιατόρια' : isRo ? 'Restaurante' : 'Restaurants' },
            { href: '/community/technicians', label: isEl ? 'Τεχνικοί' : isRo ? 'Tehnicieni' : 'Technicians' },
            { href: '/community/reports',     label: isEl ? 'Αναφορές' : isRo ? 'Rapoarte Comunitate' : 'Community Reports' },
            { href: '/community/board',       label: isEl ? 'Κοινότητα' : isRo ? 'Comunitate' : 'Community Board' },
            { href: '/faqs',        label: t(lang,'footer.faqs') },
            { href: '/contact',     label: t(lang,'footer.contact') },
          ].map((l) => (
            <li><a href={l.href} class="text-gray-400 text-sm hover:text-white transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Work With Us -->
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-wider text-gray-400 mb-4">{isEl ? 'Συνεργαστείτε μαζί μας' : isBg ? 'Работете с нас' : isSr ? 'Радите са нама' : isTr ? 'Bizimle Çalışın' : isRo ? 'Lucrați cu Noi' : 'Work With Us'}</h4>
        <ul class="space-y-2.5">
          <li>
            <a href="/for-owners" class="text-gray-400 text-sm hover:text-white transition-colors flex items-center gap-1.5">
              <span>🏡</span> {isEl ? 'Για Ιδιοκτήτες Ακινήτων' : isBg ? 'За собственици на имоти' : isSr ? 'За власнике некретнина' : isTr ? 'Mülk Sahipleri İçin' : isRo ? 'Pentru Proprietari' : 'For Property Owners'}
            </a>
          </li>
          <li>
            <a href="/for-restaurant-owners" class="text-gray-400 text-sm hover:text-white transition-colors flex items-center gap-1.5">
              <span>🍽️</span> {isEl ? 'Για Ιδιοκτήτες Εστιατορίων' : isBg ? 'За собственици на ресторанти' : isSr ? 'За власнике ресторана' : isTr ? 'Restoran Sahipleri İçin' : isRo ? 'Pentru Proprietari de Restaurante' : 'For Restaurant Owners'}
            </a>
          </li>
          <li>
            <a href="/list-your-property" class="text-gray-400 text-sm hover:text-white transition-colors flex items-center gap-1.5">
              <span>📋</span> {isEl ? 'Καταχωρίστε το Ακίνητό σας' : isBg ? 'Публикувайте вашия имот' : isSr ? 'Огласите некретнину' : isTr ? 'Mülkünüzü Listeleyin' : isRo ? 'Listați Proprietatea' : 'List Your Property'}
            </a>
          </li>
          <li>
            <a href="/admin/login" class="text-gray-400 text-sm hover:text-white transition-colors">{isEl ? 'Σύνδεση Ιδιοκτήτη' : isBg ? 'Вход за собственици' : isSr ? 'Пријава власника' : isTr ? 'Mülk Sahibi Girişi' : isRo ? 'Autentificare Proprietar' : 'Owner Sign In'}</a>
          </li>
          <li class="pt-1">
            <a href="/become-a-cleaner" class="text-gray-400 text-sm hover:text-white transition-colors flex items-center gap-1.5">
              <span>🧹</span> {isEl ? 'Γίνετε Καθαριστής' : isBg ? 'Станете почистващ' : isSr ? 'Постаните чистач/чистачица' : isTr ? 'Temizlikçi Olun' : isRo ? 'Deveniți Curățător' : 'Become a Cleaner'}
            </a>
          </li>
          <li>
            <a href="/cleaner/login" class="text-gray-400 text-sm hover:text-white transition-colors">{isEl ? 'Σύνδεση Καθαριστή' : isBg ? 'Вход за почистващи' : isSr ? 'Пријава чистача' : isTr ? 'Temizlikçi Girişi' : isRo ? 'Autentificare Curățător' : 'Cleaner Sign In'}</a>
          </li>
          <li class="pt-1">
            <a href="/partner-with-us" class="text-gray-400 text-sm hover:text-white transition-colors flex items-center gap-1.5">
              <span>🤝</span> {isEl ? 'Συνεργαστείτε μαζί μας' : isBg ? 'Партнирайте с нас' : isSr ? 'Партнерство са нама' : isTr ? 'Bizimle Ortak Olun' : isRo ? 'Parteneriați cu Noi' : 'Partner with us'}
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-wider text-gray-400 mb-4">{t(lang,'footer.legal')}</h4>
        <ul class="space-y-2.5">
          {[
            { href: '/cancellation-policy', label: t(lang,'footer.cancellation') },
            { href: '/terms',               label: t(lang,'footer.terms') },
            { href: '/privacy-policy',      label: t(lang,'footer.privacy') },
          ].map((l) => (
            <li><a href={l.href} class="text-gray-400 text-sm hover:text-white transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-semibold text-sm uppercase tracking-wider text-gray-400 mb-4">{t(lang,'footer.contact')}</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="flex items-start gap-2">
            <span>📍</span>
            <span>Keramoti, Kefalonia<br>Greece 64004</span>
          </li>
          <li class="flex items-center gap-2">
            <span>✉️</span>
            <a href="mailto:info@kefaloniabnb.com" class="hover:text-white transition-colors">info@kefaloniabnb.com</a>
          </li>
          <li class="flex items-center gap-2">
            <span>📱</span>
            <a href="https://wa.me/306900000000" class="hover:text-white transition-colors">{t(lang,'footer.whatsapp')}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-gray-500 text-sm">© {year} KefaloniaBNB. {t(lang,'footer.rights')}</p>
      <p class="text-gray-600 text-xs">{t(lang,'footer.book_tagline')}</p>
    </div>
  </div>
</footer>
