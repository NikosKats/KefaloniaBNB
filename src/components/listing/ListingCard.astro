---
import StarRating from '../shared/StarRating.astro';
import type { ListingWithDetails } from '../../types/index.ts';
import { formatPrice } from '../../lib/pricing.ts';
import { t, type Lang } from '../../i18n/translations.ts';

interface Props {
  listing: ListingWithDetails;
  featured?: boolean;
  showFavorite?: boolean;
  isFavorited?: boolean;
}
const { listing, featured = false, showFavorite = false, isFavorited = false } = Astro.props;
const lang = (Astro.locals.lang ?? 'en') as Lang;
const isEl = lang === 'el';
const isBg = lang === 'bg';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';
const cover = listing.listing_images.find((i) => i.is_cover) ?? listing.listing_images[0];
const amenityBadges = listing.amenities
  .filter((a) => ['beach_access', 'pool', 'gym', 'pet_friendly'].includes(a.key))
  .slice(0, 3);
---

<a href={`/rentals/${listing.slug}`} class="group block">
  <!-- Image -->
  <div class="relative aspect-[4/3] rounded-2xl overflow-hidden bg-gray-100 mb-3">
    {cover ? (
      <img
        src={cover.url}
        alt={cover.alt_text ?? listing.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
        width="600"
        height="450"
      />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-[#1a1a2e] to-[#2d2d4e] flex items-center justify-center">
        <span class="text-white/30 text-6xl">🏡</span>
      </div>
    )}
    <!-- Badges -->
    <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
      {featured && (
        <span class="bg-amber-400 text-amber-900 text-xs font-semibold px-2 py-1 rounded-full shadow-sm">
          ⭐ {isEl ? 'Προτεινόμενο' : isBg ? 'Препоръчано' : isSr ? 'Истакнуто' : isTr ? 'Öne Çıkan' : isRo ? 'Recomandat' : 'Featured'}
        </span>
      )}
      {amenityBadges.map((a) => (
        <span class="bg-white/90 backdrop-blur-sm text-gray-800 text-xs font-medium px-2 py-1 rounded-full">
          {a.icon} {a.label}
        </span>
      ))}
    </div>
    {showFavorite && (
      <button
        type="button"
        data-fav-btn
        data-listing-id={listing.id}
        class={`absolute top-3 right-3 z-10 w-8 h-8 flex items-center justify-center rounded-full bg-white/80 backdrop-blur-sm shadow-sm hover:bg-white transition-colors ${isFavorited ? 'text-red-500' : 'text-gray-400'}`}
        aria-label="Toggle favorite"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill={isFavorited ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
        </svg>
      </button>
    )}
    {!showFavorite && !listing.instant_booking && (
      <div class="absolute top-3 right-3">
        <span class="bg-[#1a1a2e]/80 backdrop-blur-sm text-white text-xs font-medium px-2 py-1 rounded-full">
          {t(lang,'book.request_book')}
        </span>
      </div>
    )}
  </div>

  <!-- Info -->
  <div>
    <div class="flex items-start justify-between gap-2 mb-1">
      <h3 class="font-semibold text-gray-900 text-sm leading-snug group-hover:text-[#c9a96e] transition-colors line-clamp-1">
        {listing.title}
      </h3>
      {listing.review_count > 0 && (
        <div class="flex items-center gap-1 shrink-0">
          <StarRating rating={listing.avg_rating} size="sm" />
          <span class="text-xs text-gray-500">({listing.review_count})</span>
        </div>
      )}
    </div>
    <p class="text-gray-500 text-sm mb-2">
      {listing.city}, {listing.country} · {listing.bedrooms} {t(lang,'listing.bedrooms_stat')} · {listing.max_guests} {t(lang,'listing.guests_stat')}
    </p>
    <p class="text-gray-900 text-sm">
      <span class="font-semibold">{formatPrice(listing.base_price)}</span>
      <span class="text-gray-500"> {t(lang,'widget.per_night')}</span>
    </p>
  </div>
</a>

<script is:inline>
  // Favorite toggle — runs once, attaches to all [data-fav-btn] on the page
  if (!window.__favInit) {
    window.__favInit = true;
    document.addEventListener('click', async function(e) {
      var btn = e.target.closest('[data-fav-btn]');
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      var lid = btn.dataset.listingId;
      var svg = btn.querySelector('svg');
      var isFav = svg.getAttribute('fill') === 'currentColor';
      // Optimistic toggle
      svg.setAttribute('fill', isFav ? 'none' : 'currentColor');
      btn.classList.toggle('text-red-500', !isFav);
      btn.classList.toggle('text-gray-400', isFav);
      try {
        var res = await fetch('/api/favorites', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ listing_id: lid }),
        });
        if (!res.ok) {
          // Revert on error
          svg.setAttribute('fill', isFav ? 'currentColor' : 'none');
          btn.classList.toggle('text-red-500', isFav);
          btn.classList.toggle('text-gray-400', !isFav);
        }
      } catch {
        svg.setAttribute('fill', isFav ? 'currentColor' : 'none');
        btn.classList.toggle('text-red-500', isFav);
        btn.classList.toggle('text-gray-400', !isFav);
      }
    });
  }
</script>
