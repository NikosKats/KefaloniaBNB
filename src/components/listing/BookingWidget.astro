---
import type { Listing, Season } from '../../types/index.ts';
import { formatPrice } from '../../lib/pricing.ts';
import { t, type Lang } from '../../i18n/translations.ts';

interface Props {
  listing: Listing;
  seasons: Season[];
  unavailableRanges?: Array<{ start: string; end: string }>;
}
const { listing, seasons, unavailableRanges = [] } = Astro.props;
const lang = (Astro.locals.lang ?? 'en') as Lang;

const i18nWidget = {
  nights:       t(lang,'widget.nights'),
  cleaning:     t(lang,'widget.cleaning'),
  extraGuest:   t(lang,'widget.extra_guest'),
  discount:     t(lang,'widget.discount'),
  total:        t(lang,'widget.total'),
  selectDates:  t(lang,'widget.select_dates'),
  checkin:      t(lang,'widget.checkin'),
  checkout:     t(lang,'widget.checkout'),
};

const dayNames = t(lang,'cal.days').split(',');
const calLocale = t(lang,'cal.locale');
---

<div id="booking-widget" class="bg-white rounded-2xl border border-gray-200 shadow-lg p-6">
  <!-- Price -->
  <div class="flex items-baseline justify-between mb-5">
    <div>
      <div class="flex items-baseline gap-1.5">
        <span id="widget-price-display" class="text-2xl font-bold text-gray-900">{formatPrice(listing.base_price)}</span>
        <span class="text-gray-500 text-sm"> {t(lang,'widget.per_night')}</span>
      </div>
      <span id="widget-season-badge" class="hidden mt-0.5 inline-flex items-center gap-1 text-xs font-medium text-amber-700 bg-amber-50 border border-amber-200 rounded-full px-2 py-0.5"></span>
    </div>
    {listing.review_count > 0 && (
      <div class="flex items-center gap-1 text-sm">
        <svg class="w-4 h-4 text-amber-400 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <span class="font-medium">{listing.avg_rating.toFixed(1)}</span>
        <span class="text-gray-400">({listing.review_count})</span>
      </div>
    )}
  </div>

  <!-- Date & guest picker -->
  <form id="booking-form" method="GET" action="#" class="space-y-3">
    <!-- Custom date picker trigger -->
    <div class="relative">
      <div
        id="date-picker-trigger"
        class="grid grid-cols-2 border border-gray-300 rounded-xl overflow-hidden cursor-pointer hover:border-gray-400 transition-colors"
      >
        <div class="p-3 border-r border-gray-300" id="ci-display">
          <p class="text-xs font-semibold text-gray-700 uppercase tracking-wide mb-1">{i18nWidget.checkin}</p>
          <p id="ci-label" class="text-sm text-gray-400">dd/mm/yyyy</p>
        </div>
        <div class="p-3" id="co-display">
          <p class="text-xs font-semibold text-gray-700 uppercase tracking-wide mb-1">{i18nWidget.checkout}</p>
          <p id="co-label" class="text-sm text-gray-400">dd/mm/yyyy</p>
        </div>
      </div>
      <input type="hidden" id="widget-checkin" name="check_in" />
      <input type="hidden" id="widget-checkout" name="check_out" />

      <!-- Calendar popup -->
      <div
        id="widget-cal-popup"
        class="hidden absolute left-0 right-0 top-full mt-1 z-50 bg-white border border-gray-200 rounded-2xl shadow-xl p-4"
        style="min-width:320px"
      >
        <!-- Month navigation -->
        <div class="flex items-center justify-between mb-4">
          <button type="button" id="cal-prev" class="p-1.5 rounded-lg hover:bg-gray-100 transition-colors text-gray-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <span id="cal-month-label" class="text-sm font-semibold text-gray-900"></span>
          <button type="button" id="cal-next" class="p-1.5 rounded-lg hover:bg-gray-100 transition-colors text-gray-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
        <!-- Month grid(s) -->
        <div id="widget-cal-months" class="flex gap-6"></div>
        <!-- Hint -->
        <p id="cal-hint" class="text-xs text-gray-400 mt-3 text-center">Select check-in date</p>
        <!-- Legend -->
        <div class="flex gap-4 text-xs text-gray-400 mt-2 justify-center">
          <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded bg-gray-200 inline-block"></span> Unavailable</span>
          <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded bg-[#1a1a2e] inline-block"></span> Selected</span>
        </div>
      </div>
    </div>

    <div class="border border-gray-300 rounded-xl p-3">
      <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wide mb-1">{t(lang,'widget.guests')}</label>
      <select id="widget-guests" name="guests" class="w-full text-sm text-gray-900 outline-none bg-transparent cursor-pointer">
        {Array.from({ length: listing.max_guests }, (_, i) => (
          <option value={i + 1}>{i + 1} {i > 0 ? t(lang,'widget.guests_pl') : t(lang,'widget.guest')}</option>
        ))}
      </select>
    </div>

    <!-- Price breakdown (shown when dates selected) -->
    <div id="price-breakdown" class="hidden space-y-2 py-2 border-t border-gray-100">
      <div class="flex justify-between text-sm text-gray-600">
        <span id="bd-base-label"></span>
        <span id="bd-base-value"></span>
      </div>
      <div class="flex justify-between text-sm text-amber-700 hidden" id="bd-season-row">
        <span id="bd-season-label"></span>
        <span id="bd-season-value"></span>
      </div>
      <div class="flex justify-between text-sm text-gray-600" id="bd-clean-row">
        <span>{t(lang,'widget.cleaning')}</span>
        <span id="bd-clean-value"></span>
      </div>
      <div class="flex justify-between text-sm text-gray-600 hidden" id="bd-extra-row">
        <span>{t(lang,'widget.extra_guest')}</span>
        <span id="bd-extra-value"></span>
      </div>
      <div class="flex justify-between text-sm text-gray-600 hidden" id="bd-coupon-row">
        <span id="bd-coupon-label">{t(lang,'widget.discount')}</span>
        <span id="bd-coupon-value" class="text-green-600"></span>
      </div>
      <div class="flex justify-between font-semibold text-gray-900 pt-2 border-t border-gray-100">
        <span>{t(lang,'widget.total')}</span>
        <span id="bd-total"></span>
      </div>
    </div>

    <!-- Coupon -->
    <div class="flex gap-2">
      <input
        type="text"
        id="coupon-input"
        placeholder={t(lang,'widget.promo')}
        class="flex-1 border border-gray-300 rounded-xl px-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-[#1a1a2e] focus:border-transparent"
      />
      <button
        type="button"
        id="coupon-btn"
        class="border border-gray-300 rounded-xl px-3 py-2.5 text-sm font-medium hover:bg-gray-50 transition-colors"
      >
        {t(lang,'widget.apply')}
      </button>
    </div>
    <div id="coupon-msg" class="text-xs hidden"></div>

    <!-- Min nights notice -->
    {listing.min_nights > 1 && (
      <p class="text-xs text-gray-500 text-center">
        {t(lang,'widget.min_nights')}: {listing.min_nights} {t(lang,'widget.nights')}
      </p>
    )}

    <button
      type="submit"
      id="book-btn"
      class="w-full bg-[#1a1a2e] hover:bg-[#2d2d4e] text-white font-semibold py-4 rounded-xl transition-colors text-sm disabled:opacity-50 disabled:cursor-not-allowed"
    >
      {listing.instant_booking ? t(lang,'widget.book_now') : t(lang,'widget.request_book')}
    </button>
  </form>

  <p class="text-center text-xs text-gray-400 mt-3">{t(lang,'widget.no_charge')}</p>
</div>

<script define:vars={{ listing, seasons, i18nWidget, unavailableRanges, dayNames, calLocale }}>
  const ciInput    = document.getElementById('widget-checkin');
  const coInput    = document.getElementById('widget-checkout');
  const ciLabel    = document.getElementById('ci-label');
  const coLabel    = document.getElementById('co-label');
  const ciDisplay  = document.getElementById('ci-display');
  const coDisplay  = document.getElementById('co-display');
  const trigger    = document.getElementById('date-picker-trigger');
  const popup      = document.getElementById('widget-cal-popup');
  const monthsEl   = document.getElementById('widget-cal-months');
  const hintEl     = document.getElementById('cal-hint');
  const guestsInput = document.getElementById('widget-guests');
  const breakdown  = document.getElementById('price-breakdown');
  const form       = document.getElementById('booking-form');

  let couponDiscount = 0;
  let couponCode = '';
  let selectedCI = null;
  let selectedCO = null;

  function localDateStr(d) {
    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  }

  // Build unavailable day set
  const unavailableDays = new Set();
  for (const range of (unavailableRanges || [])) {
    const d = new Date(range.start + 'T00:00:00');
    while (localDateStr(d) < range.end) {
      unavailableDays.add(localDateStr(d));
      d.setDate(d.getDate() + 1);
    }
  }

  // Calendar state: which months are visible (show 2 at once)
  const now = new Date();
  let calYear = now.getFullYear();
  let calMonth = now.getMonth();

  function fmtDisplay(ds) {
    if (!ds) return 'dd/mm/yyyy';
    const [y, m, d] = ds.split('-');
    return `${d}/${m}/${y}`;
  }

  function renderCalMonth(year, month) {
    const firstDay    = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const monthName   = new Date(year, month).toLocaleDateString(calLocale, { month: 'long', year: 'numeric' });
    const today       = localDateStr(new Date());

    let html = `<div class="flex-1 min-w-[200px]">`;
    html += `<div class="grid grid-cols-7 gap-0.5 mb-1.5">`;
    for (const d of dayNames) html += `<div class="text-center text-[10px] text-gray-400 font-medium">${d}</div>`;
    html += `</div><div class="grid grid-cols-7 gap-0.5">`;
    for (let i = 0; i < firstDay; i++) html += `<div></div>`;

    for (let day = 1; day <= daysInMonth; day++) {
      const ds = `${year}-${String(month+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
      const isPast    = ds < today;
      const isUnavail = unavailableDays.has(ds);
      const isCI      = ds === selectedCI;
      const isCO      = ds === selectedCO;
      const inRange   = selectedCI && selectedCO && ds > selectedCI && ds < selectedCO;
      const isHover   = selectedCI && !selectedCO && ds > selectedCI;

      let cls = 'text-center text-xs py-1 rounded transition-colors ';
      if (isPast || isUnavail) {
        cls += 'text-gray-300 line-through cursor-not-allowed select-none';
      } else if (isCI || isCO) {
        cls += 'bg-[#1a1a2e] text-white font-bold cursor-pointer';
      } else if (inRange) {
        cls += 'bg-[#1a1a2e]/10 text-[#1a1a2e] cursor-pointer';
      } else {
        cls += 'text-gray-800 cursor-pointer hover:bg-gray-100';
      }

      html += `<button class="${cls}" data-date="${ds}" ${(isPast || isUnavail) ? 'disabled' : ''} type="button">${day}</button>`;
    }
    html += `</div></div>`;
    return html;
  }

  function renderCalPopup() {
    if (!monthsEl) return;
    // Show 1 month at a time (widget is narrow)
    monthsEl.innerHTML = renderCalMonth(calYear, calMonth);

    // Update month label
    const labelEl = document.getElementById('cal-month-label');
    if (labelEl) {
      labelEl.textContent = new Date(calYear, calMonth).toLocaleDateString(calLocale, { month: 'long', year: 'numeric' });
    }

    // Hint
    if (hintEl) hintEl.textContent = selectedCI && !selectedCO ? 'Select check-out date' : selectedCI && selectedCO ? '✓ Dates selected — click to change' : 'Select check-in date';

    monthsEl.querySelectorAll('button[data-date]').forEach(btn => {
      btn.addEventListener('click', () => handleCalClick(btn.dataset.date));
    });
  }

  function handleCalClick(date) {
    if (!selectedCI || (selectedCI && selectedCO)) {
      selectedCI = date; selectedCO = null;
    } else if (date <= selectedCI) {
      selectedCI = date; selectedCO = null;
    } else {
      // Check no unavailable dates in range
      const cur = new Date(selectedCI + 'T00:00:00');
      cur.setDate(cur.getDate() + 1);
      let hasBlock = false;
      while (localDateStr(cur) < date) {
        if (unavailableDays.has(localDateStr(cur))) { hasBlock = true; break; }
        cur.setDate(cur.getDate() + 1);
      }
      if (hasBlock) { selectedCI = date; selectedCO = null; }
      else { selectedCO = date; }
    }

    // Update labels + hidden inputs
    ciLabel.textContent = selectedCI ? fmtDisplay(selectedCI) : 'dd/mm/yyyy';
    coLabel.textContent = selectedCO ? fmtDisplay(selectedCO) : 'dd/mm/yyyy';
    ciLabel.classList.toggle('text-gray-400', !selectedCI);
    ciLabel.classList.toggle('text-gray-900', !!selectedCI);
    coLabel.classList.toggle('text-gray-400', !selectedCO);
    coLabel.classList.toggle('text-gray-900', !!selectedCO);
    ciInput.value = selectedCI ?? '';
    coInput.value = selectedCO ?? '';

    renderCalPopup();
    updateBreakdown();

    // Close if both selected
    if (selectedCI && selectedCO) {
      setTimeout(() => popup?.classList.add('hidden'), 300);
    }
  }

  // Open/close popup
  trigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    popup?.classList.toggle('hidden');
    if (!popup?.classList.contains('hidden')) renderCalPopup();
  });
  document.addEventListener('click', (e) => {
    if (!popup?.contains(e.target) && e.target !== trigger && !trigger?.contains(e.target)) {
      popup?.classList.add('hidden');
    }
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') popup?.classList.add('hidden'); });

  // Prev/next navigation
  document.getElementById('cal-prev')?.addEventListener('click', (e) => {
    e.stopPropagation();
    calMonth--;
    if (calMonth < 0) { calMonth = 11; calYear--; }
    renderCalPopup();
  });
  document.getElementById('cal-next')?.addEventListener('click', (e) => {
    e.stopPropagation();
    calMonth++;
    if (calMonth > 11) { calMonth = 0; calYear++; }
    renderCalPopup();
  });

  // Sync with page calendar
  document.addEventListener('dates-selected', (e) => {
    const { checkIn, checkOut } = e.detail;
    if (checkIn) { selectedCI = checkIn; ciInput.value = checkIn; ciLabel.textContent = fmtDisplay(checkIn); ciLabel.classList.replace('text-gray-400','text-gray-900'); }
    if (checkOut) { selectedCO = checkOut; coInput.value = checkOut; coLabel.textContent = fmtDisplay(checkOut); coLabel.classList.replace('text-gray-400','text-gray-900'); }
    updateBreakdown();
  });

  // ── Price calc ──────────────────────────────────────────────────────────────
  function calcPrice(checkIn, checkOut, guests) {
    const msPerDay = 1000 * 60 * 60 * 24;
    const nights = Math.round((new Date(checkOut) - new Date(checkIn)) / msPerDay);
    if (nights <= 0) return null;
    const season = seasons.find(s => s.start_date <= checkIn && s.end_date >= checkOut);
    const mod = season?.price_modifier ?? 1.0;
    const basePrice = listing.base_price;
    const baseTotal = basePrice * nights;
    const seasonSurcharge = Math.round((mod - 1) * baseTotal * 100) / 100;
    const extraGuests = Math.max(0, guests - listing.extra_guest_after);
    const extraFee = listing.extra_guest_fee * extraGuests * nights;
    const total = Math.max(0, baseTotal + seasonSurcharge + listing.cleaning_fee + extraFee - couponDiscount);
    return { nights, basePrice, baseTotal, seasonSurcharge, seasonName: season?.name ?? null, cleaningFee: listing.cleaning_fee, extraFee, total };
  }

  function fmt(n) {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'EUR', minimumFractionDigits: 0 }).format(n);
  }

  function updateBreakdown() {
    const ci = ciInput.value;
    const co = coInput.value;
    const guests = parseInt(guestsInput.value);
    if (!ci || !co) {
      breakdown?.classList.add('hidden');
      const pd = document.getElementById('widget-price-display');
      if (pd) pd.textContent = fmt(listing.base_price);
      document.getElementById('widget-season-badge')?.classList.add('hidden');
      return;
    }
    const p = calcPrice(ci, co, guests);
    if (!p) { breakdown?.classList.add('hidden'); return; }

    breakdown?.classList.remove('hidden');

    // Update header price + season badge
    const priceDisplay = document.getElementById('widget-price-display');
    const seasonBadge  = document.getElementById('widget-season-badge');
    if (p.seasonSurcharge !== 0) {
      const effectiveNightly = (p.basePrice * (1 + p.seasonSurcharge / p.baseTotal));
      if (priceDisplay) priceDisplay.textContent = fmt(Math.round(effectiveNightly));
      if (seasonBadge) {
        const pctBadge = Math.round((p.seasonSurcharge / p.baseTotal) * 100);
        seasonBadge.textContent = `★ ${p.seasonName ?? 'Peak season'} +${pctBadge}%`;
        seasonBadge.classList.remove('hidden');
      }
    } else {
      if (priceDisplay) priceDisplay.textContent = fmt(listing.base_price);
      seasonBadge?.classList.add('hidden');
    }

    document.getElementById('bd-base-label').textContent = `${fmt(p.basePrice)} × ${p.nights} ${i18nWidget.nights}`;
    document.getElementById('bd-base-value').textContent = fmt(p.baseTotal);
    const seasonRow = document.getElementById('bd-season-row');
    if (p.seasonSurcharge !== 0) {
      seasonRow?.classList.remove('hidden');
      const pct = Math.round((p.seasonSurcharge / p.baseTotal) * 100);
      document.getElementById('bd-season-label').textContent = p.seasonName ? `${p.seasonName} (+${pct}%)` : `Peak season (+${pct}%)`;
      document.getElementById('bd-season-value').textContent = `+${fmt(p.seasonSurcharge)}`;
    } else {
      seasonRow?.classList.add('hidden');
    }
    document.getElementById('bd-clean-value').textContent = fmt(p.cleaningFee);
    const extraRow = document.getElementById('bd-extra-row');
    if (p.extraFee > 0) { extraRow?.classList.remove('hidden'); document.getElementById('bd-extra-value').textContent = fmt(p.extraFee); }
    else extraRow?.classList.add('hidden');
    const couponRow = document.getElementById('bd-coupon-row');
    if (couponDiscount > 0) { couponRow?.classList.remove('hidden'); document.getElementById('bd-coupon-value').textContent = `-${fmt(couponDiscount)}`; }
    else couponRow?.classList.add('hidden');
    document.getElementById('bd-total').textContent = fmt(p.total);
  }

  guestsInput?.addEventListener('change', updateBreakdown);

  // Coupon
  document.getElementById('coupon-btn')?.addEventListener('click', async () => {
    const code = document.getElementById('coupon-input').value.trim();
    const msg = document.getElementById('coupon-msg');
    if (!code) return;
    const ci = ciInput.value; const co = coInput.value;
    const res = await fetch(`/api/coupons/validate?code=${encodeURIComponent(code)}&listing_id=${listing.id}&check_in=${ci}&check_out=${co}`);
    const data = await res.json();
    msg.classList.remove('hidden', 'text-green-600', 'text-red-600');
    if (data.valid) { couponDiscount = data.discount ?? 0; couponCode = code; msg.classList.add('text-green-600'); msg.textContent = `✓ ${data.message}`; }
    else { couponDiscount = 0; couponCode = ''; msg.classList.add('text-red-600'); msg.textContent = data.message ?? 'Invalid code'; }
    updateBreakdown();
  });

  // Form submit
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const ci = ciInput.value; const co = coInput.value; const guests = guestsInput.value;
    if (!ci || !co) { alert(i18nWidget.selectDates); return; }
    const params = new URLSearchParams({ check_in: ci, check_out: co, guests, ...(couponCode && { coupon: couponCode }) });
    window.location.href = `/book/${listing.id}?${params}`;
  });
</script>
