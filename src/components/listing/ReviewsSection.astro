---
import StarRating from '../shared/StarRating.astro';
import type { Review } from '../../types/index.ts';
import { t, type Lang } from '../../i18n/translations.ts';

interface Props {
  reviews: Review[];
  avgRating: number;
  reviewCount: number;
}
const { reviews, avgRating, reviewCount } = Astro.props;
const lang = (Astro.locals.lang ?? 'en') as Lang;
const locale = t(lang, 'cal.locale');

function fmtDate(d: string) {
  return new Date(d).toLocaleDateString(locale, { month: 'long', year: 'numeric' });
}
---

{reviewCount > 0 && (
  <section>
    <!-- Aggregate -->
    <div class="flex items-center gap-4 mb-8">
      <div class="text-center">
        <p class="text-5xl font-bold text-gray-900">{avgRating.toFixed(1)}</p>
        <StarRating rating={avgRating} size="lg" />
        <p class="text-sm text-gray-500 mt-1">{reviewCount} {reviewCount !== 1 ? t(lang,'reviews.reviews_pl') : t(lang,'reviews.review')}</p>
      </div>
      <div class="flex-1 ml-6 space-y-1.5">
        {[5,4,3,2,1].map((star) => {
          const count = reviews.filter(r => r.rating === star).length;
          const pct = reviewCount > 0 ? (count / reviewCount) * 100 : 0;
          return (
            <div class="flex items-center gap-2 text-sm">
              <span class="w-4 text-gray-600 text-right">{star}</span>
              <svg class="w-3.5 h-3.5 text-amber-400 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <div class="flex-1 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                <div class="h-full bg-amber-400 rounded-full transition-all" style={`width:${pct}%`}></div>
              </div>
              <span class="w-6 text-gray-400">{count}</span>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Review cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {reviews.slice(0, 6).map((review) => (
        <div class="bg-gray-50 rounded-xl p-5">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-[#1a1a2e] text-white flex items-center justify-center font-semibold text-sm">
                {review.guest_name.charAt(0)}
              </div>
              <div>
                <p class="font-semibold text-gray-900 text-sm">{review.guest_name}</p>
                <p class="text-xs text-gray-400">{review.guest_country ?? ''}{review.stay_date ? ` · ${fmtDate(review.stay_date)}` : ''}</p>
              </div>
            </div>
            <StarRating rating={review.rating} size="sm" />
          </div>
          {review.title && <p class="font-medium text-gray-800 text-sm mb-1">{review.title}</p>}
          <p class="text-gray-600 text-sm leading-relaxed line-clamp-4">{review.body}</p>
          {review.is_verified && (
            <p class="mt-2 text-xs text-emerald-600 font-medium flex items-center gap-1">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              {t(lang,'reviews.verified')}
            </p>
          )}
        </div>
      ))}
    </div>
  </section>
)}
