---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, type Lang } from '../i18n/translations.ts';

const lang = (Astro.locals.lang ?? 'en') as Lang;
const isEl = lang === 'el';
const isBg = lang === 'bg';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';
const supabase = Astro.locals.supabase;
const { data: page } = await supabase.from('cms_pages').select('*, faq_items(*)').eq('slug', 'faqs').single();
const cmsItems = (page?.faq_items ?? []).sort((a: any, b: any) => a.sort_order - b.sort_order);

const fallbackFaqs = [
  {
    id: 'booking',
    category: 'Searching & Booking',
    icon: '🔍',
    items: [
      {
        q: 'How do I search for a property?',
        a: 'Use the search bar on our homepage to enter your destination, travel dates and number of guests. Filter results by price, amenities, property type and more to find your perfect stay.',
      },
      {
        q: 'Can I book instantly or do I need approval?',
        a: 'It depends on the property. Listings marked with an "Instant" badge are confirmed immediately after payment. Others are sent to the host for approval — you\'ll typically hear back within a few hours.',
      },
      {
        q: 'Can I modify my dates after booking?',
        a: 'Date changes are subject to availability and the host\'s approval. Contact us or the host as soon as possible. If the new dates cost more or less, the difference will be charged or refunded accordingly.',
      },
      {
        q: 'Do I need to create an account to book?',
        a: 'No account is needed. Simply fill in your details at checkout and all booking confirmations, receipts and check-in instructions are sent directly to your email.',
      },
      {
        q: 'How far in advance can I book?',
        a: 'Most properties accept bookings up to 12 months in advance. The calendar on each listing shows exactly which dates are available in real time.',
      },
    ],
  },
  {
    id: 'payment',
    category: 'Payment',
    icon: '💳',
    items: [
      {
        q: 'What payment methods are accepted?',
        a: 'We accept all major credit and debit cards (Visa, Mastercard) processed securely through Stripe, as well as bank transfers via IBAN, Revolut or Wise. Card payments are confirmed instantly; bank transfers are confirmed within 24 hours.',
      },
      {
        q: 'Can I pay a deposit and settle the rest later?',
        a: 'Yes — many properties offer a flexible deposit option. You pay a small percentage now to secure your booking, and the remaining balance is collected on arrival. Look for the "Pay deposit" option at checkout.',
      },
      {
        q: 'Is it safe to pay online?',
        a: 'Absolutely. Card payments are handled by Stripe, a PCI-DSS Level 1 certified processor trusted by millions of businesses globally. We never store your card details on our servers.',
      },
      {
        q: 'When will I receive my receipt?',
        a: 'A payment confirmation with a full cost breakdown is sent to your email immediately after your booking is paid. You can also use this as proof of payment for bank transfer bookings.',
      },
      {
        q: 'Are there any hidden fees?',
        a: 'No surprises. The price breakdown shown before you confirm includes the nightly rate, cleaning fee, any applicable extra-guest fees and taxes. The total you see is the total you pay.',
      },
    ],
  },
  {
    id: 'stay',
    category: 'Your Stay',
    icon: '🏡',
    items: [
      {
        q: 'How do I check in?',
        a: 'You\'ll receive a detailed check-in email 48 hours before arrival containing directions, access instructions (key safe codes, key handover details etc.) and any property-specific notes.',
      },
      {
        q: 'What time is check-in and check-out?',
        a: 'Standard check-in is from 15:00 and check-out is by 11:00. Early check-in or late check-out can often be arranged directly with the host in advance, subject to availability.',
      },
      {
        q: 'What\'s included in every property?',
        a: 'All properties come with Wi-Fi, bed linen, towels and the amenities listed on each property page. Beyond those basics, what\'s included varies — review the amenities section on the listing before booking.',
      },
      {
        q: 'What if I have a problem during my stay?',
        a: 'Contact us or the host immediately by phone, email or WhatsApp. We aim to resolve any issues same-day. If a problem makes the property uninhabitable and can\'t be fixed, we will work to find alternative accommodation.',
      },
      {
        q: 'Are pets allowed?',
        a: 'Pet policies are set by each host. Check the listing page or the amenities section to see if pets are welcome. If you\'re unsure, reach out before booking — some hosts are happy to accommodate pets on request.',
      },
    ],
  },
  {
    id: 'cancellations',
    category: 'Cancellations & Refunds',
    icon: '↩️',
    items: [
      {
        q: 'What cancellation policy applies to my booking?',
        a: 'Each property has its own policy — Flexible, Moderate or Strict — clearly shown on the listing page and in your booking confirmation. Always review the policy before booking as refund terms differ.',
      },
      {
        q: 'How do I cancel a booking?',
        a: 'Reply to your booking confirmation email or contact us via the site. Include your booking reference number and we\'ll process the cancellation and confirm your eligibility for a refund.',
      },
      {
        q: 'How long does a refund take?',
        a: 'Refunds for card payments are processed within 5–10 business days back to the original card. Bank transfer refunds are returned to the account you paid from within 3–5 business days.',
      },
      {
        q: 'What happens if the host cancels my booking?',
        a: 'If a host cancels, you receive a full refund automatically — no questions asked. We\'ll also help you find an alternative property for your dates.',
      },
    ],
  },
  {
    id: 'hosting',
    category: 'For Hosts',
    icon: '🏠',
    items: [
      {
        q: 'How do I list my property?',
        a: 'Create a host account, go to your dashboard and click "Add listing". You\'ll be guided through uploading photos, setting your prices, availability and house rules. Listings go live once reviewed.',
      },
      {
        q: 'How and when do I get paid?',
        a: 'Payouts are sent automatically to your connected bank account or Stripe account after each guest checks in. You can view all upcoming and past payouts in your host dashboard.',
      },
      {
        q: 'Can I set my own prices and availability?',
        a: 'Yes — you have full control. Set your base nightly rate, seasonal pricing, minimum and maximum stay lengths, and block off dates whenever you need. Changes take effect immediately.',
      },
      {
        q: 'What fees does the platform charge hosts?',
        a: 'We charge a small commission on each completed booking. The exact percentage is shown in your host settings and is deducted before payout — you always see the net amount you\'ll receive.',
      },
    ],
  },
];

const useCms = false; // always show generic platform FAQs
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? '';
const allFaqsFlat = useCms
  ? cmsItems
  : fallbackFaqs.flatMap((g) => g.items.map((i) => ({ question: i.q, answer: i.a })));

const faqSchema = allFaqsFlat.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqsFlat.map((faq: any) => ({
    '@type': 'Question',
    name: faq.question ?? faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer ?? faq.a },
  })),
} : null;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'FAQs', item: `${siteUrl}/faqs` },
    ],
  },
  ...(faqSchema ? [faqSchema] : []),
];
---

<BaseLayout
  title={page?.meta_title ?? 'Frequently Asked Questions'}
  description={page?.meta_description ?? 'Everything you need to know about searching, booking, payments, check-in, cancellations and hosting on our platform.'}
  schema={schemas}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

    <!-- Header -->
    <div class="text-center mb-12">
      <p class="text-[#c9a96e] font-semibold text-sm uppercase tracking-wider mb-2">{isEl ? 'Κέντρο Βοήθειας' : isBg ? 'Център за помощ' : isSr ? 'Центар за помоћ' : isTr ? 'Yardım Merkezi' : isRo ? 'Centru de Ajutor' : 'Help Centre'}</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">{page?.title ?? 'Frequently Asked Questions'}</h1>
      <p class="text-gray-500 max-w-xl mx-auto">
        {isEl ? 'Βρείτε γρήγορες απαντήσεις παρακάτω. Δεν βρίσκετε αυτό που ψάχνετε;' : isBg ? 'Намерете бързи отговори по-долу. Не можете да намерите търсеното?' : isSr ? 'Пронађите брзе одговоре испод. Не можете да нађете оно што тражите?' : isTr ? 'Aşağıda hızlı yanıtlar bulun. Aradığınızı bulamıyor musunuz?' : isRo ? 'Găsiți răspunsuri rapide mai jos. Nu găsiți ce căutați?' : 'Find quick answers below. Can\'t find what you\'re looking for?'}{' '}
        <a href="/contact" class="text-[#1a1a2e] font-medium underline hover:text-[#c9a96e] transition-colors">{isEl ? 'Επικοινωνήστε μαζί μας' : isBg ? 'Свържете се с нас' : isSr ? 'Контактирајте нас' : isTr ? 'Bizimle iletişime geçin' : isRo ? 'Contactați-ne' : 'Contact us'}</a>
        {' '}{isEl ? '— απαντάμε εντός λίγων ωρών.' : isBg ? '— отговаряме в рамките на няколко часа.' : isSr ? '— одговарамо у року од неколико сати.' : isTr ? '— birkaç saat içinde yanıt veririz.' : isRo ? '— răspundem în câteva ore.' : '— we reply within a few hours.'}
      </p>
    </div>

    {useCms ? (
      <!-- CMS-managed FAQs -->
      <div class="space-y-3">
        {cmsItems.map((faq: any) => (
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between p-5 cursor-pointer font-medium text-gray-900 hover:bg-gray-50 transition-colors list-none">
              {faq.question}
              <svg class="w-5 h-5 text-gray-400 shrink-0 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-5 pb-5 text-gray-600 text-sm leading-relaxed border-t border-gray-100 pt-4">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    ) : (
      <!-- Generic grouped FAQs with category tabs -->
      <div>
        <!-- Category tabs -->
        <div class="flex gap-2 flex-wrap mb-8" id="faq-tabs">
          <button
            class="faq-tab px-4 py-2 rounded-full text-sm font-medium transition-colors bg-[#1a1a2e] text-white"
            data-target="all"
          >
            {isEl ? 'Όλα' : isBg ? 'Всички' : isSr ? 'Све' : isTr ? 'Tümü' : isRo ? 'Toate' : 'All'}
          </button>
          {fallbackFaqs.map((group) => (
            <button
              class="faq-tab px-4 py-2 rounded-full text-sm font-medium transition-colors bg-gray-100 text-gray-600 hover:bg-gray-200"
              data-target={group.id}
            >
              <span class="mr-1.5">{group.icon}</span>{
                group.id === 'booking' ? (isEl ? 'Αναζήτηση & Κράτηση' : isBg ? 'Търсене & Резервация' : isSr ? 'Претрага & Резервација' : isTr ? 'Arama & Rezervasyon' : isRo ? 'Căutare & Rezervare' : group.category) :
                group.id === 'payment' ? (isEl ? 'Πληρωμή' : isBg ? 'Плащане' : isSr ? 'Плаћање' : isTr ? 'Ödeme' : isRo ? 'Plată' : group.category) :
                group.id === 'stay' ? (isEl ? 'Η Διαμονή σας' : isBg ? 'Вашият престой' : isSr ? 'Ваш боравак' : isTr ? 'Konaklamanız' : isRo ? 'Sejurul Dvs.' : group.category) :
                group.id === 'cancellations' ? (isEl ? 'Ακυρώσεις & Επιστροφές' : isBg ? 'Анулации & Възстановявания' : isSr ? 'Отказивање & Повраћај' : isTr ? 'İptal & İade' : isRo ? 'Anulări & Rambursări' : group.category) :
                group.id === 'hosting' ? (isEl ? 'Για Ιδιοκτήτες' : isBg ? 'За домакини' : isSr ? 'За домаћине' : isTr ? 'Ev Sahipleri İçin' : isRo ? 'Pentru Proprietari' : group.category) :
                group.category
              }
            </button>
          ))}
        </div>

        <!-- FAQ groups -->
        <div class="space-y-10" id="faq-groups">
          {fallbackFaqs.map((group) => (
            <section class="faq-group" data-group={group.id}>
              <div class="flex items-center gap-2 mb-4">
                <span class="text-xl">{group.icon}</span>
                <h2 class="text-sm font-semibold uppercase tracking-widest text-gray-400">{
                  group.id === 'booking' ? (isEl ? 'Αναζήτηση & Κράτηση' : isBg ? 'Търсене & Резервация' : isSr ? 'Претрага & Резервација' : isTr ? 'Arama & Rezervasyon' : isRo ? 'Căutare & Rezervare' : group.category) :
                  group.id === 'payment' ? (isEl ? 'Πληρωμή' : isBg ? 'Плащане' : isSr ? 'Плаћање' : isTr ? 'Ödeme' : isRo ? 'Plată' : group.category) :
                  group.id === 'stay' ? (isEl ? 'Η Διαμονή σας' : isBg ? 'Вашият престой' : isSr ? 'Ваш боравак' : isTr ? 'Konaklamanız' : isRo ? 'Sejurul Dvs.' : group.category) :
                  group.id === 'cancellations' ? (isEl ? 'Ακυρώσεις & Επιστροφές' : isBg ? 'Анулации & Възстановявания' : isSr ? 'Отказивање & Повраћај' : isTr ? 'İptal & İade' : isRo ? 'Anulări & Rambursări' : group.category) :
                  group.id === 'hosting' ? (isEl ? 'Για Ιδιοκτήτες' : isBg ? 'За домакини' : isSr ? 'За домаћине' : isTr ? 'Ev Sahipleri İçin' : isRo ? 'Pentru Proprietari' : group.category) :
                  group.category
                }</h2>
              </div>
              <div class="space-y-3">
                {group.items.map((faq) => (
                  <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
                    <summary class="flex items-center justify-between p-5 cursor-pointer font-medium text-gray-900 hover:bg-gray-50 transition-colors list-none">
                      {
                        faq.q === 'How do I search for a property?' ? (isEl ? 'Πώς αναζητώ ένα ακίνητο;' : isBg ? 'Как да търся имот?' : isSr ? 'Како да претражим некретнину?' : isTr ? 'Bir mülkü nasıl ararım?' : isRo ? 'Cum caut o proprietate?' : faq.q) :
                        faq.q === 'Can I book instantly or do I need approval?' ? (isEl ? 'Μπορώ να κάνω άμεση κράτηση ή χρειάζομαι έγκριση;' : isBg ? 'Мога ли да резервирам веднага или ми е нужно одобрение?' : isSr ? 'Могу ли да резервишем одмах или ми је потребно одобрење?' : isTr ? 'Anında rezervasyon yapabilir miyim yoksa onay gerekli mi?' : isRo ? 'Pot rezerva instant sau am nevoie de aprobare?' : faq.q) :
                        faq.q === 'Can I modify my dates after booking?' ? (isEl ? 'Μπορώ να αλλάξω τις ημερομηνίες μου μετά την κράτηση;' : isBg ? 'Мога ли да променя датите след резервацията?' : isSr ? 'Могу ли да изменим датуме након резервације?' : isTr ? 'Rezervasyon sonrası tarihlerimi değiştirebilir miyim?' : isRo ? 'Pot modifica datele după rezervare?' : faq.q) :
                        faq.q === 'Do I need to create an account to book?' ? (isEl ? 'Χρειάζομαι λογαριασμό για να κάνω κράτηση;' : isBg ? 'Трябва ли да създам акаунт, за да резервирам?' : isSr ? 'Да ли ми је потребан налог за резервацију?' : isTr ? 'Rezervasyon yapmak için hesap oluşturmam gerekiyor mu?' : isRo ? 'Trebuie să-mi creez cont pentru a rezerva?' : faq.q) :
                        faq.q === 'How far in advance can I book?' ? (isEl ? 'Πόσο νωρίτερα μπορώ να κάνω κράτηση;' : isBg ? 'Колко предварително мога да резервирам?' : isSr ? 'Колико унапред могу да резервишем?' : isTr ? 'Ne kadar önceden rezervasyon yapabilirim?' : isRo ? 'Cu cât timp înainte pot rezerva?' : faq.q) :
                        faq.q === 'What payment methods are accepted?' ? (isEl ? 'Ποιες μέθοδοι πληρωμής γίνονται δεκτές;' : isBg ? 'Какви методи на плащане се приемат?' : isSr ? 'Које методе плаћања се прихватају?' : isTr ? 'Hangi ödeme yöntemleri kabul edilmektedir?' : isRo ? 'Ce metode de plată sunt acceptate?' : faq.q) :
                        faq.q === 'Can I pay a deposit and settle the rest later?' ? (isEl ? 'Μπορώ να πληρώσω προκαταβολή και το υπόλοιπο αργότερα;' : isBg ? 'Мога ли да платя депозит и остатъка по-късно?' : isSr ? 'Могу ли да платим депозит и остатак касније?' : isTr ? 'Depozito ödeyip kalanını sonra ödeyebilir miyim?' : isRo ? 'Pot plăti un avans și restul mai târziu?' : faq.q) :
                        faq.q === 'Is it safe to pay online?' ? (isEl ? 'Είναι ασφαλής η ηλεκτρονική πληρωμή;' : isBg ? 'Безопасно ли е да плащам онлайн?' : isSr ? 'Да ли је безбедно плаћати онлајн?' : isTr ? 'Online ödeme güvenli mi?' : isRo ? 'Este sigur să plătesc online?' : faq.q) :
                        faq.q === 'When will I receive my receipt?' ? (isEl ? 'Πότε θα λάβω την απόδειξή μου;' : isBg ? 'Кога ще получа разписката си?' : isSr ? 'Када ћу добити потврду о плаћању?' : isTr ? 'Makbuzumu ne zaman alacağım?' : isRo ? 'Când voi primi chitanța?' : faq.q) :
                        faq.q === 'Are there any hidden fees?' ? (isEl ? 'Υπάρχουν κρυφές χρεώσεις;' : isBg ? 'Има ли скрити такси?' : isSr ? 'Постоје ли скривене накнаде?' : isTr ? 'Gizli ücretler var mı?' : isRo ? 'Există comisioane ascunse?' : faq.q) :
                        faq.q === 'How do I check in?' ? (isEl ? 'Πώς κάνω check-in;' : isBg ? 'Как да направя настаняване?' : isSr ? 'Како се пријављујем?' : isTr ? 'Nasıl giriş yaparım?' : isRo ? 'Cum fac check-in?' : faq.q) :
                        faq.q === 'What time is check-in and check-out?' ? (isEl ? 'Ποια ώρα είναι το check-in και check-out;' : isBg ? 'В колко часа е настаняването и напускането?' : isSr ? 'Када је долазак и одлазак?' : isTr ? 'Giriş ve çıkış saatleri nelerdir?' : isRo ? 'La ce oră este check-in și check-out?' : faq.q) :
                        faq.q === "What's included in every property?" ? (isEl ? 'Τι περιλαμβάνεται σε κάθε ακίνητο;' : isBg ? 'Какво е включено във всеки имот?' : isSr ? 'Шта је укључено у свакој некретнини?' : isTr ? 'Her mülkte neler dahildir?' : isRo ? 'Ce este inclus în fiecare proprietate?' : faq.q) :
                        faq.q === 'What if I have a problem during my stay?' ? (isEl ? 'Τι γίνεται αν αντιμετωπίσω πρόβλημα κατά τη διαμονή μου;' : isBg ? 'Какво да правя, ако имам проблем по време на престоя?' : isSr ? 'Шта ако имам проблем током боравка?' : isTr ? 'Konaklamam sırasında bir sorun yaşarsam ne olur?' : isRo ? 'Ce se întâmplă dacă am o problemă în timpul sejurului?' : faq.q) :
                        faq.q === 'Are pets allowed?' ? (isEl ? 'Επιτρέπονται τα κατοικίδια;' : isBg ? 'Разрешени ли са домашни любимци?' : isSr ? 'Да ли су кућни љубимци дозвољени?' : isTr ? 'Evcil hayvanlar kabul ediliyor mu?' : isRo ? 'Sunt permise animalele de companie?' : faq.q) :
                        faq.q === 'What cancellation policy applies to my booking?' ? (isEl ? 'Ποια πολιτική ακύρωσης ισχύει για την κράτησή μου;' : isBg ? 'Каква политика за анулация важи за моята резервация?' : isSr ? 'Која политика отказивања важи за моју резервацију?' : isTr ? 'Rezervasyonuma hangi iptal politikası uygulanır?' : isRo ? 'Ce politică de anulare se aplică rezervării mele?' : faq.q) :
                        faq.q === 'How do I cancel a booking?' ? (isEl ? 'Πώς ακυρώνω μια κράτηση;' : isBg ? 'Как да анулирам резервация?' : isSr ? 'Како да откажем резервацију?' : isTr ? 'Bir rezervasyonu nasıl iptal ederim?' : isRo ? 'Cum anulez o rezervare?' : faq.q) :
                        faq.q === 'How long does a refund take?' ? (isEl ? 'Πόσος χρόνος χρειάζεται για επιστροφή χρημάτων;' : isBg ? 'Колко време отнема възстановяването на средства?' : isSr ? 'Колико дуго траје повраћај новца?' : isTr ? 'İade ne kadar sürer?' : isRo ? 'Cât durează o rambursare?' : faq.q) :
                        faq.q === 'What happens if the host cancels my booking?' ? (isEl ? 'Τι γίνεται αν ο ιδιοκτήτης ακυρώσει την κράτησή μου;' : isBg ? 'Какво се случва, ако домакинът анулира резервацията ми?' : isSr ? 'Шта се дешава ако домаћин откаже моју резервацију?' : isTr ? 'Ev sahibi rezervasyonumu iptal ederse ne olur?' : isRo ? 'Ce se întâmplă dacă proprietarul îmi anulează rezervarea?' : faq.q) :
                        faq.q === 'How do I list my property?' ? (isEl ? 'Πώς καταχωρίζω το ακίνητό μου;' : isBg ? 'Как да публикувам имота си?' : isSr ? 'Како да огласим своју некретнину?' : isTr ? 'Mülkümü nasıl listelerim?' : isRo ? 'Cum îmi listez proprietatea?' : faq.q) :
                        faq.q === 'How and when do I get paid?' ? (isEl ? 'Πώς και πότε πληρώνομαι;' : isBg ? 'Как и кога получавам плащане?' : isSr ? 'Како и када добијам исплату?' : isTr ? 'Nasıl ve ne zaman ödeme alırım?' : isRo ? 'Cum și când primesc plata?' : faq.q) :
                        faq.q === 'Can I set my own prices and availability?' ? (isEl ? 'Μπορώ να ορίσω τις δικές μου τιμές και διαθεσιμότητα;' : isBg ? 'Мога ли да задам собствени цени и наличност?' : isSr ? 'Могу ли да одредим сопствене цене и доступност?' : isTr ? 'Kendi fiyatlarımı ve müsaitlik durumumu belirleyebilir miyim?' : isRo ? 'Pot stabili propriile prețuri și disponibilitate?' : faq.q) :
                        faq.q === 'What fees does the platform charge hosts?' ? (isEl ? 'Τι τέλη χρεώνει η πλατφόρμα στους ιδιοκτήτες;' : isBg ? 'Какви такси начислява платформата на домакините?' : isSr ? 'Које накнаде платформа наплаћује домаћинима?' : isTr ? 'Platform ev sahiplerinden ne kadar ücret alır?' : isRo ? 'Ce comisioane percepe platforma proprietarilor?' : faq.q) :
                        faq.q
                      }
