---
import '../../styles/global.css';
// This page is excluded from the cleaner middleware guard (no session check needed — token is in URL hash)

const lang = (Astro.locals.lang ?? 'en') as string;
const isBg = lang === 'bg';
const isEl = lang === 'el';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';

const tTitle = isEl ? 'Ορισμός Κωδικού' : isBg ? 'Задаване на парола' : isSr ? 'Postavljanje lozinke' : isTr ? 'Şifre Belirleme' : isRo ? 'Setare Parolă' : 'Set Your Password';
const tSubtitle = isEl ? 'Δημιουργήστε κωδικό για τον λογαριασμό καθαριστή σας στο KefaloniaBNB.' : isBg ? 'Създайте парола за вашия акаунт на чистач в KefaloniaBNB.' : isSr ? 'Kreirajte lozinku za vaš nalog čistača na KefaloniaBNB.' : isTr ? 'KefaloniaBNB temizlikçi hesabınız için bir şifre oluşturun.' : isRo ? 'Creați o parolă pentru contul dvs. de curățenie KefaloniaBNB.' : 'Create a password for your KefaloniaBNB cleaner account.';
const tNewPassword = isEl ? 'Νέος κωδικός' : isBg ? 'Нова парола' : isSr ? 'Nova lozinka' : isTr ? 'Yeni şifre' : isRo ? 'Parolă nouă' : 'New password';
const tConfirmPassword = isEl ? 'Επιβεβαίωση κωδικού' : isBg ? 'Потвърдете паролата' : isSr ? 'Potvrdite lozinku' : isTr ? 'Şifreyi onaylayın' : isRo ? 'Confirmare parolă' : 'Confirm password';
const tPlaceholderMin = isEl ? 'Τουλάχιστον 8 χαρακτήρες' : isBg ? 'Поне 8 символа' : isSr ? 'Najmanje 8 karaktera' : isTr ? 'En az 8 karakter' : isRo ? 'Minimum 8 caractere' : 'Minimum 8 characters';
const tPlaceholderRepeat = isEl ? 'Επαναλάβετε τον κωδικό' : isBg ? 'Повторете паролата' : isSr ? 'Ponovite lozinku' : isTr ? 'Şifreyi tekrarlayın' : isRo ? 'Repetați parola' : 'Repeat your password';
const tSetPwBtn = isEl ? 'Ορισμός κωδικού & σύνδεση' : isBg ? 'Задаване на парола и вход' : isSr ? 'Postavi lozinku i prijavi se' : isTr ? 'Şifreyi belirle ve giriş yap' : isRo ? 'Setare parolă & autentificare' : 'Set password & sign in';
const tBackToSignIn = isEl ? '← Πίσω στη σύνδεση' : isBg ? '← Обратно към вход' : isSr ? '← Nazad na prijavu' : isTr ? '← Girişe geri dön' : isRo ? '← Înapoi la autentificare' : '← Back to sign in';
const tInvalidLink = isEl ? 'Αυτός ο σύνδεσμος πρόσκλησης δεν είναι έγκυρος ή έχει λήξει. Ζητήστε από τον διαχειριστή να στείλει νέα πρόσκληση.' : isBg ? 'Тази покана е невалидна или е изтекла. Помолете администратора да изпрати нова покана.' : isSr ? 'Ovaj pozivni link je nevažeći ili je istekao. Zamolite admina da ponovo pošalje poziv.' : isTr ? 'Bu davet bağlantısı geçersiz veya süresi dolmuş. Yöneticiden daveti tekrar göndermesini isteyin.' : isRo ? 'Link invitație invalid sau expirat. Rugați administratorul să retrimită invitația.' : 'This invite link is invalid or has expired. Ask the admin to resend the invite.';
const tInvalidLinkShort = isEl ? 'Μη έγκυρος σύνδεσμος πρόσκλησης. Ζητήστε από τον διαχειριστή να στείλει νέα πρόσκληση.' : isBg ? 'Невалиден линк за покана. Помолете администратора да изпрати нова покана.' : isSr ? 'Nevažeći pozivni link. Zamolite admina da ponovo pošalje poziv.' : isTr ? 'Geçersiz davet bağlantısı. Yöneticiden daveti tekrar göndermesini isteyin.' : isRo ? 'Link invitație invalid. Rugați administratorul să retrimită invitația.' : 'Invalid invite link. Ask the admin to resend the invite.';
const tExpiredLink = isEl ? 'Αυτός ο σύνδεσμος πρόσκλησης έχει λήξει. Ζητήστε από τον διαχειριστή να στείλει νέα πρόσκληση.' : isBg ? 'Тази покана е изтекла. Помолете администратора да изпрати нова покана.' : isSr ? 'Ovaj pozivni link je istekao. Zamolite admina da ponovo pošalje poziv.' : isTr ? 'Bu davet bağlantısının süresi dolmuş. Yöneticiden daveti tekrar göndermesini isteyin.' : isRo ? 'Link invitație expirat. Rugați administratorul să retrimită invitația.' : 'This invite link has expired. Ask the admin to resend the invite.';
const tPasswordsNoMatch = isEl ? 'Οι κωδικοί δεν ταιριάζουν.' : isBg ? 'Паролите не съвпадат.' : isSr ? 'Lozinke se ne poklapaju.' : isTr ? 'Şifreler eşleşmiyor.' : isRo ? 'Parolele nu se potrivesc.' : 'Passwords do not match.';
const tPasswordMin8 = isEl ? 'Ο κωδικός πρέπει να είναι τουλάχιστον 8 χαρακτήρες.' : isBg ? 'Паролата трябва да е поне 8 символа.' : isSr ? 'Lozinka mora imati najmanje 8 karaktera.' : isTr ? 'Şifre en az 8 karakter olmalıdır.' : isRo ? 'Parola trebuie să aibă minimum 8 caractere.' : 'Password must be at least 8 characters.';
const tSaving = isEl ? 'Αποθήκευση…' : isBg ? 'Запазване…' : isSr ? 'Čuvanje…' : isTr ? 'Kaydediliyor…' : isRo ? 'Se salvează…' : 'Saving…';
const tPasswordSet = isEl ? 'Ο κωδικός ορίστηκε! Μεταφερόσαστε στο ταμπλό…' : isBg ? 'Паролата е зададена! Пренасочване към таблото…' : isSr ? 'Lozinka postavljena! Preusmeravanje na tablu…' : isTr ? 'Şifre belirlendi! Panele yönlendiriliyorsunuz…' : isRo ? 'Parolă setată cu succes! Redirecționare către panou…' : 'Password set! Taking you to your dashboard…';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{tTitle} – KefaloniaBNB</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="min-h-screen bg-gray-50 flex items-center justify-center px-4">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <p class="text-4xl mb-3">🧹</p>
      <h1 class="text-2xl font-bold text-gray-900">{tTitle}</h1>
      <p class="text-gray-500 text-sm mt-1">{tSubtitle}</p>
    </div>

    <div id="error-banner" class="hidden bg-red-50 border border-red-200 text-red-700 text-sm p-3 rounded-xl mb-4"></div>
    <div id="success-banner" class="hidden bg-green-50 border border-green-200 text-green-700 text-sm p-3 rounded-xl mb-4"></div>

    <div id="form-card" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
      <form id="set-password-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">{tNewPassword}</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="8"
            autocomplete="new-password"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#c9a96e] focus:border-transparent outline-none"
            placeholder={tPlaceholderMin}
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">{tConfirmPassword}</label>
          <input
            type="password"
            id="confirm-password"
            name="confirm_password"
            required
            minlength="8"
            autocomplete="new-password"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#c9a96e] focus:border-transparent outline-none"
            placeholder={tPlaceholderRepeat}
          />
        </div>
        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-[#c9a96e] text-white font-semibold py-3 rounded-xl text-sm hover:opacity-90 transition-opacity disabled:opacity-50 disabled:cursor-not-allowed"
        >
          {tSetPwBtn}
        </button>
      </form>
    </div>

    <p class="text-center mt-4">
      <a href="/cleaner/login" class="text-gray-400 text-xs hover:text-gray-600">{tBackToSignIn}</a>
    </p>
  </div>

  <div id="i18n-data" class="hidden"
    data-t-invalid-link={tInvalidLink}
    data-t-invalid-link-short={tInvalidLinkShort}
    data-t-expired-link={tExpiredLink}
    data-t-passwords-no-match={tPasswordsNoMatch}
    data-t-password-min8={tPasswordMin8}
    data-t-saving={tSaving}
    data-t-set-pw-btn={tSetPwBtn}
    data-t-password-set={tPasswordSet}
    aria-hidden="true"
  ></div>
  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    );

    const i18n = document.getElementById('i18n-data')!.dataset;
    const errorBanner   = document.getElementById('error-banner')!;
    const successBanner = document.getElementById('success-banner')!;
    const formCard      = document.getElementById('form-card')!;
    const form          = document.getElementById('set-password-form') as HTMLFormElement;
    const submitBtn     = document.getElementById('submit-btn') as HTMLButtonElement;

    const tInvalidLink = i18n.tInvalidLink!;
    const tInvalidLinkShort = i18n.tInvalidLinkShort!;
    const tExpiredLink = i18n.tExpiredLink!;
    const tPasswordsNoMatch = i18n.tPasswordsNoMatch!;
    const tPasswordMin8 = i18n.tPasswordMin8!;
    const tSaving = i18n.tSaving!;
    const tSetPwBtn = i18n.tSetPwBtn!;
    const tPasswordSet = i18n.tPasswordSet!;

    function showError(msg: string) {
      errorBanner.textContent = msg;
      errorBanner.classList.remove('hidden');
      successBanner.classList.add('hidden');
    }

    async function init() {
      const hash = window.location.hash.slice(1);
      const params = new URLSearchParams(hash);
      const type = params.get('type');
      const accessToken = params.get('access_token');
      const refreshToken = params.get('refresh_token');
      const errorCode = params.get('error_code');
      const errorDesc = params.get('error_description');

      if (errorCode) {
        formCard.classList.add('hidden');
        showError(
          errorDesc
            ? decodeURIComponent(errorDesc.replace(/\+/g, ' '))
            : tInvalidLink,
        );
        return;
      }

      if (type !== 'recovery' || !accessToken || !refreshToken) {
        formCard.classList.add('hidden');
        showError(tInvalidLinkShort);
        return;
      }

      const { error: sessionError } = await supabase.auth.setSession({
        access_token: accessToken,
        refresh_token: refreshToken,
      });

      if (sessionError) {
        formCard.classList.add('hidden');
        showError(tExpiredLink);
        return;
      }

      history.replaceState(null, '', window.location.pathname);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBanner.classList.add('hidden');

      const password        = (document.getElementById('password') as HTMLInputElement).value;
      const confirmPassword = (document.getElementById('confirm-password') as HTMLInputElement).value;

      if (password !== confirmPassword) { showError(tPasswordsNoMatch); return; }
      if (password.length < 8) { showError(tPasswordMin8); return; }

      submitBtn.disabled = true;
      submitBtn.textContent = tSaving;

      const { error } = await supabase.auth.updateUser({ password });

      if (error) {
        showError(error.message);
        submitBtn.disabled = false;
        submitBtn.textContent = tSetPwBtn;
        return;
      }

      formCard.classList.add('hidden');
      successBanner.textContent = tPasswordSet;
      successBanner.classList.remove('hidden');

      setTimeout(() => { window.location.href = '/cleaner/dashboard'; }, 1500);
    });

    init();
  </script>
</body>
</html>
