---
import CleanerLayout from '../../../layouts/CleanerLayout.astro';
import { getServiceClient } from '../../../lib/supabase.ts';


const userId = Astro.locals.session.user.id;
const service = getServiceClient();

const { data: profile } = await service
  .from('cleaner_profiles')
  .select('id, cleaner_service_areas(*)')
  .eq('user_id', userId)
  .single();

if (!profile) return Astro.redirect('/cleaner/dashboard');

const { data: requests } = await service
  .from('cleaning_requests')
  .select('*, listings(title,city,region,bedrooms,property_type), cleaning_matches(id)')
  .eq('status', 'open')
  .order('requested_date');

const lang = (Astro.locals.lang ?? 'en') as string;
const isBg = lang === 'bg';
const isEl = lang === 'el';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';

const tTitle = isEl ? 'Ανοιχτά Αιτήματα Καθαρισμού' : isBg ? 'Отворени заявки за почистване' : isSr ? 'Otvoreni zahtevi za čišćenje' : isTr ? 'Açık Temizlik Talepleri' : isRo ? 'Cereri de Curățenie Deschise' : 'Open Cleaning Requests';
const tOpenRequest = isEl ? 'ανοιχτό αίτημα' : isBg ? 'отворена заявка' : isSr ? 'otvoren zahtev' : isTr ? 'açık talep' : isRo ? 'cerere deschisă' : 'open request';
const tOpenRequests = isEl ? 'ανοιχτά αιτήματα' : isBg ? 'отворени заявки' : isSr ? 'otvorenih zahteva' : isTr ? 'açık talep' : isRo ? 'cereri deschise' : 'open requests';
const tNoOpenRequests = isEl ? 'Δεν υπάρχουν ανοιχτά αιτήματα αυτή τη στιγμή.' : isBg ? 'Няма отворени заявки в момента.' : isSr ? 'Trenutno nema otvorenih zahteva.' : isTr ? 'Şu anda açık talep yok.' : isRo ? 'Nicio cerere deschisă momentan.' : 'No open requests at the moment.';
const tCheckBack = isEl ? 'Ελέγξτε ξανά σύντομα!' : isBg ? 'Проверете отново скоро!' : isSr ? 'Proverite ponovo uskoro!' : isTr ? 'Yakında tekrar kontrol edin!' : isRo ? 'Reveniți în curând!' : 'Check back soon!';
const tBid = isEl ? 'προσφορά' : isBg ? 'оферта' : isSr ? 'ponuda' : isTr ? 'teklif' : isRo ? 'ofertă' : 'bid';
const tBids = isEl ? 'προσφορές' : isBg ? 'оферти' : isSr ? 'ponuda' : isTr ? 'teklif' : isRo ? 'oferte' : 'bids';
const tPlaceBid = isEl ? 'Υποβολή Προσφοράς →' : isBg ? 'Подайте оферта →' : isSr ? 'Pošalji ponudu →' : isTr ? 'Teklif Ver →' : isRo ? 'Plasează Ofertă →' : 'Place Bid →';

const reqCount = (requests ?? []).length;
---

<CleanerLayout title={tTitle}>
  <div class="space-y-4">
    <div class="flex justify-between items-center">
      <p class="text-sm text-gray-500">{reqCount} {reqCount !== 1 ? tOpenRequests : tOpenRequest}</p>
    </div>

    {reqCount === 0 && (
      <div class="text-center py-20 text-gray-400">
        <p class="text-4xl mb-3">🧹</p>
        <p>{tNoOpenRequests}</p>
        <p class="text-xs mt-2">{tCheckBack}</p>
      </div>
    )}

    {(requests ?? []).map((r: any) => {
      const bidsCount = (r.cleaning_matches ?? []).length;
      return (
        <div class="bg-white border border-gray-100 rounded-2xl p-5 hover:border-[#c9a96e] transition-all relative cursor-pointer">
          <a href={`/cleaner/requests/${r.id}`} class="absolute inset-0 rounded-2xl z-0"></a>
          <div class="flex justify-between items-start relative z-10">
            <div>
              <p class="font-semibold text-gray-900">{r.listings?.title}</p>
              <p class="text-xs text-gray-500 mt-0.5">{r.listings?.city} · {r.listings?.bedrooms} BR · {r.listings?.property_type}</p>
              <p class="text-xs text-gray-400 mt-0.5">{r.requested_date} · {r.earliest_time} – {r.latest_time}</p>
              {r.notes && <p class="text-xs text-gray-500 mt-1 italic">{r.notes}</p>}
            </div>
            <div class="text-right ml-4">
              <p class="text-xs text-gray-400">{bidsCount} {bidsCount !== 1 ? tBids : tBid}</p>
              <span class="text-xs text-[#c9a96e] font-medium mt-1 block">{tPlaceBid}</span>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</CleanerLayout>
