---
import '../../styles/global.css';

// Already logged in as cleaner → go to dashboard
if (Astro.locals.session && Astro.locals.profile?.role === 'cleaner') {
  return Astro.redirect('/cleaner/dashboard');
}

const error = Astro.url.searchParams.get('error');
const success = Astro.url.searchParams.get('success') === '1';

const lang = (Astro.locals.lang ?? 'en') as string;
const isBg = lang === 'bg';
const isEl = lang === 'el';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';

const tTitle = isEl ? 'Εγγραφή ως Καθαριστής' : isBg ? 'Регистрация като чистач' : isSr ? 'Registracija kao čistač' : isTr ? 'Temizlikçi Olarak Katılın' : isRo ? 'Înregistrare ca Persoană Curățenie' : 'Join as a Cleaner';
const tSubtitle = isEl ? 'Κερδίστε χρήματα καθαρίζοντας ακίνητα στην Καβάλα' : isBg ? 'Печелете, като почиствате имоти в Кавала' : isSr ? 'Zaradite čišćenjem nekretnina u Kavali' : isTr ? 'Kefalonia\'da mülk temizleyerek para kazanın' : isRo ? 'Câștigați bani curățând proprietăți în Kefalonia' : 'Get paid to clean properties in Kefalonia';
const tCheckEmail = isEl ? 'Ελέγξτε το email σας' : isBg ? 'Проверете имейла си' : isSr ? 'Proverite email' : isTr ? 'E-postanızı kontrol edin' : isRo ? 'Verificați email-ul' : 'Check your email';
const tConfirmLink = isEl ? 'Σας στείλαμε σύνδεσμο επιβεβαίωσης. Κάντε κλικ για να ενεργοποιήσετε τον λογαριασμό σας.' : isBg ? 'Изпратихме ви линк за потвърждение. Кликнете го, за да активирате акаунта си, след което влезте.' : isSr ? 'Poslali smo vam link za potvrdu. Kliknite na njega da aktivirate nalog, zatim se prijavite.' : isTr ? 'Size bir onay bağlantısı gönderdik. Hesabınızı etkinleştirmek için tıklayın, ardından giriş yapın.' : isRo ? 'V-am trimis un link de confirmare. Faceți clic pentru a activa contul, apoi autentificați-vă.' : 'We sent a confirmation link to your email. Click it to activate your account, then sign in.';
const tGoToSignIn = isEl ? 'Μετάβαση στη Σύνδεση' : isBg ? 'Към Вход' : isSr ? 'Idi na Prijavu' : isTr ? 'Girişe Git' : isRo ? 'Mergi la Autentificare' : 'Go to Sign In';
const tFullName = isEl ? 'Ονοματεπώνυμο' : isBg ? 'Пълно име' : isSr ? 'Puno ime' : isTr ? 'Ad Soyad' : isRo ? 'Nume complet' : 'Full Name';
const tEmail = isEl ? 'Ηλ. ταχυδρομείο' : isBg ? 'Имейл' : isSr ? 'Email' : isTr ? 'E-posta' : isRo ? 'Email' : 'Email';
const tPhone = isEl ? 'Τηλέφωνο (προαιρετικό)' : isBg ? 'Телефон (незадължително)' : isSr ? 'Telefon (opciono)' : isTr ? 'Telefon (isteğe bağlı)' : isRo ? 'Telefon (opțional)' : 'Phone (optional)';
const tPassword = isEl ? 'Κωδικός' : isBg ? 'Парола' : isSr ? 'Lozinka' : isTr ? 'Şifre' : isRo ? 'Parolă' : 'Password';
const tConfirmPassword = isEl ? 'Επιβεβαίωση Κωδικού' : isBg ? 'Потвърдете паролата' : isSr ? 'Potvrdite lozinku' : isTr ? 'Şifreyi Onaylayın' : isRo ? 'Confirmare parolă' : 'Confirm Password';
const tPlaceholderName = isEl ? 'Το πλήρες όνομά σας' : isBg ? 'Вашето пълно име' : isSr ? 'Vaše puno ime' : isTr ? 'Tam adınız' : isRo ? 'Numele dvs. complet' : 'Your full name';
const tPlaceholderPwMin = isEl ? 'Τουλάχιστον 8 χαρακτήρες' : isBg ? 'Поне 8 символа' : isSr ? 'Najmanje 8 karaktera' : isTr ? 'En az 8 karakter' : isRo ? 'Minimum 8 caractere' : 'At least 8 characters';
const tPlaceholderRepeat = isEl ? 'Επαναλάβετε τον κωδικό' : isBg ? 'Повторете паролата' : isSr ? 'Ponovite lozinku' : isTr ? 'Şifreyi tekrarlayın' : isRo ? 'Repetați parola' : 'Repeat password';
const tAgreeText = isEl ? 'Εγγραφόμενοι συμφωνείτε να παρέχετε υπηρεσίες καθαρισμού μέσω της πλατφόρμας KefaloniaBNB.' : isBg ? 'С регистрацията си се съгласявате да предоставяте услуги по почистване чрез платформата KefaloniaBNB.' : isSr ? 'Registracijom pristajete da pružate usluge čišćenja putem platforme KefaloniaBNB.' : isTr ? 'Kaydolarak KefaloniaBNB platformu üzerinden temizlik hizmetleri sunmayı kabul ediyorsunuz.' : isRo ? 'Prin înregistrare sunteți de acord să furnizați servicii de curățenie prin platforma KefaloniaBNB.' : 'By signing up you agree to provide cleaning services through the KefaloniaBNB platform.';
const tCreateAccount = isEl ? 'Δημιουργία Λογαριασμού' : isBg ? 'Създаване на акаунт' : isSr ? 'Kreiranje naloga' : isTr ? 'Hesap Oluştur' : isRo ? 'Creare Cont' : 'Create Account';
const tAlreadyHave = isEl ? 'Έχετε ήδη λογαριασμό;' : isBg ? 'Вече имате акаунт?' : isSr ? 'Već imate nalog?' : isTr ? 'Zaten hesabınız var mı?' : isRo ? 'Aveți deja un cont?' : 'Already have an account?';
const tSignInLink = isEl ? 'Σύνδεση →' : isBg ? 'Вход →' : isSr ? 'Prijava →' : isTr ? 'Giriş →' : isRo ? 'Autentificare →' : 'Sign in →';
const tSomethingWrong = isEl ? 'Κάτι πήγε στραβά. Παρακαλώ δοκιμάστε ξανά.' : isBg ? 'Нещо се обърка. Моля, опитайте отново.' : isSr ? 'Nešto je pošlo naopako. Pokušajte ponovo.' : isTr ? 'Bir şeyler ters gitti. Lütfen tekrar deneyin.' : isRo ? 'Ceva a mers greșit. Vă rugăm încercați din nou.' : 'Something went wrong. Please try again.';

const errorMessages: Record<string, string> = {
  exists:   isEl ? 'Υπάρχει ήδη λογαριασμός με αυτό το email. Δοκιμάστε σύνδεση.' : isBg ? 'Акаунт с този имейл вече съществува. Опитайте да влезете.' : isSr ? 'Nalog sa ovim emailom već postoji. Pokušajte da se prijavite.' : isTr ? 'Bu e-posta ile bir hesap zaten var. Giriş yapmayı deneyin.' : isRo ? 'Un cont cu acest email există deja. Încercați autentificarea.' : 'An account with this email already exists. Try signing in.',
  mismatch: isEl ? 'Οι κωδικοί δεν ταιριάζουν.' : isBg ? 'Паролите не съвпадат.' : isSr ? 'Lozinke se ne poklapaju.' : isTr ? 'Şifreler eşleşmiyor.' : isRo ? 'Parolele nu se potrivesc.' : 'Passwords do not match.',
  weak:     isEl ? 'Ο κωδικός πρέπει να είναι τουλάχιστον 8 χαρακτήρες.' : isBg ? 'Паролата трябва да е поне 8 символа.' : isSr ? 'Lozinka mora imati najmanje 8 karaktera.' : isTr ? 'Şifre en az 8 karakter olmalıdır.' : isRo ? 'Parola trebuie să aibă minimum 8 caractere.' : 'Password must be at least 8 characters.',
  missing:  isEl ? 'Συμπληρώστε όλα τα υποχρεωτικά πεδία.' : isBg ? 'Моля, попълнете всички задължителни полета.' : isSr ? 'Popunite sva obavezna polja.' : isTr ? 'Lütfen tüm gerekli alanları doldurun.' : isRo ? 'Vă rugăm completați toate câmpurile obligatorii.' : 'Please fill in all required fields.',
  failed:   isEl ? 'Η εγγραφή απέτυχε. Δοκιμάστε ξανά.' : isBg ? 'Регистрацията не успя. Моля, опитайте отново.' : isSr ? 'Registracija neuspešna. Pokušajte ponovo.' : isTr ? 'Kayıt başarısız. Lütfen tekrar deneyin.' : isRo ? 'Înregistrare eșuată. Vă rugăm încercați din nou.' : 'Registration failed. Please try again.',
};
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{tTitle} — KefaloniaBNB</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="min-h-screen bg-gray-50 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <p class="text-3xl mb-3">🧹</p>
      <h1 class="text-2xl font-bold text-gray-900">{tTitle}</h1>
      <p class="text-sm text-gray-500 mt-1">{tSubtitle}</p>
    </div>

    {success ? (
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 text-center">
        <p class="text-4xl mb-4">✉️</p>
        <h2 class="font-bold text-gray-900 mb-2">{tCheckEmail}</h2>
        <p class="text-sm text-gray-500 mb-4">
          {tConfirmLink}
        </p>
        <a href="/cleaner/login" class="inline-block bg-[#1a1a2e] text-white font-semibold px-6 py-3 rounded-xl hover:bg-[#2d2d4e] transition-colors text-sm">
          {tGoToSignIn}
        </a>
      </div>
    ) : (
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
        {error && (
          <div class="mb-5 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl px-4 py-3">
            {errorMessages[error] ?? tSomethingWrong}
          </div>
        )}

        <form method="POST" action="/api/auth/cleaner-signup" class="space-y-4">
          <div>
            <label for="full_name" class="block text-sm font-medium text-gray-700 mb-1">{tFullName}</label>
            <input
              type="text" id="full_name" name="full_name" required autocomplete="name"
              class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#c9a96e] focus:border-transparent outline-none"
              placeholder={tPlaceholderName}
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">{tEmail}</label>
            <input
              type="email" id="email" name="email" required autocomplete="email"
              class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#c9a96e] focus:border-transparent outline-none"
              placeholder="you@example.com"
            />
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">{tPhone}</label>
            <input
              type="tel" id="phone" name="phone" autocomplete="tel"
              class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#c9a96e] focus:border-transparent outline-none"
              placeholder="+30 6xx xxx xxxx"
            />
          </div>

          <div>
            <label for="password" class="block text-sm font-medium text-gray-700 mb-1">{tPassword}</label>
            <input
              type="password" id="password" name="password" required autocomplete="new-password"
              minlength="8"
              class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#c9a96e] focus:border-transparent outline-none"
              placeholder={tPlaceholderPwMin}
            />
          </div>

          <div>
            <label for="confirm_password" class="block text-sm font-medium text-gray-700 mb-1">{tConfirmPassword}</label>
            <input
              type="password" id="confirm_password" name="confirm_password" required autocomplete="new-password"
              class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#c9a96e] focus:border-transparent outline-none"
              placeholder={tPlaceholderRepeat}
            />
          </div>

          <p class="text-xs text-gray-400 pt-1">
            {tAgreeText}
          </p>

          <button
            type="submit"
            class="w-full bg-[#c9a96e] text-white font-semibold py-3 rounded-xl hover:opacity-90 transition-opacity mt-2"
          >
            {tCreateAccount}
          </button>
        </form>

        <p class="text-center text-sm text-gray-500 mt-6">
          {tAlreadyHave}
          <a href="/cleaner/login" class="text-[#c9a96e] font-medium hover:opacity-80">{tSignInLink}</a>
        </p>
      </div>
    )}
  </div>
</body>
</html>
