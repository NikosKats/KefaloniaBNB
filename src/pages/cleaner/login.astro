---
import '../../styles/global.css';

// Already logged in as cleaner → go to dashboard
if (Astro.locals.session && Astro.locals.profile?.role === 'cleaner') {
  return Astro.redirect('/cleaner/dashboard');
}

const next = Astro.url.searchParams.get('next') ?? '/cleaner/dashboard';
const error = Astro.url.searchParams.get('error');

const lang = (Astro.locals.lang ?? 'en') as string;
const isBg = lang === 'bg';
const isEl = lang === 'el';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';

const tTitle = isEl ? 'Πύλη Καθαριστή' : isBg ? 'Портал за чистачи' : isSr ? 'Portal za čistače' : isTr ? 'Temizlikçi Portalı' : isRo ? 'Portal Curățenie' : 'Cleaner Portal';
const tSubtitle = isEl ? 'Συνδεθείτε για να διαχειριστείτε τις εργασίες καθαρισμού' : isBg ? 'Влезте, за да управлявате вашите работи по почистване' : isSr ? 'Prijavite se za upravljanje poslovima čišćenja' : isTr ? 'Temizlik işlerinizi yönetmek için giriş yapın' : isRo ? 'Autentificați-vă pentru a gestiona lucrările de curățenie' : 'Sign in to manage your cleaning jobs';
const tEmail = isEl ? 'Ηλ. ταχυδρομείο' : isBg ? 'Имейл' : isSr ? 'Email' : isTr ? 'E-posta' : isRo ? 'Email' : 'Email';
const tPassword = isEl ? 'Κωδικός' : isBg ? 'Парола' : isSr ? 'Lozinka' : isTr ? 'Şifre' : isRo ? 'Parolă' : 'Password';
const tSignIn = isEl ? 'Σύνδεση' : isBg ? 'Вход' : isSr ? 'Prijava' : isTr ? 'Giriş Yap' : isRo ? 'Autentificare' : 'Sign In';
const tNewCleaner = isEl ? 'Νέος καθαριστής;' : isBg ? 'Нов чистач?' : isSr ? 'Novi čistač?' : isTr ? 'Yeni temizlikçi?' : isRo ? 'Persoană curățenie nouă?' : 'New cleaner?';
const tApplyToJoin = isEl ? 'Κάντε αίτηση →' : isBg ? 'Кандидатствайте →' : isSr ? 'Prijavite se →' : isTr ? 'Başvurun →' : isRo ? 'Aplicați →' : 'Apply to join →';
const tSomethingWrong = isEl ? 'Κάτι πήγε στραβά. Παρακαλώ δοκιμάστε ξανά.' : isBg ? 'Нещо се обърка. Моля, опитайте отново.' : isSr ? 'Nešto je pošlo naopako. Pokušajte ponovo.' : isTr ? 'Bir şeyler ters gitti. Lütfen tekrar deneyin.' : isRo ? 'Ceva a mers greșit. Vă rugăm încercați din nou.' : 'Something went wrong. Please try again.';

const errorMessages: Record<string, string> = {
  invalid:      isEl ? 'Λάθος email ή κωδικός.' : isBg ? 'Невалиден имейл или парола.' : isSr ? 'Pogrešan email ili lozinka.' : isTr ? 'Geçersiz e-posta veya şifre.' : isRo ? 'Email sau parolă invalidă.' : 'Invalid email or password.',
  missing:      isEl ? 'Εισάγετε email και κωδικό.' : isBg ? 'Моля, въведете имейл и парола.' : isSr ? 'Unesite email i lozinku.' : isTr ? 'Lütfen e-posta ve şifrenizi girin.' : isRo ? 'Vă rugăm introduceți email-ul și parola.' : 'Please enter your email and password.',
  unauthorized: isEl ? 'Ο λογαριασμός σας δεν έχει πρόσβαση καθαριστή.' : isBg ? 'Вашият акаунт няма достъп като чистач.' : isSr ? 'Vaš nalog nema pristup za čistače.' : isTr ? 'Hesabınızın temizlikçi erişimi yok.' : isRo ? 'Contul dvs. nu are acces de curățenie.' : 'Your account does not have cleaner access.',
  unconfirmed:  isEl ? 'Επιβεβαιώστε το email σας πριν συνδεθείτε.' : isBg ? 'Моля, потвърдете имейла си преди да влезете.' : isSr ? 'Potvrdite email pre prijavljivanja.' : isTr ? 'Giriş yapmadan önce e-postanızı onaylayın.' : isRo ? 'Vă rugăm confirmați email-ul înainte de autentificare.' : 'Please confirm your email before signing in.',
};
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{tTitle} — KefaloniaBNB</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="min-h-screen bg-gray-50 flex items-center justify-center px-4">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <p class="text-3xl mb-3">🧹</p>
      <h1 class="text-2xl font-bold text-gray-900">{tTitle}</h1>
      <p class="text-sm text-gray-500 mt-1">{tSubtitle}</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
      {error && (
        <div class="mb-5 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl px-4 py-3">
          {errorMessages[error] ?? tSomethingWrong}
        </div>
      )}

      <form method="POST" action={`/api/auth/cleaner-login?next=${encodeURIComponent(next)}`} class="space-y-4">
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-1">{tEmail}</label>
          <input
            type="email" id="email" name="email" required autocomplete="email"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#c9a96e] focus:border-transparent outline-none"
            placeholder="you@example.com"
          />
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-gray-700 mb-1">{tPassword}</label>
          <input
            type="password" id="password" name="password" required autocomplete="current-password"
            class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#c9a96e] focus:border-transparent outline-none"
            placeholder="••••••••"
          />
        </div>

        <button
          type="submit"
          class="w-full bg-[#1a1a2e] text-white font-semibold py-3 rounded-xl hover:bg-[#2d2d4e] transition-colors mt-2"
        >
          {tSignIn}
        </button>
      </form>

      <p class="text-center text-sm text-gray-500 mt-6">
        {tNewCleaner}
        <a href="/cleaner/signup" class="text-[#c9a96e] font-medium hover:opacity-80">{tApplyToJoin}</a>
      </p>
    </div>
  </div>
</body>
</html>
