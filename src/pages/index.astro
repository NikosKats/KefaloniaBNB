---
import BaseLayout from '../layouts/BaseLayout.astro';
import ListingCard from '../components/listing/ListingCard.astro';
import type { ListingWithDetails, Review } from '../types/index.ts';
import { t, type Lang } from '../i18n/translations.ts';
import { getActiveFeaturedListingIds } from '../lib/featured.ts';

const lang = (Astro.locals.lang ?? 'en') as Lang;
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';
const supabase = Astro.locals.supabase;
const siteUrl  = import.meta.env.PUBLIC_SITE_URL ?? 'https://kefaloniabnb.com';

const [listingsRes, reviewsRes, statsRes, featuredIds] = await Promise.all([
  supabase
    .from('listings')
    .select('*, listing_images(*), listing_amenities(amenities(*))')
    .eq('is_active', true)
    .order('avg_rating', { ascending: false }),
  supabase
    .from('reviews')
    .select('*')
    .eq('is_published', true)
    .order('created_at', { ascending: false })
    .limit(3),
  supabase
    .from('bookings')
    .select('id', { count: 'exact', head: true })
    .in('status', ['confirmed', 'completed']),
  getActiveFeaturedListingIds(),
]);

const featuredSet = new Set(featuredIds);

const allListings: ListingWithDetails[] = (listingsRes.data ?? []).map((l: any) => ({
  ...l,
  listing_images: l.listing_images ?? [],
  amenities: (l.listing_amenities ?? []).map((la: any) => la.amenities).filter(Boolean),
}));

const listings: ListingWithDetails[] = [
  ...allListings.filter((l) => featuredSet.has(l.id)),
  ...allListings.filter((l) => !featuredSet.has(l.id)),
];

const reviews: Review[] = reviewsRes.data ?? [];
const totalBookings = statsRes.count ?? 0;

const activePropCount  = listings.length;
const uniqueCities     = [...new Set(listings.map((l) => l.city).filter(Boolean))].length;
const avgRatingAll     = listings.filter((l) => l.review_count > 0).length > 0
  ? (listings.reduce((s, l) => s + Number(l.avg_rating ?? 0), 0) / listings.filter(l => l.review_count > 0).length)
  : 4.9;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'RealEstateAgent',
    '@id': `${siteUrl}/#site`,
    name: 'KefaloniaBNB',
    description: 'Vacation rental marketplace for Greece. Book villas, apartments and holiday homes direct — no platform fees, best rates guaranteed.',
    url: siteUrl,
    logo: `${siteUrl}/favicon.svg`,
    image: `${siteUrl}/og-default.jpg`,
    paymentAccepted: 'Credit Card, Bank Transfer',
    currenciesAccepted: 'EUR',
    priceRange: '€€',
    areaServed: { '@type': 'Country', name: 'Greece' },
    sameAs: [],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    name: 'KefaloniaBNB',
    url: siteUrl,
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${siteUrl}/rentals?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
];
---

<BaseLayout
  title="KefaloniaBNB – Book Direct. No Fees. Kefalonia & Keramoti Villas."
  description="Book villas in Kefalonia & Keramoti with zero booking fees. Direct contact with owners. Cheaper than OTA platforms, better than agencies."
  schema={schema}
>

  <!-- ── HERO ────────────────────────────────────────────────────────────── -->
  <section class="relative min-h-[92vh] flex items-center justify-center overflow-hidden bg-[#1a1a2e]">
    <div class="absolute inset-0 bg-gradient-to-br from-[#0f3460] via-[#16213e] to-[#1a1a2e]"></div>
    <div class="absolute inset-0 opacity-[0.03]"
      style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 40px 40px;">
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center text-white">
      <div class="inline-flex items-center gap-2 bg-[#c9a96e]/20 border border-[#c9a96e]/40 rounded-full px-4 py-1.5 text-sm text-[#c9a96e] font-medium mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-[#c9a96e] animate-pulse"></span>
        {lang === 'el' ? '#1 Πλατφόρμα Κρατήσεων για Καβάλα & Θάσο' : lang === 'bg' ? '#1 Платформа за резервации за Kefalonia & Thassos' : isSr ? '#1 Платформа за резервације за Kefalonia & Thassos' : isTr ? "Kefalonia & Thassos için #1 Rezervasyon Platformu" : isRo ? 'Platforma #1 de Rezervări pentru Kefalonia & Thassos' : '#1 Booking Platform for Kefalonia & Thassos'}
      </div>

      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight mb-6 leading-tight">
        {lang === 'el'
          ? 'Κλείστε απευθείας. Χωρίς προμήθειες.'
          : lang === 'bg'
          ? 'Резервирайте директно.\nБез такси.'
          : isSr
          ? 'Резервишите директно.\nБез накнада.'
          : isTr
          ? 'Doğrudan Rezerve Edin.\nÜcretsiz.'
          : isRo
          ? 'Rezervați Direct.\nFără Comisioane.'
          : 'Book Direct.\nNo Fees.'}
      </h1>
      <p class="text-lg sm:text-xl text-white/70 max-w-2xl mx-auto mb-5 leading-relaxed">
        {lang === 'el'
          ? 'Βίλες και καταλύματα σε όλο τον Νομό Καβάλας — απευθείας από τον ιδιοκτήτη. Φτηνότερα από άλλες πλατφόρμες. Χωρίς μεσάζοντες.'
          : lang === 'bg'
          ? 'Вили и апартаменти в района на Kefalonia — директно от собствениците. Гостите спестяват пари. Собствениците запазват 95%.'
          : isSr ? 'Виле и апартмани у региону Кавале — директно од власника. Гости штеде новац. Власници задржавају 95%.'
          : isTr ? 'Kefalonia bölgesinde villalar ve daireler — sahipleriyle doğrudan rezerve edilmiş. Misafirler tasarruf eder. Sahipler %95 kazanır.'
          : isRo ? 'Vile și apartamente în regiunea Kefalonia — rezervate direct cu proprietarii. Oaspeții economisesc. Proprietarii păstrează 95%.'
          : 'Villas and apartments across the Kefalonia region — booked directly with owners. Guests save money. Owners keep 95%.'}
      </p>
      <!-- Location strip — clickable -->
      <div class="flex flex-wrap justify-center gap-2 mb-10 text-xs">
        {([
          { label: 'Keramoti', slug: 'keramoti' },
          { label: 'Kefalonia', slug: 'kefalonia' },
          { label: 'Thassos', slug: 'thassos' },
          { label: 'Nea Peramos', slug: 'nea-peramos' },
          { label: 'Nea Iraklitsa', slug: 'nea-iraklitsa' },
          { label: 'Golden Beach', slug: 'golden-beach' },
          { label: 'Potos', slug: 'potos' },
        ] as { label: string; slug: string }[]).map(({ label, slug }) => (
          <a
            href={`/locations/${slug}`}
            class="bg-white/10 border border-white/10 hover:bg-white/20 hover:border-white/30 text-white/60 hover:text-white/90 rounded-full px-3 py-1 transition-colors"
          >
            {label}
          </a>
        ))}
        <a href="/locations" class="bg-white/10 border border-white/10 hover:bg-white/20 text-white/40 hover:text-white/70 rounded-full px-3 py-1 transition-colors">
          All destinations →
        </a>
      </div>

      <!-- Search box -->
      <div class="bg-white rounded-2xl p-4 max-w-3xl mx-auto shadow-2xl">
        <form action="/rentals" method="GET" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
          <div class="text-left">
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1 px-1">Destination</label>
            <select name="region" class="w-full px-3 py-2 text-sm text-gray-900 bg-gray-50 rounded-xl outline-none focus:ring-2 focus:ring-[#1a1a2e] cursor-pointer">
              <option value="">Anywhere</option>
              <option value="kefalonia">Kefalonia Region</option>
              <option value="thassos">Thassos Island</option>
            </select>
          </div>
          <div class="text-left">
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1 px-1">{t(lang, 'listing.check_in')}</label>
            <input type="date" name="check_in" class="w-full px-3 py-2 text-sm text-gray-900 bg-gray-50 rounded-xl outline-none focus:ring-2 focus:ring-[#1a1a2e]" />
          </div>
          <div class="text-left">
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1 px-1">{t(lang, 'listing.check_out')}</label>
            <input type="date" name="check_out" class="w-full px-3 py-2 text-sm text-gray-900 bg-gray-50 rounded-xl outline-none focus:ring-2 focus:ring-[#1a1a2e]" />
          </div>
          <button type="submit" class="bg-[#1a1a2e] text-white font-semibold rounded-xl py-2.5 px-6 hover:bg-[#2d2d4e] transition-colors text-sm mt-auto cursor-pointer flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            {t(lang, 'home.hero.cta')}
          </button>
        </form>
      </div>

      <!-- Stats -->
      <div class="flex flex-wrap justify-center gap-8 mt-10 text-white/60 text-sm">
        {activePropCount > 0 && (
          <div>
            <p class="text-white text-2xl font-bold">{activePropCount}+</p>
            <p>{lang === 'el' ? 'Καταλύματα' : lang === 'bg' ? 'Имоти' : isSr ? 'Некретнине' : isTr ? 'Mülkler' : isRo ? 'Proprietăți' : 'Properties'}</p>
          </div>
        )}
        {uniqueCities > 0 && (
          <div>
            <p class="text-white text-2xl font-bold">{uniqueCities}</p>
            <p>{lang === 'el' ? 'Τοποθεσίες' : lang === 'bg' ? 'Локации' : isSr ? 'Локације' : isTr ? 'Lokasyonlar' : isRo ? 'Locații' : 'Locations'}</p>
          </div>
        )}
        {totalBookings > 0 && (
          <div>
            <p class="text-white text-2xl font-bold">{totalBookings}+</p>
            <p>{lang === 'el' ? 'Κρατήσεις' : lang === 'bg' ? 'Резервации' : isSr ? 'Резервације' : isTr ? 'Rezervasyonlar' : isRo ? 'Rezervări' : 'Bookings'}</p>
          </div>
        )}
        <div>
          <p class="text-white text-2xl font-bold">{avgRatingAll.toFixed(1)}★</p>
          <p>{lang === 'el' ? 'Μ.Ο. Βαθμολογία' : lang === 'bg' ? 'Средна оценка' : isSr ? 'Просечна оцена' : isTr ? 'Ort. puan' : isRo ? 'Evaluare medie' : 'Avg. rating'}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── AUDIENCE SPLIT ───────────────────────────────────────────────────── -->
  <section class="bg-white border-b border-gray-100 py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <p class="text-center text-xs font-semibold text-gray-400 uppercase tracking-widest mb-8">
        {lang === 'el' ? 'Ποιος είσαι;' : lang === 'bg' ? 'Кой си ти?' : isSr ? 'Ко си ти?' : isTr ? 'Kim için buradasın?' : isRo ? 'Cine ești?' : "Who are you here for?"}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Guest -->
        <a href="/rentals" class="group flex flex-col items-start gap-3 bg-gray-50 hover:bg-[#1a1a2e] border border-gray-100 hover:border-[#1a1a2e] rounded-2xl p-6 transition-all">
          <span class="text-3xl">🏖️</span>
          <div>
            <p class="font-bold text-gray-900 group-hover:text-white text-lg transition-colors">
              {lang === 'el' ? "Είμαι επισκέπτης" : lang === 'bg' ? "Аз съм гост" : isSr ? "Ја сам гост" : isTr ? "Ben bir Misafirim" : isRo ? "Sunt Oaspete" : "I'm a Guest"}
            </p>
            <p class="text-sm text-gray-500 group-hover:text-white/70 mt-1 transition-colors">
              {lang === 'el' ? 'Κλείστε βίλες χωρίς χρεώσεις' : lang === 'bg' ? 'Резервирайте вили без такси за резервация' : isSr ? 'Резервишите виле без накнада за резервацију' : isTr ? 'Sıfır rezervasyon ücreti ile villa rezerve edin' : isRo ? 'Rezervați vile fără comisioane de rezervare' : 'Book villas with zero booking fees'}
            </p>
          </div>
          <span class="text-xs font-semibold text-[#c9a96e] group-hover:text-[#c9a96e] mt-auto">
            {lang === 'el' ? 'Βρείτε κατάλυμα →' : lang === 'bg' ? 'Намерете вила →' : isSr ? 'Пронађи вилу →' : isTr ? 'Villa Bul →' : isRo ? 'Găsește o Vilă →' : 'Find a Villa →'}
          </span>
        </a>

        <!-- Owner -->
        <a href="/contact" class="group flex flex-col items-start gap-3 bg-gray-50 hover:bg-[#1a1a2e] border border-gray-100 hover:border-[#1a1a2e] rounded-2xl p-6 transition-all">
          <span class="text-3xl">🏡</span>
          <div>
            <p class="font-bold text-gray-900 group-hover:text-white text-lg transition-colors">
              {lang === 'el' ? "Είμαι ιδιοκτήτης" : lang === 'bg' ? "Аз съм собственик на имот" : isSr ? "Ја сам власник некретнине" : isTr ? "Ben bir Mülk Sahibiyim" : isRo ? "Sunt Proprietar" : "I'm a Property Owner"}
            </p>
            <p class="text-sm text-gray-500 group-hover:text-white/70 mt-1 transition-colors">
              {lang === 'el' ? 'Καταχωρίστε το ακίνητό σας, κρατήστε το 95%' : lang === 'bg' ? 'Публикувайте имота си, запазете до 95%' : isSr ? 'Огласите некретнину, задржите до 95%' : isTr ? 'Mülkünüzü listeleyin, %95\'e kadar kazanın' : isRo ? 'Listați proprietatea, păstrați până la 95%' : 'List your property, keep up to 95%'}
            </p>
          </div>
          <span class="text-xs font-semibold text-[#c9a96e] group-hover:text-[#c9a96e] mt-auto">
            {lang === 'el' ? 'Καταχωρίστε το ακίνητό σας →' : lang === 'bg' ? 'Публикувайте имота си →' : isSr ? 'Огласи моју некретнину →' : isTr ? 'Mülkümü Listele →' : isRo ? 'Listează Proprietatea →' : 'List My Property →'}
          </span>
        </a>

        <!-- Cleaner -->
        <a href="/cleaner/signup" class="group flex flex-col items-start gap-3 bg-gray-50 hover:bg-[#1a1a2e] border border-gray-100 hover:border-[#1a1a2e] rounded-2xl p-6 transition-all">
          <span class="text-3xl">🧹</span>
          <div>
            <p class="font-bold text-gray-900 group-hover:text-white text-lg transition-colors">
              {lang === 'el' ? "Είμαι καθαριστής" : lang === 'bg' ? "Аз съм почистващ" : isSr ? "Ја сам чистач/чистачица" : isTr ? "Ben bir Temizlikçiyim" : isRo ? "Sunt Personal de Curățenie" : "I'm a Cleaner"}
            </p>
            <p class="text-sm text-gray-500 group-hover:text-white/70 mt-1 transition-colors">
              {lang === 'el' ? 'Κάντε προσφορές σε εργασίες, πληρωθείτε αυτόματα' : lang === 'bg' ? 'Наддавайте за задачи. Получавайте плащане автоматично.' : isSr ? 'Нудите за послове. Примайте плаћање аутоматски.' : isTr ? 'İşler için teklif verin. Otomatik ödeme alın.' : isRo ? 'Licitați pentru lucrări. Plată automată.' : 'Bid on jobs. Get paid automatically.'}
            </p>
          </div>
          <span class="text-xs font-semibold text-[#c9a96e] group-hover:text-[#c9a96e] mt-auto">
            {lang === 'el' ? 'Βρείτε εργασία →' : lang === 'bg' ? 'Намерете работа →' : isSr ? 'Пронађи посао →' : isTr ? 'İş Bul →' : isRo ? 'Găsește Lucrări →' : 'Find Work →'}
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FEATURED LISTINGS ───────────────────────────────────────────────── -->
  {listings.length > 0 && (
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-10">
          <div>
            <p class="text-[#c9a96e] font-semibold text-sm uppercase tracking-wider mb-2">{t(lang, 'home.featured.badge')}</p>
            <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">{t(lang, 'home.featured.title')}</h2>
          </div>
          <a href="/rentals" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-medium text-[#1a1a2e] hover:text-[#c9a96e] transition-colors">
            {t(lang, 'home.featured.all')}
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {listings.slice(0, 3).map((listing) => (
            <ListingCard listing={listing} featured={featuredSet.has(listing.id)} />
          ))}
        </div>
        <div class="mt-8 text-center sm:hidden">
          <a href="/rentals" class="inline-flex items-center gap-2 border border-gray-200 bg-white text-gray-700 font-medium px-6 py-3 rounded-xl hover:bg-gray-50 transition-colors text-sm">
            {t(lang, 'home.featured.all')}
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ── FOR GUESTS ───────────────────────────────────────────────────────── -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-[#c9a96e] font-semibold text-sm uppercase tracking-wider mb-3">
            {lang === 'el' ? 'Για Επισκέπτες' : lang === 'bg' ? 'За гости' : isSr ? 'За госте' : isTr ? 'Misafirler İçin' : isRo ? 'Pentru Oaspeți' : 'For Guests'}
          </p>
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
            {lang === 'el' ? 'Πληρώστε λιγότερο.\nΜείνετε καλύτερα.' : lang === 'bg' ? 'Платете по-малко.\nОстанете по-добре.' : isSr ? 'Платите мање.\nОстаните боље.' : isTr ? 'Daha az ödeyin.\nDaha iyi kalın.' : isRo ? 'Plătiți mai puțin.\nStați mai bine.' : 'Pay less.\nStay better.'}
          </h2>
          <p class="text-gray-500 text-lg mb-8 leading-relaxed">
            {lang === 'el'
              ? 'Σε άλλες πλατφόρμες πληρώνετε έως 14% επιπλέον. Εδώ δεν πληρώνετε τίποτα παραπάνω. Επιπλέον, οι ιδιοκτήτες μας πληρώνουν μόνο 5% προμήθεια — οπότε μπορούν να προσφέρουν καλύτερες τιμές. Μιλήστε απευθείας με τον ιδιοκτήτη — όχι με ένα bot.'
              : lang === 'bg'
              ? 'В други платформи плащате до 14% повече. Тук не плащате нищо допълнително. Освен това собствениците ни плащат само 5% комисионна — така могат да предлагат по-добри цени. Говорете директно със собственика — не с бот.'
              : isSr ? 'На другим платформама плаћате до 14% више. Овде не плаћате ништа додатно. Поврх тога, наши власници плаћају само 5% провизију — тако могу да понуде боље цене. Разговарајте директно са власником — не са ботом.'
              : isTr ? 'Diğer platformlarda %14\'e kadar fazla ödersiniz. Burada hiçbir şey ödemezsiniz. Üstelik sahiplerimiz yalnızca %5 komisyon öder — bu yüzden daha rekabetçi fiyatlar sunabilirler. Sahibiyle doğrudan konuşun — botla değil.'
              : isRo ? 'Pe alte platforme plătiți până la 14% în plus. Aici nu plătiți nimic în plus. Iar proprietarii plătesc doar 5% comision — deci pot oferi prețuri mai competitive. Vorbiți direct cu proprietarul — nu cu un bot.'
              : 'On other platforms you pay up to 14% extra. Here you pay nothing extra. And because owners only pay a 5% commission, they can price more competitively. Talk directly to the owner — not a bot.'}
          </p>
          <ul class="space-y-3 mb-10">
            {[
              lang === 'el' ? '✓ Μηδενικές χρεώσεις επισκέπτη' : lang === 'bg' ? '✓ Нулеви такси за резервация' : isSr ? '✓ Нула накнада за резервацију' : isTr ? '✓ Sıfır misafir rezervasyon ücreti' : isRo ? '✓ Zero comisioane de rezervare' : '✓ Zero guest booking fees',
              lang === 'el' ? '✓ Μόνο επαληθευμένα, υψηλής ποιότητας καταλύματα' : lang === 'bg' ? '✓ Само проверени имоти с високо качество' : isSr ? '✓ Само проверене, висококвалитетне некретнине' : isTr ? '✓ Yalnızca doğrulanmış, yüksek kaliteli mülkler' : isRo ? '✓ Doar proprietăți verificate, de înaltă calitate' : '✓ Verified, high-quality properties only',
              lang === 'el' ? '✓ Άμεση επικοινωνία με τον ιδιοκτήτη' : lang === 'bg' ? '✓ Директна връзка със собственика — WhatsApp, телефон' : isSr ? '✓ Директан контакт са власником — WhatsApp, телефон' : isTr ? '✓ Sahibiyle doğrudan iletişim — WhatsApp, telefon' : isRo ? '✓ Contact direct cu proprietarul — WhatsApp, telefon' : '✓ Direct contact with the owner — WhatsApp, phone',
              lang === 'el' ? '✓ Ασφαλής πληρωμή Stripe ή τραπεζική μεταφορά' : lang === 'bg' ? '✓ Сигурно плащане чрез Stripe или банков превод' : isSr ? '✓ Сигурно плаћање Stripe или банковни трансфер' : isTr ? '✓ Güvenli Stripe ödeme veya banka transferi' : isRo ? '✓ Plată securizată Stripe sau transfer bancar' : '✓ Secure Stripe checkout or bank transfer',
            ].map(item => (
              <li class="flex items-center gap-3 text-gray-700 text-sm font-medium">{item}</li>
            ))}
          </ul>
