---
import BaseLayout from '../layouts/BaseLayout.astro';
import { type Lang } from '../i18n/translations.ts';

const lang = (Astro.locals.lang ?? 'en') as Lang;
const isEl = lang === 'el';
const isBg = lang === 'bg';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://kefaloniabnb.com';

const benefits = [
  {
    icon: '💰',
    title: isEl ? 'Ανταγωνιστική Αμοιβή' : isBg ? 'Конкурентно Заплащане' : isSr ? 'Конкурентна Накнада' : isTr ? 'Rekabetçi Ücret' : isRo ? 'Plată Competitivă' : 'Competitive Pay',
    body: isEl
      ? 'Ορίστε τις δικές σας τιμές ανά εργασία. Κρατάτε το 95% κάθε πληρωμής — εμείς παίρνουμε μόνο ένα τέλος πλατφόρμας 5%.'
      : isBg
      ? 'Определете собствените си цени за всяка задача. Запазвате 95% от всяко плащане — ние вземаме само 5% такса за платформата.'
      : isSr
      ? 'Одредите сопствене цене по послу. Задржавате 95% сваке уплате — ми узимамо само 5% накнаде платформе.'
      : isTr
      ? 'İş başına kendi fiyatlarınızı belirleyin. Her ödemeden %95\'ini alırsınız — biz yalnızca %5 platform ücreti alırız.'
      : isRo
      ? 'Stabiliți-vă propriile prețuri per lucrare. Păstrați 95% din fiecare plată — noi reținem doar 5% taxă de platformă.'
      : 'Set your own prices per job. Keep 95% of every payment — we take just a 5% platform fee.',
  },
  {
    icon: '📅',
    title: isEl ? 'Ευέλικτο Πρόγραμμα' : isBg ? 'Гъвкав График' : isSr ? 'Флексибилан Распоред' : isTr ? 'Esnek Program' : isRo ? 'Program Flexibil' : 'Flexible Schedule',
    body: isEl
      ? 'Εσείς επιλέγετε για ποιες εργασίες να υποβάλετε προσφορά. Ορίστε τη δική σας διαθεσιμότητα και μη αναλαμβάνετε περισσότερα από όσα μπορείτε να χειριστείτε.'
      : isBg
      ? 'Вие избирате за кои задачи да оферирате. Задайте собствената си наличност и никога не поемайте повече, отколкото можете да се справите.'
      : isSr
      ? 'Ви бирате за које послове да конкуришете. Одредите сопствену доступност и никада не преузимајте више него што можете да обавите.'
      : isTr
      ? 'Hangi işlere teklif vereceğinizi siz seçersiniz. Kendi programınızı belirleyin ve üstesinden gelemeyeceğinizden fazlasını asla üstlenmeyin.'
      : isRo
      ? 'Dvs. alegeți pentru ce lucrări să licitați. Stabiliți-vă propria disponibilitate și nu preluați mai mult decât puteți gestiona.'
      : 'You choose which jobs to bid on. Set your own availability and never take more than you can handle.',
  },
  {
    icon: '⚡',
    title: isEl ? 'Γρήγορες Αποδόσεις' : isBg ? 'Бързи Плащания' : isSr ? 'Брза Исплата' : isTr ? 'Hızlı Ödemeler' : isRo ? 'Plăți Rapide' : 'Fast Payouts',
    body: isEl
      ? 'Μόλις ο ιδιοκτήτης εγκρίνει την εργασία σας, η πληρωμή μεταφέρεται απευθείας στον λογαριασμό Stripe σας.'
      : isBg
      ? 'След като собственикът на имота одобри работата ви, плащането се прехвърля директно по вашата Stripe сметка.'
      : isSr
      ? 'Чим власник некретнине одобри ваш рад, уплата се преноси директно на ваш Stripe налог.'
      : isTr
      ? 'Mülk sahibi çalışmanızı onayladığında ödeme doğrudan Stripe hesabınıza aktarılır.'
      : isRo
      ? 'Odată ce proprietarul aprobă munca dvs., plata este transferată direct în contul dvs. Stripe.'
      : 'Once the property owner approves your work, payment is transferred directly to your Stripe account.',
  },
  {
    icon: '📱',
    title: isEl ? 'Απλή Εφαρμογή' : isBg ? 'Лесно Приложение' : isSr ? 'Једноставна Апликација' : isTr ? 'Basit Uygulama' : isRo ? 'Aplicație Simplă' : 'Simple App',
    body: isEl
      ? 'Διαχειριστείτε τα πάντα από το τηλέφωνό σας — δείτε λεπτομέρειες εργασίας, επισημάνετε τη λίστα ελέγχου, ανεβάστε φωτογραφίες πριν & μετά.'
      : isBg
      ? 'Управлявайте всичко от телефона си — вижте детайлите на задачата, отбелязвайте контролния списък, качвайте снимки преди и след почистването.'
      : isSr
      ? 'Управљајте свим са телефона — прегледајте детаље посла, обележите контролну листу, отпремите фотографије пре и после.'
      : isTr
      ? 'Her şeyi telefonunuzdan yönetin — iş detaylarını görün, kontrol listesini işaretleyin, öncesi ve sonrası fotoğrafları yükleyin.'
      : isRo
      ? 'Gestionați totul de pe telefon — vedeți detaliile lucrării, bifați lista de verificare, încărcați fotografii înainte și după.'
      : 'Manage everything from your phone — see job details, tick off your checklist, upload before & after photos.',
  },
  {
    icon: '🏡',
    title: isEl ? 'Ποιοτικά Ακίνητα' : isBg ? 'Качествени Имоти' : isSr ? 'Квалитетне Некретнине' : isTr ? 'Kaliteli Mülkler' : isRo ? 'Proprietăți de Calitate' : 'Quality Properties',
    body: isEl
      ? 'Εργαστείτε σε premium ενοικιαζόμενες βίλες και διαμερίσματα στην περιοχή της Καβάλας. Σταθερές, επαναλαμβανόμενες κρατήσεις.'
      : isBg
      ? 'Работете в луксозни ваканционни вили и апартаменти в района на Kefalonia. Редовни, повтарящи се резервации.'
      : isSr
      ? 'Радите у премиум одмаралишним вилама и апартманима у региону Кавале. Стални, понављајући резервације.'
      : isTr
      ? 'Kefalonia bölgesindeki premium tatil villalarında ve dairelerinde çalışın. Tutarlı, tekrarlayan rezervasyonlar.'
      : isRo
      ? 'Lucrați în vile și apartamente premium de vacanță din regiunea Kefalonia. Rezervări constante și recurente.'
      : 'Work in premium vacation villas and apartments in the Kefalonia region. Consistent, repeat bookings.',
  },
  {
    icon: '🤝',
    title: isEl ? 'Άμεση Σχέση' : isBg ? 'Пряка Връзка' : isSr ? 'Директан Однос' : isTr ? 'Doğrudan İlişki' : isRo ? 'Relație Directă' : 'Direct Relationship',
    body: isEl
      ? 'Χτίστε φήμη με τους ιδιοκτήτες ακινήτων. Οι καθαριστές με κορυφαία βαθμολογία έχουν προτεραιότητα ορατότητας προσφορών.'
      : isBg
      ? 'Изградете репутация при собствениците на имоти. Почистващите с най-висок рейтинг получават приоритетна видимост на офертите.'
      : isSr
      ? 'Изградите репутацију код власника некретнина. Чистачи са највишом оценом добијају приоритет у видљивости понуда.'
      : isTr
      ? 'Mülk sahipleriyle itibar oluşturun. En yüksek puanlı temizlikçiler teklif görünürlüğünde öncelik elde eder.'
      : isRo
      ? 'Construiți-vă reputația cu proprietarii. Curățătorii cu cele mai bune evaluări primesc prioritate la vizibilitatea ofertelor.'
      : 'Build a reputation with property owners. Top-rated cleaners get priority bid visibility.',
  },
];

const steps = [
  {
    n: '01',
    title: isEl ? 'Δημιουργήστε το προφίλ σας' : isBg ? 'Създайте своя профил' : isSr ? 'Направите свој профил' : isTr ? 'Profilinizi Oluşturun' : isRo ? 'Creați-vă profilul' : 'Create your profile',
    body: isEl
      ? 'Εγγραφείτε σε 2 λεπτά. Προσθέστε το βιογραφικό σας, τους τύπους ακινήτων που εξυπηρετείτε, τις τιμές και την περιοχή σας.'
      : isBg
      ? 'Регистрирайте се за 2 минути. Добавете биографията си, видовете имоти, които обслужвате, вашите цени и района, в який работите.'
      : isSr
      ? 'Региструјте се за 2 минута. Додајте биографију, врсте некретнина које услужујете, цене и своје подручје.'
      : isTr
      ? '2 dakikada kaydolun. Biyografinizi, hizmet verdiğiniz mülk türlerini, fiyatlandırmanızı ve bölgenizi ekleyin.'
      : isRo
      ? 'Înregistrați-vă în 2 minute. Adăugați biografia, tipurile de proprietăți pe care le deserviți, prețurile și zona dvs.'
      : 'Sign up in 2 minutes. Add your bio, the property types you service, your pricing, and your area.',
  },
  {
    n: '02',
    title: isEl ? 'Συνδέστε Stripe' : isBg ? 'Свържете Stripe' : isSr ? 'Повежите Stripe' : isTr ? 'Stripe\'ı Bağlayın' : isRo ? 'Conectați Stripe' : 'Connect Stripe',
    body: isEl
      ? 'Συνδέστε τον τραπεζικό λογαριασμό σας μέσω Stripe Express (δωρεάν). Έτσι λαμβάνετε πληρωμές με ασφάλεια.'
      : isBg
      ? 'Свържете банковата си сметка чрез Stripe Express (безплатно). По този начин получавате плащанията си по сигурен начин.'
      : isSr
      ? 'Повежите банковни рачун преко Stripe Express (бесплатно). На тај начин безбедно примате уплате.'
      : isTr
      ? 'Banka hesabınızı Stripe Express (ücretsiz) üzerinden bağlayın. Ödemelerinizi bu şekilde güvenle alırsınız.'
      : isRo
      ? 'Conectați contul bancar prin Stripe Express (gratuit). Așa primiți plățile în siguranță.'
      : 'Link your bank account via Stripe Express (free). This is how you receive payments securely.',
  },
  {
    n: '03',
    title: isEl ? 'Αναζητήστε ανοιχτά αιτήματα' : isBg ? 'Разгледайте отворените заявки' : isSr ? 'Прегледајте отворене захтеве' : isTr ? 'Açık Talepleri Görüntüleyin' : isRo ? 'Răsfoiți cererile deschise' : 'Browse open requests',
    body: isEl
      ? 'Οι ιδιοκτήτες δημοσιεύουν αιτήματα καθαρισμού μετά από checkout επισκεπτών. Αναζητήστε κατά ημερομηνία και τοποθεσία, μετά υποβάλετε την προσφορά σας.'
      : isBg
      ? 'Собствениците на имоти публикуват заявки за почистване след напускане на гостите. Разгледайте по дата и местоположение, след което подайте офертата си.'
      : isSr
      ? 'Власници некретнина објављују захтеве за чишћење након одласка гостију. Прегледајте по датуму и локацији, затим пошаљите понуду.'
      : isTr
      ? 'Mülk sahipleri misafir çıkışlarının ardından temizlik talepleri yayınlar. Tarihe ve konuma göre filtreleyin, ardından teklifinizi verin.'
      : isRo
      ? 'Proprietarii postează cereri de curățenie după checkout-ul oaspeților. Navigați după dată și locație, apoi plasați oferta.'
      : 'Property owners post cleaning requests after guest checkouts. Browse by date and location, then place your bid.',
  },
  {
    n: '04',
    title: isEl ? 'Κάντε τη δουλειά' : isBg ? 'Извършете работата' : isSr ? 'Завршите посао' : isTr ? 'İşi Yapın' : isRo ? 'Efectuați lucrarea' : 'Do the work',
    body: isEl
      ? 'Την ημέρα, ξεκινήστε την εργασία στην εφαρμογή, δουλέψτε τη λίστα ελέγχου και ανεβάστε φωτογραφίες πριν & μετά.'
      : isBg
      ? 'В деня на почистването стартирайте задачата в приложението, следвайте контролния списък и качете снимки преди и след работата.'
      : isSr
      ? 'На дан чишћења покрените посао у апликацији, пратите контролну листу и отпремите фотографије пре и после.'
      : isTr
      ? 'Gün geldiğinde uygulamada işi başlatın, kontrol listesini takip edin ve öncesi ile sonrası fotoğraflarını yükleyin.'
      : isRo
      ? 'În ziua respectivă, începeți lucrarea în aplicație, parcurgeți lista de verificare și încărcați fotografii înainte și după.'
      : 'On the day, start the job in the app, work through the checklist, and upload before & after photos.',
  },
  {
    n: '05',
    title: isEl ? 'Αμειφθείτε' : isBg ? 'Получете плащането си' : isSr ? 'Примите плаћање' : isTr ? 'Ödemenizi Alın' : isRo ? 'Primiți plata' : 'Get paid',
    body: isEl
      ? 'Ο ιδιοκτήτης αξιολογεί τις φωτογραφίες σας και εγκρίνει την εργασία. Η πληρωμή μπαίνει αυτόματα στον λογαριασμό σας.'
      : isBg
      ? 'Собственикът преглежда снимките ви и одобрява задачата. Плащането постъпва автоматично по вашата сметка.'
      : isSr
      ? 'Власник прегледа ваше фотографије и одобри посао. Уплата аутоматски стиже на ваш налог.'
      : isTr
      ? 'Mülk sahibi fotoğraflarınızı inceler ve işi onaylar. Ödeme otomatik olarak hesabınıza yatar.'
      : isRo
      ? 'Proprietarul vă verifică fotografiile și aprobă lucrarea. Plata intră automat în contul dvs.'
      : 'The owner reviews your photos and approves the job. Payment hits your account automatically.',
  },
];

const faqs = [
  {
    q: isEl ? 'Υπάρχει τέλος εγγραφής;' : isBg ? 'Има ли такса за регистрация?' : isSr ? 'Да ли постоји накнада за пријаву?' : isTr ? 'Kaydolmak ücretli mi?' : isRo ? 'Există o taxă de înscriere?' : 'Is there a fee to join?',
    a: isEl
      ? 'Όχι. Η εγγραφή είναι εντελώς δωρεάν. Παίρνουμε μόνο προμήθεια 5% όταν ολοκληρώνετε μια αμειβόμενη εργασία.'
      : isBg
      ? 'Не. Регистрацията е напълно безплатна. Вземаме само 5% комисиона, когато завършите платена задача.'
      : isSr
      ? 'Не. Регистрација је потпуно бесплатна. Узимамо само 5% провизије када завршите плаћени посао.'
      : isTr
      ? 'Hayır. Kaydolmak tamamen ücretsizdir. Yalnızca ücretli bir iş tamamladığınızda %5 komisyon alırız.'
      : isRo
      ? 'Nu. Înscrierea este complet gratuită. Reținem doar un comision de 5% când finalizați o lucrare plătită.'
      : 'No. Signing up is completely free. We only take a 5% commission when you complete a paid job.',
  },
  {
    q: isEl ? 'Πόσο γρήγορα αμείβομαι;' : isBg ? 'Колко бързо получавам плащане?' : isSr ? 'Колико брзо добијам плаћање?' : isTr ? 'Ne kadar hızlı ödeme alırım?' : isRo ? 'Cât de repede primesc plata?' : 'How quickly do I get paid?',
    a: isEl
      ? 'Μόλις ο ιδιοκτήτης εγκρίνει την εργασία σας (συνήθως την ίδια μέρα), το Stripe μεταφέρει τα έσοδά σας απευθείας στην τράπεζά σας. Ισχύουν οι τυπικοί χρόνοι απόδοσης Stripe (1–2 εργάσιμες μέρες στην Ελλάδα).'
      : isBg
      ? 'Веднага щом собственикът одобри задачата ви (обикновено същия ден), Stripe превежда приходите ви директно по банковата ви сметка. Важат стандартните срокове на Stripe (1–2 работни дни в Гърция).'
      : isSr
      ? 'Чим власник некретнине одобри ваш посао (обично истог дана), Stripe преноси вашу зараду директно на банковни рачун. Примењују се стандардна времена исплате Stripe-а (1–2 радна дана у Грчкој).'
      : isTr
      ? 'Mülk sahibi işinizi onaylar onaylamaz (genellikle aynı gün) Stripe kazancınızı doğrudan bankanıza aktarır. Standart Stripe ödeme süreleri geçerlidir (Yunanistan\'da 1–2 iş günü).'
      : isRo
      ? 'Imediat ce proprietarul aprobă lucrarea dvs. (de obicei în aceeași zi), Stripe transferă câștigurile direct în banca dvs. Se aplică timpii standard de plată Stripe (1–2 zile lucrătoare în Grecia).'
      : 'As soon as the property owner approves your job (typically the same day), Stripe transfers your earnings directly to your bank. Standard Stripe payout times apply (1–2 business days in Greece).',
  },
  {
    q: isEl ? 'Μπορώ να επιλέξω ποια ακίνητα καθαρίζω;' : isBg ? 'Мога ли да избирам кои имоти почиствам?' : isSr ? 'Могу ли да бирам које некретнине чистим?' : isTr ? 'Hangi mülkleri temizleyeceğimi seçebilir miyim?' : isRo ? 'Pot alege ce proprietăți curăț?' : 'Can I choose which properties I clean?',
    a: isEl
      ? 'Ναι. Αναζητάτε ανοιχτά αιτήματα και υποβάλλετε προσφορά μόνο σε εργασίες που ταιριάζουν με το πρόγραμμα, την τοποθεσία και τις τιμές σας.'
      : isBg
      ? 'Да. Разглеждате отворените заявки и оферирате само за задачи, подходящи за вашия график, местоположение и ценови диапазон.'
      : isSr
      ? 'Да. Прегледате отворене захтеве и конкуришете само за послове који одговарају вашем распореду, локацији и ценама.'
      : isTr
      ? 'Evet. Açık talepleri inceler ve yalnızca programınıza, konumunuza ve fiyatlandırmanıza uyan işlere teklif verirsiniz.'
      : isRo
      ? 'Da. Navigați cererile deschise și licitați doar pentru lucrările care se potrivesc programului, locației și prețurilor dvs.'
      : 'Yes. You browse open requests and bid only on jobs that suit your schedule, location, and pricing.',
  },
  {
    q: isEl ? 'Χρειάζεται να έχω τα δικά μου υλικά καθαρισμού;' : isBg ? 'Необходими ли са ми собствени почистващи препарати?' : isSr ? 'Да ли ми треба сопствени прибор за чишћење?' : isTr ? 'Kendi temizlik malzemelerimi getirmem gerekiyor mu?' : isRo ? 'Am nevoie de propriile produse de curățenie?' : 'Do I need my own cleaning supplies?',
    a: isEl
      ? 'Αυτό συμφωνείται απευθείας με κάθε ιδιοκτήτη. Πολλοί παρέχουν υλικά επί τόπου· κάποιοι προτιμούν να φέρνετε τα δικά σας. Αναφέρεται στις λεπτομέρειες της εργασίας.'
      : isBg
      ? 'Това се договаря директно с всеки собственик. Много от тях осигуряват консумативи на място; някои предпочитат да носите свои. Указано е в детайлите на задачата.'
      : isSr
      ? 'То се договара директно са сваким власником. Многи обезбеђују потрепштине на лицу места; неки преферирају да донесете своје. Наведено је у детаљима посла.'
      : isTr
      ? 'Bu her mülk sahibiyle doğrudan anlaşılır. Birçoğu malzemeleri yerinde sağlar; bazıları kendinizinkini getirmenizi tercih eder. İş detaylarında belirtilmiştir.'
      : isRo
      ? 'Acest lucru se stabilește direct cu fiecare proprietar. Mulți furnizează produse la fața locului; unii preferă să le aduceți pe ale dvs. Este menționat în detaliile lucrării.'
      : 'This is agreed directly with each property owner. Many provide supplies on-site; some prefer you bring your own. It\'s noted in the job details.',
  },
  {
    q: isEl ? 'Ποιες περιοχές καλύπτει αυτό;' : isBg ? 'Кои райони обхваща услугата?' : isSr ? 'Које области ово покрива?' : isTr ? 'Bu hangi bölgeleri kapsıyor?' : isRo ? 'Ce zone acoperă?' : 'What areas does this cover?',
    a: isEl
      ? 'Προς το παρόν Kefalonia, Keramoti, Νέα Πέραμος και γύρω περιοχές στη βόρεια Ελλάδα. Περισσότερες περιοχές σύντομα.'
      : isBg
      ? 'Към момента Kefalonia, Keramoti, Nea Peramos и околните райони в Северна Гърция. Очаквайте скоро и нови региони.'
      : isSr
      ? 'Тренутно Кавала, Керамоти, Неа Перамос и околна подручја у северној Грчкој. Ускоро и нови региони.'
      : isTr
      ? 'Şu anda Kefalonia, Keramoti, Nea Peramos ve Kuzey Yunanistan\'daki çevre bölgeler. Yakında daha fazla bölge.'
      : isRo
      ? 'În prezent Kefalonia, Keramoti, Nea Peramos și zonele înconjurătoare din nordul Greciei. Mai multe regiuni în curând.'
      : 'Currently Kefalonia, Keramoti, Nea Peramos, and surrounding areas in northern Greece. More regions coming soon.',
  },
  {
    q: isEl ? 'Μπορώ να ορίσω τις δικές μου τιμές;' : isBg ? 'Мога ли да задавам собствените си цени?' : isSr ? 'Могу ли да одредим сопствене цене?' : isTr ? 'Kendi fiyatlarımı belirleyebilir miyim?' : isRo ? 'Pot să îmi stabilesc propriile prețuri?' : 'Can I set my own prices?',
    a: isEl
      ? 'Ναι. Ορίζετε τη βασική τιμή σας ανά τύπο ακινήτου και αριθμό υπνοδωματίων. Όταν υποβάλλετε προσφορά για εργασία μπορείτε επίσης να προσαρμόσετε την τιμή για το συγκεκριμένο αίτημα.'
      : isBg
      ? 'Да. Задавате базовата си цена по вид имот и брой спални. При оферирането за конкретна задача можете допълнително да коригирате цената за това конкретно заявление.'
      : isSr
      ? 'Да. Одређујете основну цену по врсти некретнине и броју спаваћих соба. Када конкуришете за посао, можете такође прилагодити цену за тај конкретни захтев.'
      : isTr
      ? 'Evet. Mülk türü ve yatak odası sayısına göre temel fiyatınızı siz belirlersiniz. Bir işe teklif verirken o talebe özgü fiyatı da ayarlayabilirsiniz.'
      : isRo
      ? 'Da. Vă stabiliți prețul de bază per tip de proprietate și număr de dormitoare. Când licitați pentru o lucrare, puteți ajusta prețul pentru cererea respectivă.'
      : 'Yes. You set your base price per property type and bedroom count. When you bid on a job you can also adjust the price for that specific request.',
  },
];
