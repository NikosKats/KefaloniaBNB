---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = (Astro.locals.lang ?? 'en') as string;
const isEl = lang === 'el';
const isBg = lang === 'bg';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';
---

<BaseLayout title={isEl ? 'Ορισμός Κωδικού' : isBg ? 'Задаване на парола' : isSr ? 'Postavi lozinku' : isTr ? 'Şifre Belirle' : isRo ? 'Setare Parolă' : 'Set Password'} noIndex>
  <section class="bg-[#1a1a2e] py-16 sm:py-20">
    <div class="max-w-md mx-auto px-4 text-center">
      <h1 class="text-3xl font-bold text-white mb-2">{isEl ? 'Ορισμός Κωδικού' : isBg ? 'Задайте паролата си' : isSr ? 'Postavite svoju lozinku' : isTr ? 'Şifrenizi Belirleyin' : isRo ? 'Setează-ți Parola' : 'Set Your Password'}</h1>
      <p class="text-gray-300">{isEl ? 'Επιλέξτε έναν νέο κωδικό πρόσβασης' : isBg ? 'Изберете нова парола за вашия акаунт' : isSr ? 'Izaberite novu lozinku za vaš nalog' : isTr ? 'Hesabınız için yeni bir şifre seçin' : isRo ? 'Alege o parolă nouă pentru contul tău' : 'Choose a new password for your account'}</p>
    </div>
  </section>

  <section class="max-w-md mx-auto px-4 py-10">
    <div id="error-banner" class="hidden bg-red-50 border border-red-200 text-red-700 text-sm p-4 rounded-xl mb-6"></div>
    <div id="success-banner" class="hidden bg-green-50 border border-green-200 text-green-700 text-sm p-4 rounded-xl mb-6"></div>

    <div id="form-card" class="bg-white border border-gray-100 rounded-2xl p-8 shadow-sm">
      <form id="set-password-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">{isEl ? 'Νέος κωδικός' : isBg ? 'Нова парола' : isSr ? 'Nova lozinka' : isTr ? 'Yeni şifre' : isRo ? 'Parolă nouă' : 'New password'}</label>
          <input
            type="password"
            id="password"
            required
            minlength="6"
            autocomplete="new-password"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm outline-none focus:border-[#1a1a2e]"
            placeholder={isEl ? 'Τουλάχιστον 6 χαρακτήρες' : isBg ? 'Минимум 6 символа' : isSr ? 'Najmanje 6 karaktera' : isTr ? 'En az 6 karakter' : isRo ? 'Minim 6 caractere' : 'Minimum 6 characters'}
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">{isEl ? 'Επιβεβαίωση κωδικού' : isBg ? 'Потвърдете паролата' : isSr ? 'Potvrdite lozinku' : isTr ? 'Şifreyi onayla' : isRo ? 'Confirmă parola' : 'Confirm password'}</label>
          <input
            type="password"
            id="confirm-password"
            required
            minlength="6"
            autocomplete="new-password"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm outline-none focus:border-[#1a1a2e]"
            placeholder={isEl ? 'Επαναλάβετε τον κωδικό' : isBg ? 'Повторете паролата си' : isSr ? 'Ponovite lozinku' : isTr ? 'Şifrenizi tekrarlayın' : isRo ? 'Repetă parola' : 'Repeat your password'}
          />
        </div>
        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-[#1a1a2e] text-white font-semibold py-3 rounded-xl text-sm hover:bg-[#2d2d4e] transition-colors disabled:opacity-50"
        >
          {isEl ? 'Ορισμός κωδικού' : isBg ? 'Задайте парола' : isSr ? 'Postavi lozinku' : isTr ? 'Şifre Belirle' : isRo ? 'Setare Parolă' : 'Set Password'}
        </button>
      </form>
    </div>

    <p class="text-center mt-4">
      <a href="/community/join" class="text-sm text-gray-500 hover:text-gray-700 transition-colors">&larr; {isEl ? 'Πίσω στη σύνδεση' : isBg ? 'Назад към входа' : isSr ? 'Nazad na prijavu' : isTr ? 'Girişe dön' : isRo ? 'Înapoi la autentificare' : 'Back to login'}</a>
    </p>
  </section>
</BaseLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  );

  const errorBanner = document.getElementById('error-banner')!;
  const successBanner = document.getElementById('success-banner')!;
  const formCard = document.getElementById('form-card')!;
  const form = document.getElementById('set-password-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  function showError(msg: string) {
    errorBanner.textContent = msg;
    errorBanner.classList.remove('hidden');
    successBanner.classList.add('hidden');
  }

  async function init() {
    const hash = window.location.hash.slice(1);
    const params = new URLSearchParams(hash);
    const type = params.get('type');
    const accessToken = params.get('access_token');
    const refreshToken = params.get('refresh_token');
    const errorCode = params.get('error_code');
    const errorDesc = params.get('error_description');

    if (errorCode) {
      formCard.classList.add('hidden');
      showError(
        errorDesc
          ? decodeURIComponent(errorDesc.replace(/\+/g, ' '))
          : 'This link is invalid or has expired. Please request a new password reset.', // TODO: translate at runtime if needed
      );
      return;
    }

    if (type !== 'recovery' || !accessToken || !refreshToken) {
      formCard.classList.add('hidden');
      const _le1 = document.documentElement.lang;
      showError(_le1 === 'el' ? 'Μη έγκυρος ή ληγμένος σύνδεσμος. Ζητήστε νέα επαναφορά κωδικού.' : _le1 === 'bg' ? 'Невалиден или изтекъл линк. Моля, поискайте ново нулиране на паролата.' : _le1 === 'sr' ? 'Nevažeći ili istekao link. Zatražite novo resetovanje lozinke.' : _le1 === 'tr' ? 'Geçersiz veya süresi dolmuş bağlantı. Yeni şifre sıfırlama isteyin.' : _le1 === 'ro' ? 'Link invalid sau expirat. Te rugăm să soliciți o nouă resetare a parolei.' : 'Invalid or expired link. Please request a new password reset.');
      return;
    }

    const { error: sessionError } = await supabase.auth.setSession({
      access_token: accessToken,
      refresh_token: refreshToken,
    });

    if (sessionError) {
      formCard.classList.add('hidden');
      const _le2 = document.documentElement.lang;
      showError(_le2 === 'el' ? 'Αυτός ο σύνδεσμος έχει λήξει. Ζητήστε νέα επαναφορά κωδικού.' : _le2 === 'bg' ? 'Този линк е изтекъл. Моля, поискайте ново нулиране на паролата.' : _le2 === 'sr' ? 'Ovaj link je istekao. Zatražite novo resetovanje lozinke.' : _le2 === 'tr' ? 'Bu bağlantının süresi dolmuş. Yeni şifre sıfırlama isteyin.' : _le2 === 'ro' ? 'Acest link a expirat. Te rugăm să soliciți o nouă resetare a parolei.' : 'This link has expired. Please request a new password reset.');
      return;
    }

    history.replaceState(null, '', window.location.pathname);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBanner.classList.add('hidden');

    const password = (document.getElementById('password') as HTMLInputElement).value;
    const confirmPassword = (document.getElementById('confirm-password') as HTMLInputElement).value;

    const _l = document.documentElement.lang;
    if (password !== confirmPassword) {
      showError(_l === 'el' ? 'Οι κωδικοί δεν ταιριάζουν.' : _l === 'bg' ? 'Паролите не съвпадат.' : _l === 'sr' ? 'Lozinke se ne poklapaju.' : _l === 'tr' ? 'Şifreler eşleşmiyor.' : _l === 'ro' ? 'Parolele nu se potrivesc.' : 'Passwords do not match.');
      return;
    }
    if (password.length < 6) {
      showError(_l === 'el' ? 'Ο κωδικός πρέπει να έχει τουλάχιστον 6 χαρακτήρες.' : _l === 'bg' ? 'Паролата трябва да е поне 6 символа.' : _l === 'sr' ? 'Lozinka mora imati najmanje 6 karaktera.' : _l === 'tr' ? 'Şifre en az 6 karakter olmalıdır.' : _l === 'ro' ? 'Parola trebuie să aibă cel puțin 6 caractere.' : 'Password must be at least 6 characters.');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = _l === 'el' ? 'Αποθήκευση...' : _l === 'bg' ? 'Запазване...' : _l === 'sr' ? 'Čuvanje...' : _l === 'tr' ? 'Kaydediliyor...' : _l === 'ro' ? 'Se salvează...' : 'Saving...';

    const { error } = await supabase.auth.updateUser({ password });

    if (error) {
      showError(error.message);
      submitBtn.disabled = false;
      const _l2 = document.documentElement.lang;
      submitBtn.textContent = _l2 === 'el' ? 'Ορισμός κωδικού' : _l2 === 'bg' ? 'Задайте парола' : _l2 === 'sr' ? 'Postavi lozinku' : _l2 === 'tr' ? 'Şifre Belirle' : _l2 === 'ro' ? 'Setare Parolă' : 'Set Password';
      return;
    }

    // Set the session cookie server-side
    const { data: sessionData } = await supabase.auth.getSession();
    if (sessionData?.session) {
      await fetch('/api/auth/set-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          access_token: sessionData.session.access_token,
          refresh_token: sessionData.session.refresh_token,
        }),
      });
    }

    formCard.classList.add('hidden');
    const _l3 = document.documentElement.lang;
    successBanner.textContent = _l3 === 'el' ? 'Ο κωδικός ορίστηκε! Ανακατεύθυνση...' : _l3 === 'bg' ? 'Паролата е зададена! Пренасочване...' : _l3 === 'sr' ? 'Lozinka postavljena! Preusmeravanje...' : _l3 === 'tr' ? 'Şifre belirlendi! Yönlendiriliyor...' : _l3 === 'ro' ? 'Parolă setată! Redirecționare...' : 'Password set! Redirecting...';
    successBanner.classList.remove('hidden');

    setTimeout(() => { window.location.href = '/community/board'; }, 1500);
  });

  init();
</script>
