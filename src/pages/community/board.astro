---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getServiceClient } from '../../lib/supabase.ts';

const lang = (Astro.locals.lang ?? 'en') as string;
const isEl = lang === 'el';
const isBg = lang === 'bg';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';
const isLoggedIn = !!Astro.locals.session;
const currentUserId = Astro.locals.session?.user?.id ?? null;
const fbAppId = import.meta.env.PUBLIC_FACEBOOK_APP_ID ?? '';

const service = getServiceClient();

// Server-side: initial page of posts
const category = Astro.url.searchParams.get('category') ?? 'all';
const page = parseInt(Astro.url.searchParams.get('page') ?? '1');
const limit = 20;
const offset = (page - 1) * limit;

let query = service
  .from('community_posts')
  .select('*, profiles:author_id(avatar_url, role)', { count: 'exact' })
  .eq('is_hidden', false)
  .order('created_at', { ascending: false })
  .range(offset, offset + limit - 1);

if (category && category !== 'all') {
  query = query.eq('category', category);
}

const { data: posts, count: totalPosts } = await query;
const totalPages = Math.ceil((totalPosts ?? 0) / limit);

// Get user's likes for these posts
let userLikes: Set<string> = new Set();
if (currentUserId && posts?.length) {
  const { data: likes } = await service
    .from('community_likes')
    .select('post_id')
    .eq('user_id', currentUserId)
    .in('post_id', posts.map(p => p.id));
  for (const l of likes ?? []) {
    if (l.post_id) userLikes.add(l.post_id);
  }
}

// Get user profile for post composer
let userName = '';
let userAvatar = '';
if (currentUserId) {
  const { data: prof } = await service.from('profiles').select('full_name, avatar_url').eq('id', currentUserId).single();
  userName = prof?.full_name ?? '';
  userAvatar = prof?.avatar_url ?? '';
}

const categories = [
  { value: 'all', label: isEl ? 'Όλα' : isBg ? 'Всички' : isSr ? 'Sve' : isTr ? 'Tümü' : isRo ? 'Toate' : 'All', icon: '📋' },
  { value: 'general', label: isEl ? 'Γενικά' : isBg ? 'Общи' : isSr ? 'Opšte' : isTr ? 'Genel' : isRo ? 'General' : 'General', icon: '💬' },
  { value: 'tips', label: isEl ? 'Συμβουλές' : isBg ? 'Съвети' : isSr ? 'Saveti' : isTr ? 'İpuçları' : isRo ? 'Sfaturi' : 'Tips', icon: '💡' },
  { value: 'questions', label: isEl ? 'Ερωτήσεις' : isBg ? 'Въпроси' : isSr ? 'Pitanja' : isTr ? 'Sorular' : isRo ? 'Întrebări' : 'Questions', icon: '❓' },
  { value: 'events', label: isEl ? 'Εκδηλώσεις' : isBg ? 'Събития' : isSr ? 'Događaji' : isTr ? 'Etkinlikler' : isRo ? 'Evenimente' : 'Events', icon: '🎉' },
  { value: 'for_sale', label: isEl ? 'Πωλήσεις' : isBg ? 'Продажби' : isSr ? 'Prodaja' : isTr ? 'Satılık' : isRo ? 'De vânzare' : 'For Sale', icon: '🏷️' },
  { value: 'lost_found', label: isEl ? 'Απώλειες' : isBg ? 'Загубени и намерени' : isSr ? 'Izgubljeno i nađeno' : isTr ? 'Kayıp & Buluntu' : isRo ? 'Pierdut și Găsit' : 'Lost & Found', icon: '🔍' },
  { value: 'recommendations', label: isEl ? 'Προτάσεις' : isBg ? 'Препоръки' : isSr ? 'Preporuke' : isTr ? 'Öneriler' : isRo ? 'Recomandări' : 'Recommendations', icon: '⭐' },
  { value: 'photos', label: isEl ? 'Φωτογραφίες' : isBg ? 'Снимки' : isSr ? 'Fotografije' : isTr ? 'Fotoğraflar' : isRo ? 'Fotografii' : 'Photos', icon: '📸' },
  { value: 'weather', label: isEl ? 'Καιρός' : isBg ? 'Времето' : isSr ? 'Vreme' : isTr ? 'Hava Durumu' : isRo ? 'Vremea' : 'Weather', icon: '☀️' },
  { value: 'activities', label: isEl ? 'Δραστηριότητες' : isBg ? 'Дейности' : isSr ? 'Aktivnosti' : isTr ? 'Aktiviteler' : isRo ? 'Activități' : 'Activities', icon: '🏄' },
  { value: 'ferries', label: isEl ? 'Φέρι / Πλοία' : isBg ? 'Фериботи' : isSr ? 'Trajekti' : isTr ? 'Feribotlar' : isRo ? 'Feriboturi' : 'Ferries', icon: '⛴️' },
  { value: 'buses', label: isEl ? 'Λεωφορεία' : isBg ? 'Автобуси' : isSr ? 'Autobusi' : isTr ? 'Otobüsler' : isRo ? 'Autobuze' : 'Buses', icon: '🚌' },
  { value: 'beach', label: isEl ? 'Παραλία' : isBg ? 'Плаж' : isSr ? 'Plaža' : isTr ? 'Plaj' : isRo ? 'Plajă' : 'Beach', icon: '🏖️' },
];

const categoryLabels: Record<string, string> = {};
for (const c of categories) categoryLabels[c.value] = `${c.icon} ${c.label}`;

function getTimeSince(date: Date): string {
  const seconds = Math.floor((Date.now() - date.getTime()) / 1000);
  if (seconds < 60) return isEl ? 'μόλις τώρα' : isBg ? 'току-що' : isSr ? 'upravo' : isTr ? 'az önce' : isRo ? 'chiar acum' : 'just now';
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes}${isEl ? 'λ' : isBg ? 'м' : isSr ? 'm' : isTr ? 'd' : isRo ? 'm' : 'm'}`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours}${isEl ? 'ω' : isBg ? 'ч' : isSr ? 'č' : isTr ? 's' : isRo ? 'h' : 'h'}`;
  const days = Math.floor(hours / 24);
  if (days < 7) return `${days}${isEl ? 'μ' : isBg ? 'д' : isSr ? 'd' : isTr ? 'g' : isRo ? 'd' : 'd'}`;
  return date.toLocaleDateString();
}

const roleBadges: Record<string, { label: string; color: string }> = {
  super_admin: { label: isEl ? 'Διαχειριστής' : isBg ? 'Админ' : isSr ? 'Admin' : isTr ? 'Yönetici' : isRo ? 'Admin' : 'Admin', color: 'bg-red-100 text-red-700' },
  admin: { label: isEl ? 'Διαχειριστής' : isBg ? 'Админ' : isSr ? 'Admin' : isTr ? 'Yönetici' : isRo ? 'Admin' : 'Admin', color: 'bg-red-100 text-red-700' },
  property_owner: { label: isEl ? 'Ιδιοκτήτης' : isBg ? 'Собственик' : isSr ? 'Vlasnik' : isTr ? 'Mal Sahibi' : isRo ? 'Proprietar' : 'Owner', color: 'bg-blue-100 text-blue-700' },
  restaurant_owner: { label: isEl ? 'Εστιάτορας' : isBg ? 'Ресторант' : isSr ? 'Restoran' : isTr ? 'Restoran' : isRo ? 'Restaurant' : 'Restaurant', color: 'bg-amber-100 text-amber-700' },
};
---

<BaseLayout
  title={isEl ? 'Κοινότητα Κεραμωτής' : isBg ? 'Общност Керамоти' : isSr ? 'Zajednica Keramoti' : isTr ? 'Keramoti Topluluk Panosu' : isRo ? 'Panoul Comunității Keramoti' : 'Keramoti Community Board'}
  description={isEl ? 'Η κοινότητα της Κεραμωτής — μοιράσου, ρώτησε, ανακάλυψε' : isBg ? 'Общността на Керамоти — споделяй, питай, откривай' : isSr ? 'Zajednica Keramotija — deli, pitaj, otkrivaj' : isTr ? 'Keramoti topluluğu — paylaş, sor, keşfet' : isRo ? 'Comunitatea Keramoti — distribuie, întreabă, descoperă' : 'The Keramoti community — share, ask, discover'}
>
  <section class="bg-[#1a1a2e] py-12 sm:py-16">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2">{isEl ? 'Κοινότητα Κεραμωτής' : isBg ? 'Общност Керамоти' : isSr ? 'Zajednica Keramoti' : isTr ? 'Keramoti Topluluğu' : isRo ? 'Comunitatea Keramoti' : 'Keramoti Community'}</h1>
      <p class="text-gray-300">{isEl ? 'Μοιράσου εμπειρίες, ρώτησε, ανέβασε φωτογραφίες' : isBg ? 'Споделяйте преживявания, задавайте въпроси, качвайте снимки' : isSr ? 'Deli iskustva, postavljaj pitanja, kači fotografije' : isTr ? 'Deneyimlerinizi paylaşın, sorular sorun, fotoğraf yükleyin' : isRo ? 'Distribuie experiențe, pune întrebări, postează fotografii' : 'Share experiences, ask questions, post photos'}
      {!isLoggedIn ? (
        <a href="/community/join" class="inline-block mt-4 bg-[#c9a96e] text-white px-6 py-2.5 rounded-xl text-sm font-semibold hover:bg-[#b89556] transition-colors">
          {isEl ? 'Γίνε Μέλος' : isBg ? 'Присъединете се' : isSr ? 'Pridruži se' : isTr ? 'Topluluğa Katıl' : isRo ? 'Alătură-te Comunității' : 'Join the Community'}
        </a>
      ) : (
        <div class="flex items-center justify-center gap-3 mt-4">
          <a href="/community/profile" class="bg-white/10 text-white px-6 py-2.5 rounded-xl text-sm font-semibold hover:bg-white/20 transition-colors">
            {isEl ? 'Το Προφίλ Μου' : isBg ? 'Моят профил' : isSr ? 'Moj profil' : isTr ? 'Profilim' : isRo ? 'Profilul Meu' : 'My Profile'}
          </a>
          <button id="logout-btn" class="bg-white/5 text-gray-400 px-4 py-2.5 rounded-xl text-sm hover:bg-white/10 hover:text-white transition-colors border border-white/10">
            {isEl ? 'Αποσύνδεση' : isBg ? 'Изход' : isSr ? 'Odjava' : isTr ? 'Çıkış' : isRo ? 'Deconectare' : 'Log Out'}
          </button>
        </div>
      )}
    </div>
  </section>

  <section class="max-w-2xl mx-auto px-4 py-6">
    <!-- Category filters -->
    <div class="flex gap-2 overflow-x-auto pb-2 mb-6 scrollbar-hide">
      {categories.map(c => (
        <a href={`/community/board${c.value === 'all' ? '' : `?category=${c.value}`}`}
          class={`flex-shrink-0 px-3 py-1.5 rounded-full text-xs font-medium transition-colors ${category === c.value || (c.value === 'all' && !Astro.url.searchParams.get('category')) ? 'bg-[#1a1a2e] text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`}>
          {c.icon} {c.label}
        </a>
      ))}
    </div>

    {/* Post composer */}
    {isLoggedIn ? (
      <div class="bg-white rounded-2xl border border-gray-100 p-4 mb-6 shadow-sm">
        <form id="post-form">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-full bg-[#1a1a2e] flex items-center justify-center text-white text-sm font-bold flex-shrink-0 overflow-hidden">
              {userAvatar ? (
                <img src={userAvatar} alt="" class="w-full h-full object-cover" />
              ) : (
                userName ? userName[0].toUpperCase() : '?'
              )}
            </div>
            <div class="flex-1">
              <textarea
                name="body"
                rows="3"
                placeholder={isEl ? 'Τι θέλεις να μοιραστείς;' : isBg ? 'Какво мислите?' : isSr ? 'Šta vam je na umu?' : isTr ? 'Aklınızda ne var?' : isRo ? 'La ce te gândești?' : "What's on your mind?"}
                class="w-full text-sm text-gray-800 placeholder-gray-400 outline-none resize-none border-none p-0"
              ></textarea>
            </div>
          </div>

          {/* Photo preview area */}
          <div id="photo-preview" class="hidden flex gap-2 mt-3 flex-wrap"></div>

          <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-50">
            <div class="flex items-center gap-2">
              <select name="category" class="text-xs bg-gray-100 text-gray-600 px-3 py-1.5 rounded-full outline-none">
                {categories.filter(c => c.value !== 'all').map(c => (
                  <option value={c.value}>{c.icon} {c.label}</option>
                ))}
              </select>
              <label class="cursor-pointer text-xs text-gray-500 hover:text-gray-700 flex items-center gap-1 bg-gray-100 px-3 py-1.5 rounded-full">
                📷 {isEl ? 'Φωτο' : isBg ? 'Снимка' : isSr ? 'Foto' : isTr ? 'Fotoğraf' : isRo ? 'Foto' : 'Photo'}
                <input type="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple class="hidden" id="photo-input" />
              </label>
            </div>
            <button type="submit" class="bg-[#1a1a2e] text-white px-5 py-1.5 rounded-full text-xs font-semibold hover:bg-[#2d2d4e] transition-colors">
              {isEl ? 'Δημοσίευση' : isBg ? 'Публикувай' : isSr ? 'Objavi' : isTr ? 'Paylaş' : isRo ? 'Publică' : 'Post'}
            </button>
          </div>
          <p id="post-msg" class="text-xs mt-2 hidden"></p>
        </form>
      </div>
    ) : (
      <div class="bg-gray-50 rounded-2xl border border-gray-100 p-6 mb-6 text-center">
        <p class="text-sm text-gray-500 mb-3">{isEl ? 'Συνδέσου για να δημοσιεύσεις' : isBg ? 'Влезте, за да споделите с общността' : isSr ? 'Prijavite se da delite sa zajednicom' : isTr ? 'Toplulukla paylaşmak için giriş yapın' : isRo ? 'Autentifică-te pentru a distribui în comunitate' : 'Log in to share with the community'}</p>
        <div class="flex items-center justify-center gap-3 mb-3">
          <button id="board-google-login" type="button"
            class="flex items-center gap-2 bg-white border border-gray-200 text-gray-700 px-4 py-2 rounded-xl text-xs font-medium hover:bg-gray-50 transition-colors shadow-sm">
            <svg class="w-4 h-4" viewBox="0 0 24 24">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Google
          </button>
          <button id="board-facebook-login" type="button"
            class="flex items-center gap-2 bg-[#1877F2] text-white px-4 py-2 rounded-xl text-xs font-medium hover:bg-[#166FE5] transition-colors shadow-sm">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            Facebook
          </button>
        </div>
        <a href="/community/join" class="text-xs text-gray-400 hover:text-gray-600 transition-colors">{isEl ? 'ή με email' : isBg ? 'или с имейл' : isSr ? 'ili koristite email' : isTr ? 'veya e-posta kullanın' : isRo ? 'sau folosește email' : 'or use email'}</a>
      </div>
    )}

    {/* Posts feed */}
    <div class="space-y-4" id="posts-feed">
      {(!posts || posts.length === 0) ? (
        <div class="text-center py-16 text-gray-400">
          <div class="text-5xl mb-4">💬</div>
          <p class="text-lg font-medium">{isEl ? 'Καμία δημοσίευση ακόμα' : isBg ? 'Все още няма публикации' : isSr ? 'Još nema objava' : isTr ? 'Henüz gönderi yok' : isRo ? 'Nicio postare încă' : 'No posts yet'}</p>
          <p class="text-sm mt-1">{isEl ? 'Γίνε ο πρώτος!' : isBg ? 'Бъдете първият!' : isSr ? 'Budite prvi!' : isTr ? 'İlk siz paylaşın!' : isRo ? 'Fii primul care postează!' : 'Be the first to post!'}</p>
        </div>
      ) : (
        posts.map((post: any) => {
          const isLiked = userLikes.has(post.id);
          const isAuthor = post.author_id === currentUserId;
          const timeSince = getTimeSince(new Date(post.created_at));
          return (
          <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm post-card" data-id={post.id}>
            {/* Header */}
            <div class="px-4 pt-4 pb-2 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <a href={`/community/member/${post.author_id}`} class="w-9 h-9 rounded-full bg-gradient-to-br from-[#1a1a2e] to-[#2d2d4e] flex items-center justify-center text-white text-xs font-bold overflow-hidden flex-shrink-0">
                  {post.profiles?.avatar_url ? (
                    <img src={post.profiles.avatar_url} alt="" class="w-full h-full object-cover" />
                  ) : (
                    post.author_name?.[0]?.toUpperCase() ?? '?'
                  )}
                </a>
                <div>
                  <div class="flex items-center gap-1.5">
                    <a href={`/community/member/${post.author_id}`} class="text-sm font-semibold text-gray-900 hover:underline">{post.author_name}</a>
                    {post.profiles?.role && roleBadges[post.profiles.role] && (
                      <span class={`text-[9px] font-semibold px-1.5 py-0.5 rounded-full ${roleBadges[post.profiles.role].color}`}>{roleBadges[post.profiles.role].label}</span>
                    )}
                  </div>
                  <p class="text-[11px] text-gray-400">{timeSince} · {categoryLabels[post.category] ?? post.category}</p>
                </div>
              </div>
              <div class="flex items-center gap-1">
                {isAuthor && (
                  <button class="delete-post-btn text-gray-400 hover:text-red-500 p-1" data-id={post.id} title="Delete">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  </button>
                )}
                {isLoggedIn && !isAuthor && (
                  <button class="report-post-btn text-gray-400 hover:text-orange-500 p-1" data-id={post.id} title="Report">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2z"/></svg>
                  </button>
                )}
              </div>
            </div>

            {/* Body — clickable to post page */}
            <a href={`/community/board/${post.id}`} class="block px-4 pb-3 hover:bg-gray-50/50 transition-colors">
              {post.title && <h3 class="font-semibold text-gray-900 mb-1">{post.title}</h3>}
              <p class="text-sm text-gray-700 whitespace-pre-line line-clamp-6">{post.body}</p>
            </a>

            {/* Photos — clickable lightbox */}
            {post.photo_urls?.length > 0 && (
              <div class={`${post.photo_urls.length === 1 ? '' : 'grid grid-cols-2 gap-0.5'} relative`}>
                {post.photo_urls.slice(0, 4).map((url: string, idx: number) => (
                  <img src={url} alt="" class={`w-full object-cover cursor-pointer lightbox-trigger ${post.photo_urls.length === 1 ? 'max-h-96' : 'aspect-square'}`} loading="lazy" data-photos={JSON.stringify(post.photo_urls)} data-index={idx} />
                ))}
                {post.photo_urls.length > 4 && (
                  <a href={`/community/board/${post.id}`} class="absolute bottom-2 right-2 bg-black/60 text-white text-xs font-semibold px-2.5 py-1 rounded-full">+{post.photo_urls.length - 4}</a>
                )}
              </div>
            )}

            {/* Actions bar */}
            <div class="px-4 py-2.5 border-t border-gray-50 flex items-center gap-5">
              <button class={`like-btn flex items-center gap-1.5 text-xs font-medium transition-colors ${isLiked ? 'text-red-500' : 'text-gray-500 hover:text-red-500'}`} data-id={post.id} data-liked={isLiked}>
                <svg class="w-4 h-4" fill={isLiked ? 'currentColor' : 'none'} stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                <span class="like-count">{post.like_count || ''}</span>
              </button>
              <a href={`/community/board/${post.id}`} class="flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-[#1a1a2e] transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                {post.comment_count || ''} {post.comment_count === 1 ? (isEl ? 'σχόλιο' : isBg ? 'коментар' : isSr ? 'komentar' : isTr ? 'yorum' : isRo ? 'comentariu' : 'comment') : (isEl ? 'σχόλια' : isBg ? 'коментара' : isSr ? 'komentara' : isTr ? 'yorum' : isRo ? 'comentarii' : 'comments')}
              </a>
              <button class="share-btn flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-[#1a1a2e] transition-colors ml-auto" data-url={`/community/board/${post.id}`} data-title={post.title || post.body?.slice(0, 80)}>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z" /></svg>
                {isEl ? '' : ''}
              </button>
            </div>
          </div>
          );
        })
      )}
    </div>

    {/* Pagination */}
    {totalPages > 1 && (
      <div class="flex items-center justify-center gap-2 mt-8">
        {page > 1 && (
          <a href={`/community/board?page=${page - 1}${category !== 'all' ? `&category=${category}` : ''}`}
            class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm hover:bg-gray-200">
            {isEl ? '← Προηγούμενη' : isBg ? '← Предишна' : isSr ? '← Prethodna' : isTr ? '← Önceki' : isRo ? '← Anterioară' : '← Previous'}
          </a>
        )}
        <span class="text-sm text-gray-500">{page} / {totalPages}</span>
        {page < totalPages && (
          <a href={`/community/board?page=${page + 1}${category !== 'all' ? `&category=${category}` : ''}`}
            class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm hover:bg-gray-200">
            {isEl ? 'Επόμενη →' : isBg ? 'Следваща →' : isSr ? 'Sledeća →' : isTr ? 'Sonraki →' : isRo ? 'Următoarea →' : 'Next →'}
          </a>
        )}
      </div>
    )}
  </section>

  <div id="i18n-data" class="hidden"
    data-write-something={isEl ? 'Γράψε κάτι!' : isBg ? 'Напишете нещо!' : isSr ? 'Napišite nešto!' : isTr ? 'Bir şeyler yazın!' : isRo ? 'Scrie ceva!' : 'Write something!'}
    data-failed={isEl ? 'Αποτυχία' : isBg ? 'Грешка' : isSr ? 'Neuspeh' : isTr ? 'Başarısız' : isRo ? 'Eșuat' : 'Failed'}
    data-network-error={isEl ? 'Σφάλμα δικτύου' : isBg ? 'Мрежова грешка' : isSr ? 'Mrežna greška' : isTr ? 'Ağ hatası' : isRo ? 'Eroare de rețea' : 'Network error'}
    data-delete-post={isEl ? 'Διαγραφή αυτής της δημοσίευσης;' : isBg ? 'Изтриване на тази публикация?' : isSr ? 'Obrisati ovu objavu?' : isTr ? 'Bu gönderi silinsin mi?' : isRo ? 'Ștergi această postare?' : 'Delete this post?'}
    data-report-prompt={isEl ? 'Γιατί αναφέρετε αυτή τη δημοσίευση;' : isBg ? 'Защо докладвате тази публикация?' : isSr ? 'Zašto prijavljujete ovu objavu?' : isTr ? 'Bu gönderiyi neden bildiriyorsunuz?' : isRo ? 'De ce raportezi această postare?' : 'Why are you reporting this post?'}
    data-report-thanks={isEl ? 'Η αναφορά υποβλήθηκε. Ευχαριστούμε.' : isBg ? 'Докладът е изпратен. Благодарим.' : isSr ? 'Prijava poslata. Hvala.' : isTr ? 'Bildirim gönderildi. Teşekkürler.' : isRo ? 'Raport trimis. Mulțumim.' : 'Report submitted. Thank you.'}
    data-fb-failed={isEl ? 'Η σύνδεση με Facebook απέτυχε' : isBg ? 'Входът с Facebook не бе успешен' : isSr ? 'Facebook prijava neuspešna' : isTr ? 'Facebook girişi başarısız' : isRo ? 'Autentificarea Facebook a eșuat' : 'Facebook login failed'}
    data-copied={isEl ? 'Αντιγράφηκε!' : isBg ? 'Копирано!' : isSr ? 'Kopirano!' : isTr ? 'Kopyalandı!' : isRo ? 'Copiat!' : 'Copied!'}
    data-copy={isEl ? 'Αντιγραφή' : isBg ? 'Копиране' : isSr ? 'Kopiraj' : isTr ? 'Kopyala' : isRo ? 'Copiază' : 'Copy'}
  ></div>

  <!-- Photo lightbox -->
  <div id="lightbox" class="hidden fixed inset-0 z-50 bg-black/90 flex items-center justify-center p-4" role="dialog">
    <button id="lb-close" class="absolute top-4 right-4 text-white/70 hover:text-white text-3xl z-10">&times;</button>
    <button id="lb-prev" class="absolute left-4 text-white/70 hover:text-white text-4xl z-10 hidden">&#8249;</button>
    <button id="lb-next" class="absolute right-4 text-white/70 hover:text-white text-4xl z-10 hidden">&#8250;</button>
    <img id="lb-img" src="" alt="" class="max-w-full max-h-[90vh] object-contain rounded-lg" />
  </div>

  <!-- Share popup -->
  <div id="share-popup" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/40 p-4" role="dialog">
    <div class="bg-white rounded-2xl w-full max-w-sm p-5 shadow-xl">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-semibold text-gray-900 text-sm">{isEl ? 'Κοινοποίηση' : isBg ? 'Споделяне' : isSr ? 'Podeli' : isTr ? 'Paylaş' : isRo ? 'Distribuie' : 'Share'}</h3>
        <button id="share-close" class="text-gray-400 hover:text-gray-600 text-xl">&times;</button>
      </div>
      <div class="grid grid-cols-4 gap-3" id="share-buttons">
        <button data-platform="facebook" class="flex flex-col items-center gap-1.5 p-3 rounded-xl hover:bg-gray-50 transition-colors">
          <div class="w-10 h-10 rounded-full bg-[#1877F2] flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </div>
          <span class="text-[10px] text-gray-600">Facebook</span>
        </button>
        <button data-platform="twitter" class="flex flex-col items-center gap-1.5 p-3 rounded-xl hover:bg-gray-50 transition-colors">
          <div class="w-10 h-10 rounded-full bg-black flex items-center justify-center">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </div>
          <span class="text-[10px] text-gray-600">X</span>
        </button>
        <button data-platform="whatsapp" class="flex flex-col items-center gap-1.5 p-3 rounded-xl hover:bg-gray-50 transition-colors">
          <div class="w-10 h-10 rounded-full bg-[#25D366] flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492l4.625-1.47A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818c-2.168 0-4.178-.577-5.923-1.586l-.424-.254-2.742.872.87-2.649-.277-.44A9.782 9.782 0 012.182 12c0-5.422 4.396-9.818 9.818-9.818 5.422 0 9.818 4.396 9.818 9.818 0 5.422-4.396 9.818-9.818 9.818z"/></svg>
          </div>
          <span class="text-[10px] text-gray-600">WhatsApp</span>
        </button>
        <button data-platform="copy" class="flex flex-col items-center gap-1.5 p-3 rounded-xl hover:bg-gray-50 transition-colors">
          <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center">
            <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m9.86-2.44a4.5 4.5 0 0 0-1.242-7.244l-4.5-4.5a4.5 4.5 0 0 0-6.364 6.364L5.25 9.56" /></svg>
          </div>
          <span class="text-[10px] text-gray-600" id="copy-label">{isEl ? 'Αντιγραφή' : isBg ? 'Копиране' : isSr ? 'Kopiraj' : isTr ? 'Kopyala' : isRo ? 'Copiază' : 'Copy'}</span>
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<!-- Facebook JS SDK (only for logged-out users) -->
{!isLoggedIn && (
  <script is:inline define:vars={{ fbAppId }}>
    window.fbAsyncInit = function() {
      FB.init({ appId: fbAppId, cookie: true, xfbml: false, version: 'v21.0' });
    };
    (function(d, s, id) {
      var js, fjs = d.getElementsByTagName(s)[0];
      if (d.getElementById(id)) return;
      js = d.createElement(s); js.id = id;
      js.src = 'https://connect.facebook.net/en_US/sdk.js';
      fjs.parentNode.insertBefore(js, fjs);
    }(document, 'script', 'facebook-jssdk'));
  </script>
)}

<script>
  import { createClient } from '@supabase/supabase-js';

  const sbClient = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );
  const siteUrl = import.meta.env.PUBLIC_SITE_URL || window.location.origin;
  const _i18n = document.getElementById('i18n-data')?.dataset ?? {};

  // Google login (Supabase OAuth redirect)
  document.getElementById('board-google-login')?.addEventListener('click', async () => {
    await sbClient.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: `${siteUrl}/api/auth/oauth-callback` },
    });
  });

  // Facebook login (FB JS SDK → opens native app on mobile)
  document.getElementById('board-facebook-login')?.addEventListener('click', () => {
    const btn = document.getElementById('board-facebook-login') as HTMLButtonElement;
    btn.textContent = '...';
    btn.disabled = true;
    (window as any).FB.login(async (response: any) => {
      if (response.authResponse) {
        const res = await fetch('/api/auth/facebook-token', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ access_token: response.authResponse.accessToken }),
        });
        if (res.ok) {
          window.location.href = '/community/board';
        } else {
          alert(_i18n.fbFailed || 'Facebook login failed');
          btn.textContent = 'Facebook';
          btn.disabled = false;
        }
      } else {
        btn.textContent = 'Facebook';
        btn.disabled = false;
      }
    }, { scope: 'public_profile,email', auth_type: 'rerequest' });
  });

  const isLoggedIn = document.getElementById('post-form') !== null;

  // Logout
  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    window.location.href = '/community/board';
  });

  // ── Post creation ──────────────────────────────────────────────────────────
  const uploadedUrls: string[] = [];

  document.getElementById('photo-input')?.addEventListener('change', async (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (!files) return;
    const preview = document.getElementById('photo-preview')!;
    preview.classList.remove('hidden');

    for (const file of Array.from(files)) {
      if (uploadedUrls.length >= 5) break;
      const fd = new FormData();
      fd.append('file', file);

      const placeholder = document.createElement('div');
      placeholder.className = 'w-20 h-20 rounded-lg bg-gray-100 flex items-center justify-center text-xs text-gray-400';
      placeholder.textContent = '...';
      preview.appendChild(placeholder);

      try {
        const res = await fetch('/api/community/upload', { method: 'POST', body: fd });
        const data = await res.json();
        if (res.ok) {
          uploadedUrls.push(data.url);
          placeholder.innerHTML = `<img src="${data.url}" class="w-20 h-20 rounded-lg object-cover" />`;
        } else {
          placeholder.textContent = 'Error';
          placeholder.classList.add('text-red-500');
        }
      } catch {
        placeholder.textContent = 'Error';
      }
    }
  });

  document.getElementById('post-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const fd = new FormData(form);
    const msg = document.getElementById('post-msg')!;
    const body = (fd.get('body') as string)?.trim();

    if (!body) {
      msg.textContent = _i18n.writeSomething || 'Write something!';
      msg.className = 'text-xs mt-2 text-red-600';
      return;
    }

    try {
      const res = await fetch('/api/community/posts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          body,
          category: fd.get('category'),
          photo_urls: uploadedUrls,
        }),
      });
      if (res.ok) {
        location.reload();
      } else {
        const data = await res.json();
        msg.textContent = data.error || _i18n.failed || 'Failed';
        msg.className = 'text-xs mt-2 text-red-600';
      }
    } catch {
      msg.textContent = _i18n.networkError || 'Network error';
      msg.className = 'text-xs mt-2 text-red-600';
    }
  });

  // ── Like toggle ────────────────────────────────────────────────────────────
  document.querySelectorAll('.like-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!isLoggedIn) { window.location.href = '/community/join'; return; }
      const postId = (btn as HTMLElement).dataset.id;
      const wasLiked = (btn as HTMLElement).dataset.liked === 'true';
      const countEl = btn.querySelector('.like-count') as HTMLElement;
      const svg = btn.querySelector('svg')!;

      try {
        const res = await fetch('/api/community/posts/like', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ post_id: postId }),
        });
        if (res.ok) {
          const data = await res.json();
          (btn as HTMLElement).dataset.liked = String(data.liked);
          const current = parseInt(countEl.textContent || '0');
          countEl.textContent = String(data.liked ? current + 1 : Math.max(0, current - 1)) || '';
          btn.classList.toggle('text-red-500', data.liked);
          btn.classList.toggle('text-gray-500', !data.liked);
          svg.setAttribute('fill', data.liked ? 'currentColor' : 'none');
        }
      } catch {}
    });
  });

  // ── Delete post ────────────────────────────────────────────────────────────
  document.querySelectorAll('.delete-post-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm(_i18n.deletePost || 'Delete this post?')) return;
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch(`/api/community/posts/${id}`, { method: 'DELETE' });
      if (res.ok) (btn as HTMLElement).closest('.post-card')?.remove();
    });
  });

  // ── Report post ────────────────────────────────────────────────────────────
  document.querySelectorAll('.report-post-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const reason = prompt(_i18n.reportPrompt || 'Why are you reporting this post?');
      if (!reason?.trim()) return;
      const id = (btn as HTMLElement).dataset.id;
      await fetch('/api/community/posts/report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ post_id: id, reason: reason.trim() }),
      });
      alert(_i18n.reportThanks || 'Report submitted. Thank you.');
    });
  });

  // ── Photo lightbox ────────────────────────────────────────────────────────
  const lightbox = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbPrev = document.getElementById('lb-prev')!;
  const lbNext = document.getElementById('lb-next')!;
  let lbPhotos: string[] = [];
  let lbIndex = 0;

  function lbShow(photos: string[], index: number) {
    lbPhotos = photos;
    lbIndex = index;
    lbImg.src = photos[index];
    lbPrev.classList.toggle('hidden', photos.length <= 1);
    lbNext.classList.toggle('hidden', photos.length <= 1);
    lightbox.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function lbHide() {
    lightbox.classList.add('hidden');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.lightbox-trigger').forEach(img => {
    img.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const el = e.currentTarget as HTMLElement;
      const photos = JSON.parse(el.dataset.photos || '[]');
      const idx = parseInt(el.dataset.index || '0');
      lbShow(photos, idx);
    });
  });

  document.getElementById('lb-close')?.addEventListener('click', lbHide);
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) lbHide(); });
  lbPrev.addEventListener('click', () => { lbIndex = (lbIndex - 1 + lbPhotos.length) % lbPhotos.length; lbImg.src = lbPhotos[lbIndex]; });
  lbNext.addEventListener('click', () => { lbIndex = (lbIndex + 1) % lbPhotos.length; lbImg.src = lbPhotos[lbIndex]; });
  document.addEventListener('keydown', (e) => {
    if (lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') lbHide();
    if (e.key === 'ArrowLeft') lbPrev.click();
    if (e.key === 'ArrowRight') lbNext.click();
  });

  // ── Share popup ───────────────────────────────────────────────────────────
  const sharePopup = document.getElementById('share-popup')!;
  let shareUrl = '';
  let shareTitle = '';

  document.querySelectorAll('.share-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const el = e.currentTarget as HTMLElement;
      shareUrl = window.location.origin + el.dataset.url;
      shareTitle = el.dataset.title || 'Keramoti Community';

      // Try native share on mobile
      if (navigator.share) {
        navigator.share({ title: shareTitle, url: shareUrl }).catch(() => {});
        return;
      }
      sharePopup.classList.remove('hidden');
    });
  });

  document.getElementById('share-close')?.addEventListener('click', () => sharePopup.classList.add('hidden'));
  sharePopup.addEventListener('click', (e) => { if (e.target === sharePopup) sharePopup.classList.add('hidden'); });

  document.querySelectorAll('#share-buttons button').forEach(btn => {
    btn.addEventListener('click', () => {
      const platform = (btn as HTMLElement).dataset.platform;
      const encoded = encodeURIComponent(shareUrl);
      const text = encodeURIComponent(shareTitle);
      if (platform === 'facebook') window.open(`https://www.facebook.com/sharer/sharer.php?u=${encoded}`, '_blank', 'width=600,height=400');
      else if (platform === 'twitter') window.open(`https://twitter.com/intent/tweet?url=${encoded}&text=${text}`, '_blank', 'width=600,height=400');
      else if (platform === 'whatsapp') window.open(`https://wa.me/?text=${text}%20${encoded}`, '_blank');
      else if (platform === 'copy') {
        navigator.clipboard.writeText(shareUrl).then(() => {
          const label = document.getElementById('copy-label');
          if (label) { label.textContent = _i18n.copied || 'Copied!'; setTimeout(() => label.textContent = _i18n.copy || 'Copy', 2000); }
        });
        return; // don't close
      }
      sharePopup.classList.add('hidden');
    });
  });
</script>
