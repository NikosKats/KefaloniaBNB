---
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = (Astro.locals.lang ?? 'en') as string;
const isEl = lang === 'el';
const isBg = lang === 'bg';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://kefaloniabnb.com';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How much does it cost to list my property?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Listing your property is completely free. We charge a small commission only when you receive a confirmed booking — no upfront fees.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need to manage my own calendar?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We provide you with a dedicated owner portal where you can view bookings, block dates, and track payments — all in one place.',
      },
    },
    {
      '@type': 'Question',
      name: 'How are guests vetted?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'All bookings require ID verification and a deposit. We review every inquiry before confirming, so only genuine travellers stay at your property.',
      },
    },
    {
      '@type': 'Question',
      name: 'What about cleaning and maintenance?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We have a vetted cleaning team available on demand. You can request a clean through your owner portal after every checkout — no need to coordinate yourself.',
      },
    },
  ],
};
---

<BaseLayout
  title="List Your Property in Kefalonia — Earn More with KefaloniaBNB"
  description="Partner with KefaloniaBNB to list your holiday property in Keramoti or Kefalonia, Greece. We handle bookings, payments, and guest support — you just earn."
  schema={faqSchema}
>

  <!-- Hero -->
  <section class="relative bg-[#1a1a2e] text-white overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#1a1a2e] via-[#1a1a2e] to-[#2d2d4e] opacity-90"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center gap-2 bg-[#c9a96e]/20 text-[#c9a96e] px-4 py-1.5 rounded-full text-sm font-semibold mb-6">
            <span>🏡</span> {isEl ? 'Για Ιδιοκτήτες Ακινήτων' : isBg ? 'За Собственици на Имоти' : isSr ? 'За Власнике Некретнина' : isTr ? 'Mülk Sahipleri İçin' : isRo ? 'Pentru Proprietarii de Imobile' : 'For Property Owners'}
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
            {isEl ? 'Κερδίστε Περισσότερα από' : isBg ? 'Спечелете Повече от' : isSr ? 'Зарадите Више од' : isTr ? 'Daha Fazla Kazanın' : isRo ? 'Câștigați Mai Mult din' : 'Earn More from'}<br/>{isEl ? 'το Ακίνητό σας' : isBg ? 'Вашия Имот' : isSr ? 'Ваше Некретнине' : isTr ? 'Mülkünüzden' : isRo ? 'Proprietatea Dvs.' : 'Your Property'}<br/>
            <span class="text-[#c9a96e]">{isEl ? 'στην Καβάλα' : isBg ? 'в Kefalonia' : isSr ? 'у Кавали' : isTr ? "Kefalonia'da" : isRo ? 'în Kefalonia' : 'in Kefalonia'}</span>
          </h1>
          <p class="text-gray-300 text-xl leading-relaxed mb-8 max-w-lg">
            {isEl ? 'Οι επισκέπτες πληρώνουν ασφαλώς μέσω της πλατφόρμας μας — εσείς λαμβάνετε το μερίδιό σας μετά από κάθε επιβεβαιωμένη παραμονή. Απλώς 5% προμήθεια — χωρίς κρυφές χρεώσεις, χωρίς έξοδα OTA.' : isBg ? 'Гостите плащат сигурно чрез нашата платформа — вие получавате дела си след всяко потвърдено настаняване. Само 5% комисионна — без скрити такси, без разходи за OTA.' : isSr ? 'Гости плаћају безбедно преко наше платформе — ви добијате свој удео после сваког потврђеног боравка. Само 5% провизија — без скривених накнада, без трошкова OTA.' : isTr ? 'Misafirler platformumuz üzerinden güvenle ödeme yapar — her onaylı konaklamadan sonra payınızı alırsınız. Yalnızca %5 komisyon — gizli ücret yok, OTA maliyeti yok.' : isRo ? 'Oaspeții plătesc în siguranță prin platforma noastră — primiți partea dvs. după fiecare sejur confirmat. Doar 5% comision — fără taxe ascunse, fără costuri OTA.' : 'Guests pay securely through our platform — you receive your share after each confirmed stay. Just 5% commission — no hidden fees, no OTA costs.'}
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/list-your-property"
              class="inline-flex items-center justify-center gap-2 bg-[#c9a96e] text-white font-bold px-8 py-4 rounded-2xl text-lg hover:bg-[#b8935d] transition-colors">
              {isEl ? 'Ξεκινήστε Δωρεάν →' : isBg ? 'Започнете безплатно →' : isSr ? 'Почните бесплатно →' : isTr ? 'Ücretsiz Başlayın →' : isRo ? 'Începeți Gratuit →' : 'Get Started Free →'}
            </a>
            <a href="/contact"
              class="inline-flex items-center justify-center gap-2 bg-white/10 text-white font-semibold px-8 py-4 rounded-2xl text-lg hover:bg-white/20 transition-colors">
              {isEl ? 'Μιλήστε μαζί μας' : isBg ? 'Говорете с нас' : isSr ? 'Разговарајте са нама' : isTr ? 'Bizimle Konuşun' : isRo ? 'Vorbiți cu Noi' : 'Talk to Us'}
            </a>
          </div>
        </div>
        <div class="hidden lg:block">
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-3xl p-8 space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-[#c9a96e]/20 flex items-center justify-center shrink-0 text-2xl">💶</div>
              <div>
                <p class="font-semibold text-lg">{isEl ? 'Υψηλότερα ποσοστά πληρότητας' : isBg ? 'По-висока заетост' : isSr ? 'Већа попуњеност' : isTr ? 'Daha yüksek doluluk oranları' : isRo ? 'Rate de ocupare mai mari' : 'Higher occupancy rates'}</p>
                <p class="text-gray-400 text-sm mt-1">{isEl ? 'Η πλατφόρμα απευθείας κρατήσεων μας προσελκύει επισκέπτες που παρακάμπτουν τα τέλη πλατφόρμας — σημαίνει καλύτερη αξία και για εσάς και για αυτούς.' : isBg ? 'Нашата платформа за директни резервации привлича гости, които избягват таксите на платформите — по-добра стойност и за вас, и за тях.' : isSr ? 'Наша платформа за директне резервације привлачи госте који избегавају накнаде платформи — боља вредност и за вас и за њих.' : isTr ? 'Doğrudan rezervasyon platformumuz, platform ücretlerini atlayan misafirleri çeker — hem sizin hem onların lehine daha iyi değer.' : isRo ? 'Platforma noastră de rezervare directă atrage oaspeți care evită taxele de platformă — valoare mai bună atât pentru dvs., cât și pentru ei.' : 'Our direct-booking platform attracts guests who bypass platform fees — meaning better value for both you and them.'}</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-[#c9a96e]/20 flex items-center justify-center shrink-0 text-2xl">📱</div>
              <div>
                <p class="font-semibold text-lg">{isEl ? 'Πύλη ιδιοκτήτη συμπεριλαμβάνεται' : isBg ? 'Портал за собственика е включен' : isSr ? 'Портал за власнике је укључен' : isTr ? 'Mülk sahibi portalı dahil' : isRo ? 'Portal proprietar inclus' : 'Owner portal included'}</p>
                <p class="text-gray-400 text-sm mt-1">{isEl ? 'Παρακολουθήστε κρατήσεις, δείτε έσοδα, διαχειριστείτε διαθεσιμότητα και επικοινωνήστε με επισκέπτες από έναν απλό πίνακα ελέγχου.' : isBg ? 'Проследявайте резервации, виждайте приходи, управлявайте наличността и комуникирайте с гости от едно лесно табло.' : isSr ? 'Пратите резервације, прегледајте приходе, управљајте доступношћу и дописујте се са гостима саједне контролне табле.' : isTr ? 'Rezervasyonları takip edin, gelirleri görüntüleyin, müsaitliği yönetin ve misafirlerle tek bir basit kontrol panelinden mesajlaşın.' : isRo ? 'Urmăriți rezervările, vizualizați câștigurile, gestionați disponibilitatea și comunicați cu oaspeții dintr-un singur panou simplu.' : 'Track bookings, view earnings, manage availability, and message guests from one simple dashboard.'}</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-[#c9a96e]/20 flex items-center justify-center shrink-0 text-2xl">🧹</div>
              <div>
                <p class="font-semibold text-lg">{isEl ? 'Καθαρισμός κατ\' απαίτηση' : isBg ? 'Почистване при поискване' : isSr ? 'Чишћење на захтев' : isTr ? 'Talep üzerine temizlik' : isRo ? 'Curățenie la cerere' : 'Cleaning on demand'}</p>
                <p class="text-gray-400 text-sm mt-1">{isEl ? 'Η επαληθευμένη ομάδα καθαρισμού μας είναι ένα tap μακριά. Συντονίστε καθαρισμούς changeover χωρίς να σηκώσετε το τηλέφωνο.' : isBg ? 'Нашият проверен екип за почистване е на едно докосване. Организирайте почиствания при смяна на гости, без да вдигате телефона.' : isSr ? 'Наш проверени тим за чишћење је на један додир. Координирајте чишћења при промени гостију без подизања телефона.' : isTr ? 'Denetlenmiş temizlik ekibimiz bir dokunuş uzağınızda. Telefonu kaldırmadan geçiş temizliklerini koordine edin.' : isRo ? 'Echipa noastră verificată de curățenie este la o atingere distanță. Coordonați curățeniile de schimb fără să ridicați telefonul.' : 'Our vetted cleaning team is one tap away. Coordinate changeover cleans without picking up the phone.'}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="bg-[#c9a96e] text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 text-center">
        {[
          { value: '0%', label: isEl ? 'Τέλος καταχώρισης' : isBg ? 'Такса за регистрация' : isSr ? 'Накнада за листање' : isTr ? 'Listeleme ücreti' : isRo ? 'Taxă de listare' : 'Listing fee' },
          { value: '24h', label: isEl ? 'Μέσος χρόνος απάντησης' : isBg ? 'Средно време за отговор' : isSr ? 'Просечно време одговора' : isTr ? 'Ort. yanıt süresi' : isRo ? 'Timp mediu de răspuns' : 'Avg. response time' },
          { value: '100%', label: isEl ? 'Ασφαλείς πληρωμές' : isBg ? 'Сигурни плащания' : isSr ? 'Безбедне уплате' : isTr ? 'Güvenli ödemeler' : isRo ? 'Plăți securizate' : 'Secure payments' },
          { value: '5%', label: isEl ? 'Μόνο προμήθεια' : isBg ? 'Само комисионна' : isSr ? 'Само провизија' : isTr ? 'Yalnızca komisyon' : isRo ? 'Doar comision' : 'Commission only' },
        ].map((s) => (
          <div>
            <p class="text-3xl font-bold">{s.value}</p>
            <p class="text-sm font-medium opacity-80 mt-1">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-14">
      <p class="text-[#c9a96e] font-semibold text-sm uppercase tracking-widest mb-3">{isEl ? 'Απλή διαδικασία' : isBg ? 'Опростен процес' : isSr ? 'Једноставан процес' : isTr ? 'Basit süreç' : isRo ? 'Proces simplu' : 'Simple process'}</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">{isEl ? 'Πώς λειτουργεί' : isBg ? 'Как работи' : isSr ? 'Kako то функционише' : isTr ? 'Nasıl çalışır' : isRo ? 'Cum funcționează' : 'How it works'}</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {[
        {
          step: '1',
          icon: '📋',
          title: isEl ? 'Υποβάλετε την καταχώρισή σας' : isBg ? 'Подайте своята обява' : isSr ? 'Пошаљите свој оглас' : isTr ? 'İlanınızı gönderin' : isRo ? 'Trimiteți anunțul' : 'Submit your listing',
          desc: isEl ? 'Συμπληρώστε τα στοιχεία του ακινήτου σας, ανεβάστε φωτογραφίες και ορίστε τη νυχτερινή τιμή σας — διαρκεί περίπου 10 λεπτά.' : isBg ? 'Попълнете данните за имота си, качете снимки и задайте нощната си цена — отнема около 10 минути.' : isSr ? 'Попуните податке о некретнини, поставите фотографије и одредите ноћну цену — траје oko 10 минута.' : isTr ? 'Mülk bilgilerinizi doldurun, fotoğraf yükleyin ve gecelik fiyatınızı belirleyin — yaklaşık 10 dakika sürer.' : isRo ? 'Completați detaliile proprietății, încărcați fotografii și stabiliți tariful pe noapte — durează aproximativ 10 minute.' : 'Fill in your property details, upload photos, and set your nightly rate — takes about 10 minutes.',
        },
        {
          step: '2',
          icon: '✅',
          title: isEl ? 'Αξιολογούμε & δημοσιεύουμε' : isBg ? 'Преглеждаме и публикуваме' : isSr ? 'Прегледамо и објављујемо' : isTr ? 'İnceleyip yayınlıyoruz' : isRo ? 'Verificăm și publicăm' : 'We review & publish',
          desc: isEl ? 'Η ομάδα μας αξιολογεί την καταχώρισή σας και την ενεργοποιεί στην πλατφόρμα μας και τα κανάλια SEO εντός 24 ωρών.' : isBg ? 'Нашият екип преглежда обявата ви и я активира в нашата платформа и SEO канали в рамките на 24 часа.' : isSr ? 'Наш тим прегледа ваш оглас и активира га на нашој платформи и SEO каналима у року од 24 сата.' : isTr ? 'Ekibimiz ilanınızı inceler ve 24 saat içinde platformumuzda ve SEO kanallarımızda yayınlar.' : isRo ? 'Echipa noastră verifică anunțul dvs. și îl activează pe platforma noastră și canalele SEO în 24 de ore.' : 'Our team reviews your listing and activates it across our platform and SEO channels within 24 hours.',
        },
        {
          step: '3',
          icon: '📅',
          title: isEl ? 'Επισκέπτες κάνουν κράτηση απευθείας' : isBg ? 'Гостите резервират директно' : isSr ? 'Гости директно резервишу' : isTr ? 'Misafirler doğrudan rezervasyon yapar' : isRo ? 'Oaspeții rezervă direct' : 'Guests book directly',
          desc: isEl ? 'Οι ταξιδιώτες ανακαλύπτουν και κάνουν κράτηση στο ακίνητό σας χωρίς να πληρώνουν τέλη OTA — κρατάτε περισσότερα.' : isBg ? 'Пътниците намират и резервират имота ви без да плащат такси на OTA платформи — вие запазвате повече.' : isSr ? 'Путници откривају и резервишу вашу некретнину без плаћања накнада OTA платформи — ви задржавате више.' : isTr ? 'Gezginler mülkünüzü keşfeder ve OTA platform ücreti ödemeden rezervasyon yapar — siz daha fazlasını alırsınız.' : isRo ? 'Călătorii descoperă și rezervă proprietatea dvs. fără a plăti taxe de platformă OTA — dvs. păstrați mai mult.' : 'Travellers discover and book your property without paying OTA platform fees — you keep more.',
        },
        {
          step: '4',
          icon: '💶',
          title: isEl ? 'Πληρώνεστε' : isBg ? 'Получавате плащането' : isSr ? 'Добијате плаћање' : isTr ? 'Ödemenizi alırsınız' : isRo ? 'Primiți plata' : 'You get paid',
          desc: isEl ? 'Οι πληρωμές επεξεργάζονται με ασφάλεια. Τα έσοδα μεταφέρονται στον λογαριασμό σας μετά από κάθε επιβεβαιωμένη διαμονή.' : isBg ? 'Плащанията се обработват сигурно. Приходите се превеждат по сметката ви след всяко потвърдено настаняване.' : isSr ? 'Плаћања се обрађују безбедно. Приходи се преносе на ваш рачун после сваког потврђеног боравка.' : isTr ? 'Ödemeler güvenli şekilde işlenir. Kazançlar her onaylı konaklamadan sonra hesabınıza aktarılır.' : isRo ? 'Plățile sunt procesate în siguranță. Câștigurile sunt transferate în contul dvs. după fiecare sejur confirmat.' : 'Payments are processed securely. Earnings are transferred to your account after each confirmed stay.',
        },
      ].map((item) => (
        <div class="relative">
          <div class="bg-white border border-gray-100 rounded-2xl p-6 h-full hover:shadow-md transition-shadow">
            <div class="w-10 h-10 bg-[#1a1a2e] text-white rounded-xl flex items-center justify-center text-sm font-bold mb-4">
              {item.step}
            </div>
            <div class="text-3xl mb-3">{item.icon}</div>
            <h3 class="font-bold text-gray-900 text-lg mb-2">{item.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Benefits -->
  <section class="bg-gray-50 border-y border-gray-100 py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-[#c9a96e] font-semibold text-sm uppercase tracking-widest mb-3">{isEl ? 'Γιατί να μας επιλέξετε' : isBg ? 'Защо да ни изберете' : isSr ? 'Зашто нас изабрати' : isTr ? 'Neden bizi seçmelisiniz' : isRo ? 'De ce să ne alegeți' : 'Why choose us'}</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">{isEl ? 'Όλα συμπεριλαμβάνονται' : isBg ? 'Всичко е включено' : isSr ? 'Све је укључено' : isTr ? 'Her şey dahil' : isRo ? 'Totul inclus' : 'Everything included'}</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            icon: '🌐',
            title: isEl ? 'Καταχωρίσεις βελτιστοποιημένες για SEO' : isBg ? 'Обяви, оптимизирани за SEO' : isSr ? 'Огласи оптимизовани за SEO' : isTr ? 'SEO optimize edilmiş ilanlar' : isRo ? 'Anunțuri optimizate SEO' : 'SEO-optimised listings',
            desc: isEl ? 'Το ακίνητό σας εμφανίζεται στα αποτελέσματα αναζήτησης Google, οδηγούς περιοχών και σελίδες τοποθεσιών — δωρεάν οργανική ορατότητα.' : isBg ? 'Имотът ви се появява в резултатите от търсенето в Google, наръчниците за района и страниците с локации — безплатна органична видимост.' : isSr ? 'Ваша некретнина се појављује у Google резултатима претраге, водичима за подручје и страницама локација — бесплатна органска видљивост.' : isTr ? 'Mülkünüz Google arama sonuçlarında, bölge rehberlerinde ve konum sayfalarında görünür — ücretsiz organik görünürlük.' : isRo ? 'Proprietatea dvs. apare în rezultatele de căutare Google, ghidurile zonei și paginile de locații — vizibilitate organică gratuită.' : 'Your property appears in Google search results, area guides, and location pages — free organic visibility.',
          },
          {
            icon: '💬',
            title: isEl ? 'Επικοινωνία με επισκέπτες' : isBg ? 'Комуникация с гостите' : isSr ? 'Комуникација са гостима' : isTr ? 'Misafir iletişimi' : isRo ? 'Comunicare cu oaspeții' : 'Guest communication',
            desc: isEl ? 'Χειριζόμαστε ερωτήματα, οδηγίες check-in και υποστήριξη ώστε να μην χάνετε ποτέ κράτηση.' : isBg ? 'Обработваме запитвания, инструкции за настаняване и поддръжка, за да не пропускате никога резервация.' : isSr ? 'Обрађујемо упите, упутства за пријаву и подршку тако да никада не пропустите резервацију.' : isTr ? 'Sorguları, check-in talimatlarını ve desteği biz hallederiz, böylece hiçbir rezervasyonu kaçırmazsınız.' : isRo ? 'Ne ocupăm de solicitări, instrucțiuni de check-in și asistență, astfel încât să nu pierdeți nicio rezervare.' : 'We handle enquiries, check-in instructions, and support so you never miss a booking.',
          },
          {
            icon: '🔐',
            title: isEl ? 'Ασφαλής διαχείριση εγγύησης' : isBg ? 'Сигурно управление на депозита' : isSr ? 'Безбедно управљање депозитом' : isTr ? 'Güvenli depozito yönetimi' : isRo ? 'Gestionare securizată a depozitului' : 'Secure deposit handling',
