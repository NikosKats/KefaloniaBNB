---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getServiceClient } from '../../lib/supabase.ts';
import { awardPoints, pointsToNextTier, TIER_THRESHOLDS } from '../../lib/points.ts';

const lang = (Astro.locals.lang ?? 'en') as string;
const isBg = lang === 'bg';
const isEl = lang === 'el';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';

const t = {
  myAccount: isEl ? 'Ο Λογαριασμός μου' : isBg ? 'Моят акаунт' : isSr ? 'Мој налог' : isTr ? 'Hesabım' : isRo ? 'Contul Meu' : 'My Account',
  bookings: isEl ? 'Κρατήσεις' : isBg ? 'Резервации настаняване' : isSr ? 'Букирања' : isTr ? 'Rezervasyonlar' : isRo ? 'Rezervări' : 'Bookings',
  reservations: isEl ? 'Κρατήσεις εστιατορίου' : isBg ? 'Резервации' : isSr ? 'Резервације' : isTr ? 'Restoran Rezervasyonları' : isRo ? 'Rezervări restaurant' : 'Reservations',
  friends: isEl ? 'Φίλοι' : isBg ? 'Приятели' : isSr ? 'Пријатељи' : isTr ? 'Arkadaşlar' : isRo ? 'Prieteni' : 'Friends',
  favorites: isEl ? 'Αγαπημένα' : isBg ? 'Любими' : isSr ? 'Омиљени' : isTr ? 'Favoriler' : isRo ? 'Favorite' : 'Favorites',
  messages: isEl ? 'Μηνύματα' : isBg ? 'Съобщения' : isSr ? 'Поруке' : isTr ? 'Mesajlar' : isRo ? 'Mesaje' : 'Messages',
  notifications: isEl ? 'Ειδοποιήσεις' : isBg ? 'Известия' : isSr ? 'Обавештења' : isTr ? 'Bildirimler' : isRo ? 'Notificări' : 'Notifications',
  posts: isEl ? 'Δημοσιεύσεις' : isBg ? 'Публикации' : isSr ? 'Објаве' : isTr ? 'Gönderiler' : isRo ? 'Postări' : 'Posts',
  myBookings: isEl ? 'Οι Κρατήσεις μου' : isBg ? 'Моите резервации' : isSr ? 'Моја букирања' : isTr ? 'Rezervasyonlarım' : isRo ? 'Rezervările Mele' : 'My Bookings',
  myReservations: isEl ? 'Οι Κρατήσεις μου' : isBg ? 'Моите резервации' : isSr ? 'Моје резервације' : isTr ? 'Restoran Rezervasyonlarım' : isRo ? 'Rezervările Mele' : 'My Reservations',
  viewBookings: isEl ? 'Δείτε και διαχειριστείτε τις κρατήσεις σας' : isBg ? 'Преглед и управление на резервациите ви' : isSr ? 'Прегледајте и управљајте букирањима' : isTr ? 'Rezervasyonlarınızı görüntüleyin' : isRo ? 'Vizualizați și gestionați rezervările dvs.' : 'View and manage your property bookings',
  restaurantBookings: isEl ? 'Κρατήσεις εστιατορίου' : isBg ? 'Ресторантски резервации и хранене' : isSr ? 'Ресторанске резервације' : isTr ? 'Restoran rezervasyonları' : isRo ? 'Rezervări restaurant și dining' : 'Restaurant bookings and dining',
  manageConnections: isEl ? 'Διαχειριστείτε τις συνδέσεις σας' : isBg ? 'Управлявайте връзките си' : isSr ? 'Управљајте везама' : isTr ? 'Bağlantılarınızı yönetin' : isRo ? 'Gestionați conexiunile dvs.' : 'Manage your connections',
  chatWithFriends: isEl ? 'Συνομιλήστε με φίλους' : isBg ? 'Чат с приятели и членове' : isSr ? 'Разговарајте са пријатељима' : isTr ? 'Arkadaşlarınızla sohbet edin' : isRo ? 'Conversați cu prietenii și membrii' : 'Chat with friends and members',
  savedProperties: isEl ? 'Αποθηκευμένα ακίνητα' : isBg ? 'Запазени имоти' : isSr ? 'Сачуване некретнине' : isTr ? 'Kaydettiğiniz mülkler' : isRo ? 'Proprietăți salvate' : "Properties you've saved",
  likesCommentsFriends: isEl ? 'Likes, σχόλια και αιτήματα φιλίας' : isBg ? 'Харесвания, коментари и заявки за приятелство' : isSr ? 'Лајкови, коментари и захтеви' : isTr ? 'Beğeniler, yorumlar ve arkadaşlık istekleri' : isRo ? 'Aprecieri, comentarii și cereri de prietenie' : 'Likes, comments and friend requests',
  myCommunity: isEl ? 'Η Κοινότητά μου' : isBg ? 'Моята общност' : isSr ? 'Моја заједница' : isTr ? 'Topluluğum' : isRo ? 'Comunitatea Mea' : 'My Community',
  postsCommentsActivity: isEl ? 'Δημοσιεύσεις, σχόλια και δραστηριότητα' : isBg ? 'Вашите публикации, коментари и активност' : isSr ? 'Објаве, коментари и активност' : isTr ? 'Gönderileriniz, yorumlarınız ve etkinliğiniz' : isRo ? 'Postările, comentariile și activitatea dvs.' : 'Your posts, comments and activity',
  editProfile: isEl ? 'Επεξεργασία Προφίλ' : isBg ? 'Редактиране на профил' : isSr ? 'Уреди профил' : isTr ? 'Profili Düzenle' : isRo ? 'Editare Profil' : 'Edit Profile',
  updateInfo: isEl ? 'Ενημερώστε τις πληροφορίες σας' : isBg ? 'Актуализирайте информацията и снимките си' : isSr ? 'Ажурирајте податке и фотографије' : isTr ? 'Bilgilerinizi ve fotoğraflarınızı güncelleyin' : isRo ? 'Actualizați informațiile și fotografiile dvs.' : 'Update your info and photos',
};

const session = Astro.locals.session;
if (!session) return Astro.redirect('/community/join?next=/account');

const service = getServiceClient();
const userId = session.user.id;

const [profileRes, bookingsRes, postsRes] = await Promise.all([
  service.from('profiles').select('full_name, email, avatar_url, bio, location, friends_count, favorites_count, unread_messages_count, unread_notifications_count, points_balance, tier, created_at').eq('id', userId).single(),
  service.from('bookings').select('id', { count: 'exact', head: true }).or(`guest_user_id.eq.${userId},guest_email.eq.${(Astro.locals.profile as any)?.email ?? ''}`),
  service.from('community_posts').select('id', { count: 'exact', head: true }).eq('author_id', userId),
]);

const profile = profileRes.data;

// Gamification: award email_verified bonus on first authenticated account visit.
// One-shot (unique index) so safe to always call.
if (session.user.email_confirmed_at) {
  awardPoints(userId, 'email_verified').catch(() => {/* ignore */});
}

// Award profile_photo if user has an avatar (one-shot).
if (profile?.avatar_url) {
  awardPoints(userId, 'profile_photo').catch(() => {/* ignore */});
}

const points = profile?.points_balance ?? 0;
const tier = (profile?.tier ?? 'bronze') as 'bronze' | 'silver' | 'gold';
const nextTier = pointsToNextTier(points);
const tierProgressPct = nextTier.next
  ? Math.min(100, Math.round(((points - (tier === 'bronze' ? 0 : TIER_THRESHOLDS.silver)) / (nextTier.needed + (points - (tier === 'bronze' ? 0 : TIER_THRESHOLDS.silver)))) * 100))
  : 100;

const tierLabel = { bronze: 'Bronze', silver: 'Silver', gold: 'Gold' }[tier];
const tierColor = { bronze: '#b08d57', silver: '#9ca3af', gold: '#c9a96e' }[tier];
const tierEmoji = { bronze: '🥉', silver: '🥈', gold: '🥇' }[tier];

// Does the user still have an unrevealed welcome reward?
const { data: welcomeReward } = await service
  .from('welcome_rewards')
  .select('id, revealed_at, expires_at, coupon_code, used_at')
  .eq('user_id', userId)
  .maybeSingle();
const hasUnrevealedReward = !!welcomeReward && !welcomeReward.revealed_at && new Date(welcomeReward.expires_at) > new Date();
const hasRevealedUnusedReward = !!welcomeReward?.revealed_at && !welcomeReward?.used_at && new Date(welcomeReward.expires_at) > new Date();
const bookingsCount = bookingsRes.count ?? 0;
const postsCount = postsRes.count ?? 0;

const { count: reservationsCount } = await service
  .from('restaurant_reservations')
  .select('id', { count: 'exact', head: true })
  .or(`member_id.eq.${userId}${(Astro.locals.profile as any)?.email ? `,guest_email.eq.${(Astro.locals.profile as any).email}` : ''}`);

const stats = [
  { label: t.bookings, value: bookingsCount, href: '/my-bookings', icon: '&#x1F3E0;' },
  { label: t.reservations, value: reservationsCount ?? 0, href: '/account/reservations', icon: '&#x1F37D;' },
  { label: t.friends, value: profile?.friends_count ?? 0, href: '/account/friends', icon: '&#x1F465;' },
  { label: t.favorites, value: profile?.favorites_count ?? 0, href: '/account/favorites', icon: '&#x2764;' },
  { label: t.messages, value: profile?.unread_messages_count ?? 0, href: '/account/messages', icon: '&#x1F4AC;', badge: true },
  { label: t.notifications, value: profile?.unread_notifications_count ?? 0, href: '/account/notifications', icon: '&#x1F514;', badge: true },
  { label: t.posts, value: postsCount, href: '/account/community', icon: '&#x1F4DD;' },
];

const navCards = [
  { title: t.myBookings, desc: t.viewBookings, href: '/my-bookings', icon: '&#x1F4C5;' },
  { title: t.myReservations, desc: t.restaurantBookings, href: '/account/reservations', icon: '&#x1F37D;' },
  { title: t.friends, desc: t.manageConnections, href: '/account/friends', icon: '&#x1F465;' },
  { title: t.messages, desc: t.chatWithFriends, href: '/account/messages', icon: '&#x1F4AC;' },
  { title: t.favorites, desc: t.savedProperties, href: '/account/favorites', icon: '&#x2764;' },
  { title: t.notifications, desc: t.likesCommentsFriends, href: '/account/notifications', icon: '&#x1F514;' },
  { title: t.myCommunity, desc: t.postsCommentsActivity, href: '/account/community', icon: '&#x1F4DD;' },
  { title: t.editProfile, desc: t.updateInfo, href: '/community/profile', icon: '&#x270F;' },
];
---

<BaseLayout title={t.myAccount} noIndex>
  <div class="max-w-4xl mx-auto px-4 py-10">
    <!-- Profile summary -->
    <div class="flex items-center gap-4 mb-8">
      <div class="w-16 h-16 rounded-full bg-[#1a1a2e] overflow-hidden shrink-0">
        {profile?.avatar_url ? (
          <img src={profile.avatar_url} alt="" class="w-full h-full object-cover" />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-white text-2xl font-bold">
            {(profile?.full_name || '?')[0].toUpperCase()}
          </div>
        )}
      </div>
      <div>
        <h1 class="text-2xl font-bold text-gray-900">{profile?.full_name || t.myAccount}</h1>
        <p class="text-sm text-gray-500">{profile?.email} {profile?.location ? `· ${profile.location}` : ''}</p>
      </div>
    </div>

    <!-- Welcome reward nudge -->
    {hasUnrevealedReward && (
      <a href="/account/welcome-reveal" class="block mb-6 rounded-2xl p-5 bg-gradient-to-r from-[#1a1a2e] to-[#2d2d4e] border border-[#c9a96e]/40 hover:border-[#c9a96e] transition-colors">
        <div class="flex items-center gap-4">
          <div class="text-4xl">🎁</div>
          <div class="flex-1">
            <p class="text-white font-semibold">Your welcome gift is ready to reveal</p>
            <p class="text-gray-300 text-sm mt-1">Everyone wins. 1 in 50 wins a free night. Tap to scratch →</p>
          </div>
          <span class="text-[#c9a96e] text-sm font-semibold">Reveal</span>
        </div>
      </a>
    )}
    {hasRevealedUnusedReward && welcomeReward?.coupon_code && (
      <a href="/account/welcome-reveal" class="block mb-6 rounded-2xl p-5 bg-[#fefce8] border border-[#c9a96e]/60 hover:shadow-md transition-shadow">
        <div class="flex items-center gap-4">
          <div class="text-3xl">💌</div>
          <div class="flex-1">
            <p class="text-gray-900 font-semibold">Your welcome coupon <code class="bg-white px-2 py-0.5 rounded border">{welcomeReward.coupon_code}</code> is live</p>
            <p class="text-gray-600 text-sm mt-1">Use it before {new Date(welcomeReward.expires_at).toLocaleDateString()} at midnight.</p>
          </div>
        </div>
      </a>
    )}

    <!-- Tier progress card -->
    <div class="rounded-2xl p-5 mb-8 border" style={`background: linear-gradient(135deg, ${tierColor}15, ${tierColor}05); border-color: ${tierColor}40;`}>
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-3">
          <span class="text-3xl">{tierEmoji}</span>
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wide">Member tier</p>
            <p class="text-xl font-bold" style={`color: ${tierColor};`}>{tierLabel}</p>
          </div>
        </div>
        <div class="text-right">
          <p class="text-xs text-gray-500">Points</p>
          <p class="text-2xl font-bold text-gray-900">{points.toLocaleString()}</p>
        </div>
      </div>
      {nextTier.next ? (
        <>
          <div class="h-2 rounded-full bg-gray-200 overflow-hidden mb-2">
            <div class="h-full rounded-full transition-all" style={`width: ${tierProgressPct}%; background: ${tierColor};`}></div>
          </div>
          <p class="text-xs text-gray-600"><strong>{nextTier.needed}</strong> points to <strong class="capitalize">{nextTier.next}</strong> tier &mdash; unlock bigger member discounts &amp; flash perks.</p>
        </>
      ) : (
        <p class="text-xs text-gray-600">🎉 You've reached the top tier. Enjoy every perk.</p>
      )}
      <div class="flex gap-2 mt-3">
        <a href="/perks" class="text-xs font-semibold px-3 py-1.5 rounded-full" style={`background: ${tierColor}; color: #fff;`}>View perks</a>
        <a href="/account/favorites" class="text-xs font-semibold px-3 py-1.5 rounded-full bg-white border border-gray-200 text-gray-700 hover:border-gray-400">Earn more</a>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3 mb-10">
      {stats.map((s) => (
        <a href={s.href} class="bg-white rounded-xl border border-gray-100 p-4 text-center hover:border-[#c9a96e] transition-colors">
          <p class="text-2xl mb-1" set:html={s.icon} />
          <p class="text-lg font-bold text-gray-900">
            {s.value}
            {s.badge && s.value > 0 && <span class="inline-block w-2 h-2 bg-red-500 rounded-full ml-1 relative -top-2"></span>}
          </p>
          <p class="text-xs text-gray-500">{s.label}</p>
        </a>
      ))}
    </div>

    <!-- Navigation cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {navCards.map((card) => (
        <a href={card.href} class="bg-white rounded-xl border border-gray-100 p-5 hover:border-[#c9a96e] hover:shadow-md transition-all group">
          <p class="text-2xl mb-2" set:html={card.icon} />
          <h3 class="font-semibold text-gray-900 text-sm group-hover:text-[#c9a96e] transition-colors">{card.title}</h3>
          <p class="text-xs text-gray-500 mt-1">{card.desc}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
