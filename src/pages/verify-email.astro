---
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = (Astro.locals.lang ?? 'en') as string;
const isEl = lang === 'el';
const isBg = lang === 'bg';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';

const status = Astro.url.searchParams.get('status') ?? 'invalid';
const guestToken = Astro.url.searchParams.get('token');
const isLoggedIn = !!Astro.locals.session;

const statusConfig: Record<string, { icon: string; title: string; message: string; color: string }> = {
  success: {
    icon: '✅',
    title: isEl ? 'Имейлът е потвърден!' : isBg ? 'Имейлът е потвърден!' : isSr ? 'Имејл потврђен!' : isTr ? 'E-posta Doğrulandı!' : isRo ? 'Email Verificat!' : 'Email Verified!',
    message: isEl ? 'Το email σας επαληθεύτηκε και η κράτησή σας επιβεβαιώθηκε. Θα λάβετε email επιβεβαίωσης σύντομα.' : isBg ? 'Имейлът ви е потвърден и резервацията ви е потвърдена. Ще получите имейл за потвърждение скоро.' : isSr ? 'Ваш имејл је потврђен и ваша резервација је потврђена. Ускоро ћете примити имејл за потврду.' : isTr ? 'E-postanız doğrulandı ve rezervasyonunuz onaylandı. Kısa sürede bir onay e-postası alacaksınız.' : isRo ? 'Emailul dvs. a fost verificat și rezervarea confirmată. Veți primi un email de confirmare în curând.' : 'Your email has been verified and your booking is confirmed. You\'ll receive a confirmation email shortly.',
    color: 'emerald',
  },
  expired: {
    icon: '⏰',
    title: isEl ? 'Ο σύνδεσμος έληξε' : isBg ? 'Линкът е изтекъл' : isSr ? 'Линк је истекао' : isTr ? 'Bağlantı Süresi Doldu' : isRo ? 'Link Expirat' : 'Link Expired',
    message: isEl ? 'Αυτός ο σύνδεσμος επαλήθευσης έληξε. Η κράτησή σας μπορεί να έχει ακυρωθεί αυτόματα. Παρακαλώ επικοινωνήστε μαζί μας ή κάντε νέα κράτηση.' : isBg ? 'Този линк за потвърждение е изтекъл. Резервацията ви може да е била автоматично отменена. Моля, свържете се с нас или направете нова резервация.' : isSr ? 'Овај линк за верификацију је истекао. Ваша резервација је можда аутоматски отказана. Контактирајте нас или направите нову резервацију.' : isTr ? 'Bu doğrulama bağlantısının süresi doldu. Rezervasyonunuz otomatik olarak iptal edilmiş olabilir. Lütfen bizimle iletişime geçin veya yeni bir rezervasyon yapın.' : isRo ? 'Acest link de verificare a expirat. Rezervarea dvs. poate fi anulată automat. Contactați-ne sau faceți o rezervare nouă.' : 'This verification link has expired. Your booking may have been automatically cancelled. Please contact us or make a new booking.',
    color: 'amber',
  },
  invalid: {
    icon: '❌',
    title: isEl ? 'Μη έγκυρος σύνδεσμος' : isBg ? 'Невалиден линк' : isSr ? 'Неважећи линк' : isTr ? 'Geçersiz Bağlantı' : isRo ? 'Link Invalid' : 'Invalid Link',
    message: isEl ? 'Αυτός ο σύνδεσμος επαλήθευσης δεν είναι έγκυρος ή έχει ήδη χρησιμοποιηθεί.' : isBg ? 'Този линк за потвърждение е невалиден или вече е бил използван.' : isSr ? 'Овај линк за верификацију је неважећи или је већ коришћен.' : isTr ? 'Bu doğrulama bağlantısı geçersiz veya zaten kullanılmış.' : isRo ? 'Acest link de verificare este invalid sau a fost deja utilizat.' : 'This verification link is invalid or has already been used.',
    color: 'red',
  },
};

const config = statusConfig[status] ?? statusConfig.invalid;

const tViewBooking = isEl ? 'Δείτε την Κράτησή σας' : isBg ? 'Вижте резервацията си' : isSr ? 'Погледајте резервацију' : isTr ? 'Rezervasyonunuzu Görüntüleyin' : isRo ? 'Vezi Rezervarea' : 'View Your Booking';
const tSetPassword = isEl ? 'Ορίστε κωδικό πρόσβασης' : isBg ? 'Задайте парола' : isSr ? 'Поставите лозинку' : isTr ? 'Şifre Belirleyin' : isRo ? 'Setează o Parolă' : 'Set Password';
const tSetPasswordTitle = isEl ? 'Ορίστε κωδικό για τον λογαριασμό σας' : isBg ? 'Задайте парола за акаунта си' : isSr ? 'Поставите лозинку за свој налог' : isTr ? 'Hesabınız için bir şifre belirleyin' : isRo ? 'Setează o parolă pentru contul tău' : 'Set a password for your account';
const tSetPasswordDesc = isEl ? 'Ώστε να μπορείτε να συνδεθείτε ανά πάσα στιγμή για να διαχειριστείτε τις κρατήσεις σας.' : isBg ? 'За да можете да влизате по всяко време и да управлявате резервациите си.' : isSr ? 'Да бисте могли да се пријавите у сваком тренутку и управљате резервацијама.' : isTr ? 'Böylece istediğiniz zaman giriş yapıp rezervasyonlarınızı yönetebilirsiniz.' : isRo ? 'Astfel te poți autentifica oricând pentru a-ți gestiona rezervările, favoritele și altele.' : 'So you can log in anytime to manage your bookings, favorites, and more.';
const tPasswordPlaceholder = isEl ? 'Επιλέξτε κωδικό (τουλ. 6 χαρακτήρες)' : isBg ? 'Изберете парола (мин. 6 символа)' : isSr ? 'Изаберите лозинку (мин. 6 карактера)' : isTr ? 'Bir şifre seçin (en az 6 karakter)' : isRo ? 'Alege o parolă (min. 6 caractere)' : 'Choose a password (min 6 characters)';
const tViewAllBookings = isEl ? 'Δείτε όλες τις κρατήσεις' : isBg ? 'Вижте всички резервации' : isSr ? 'Погледајте све резервације' : isTr ? 'Tüm Rezervasyonları Görüntüle' : isRo ? 'Vezi Toate Rezervările' : 'View All My Bookings';
const tBrowseProperties = isEl ? 'Δείτε καταλύματα' : isBg ? 'Разгледайте имоти' : isSr ? 'Прегледајте смештаје' : isTr ? 'Mülklere Göz Atın' : isRo ? 'Răsfoiește Proprietăți' : 'Browse Properties';
const tContactUs = isEl ? 'Επικοινωνήστε μαζί μας' : isBg ? 'Свържете се с нас' : isSr ? 'Контактирајте нас' : isTr ? 'Bize Ulaşın' : isRo ? 'Contactați-ne' : 'Contact Us';
const tSaving = isEl ? 'Αποθήκευση…' : isBg ? 'Запазване…' : isSr ? 'Чување…' : isTr ? 'Kaydediliyor…' : isRo ? 'Se salvează…' : 'Saving…';
const tDone = isEl ? 'Έτοιμο ✓' : isBg ? 'Готово ✓' : isSr ? 'Готово ✓' : isTr ? 'Tamamlandı ✓' : isRo ? 'Gata ✓' : 'Done ✓';
const tPasswordSet = isEl ? 'Ο κωδικός ορίστηκε! Μπορείτε να συνδεθείτε με το email και τον κωδικό σας.' : isBg ? 'Паролата е зададена! Вече можете да влезете с имейла и паролата си.' : isSr ? 'Лозинка је постављена! Сада можете да се пријавите са имејлом и лозинком.' : isTr ? 'Şifre belirlendi! Artık e-posta ve şifrenizle giriş yapabilirsiniz.' : isRo ? 'Parola a fost setată! Acum te poți autentifica cu emailul și parola.' : 'Password set! You can now log in with your email and password.';
const tPasswordMin = isEl ? 'Ο κωδικός πρέπει να είναι τουλάχιστον 6 χαρακτήρες' : isBg ? 'Паролата трябва да е поне 6 символа' : isSr ? 'Лозинка мора имати најмање 6 карактера' : isTr ? 'Şifre en az 6 karakter olmalıdır' : isRo ? 'Parola trebuie să aibă cel puțin 6 caractere' : 'Password must be at least 6 characters';
---

<BaseLayout title={config.title}>
  <div class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="max-w-md w-full text-center">
      <div class="text-5xl mb-4">{config.icon}</div>
      <h1 class="text-2xl font-bold text-gray-900 mb-3">{config.title}</h1>
      <p class="text-gray-600 mb-8">{config.message}</p>

      <div class="space-y-3">
        {status === 'success' && guestToken && (
          <a
            href={`/my-booking?token=${guestToken}`}
            class="block w-full bg-[#1a1a2e] text-white font-semibold py-3 px-6 rounded-xl hover:bg-[#2d2d4e] transition-colors text-center"
          >
            {tViewBooking}
          </a>
        )}

        {status === 'success' && guestToken && (
          <div id="set-password-section" class="bg-gray-50 rounded-xl border border-gray-200 p-5 text-left">
            <p class="text-sm font-semibold text-gray-800 mb-1">{tSetPasswordTitle}</p>
            <p class="text-xs text-gray-500 mb-3">{tSetPasswordDesc}</p>
            <input id="new-password" type="password" placeholder={tPasswordPlaceholder} class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#c9a96e]/40 mb-2" />
            <button id="set-password-btn" class="w-full bg-[#1a1a2e] text-white font-medium py-2.5 rounded-lg text-sm hover:bg-[#2d2d4e] transition-colors">{tSetPassword}</button>
            <p id="password-status" class="hidden text-xs mt-2"></p>
          </div>
        )}

        {status === 'success' && (
          <a
            href="/my-bookings"
            class="block w-full border border-gray-200 text-gray-700 font-medium py-3 px-6 rounded-xl hover:bg-gray-50 transition-colors text-center"
          >
            {tViewAllBookings}
          </a>
        )}

        {status === 'expired' && (
          <a
            href="/rentals"
            class="block w-full bg-[#1a1a2e] text-white font-semibold py-3 px-6 rounded-xl hover:bg-[#2d2d4e] transition-colors text-center"
          >
            {tBrowseProperties}
          </a>
        )}

        {status !== 'success' && (
          <a
            href="/contact"
            class="block w-full border border-gray-200 text-gray-700 font-medium py-3 px-6 rounded-xl hover:bg-gray-50 transition-colors text-center"
          >
            {tContactUs}
          </a>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ guestToken, tSetPassword, tSaving, tDone, tPasswordSet, tPasswordMin }}>
  var setBtn = document.getElementById('set-password-btn');
  if (setBtn) {
    setBtn.addEventListener('click', async function() {
      var pw = document.getElementById('new-password')?.value;
      var status = document.getElementById('password-status');
      if (!pw || pw.length < 6) {
        if (status) { status.textContent = tPasswordMin; status.className = 'text-xs mt-2 text-red-600'; status.classList.remove('hidden'); }
        return;
      }
      setBtn.disabled = true; setBtn.textContent = tSaving;
      try {
        var res = await fetch('/api/auth/set-guest-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: pw, guest_token: guestToken }),
        });
        var json = await res.json();
        if (!res.ok) throw new Error(json.error || 'Failed');
        if (status) { status.textContent = tPasswordSet; status.className = 'text-xs mt-2 text-emerald-600'; status.classList.remove('hidden'); }
        setBtn.textContent = tDone;
        document.getElementById('new-password').disabled = true;
        setTimeout(function() { window.location.reload(); }, 1500);
      } catch (err) {
        if (status) { status.textContent = err.message; status.className = 'text-xs mt-2 text-red-600'; status.classList.remove('hidden'); }
        setBtn.disabled = false; setBtn.textContent = tSetPassword;
      }
    });
  }
</script>
