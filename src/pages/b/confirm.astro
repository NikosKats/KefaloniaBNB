---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getServiceClient } from '../../lib/supabase';

const lang = ((Astro.locals as any).lang ?? 'en') as string;
const isBg = lang === 'bg';
const isEl = lang === 'el';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';
const token = new URL(Astro.request.url).searchParams.get('t') ?? '';

let reveal: any   = null;
let coupon: any   = null;
let business: any = null;
let pageError     = '';

const tInvalidLink = isEl ? 'Μη έγκυρος σύνδεσμος' : isBg ? 'Невалиден линк' : isSr ? 'Неважећи линк' : isTr ? 'Geçersiz Bağlantı' : isRo ? 'Link invalid' : 'Invalid Link';
const tInvalidOrExpired = isEl ? 'Αυτός ο σύνδεσμος δεν είναι έγκυρος ή έχει λήξει.' : isBg ? 'Този линк е невалиден или е изтекъл.' : isSr ? 'Овај линк је неважећи или је истекао.' : isTr ? 'Bu bağlantı geçersiz veya süresi dolmuş.' : isRo ? 'Acest link este invalid sau a expirat deja.' : 'This link is invalid or has already expired.';
const tInvalidConfLink = isEl ? 'Μη έγκυρος σύνδεσμος επιβεβαίωσης.' : isBg ? 'Невалиден линк за потвърждение.' : isSr ? 'Неважећи линк за потврду.' : isTr ? 'Geçersiz onay bağlantısı.' : isRo ? 'Link de confirmare invalid.' : 'Invalid confirmation link.';
const tAlreadyConfirmed = isEl ? 'Ήδη επιβεβαιωμένο' : isBg ? 'Вече потвърдено' : isSr ? 'Већ потврђено' : isTr ? 'Zaten Onaylandı' : isRo ? 'Deja Confirmat' : 'Already Confirmed';
const tConfirmedOn = isEl ? 'Αυτό το κουπόνι επιβεβαιώθηκε στις' : isBg ? 'Този купон е потвърден на' : isSr ? 'Овај купон је потврђен' : isTr ? 'Bu kupon tarihinde onaylandı:' : isRo ? 'Acest cupon a fost confirmat pe' : 'This coupon was confirmed on';
const tGuestCoupon = isEl ? 'Κουπόνι Επισκέπτη' : isBg ? 'Купон за гост' : isSr ? 'Купон за госта' : isTr ? 'Misafir Kuponu' : isRo ? 'Cupon Oaspete' : 'Guest Coupon';
const tCouponDesc = isEl ? 'Ένας επισκέπτης παρουσιάζει αυτό το κουπόνι. Πατήστε για να επιβεβαιώσετε τη χρήση.' : isBg ? 'Гост представя този купон. Натиснете бутона, за да потвърдите използването — това регистрира едно фактурируемо препращане от KefaloniaBNB.' : isSr ? 'Гост представља овај купон. Додирните дугме за потврду коришћења.' : isTr ? 'Bir misafir bu kuponu sunuyor. Kullanımı onaylamak için düğmeye dokunun.' : isRo ? 'Un oaspete prezintă acest cupon. Apăsați butonul de mai jos pentru a confirma utilizarea — aceasta înregistrează o recomandare facturabilă de la KefaloniaBNB.' : 'A guest is presenting this coupon. Tap the button below to confirm they used it — this records one billable referral from KefaloniaBNB.';
const tConfirmRedemption = isEl ? '✓ Επιβεβαίωση εξαργύρωσης' : isBg ? '✓ Потвърдете използването' : isSr ? '✓ Потврдите коришћење' : isTr ? '✓ Kullanımı Onayla' : isRo ? '✓ Confirmă utilizarea' : '✓ Confirm Redemption';
const tConfirming = isEl ? 'Επιβεβαίωση…' : isBg ? 'Потвърждаване…' : isSr ? 'Потврђивање…' : isTr ? 'Onaylanıyor…' : isRo ? 'Se confirmă…' : 'Confirming…';
const tRedemptionConfirmed = isEl ? 'Η εξαργύρωση επιβεβαιώθηκε!' : isBg ? 'Използването е потвърдено!' : isSr ? 'Коришћење потврђено!' : isTr ? 'Kullanım Onaylandı!' : isRo ? 'Utilizare Confirmată!' : 'Redemption Confirmed!';
const tRedemptionDesc = isEl ? 'Αυτό το κουπόνι καταγράφηκε ως εξαργυρωμένο. Θα εμφανιστεί στο μηνιαίο τιμολόγιό σας.' : isBg ? 'Този купон е регистриран като използван.<br>Ще се появи в месечната ви фактура от KefaloniaBNB.' : isSr ? 'Овај купон је забележен као искоришћен.<br>Појавиће се на вашој месечној фактури.' : isTr ? 'Bu kupon kullanıldı olarak kaydedildi.<br>Aylık faturanızda görünecektir.' : isRo ? 'Acest cupon a fost înregistrat ca utilizat.<br>Va apărea pe factura dvs. lunară de la KefaloniaBNB.' : 'This coupon has been logged as redeemed.<br>It will appear on your monthly invoice from KefaloniaBNB.';
const tPartnerProgram = isEl ? 'Πρόγραμμα συνεργατών KefaloniaBNB' : isBg ? 'Партньорска програма на KefaloniaBNB' : isSr ? 'Партнерски програм KefaloniaBNB' : isTr ? 'KefaloniaBNB ortak programı' : isRo ? 'Programul de parteneriat KefaloniaBNB' : 'KefaloniaBNB partner program';
const tSomethingWrong = isEl ? 'Κάτι πήγε στραβά — δοκιμάστε ξανά.' : isBg ? 'Нещо се обърка — опитайте отново.' : isSr ? 'Нешто је пошло наопако — покушајте поново.' : isTr ? 'Bir şeyler ters gitti — tekrar deneyin.' : isRo ? 'Ceva a mers greșit — încercați din nou.' : 'Something went wrong — please try again.';

if (!token) {
  pageError = tInvalidConfLink;
} else {
  const service = getServiceClient();
  const { data } = await service
    .from('partner_coupon_reveals')
    .select('id, confirmed_at, revealed_at, partner_coupons(code, description, discount_type, discount_value, partner_businesses(name, location_name))')
    .eq('token', token)
    .single();

  if (!data) {
    pageError = tInvalidOrExpired;
  } else {
    reveal   = data;
    coupon   = (data as any).partner_coupons;
    business = coupon?.partner_businesses;
  }
}

const discountLabel = coupon
  ? coupon.discount_type === 'percent'
    ? `-${coupon.discount_value}%`
    : `-€${coupon.discount_value}`
  : '';

const alreadyConfirmed = reveal && reveal.confirmed_at;
---

<BaseLayout title="Confirm Coupon — KefaloniaBNB" description="Business coupon confirmation page">

  <div class="min-h-screen bg-[#f8f6f2] flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 w-full max-w-sm overflow-hidden">

      <!-- Header bar -->
      <div class="bg-[#1a1a2e] px-6 py-4 flex items-center gap-2">
        <div class="w-7 h-7 bg-[#c9a96e] rounded-lg flex items-center justify-center shrink-0">
          <span class="text-white text-xs font-bold">K</span>
        </div>
        <span class="text-white text-sm font-semibold">KefaloniaBNB</span>
      </div>

      <div class="p-8 text-center">

        {pageError ? (
          <div>
            <p class="text-5xl mb-4">❌</p>
            <h1 class="text-lg font-bold text-gray-900 mb-2">{tInvalidLink}</h1>
            <p class="text-sm text-gray-500">{pageError}</p>
          </div>

        ) : alreadyConfirmed ? (
          <div>
            <p class="text-5xl mb-4">✅</p>
            <h1 class="text-xl font-bold text-gray-900 mb-2">{tAlreadyConfirmed}</h1>
            <p class="text-sm text-gray-500 mb-5">
              {tConfirmedOn}{' '}
              {new Date(reveal.confirmed_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}.
            </p>
            <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4">
              <p class="font-mono font-bold text-emerald-800 text-xl tracking-widest">{coupon.code}</p>
              <p class="text-sm text-emerald-700 mt-1">{coupon.description}</p>
              <span class="inline-block mt-2 text-xs font-bold bg-emerald-600 text-white rounded-full px-3 py-1">{discountLabel}</span>
            </div>
          </div>

        ) : (
          <div id="confirm-ui">
            <p class="text-4xl mb-4">🎟</p>
            <p class="text-xs font-semibold text-[#c9a96e] uppercase tracking-widest mb-1">{tGuestCoupon}</p>
            <h1 class="text-xl font-bold text-gray-900 mb-1">{business?.name}</h1>
            <p class="text-sm text-gray-400 mb-6">📍 {business?.location_name}</p>

            <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-5 mb-6">
              <p class="font-mono font-bold text-emerald-800 text-2xl tracking-widest mb-1">{coupon.code}</p>
              <p class="text-sm font-semibold text-emerald-700">{coupon.description}</p>
              <span class="inline-block mt-2 text-sm font-bold bg-emerald-600 text-white rounded-full px-4 py-1">{discountLabel}</span>
            </div>

            <p class="text-xs text-gray-400 mb-5 leading-relaxed">
              {tCouponDesc}
            </p>

            <button id="confirm-btn"
              class="w-full bg-[#1a1a2e] hover:bg-[#2d2d4e] text-white font-bold py-4 rounded-xl text-base transition-colors">
              {tConfirmRedemption}
            </button>

            <p id="confirm-msg" class="hidden text-sm mt-3 text-red-600"></p>
          </div>
        )}

        <p class="text-xs text-gray-300 mt-8">{tPartnerProgram}</p>
      </div>
    </div>
  </div>

</BaseLayout>

<script define:vars={{ token, tConfirming, tRedemptionConfirmed, tRedemptionDesc, tConfirmRedemption, tSomethingWrong }}>
  const btn = document.getElementById('confirm-btn');
  const msg = document.getElementById('confirm-msg');

  btn?.addEventListener('click', async () => {
    btn.disabled = true;
    btn.textContent = tConfirming;

    const res = await fetch('/api/partners/coupon-confirm', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token }),
    }).catch(() => null);

    if (res?.ok) {
      document.getElementById('confirm-ui').innerHTML = `
        <p class="text-5xl mb-4">✅</p>
        <h1 class="text-xl font-bold text-gray-900 mb-3">${tRedemptionConfirmed}</h1>
        <p class="text-sm text-gray-500 leading-relaxed">
          ${tRedemptionDesc}
        </p>
      `;
    } else {
      btn.disabled = false;
      btn.textContent = tConfirmRedemption;
      if (msg) {
        const j = await res?.json().catch(() => ({}));
        msg.textContent = j?.error ?? tSomethingWrong;
        msg.classList.remove('hidden');
      }
    }
  });
</script>
