---
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = (Astro.locals.lang ?? 'en') as string;
const isEl = lang === 'el';
const isBg = lang === 'bg';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? '';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Our Services', item: `${siteUrl}/services` },
  ],
};
---

<BaseLayout
  title="Our Services — KefaloniaBNB"
  description="From curated luxury villa rentals and direct booking to full property management, automated owner payouts, and a professional cleaning marketplace — discover the complete KefaloniaBNB service suite."
  schema={schema}
>

  <!-- Hero -->
  <section class="relative bg-[#1a1a2e] overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(ellipse at 30% 50%, #c9a96e 0%, transparent 55%), radial-gradient(ellipse at 80% 80%, #c9a96e 0%, transparent 40%);"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 text-center">
      <p class="text-[#c9a96e] text-xs font-semibold uppercase tracking-[0.2em] mb-4">{isEl ? 'Τι προσφέρουμε' : isBg ? 'Какво предлагаме' : isSr ? 'Шта нудимо' : isTr ? 'Ne sunuyoruz' : isRo ? 'Ce oferim' : 'What we offer'}</p>
      <h1 class="text-4xl sm:text-5xl font-bold text-white leading-tight mb-6">
        {isEl ? 'Μια ολοκληρωμένη σειρά υπηρεσιών για την ακτή του Αιγαίου' : isBg ? 'Пълна гама от услуги, създадена за брега на Егейско море' : isSr ? 'Потпуна понуда услуга направљена за обалу Егејског мора' : isTr ? 'Ege kıyısı için tasarlanmış eksiksiz bir hizmet paketi' : isRo ? 'O suită completă de servicii create pentru coasta Egee' : <>'A complete suite of services<br class="hidden sm:block" /> crafted for the Aegean coast'</>}
      </h1>
      <p class="text-white/60 text-lg max-w-2xl mx-auto leading-relaxed">
        {isEl ? 'Είτε είστε απαιτητικός επισκέπτης που αναζητά την καλύτερη διαμονή, είτε ιδιοκτήτης ακινήτου που θέλει να αξιοποιήσει το ακίνητό του χωρίς πολυπλοκότητα — η KefaloniaBNB έχει δημιουργηθεί, από τα θεμέλια, για εσάς.' : isBg ? 'Независимо дали сте взискателен гост, търсещ най-добрия престой, или собственик на имот, желаещ да максимизира актива си без излишни усложнения — KefaloniaBNB е изградена, от основите, за вас.' : isSr ? 'Било да сте захтеван гост у потрази за савршеним боравком, или власник некретнине који жели да максимизира свој посед без компликација — KefaloniaBNB је изграђена, од темеља, за вас.' : isTr ? 'İster en iyi konaklamayı arayan seçici bir misafir olun, ister karmaşıklık olmadan varlığınızı maksimize etmek isteyen bir mülk sahibi — KefaloniaBNB, sıfırdan, sizin için inşa edildi.' : isRo ? 'Fie că sunteți un oaspete exigent în căutarea celui mai bun sejur, fie un proprietar care dorește să-și maximizeze activul fără complexitate — KefaloniaBNB a fost construit, de la zero, pentru dumneavoastră.' : 'Whether you are a discerning guest seeking the finest stay, or a property owner looking to maximise your asset without the complexity — KefaloniaBNB has been built, from the ground up, for you.'}
      </p>
    </div>
  </section>

  <!-- Service 1: Villa Rentals -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="order-2 lg:order-1">
        <div class="inline-flex items-center gap-2 bg-[#1a1a2e]/5 rounded-full px-4 py-1.5 mb-6">
          <span class="text-[#c9a96e] text-sm font-semibold uppercase tracking-wider">{isEl ? 'Για Επισκέπτες' : isBg ? 'За Гости' : isSr ? 'За Госте' : isTr ? 'Misafirler İçin' : isRo ? 'Pentru Oaspeți' : 'For Guests'}</span>
        </div>
        <h2 class="text-3xl font-bold text-gray-900 mb-5 leading-snug">{isEl ? 'Ενοικιάσεις Πολυτελών Βιλών — Απευθείας & Χωρίς Προμήθεια' : isBg ? 'Луксозни Вили под Наем — Директно и Без Комисионна' : isSr ? 'Луксузне Виле за Изнајмљивање — Директно и Без Провизије' : isTr ? 'Lüks Villa Kiralama — Doğrudan ve Komisyonsuz' : isRo ? 'Închirieri de Vile de Lux — Direct și Fără Comision' : 'Luxury Villa Rentals — Direct & Commission-Free'}</h2>
        <p class="text-gray-500 leading-relaxed mb-5">
          {isEl ? 'Το επιλεγμένο χαρτοφυλάκιό μας περιλαμβάνει βίλες, παραθαλάσσια διαμερίσματα και ιδιωτικές κατοικίες κατά μήκος της ακτογραμμής Κεραμωτίου και Καβάλας. Κάθε ακίνητο αξιολογείται προσωπικά.' : isBg ? 'Нашето подбрано портфолио включва ръчно избрани вили, апартаменти на плажа и частни вили по крайбрежието на Keramoti и Kefalonia. Всеки имот е лично проверен — за архитектура, завършеност, местоположение и качество на домакина.' : isSr ? 'Наш одабрани портфолио обухвата ручно изабране виле, станове уз плажу и приватна одмаралишта дуж обале Кераmотиja и Кавале. Свака некретнина је лично верификована — за архитектуру, завршну обраду, локацију и квалитет домаћина.' : isTr ? 'Seçilmiş portföyümüz, Keramoti ve Kefalonia kıyı şeridi boyunca el ile seçilmiş villalar, plaj dairesi ve özel tatil evlerini kapsar. Her mülk kişisel olarak incelenir — mimarisi, bitişliği, konumu ve ev sahibinin kalitesi için.' : isRo ? 'Portofoliul nostru selectat cuprinde vile alese manual, apartamente pe plajă și refugii private de-a lungul coastei Keramoti și Kefalonia. Fiecare proprietate este verificată personal — pentru arhitectură, finisaj, amplasament și calitatea gazdei.' : 'Our curated portfolio spans handpicked villas, beachside apartments, and private retreats along the Keramoti and Kefalonia coastline. Each property is personally vetted — for its architecture, its finish, its setting, and the quality of its host.'}
        </p>
        <p class="text-gray-500 leading-relaxed mb-8">
          {isEl ? 'Η απευθείας κράτηση μέσω KefaloniaBNB σημαίνει ότι η τιμή που βλέπετε είναι η τιμή που πληρώνετε. Χωρίς τέλη OTA. Χωρίς προσαυξήσεις πλατφόρμας. Απλώς η καλύτερη διαθέσιμη τιμή.' : isBg ? 'Директната резервация чрез KefaloniaBNB означава, че цената, която виждате, е цената, която плащате. Без такси за OTA услуги. Без надценки на платформата. Само най-добрата налична цена, осигурена за минути чрез нашата сигурна каса — или чрез банков превод за тези, които го предпочитат.' : isSr ? 'Директна резервација преко KefaloniaBNB значи да је цена коју видите цена коју плаћате. Без накнада OTA услуга. Без доплатака платформе. Само најбоља доступна цена, обезбеђена за минуте преко наше сигурне наплате — или банковским трансфером за оне који то преферирају.' : isTr ? 'KefaloniaBNB üzerinden doğrudan rezervasyon yapmak, gördüğünüz fiyatın ödediğiniz fiyat olduğu anlamına gelir. OTA hizmet ücreti yok. Platform zammı yok. Sadece güvenli ödeme sistemimiz üzerinden dakikalar içinde güvence altına alınan en iyi mevcut fiyat — veya tercih edenler için banka transferi.' : isRo ? 'Rezervarea directă prin KefaloniaBNB înseamnă că prețul pe care îl vedeți este prețul pe care îl plătiți. Fără taxe de serviciu OTA. Fără adaosuri de platformă. Doar cel mai bun tarif disponibil, securizat în câteva minute prin checkout-ul nostru securizat — sau prin transfer bancar pentru cei care preferă.' : 'Booking directly through KefaloniaBNB means the price you see is the price you pay. No OTA service fees. No platform markups. Just the best available rate, secured in minutes through our secure checkout — or via bank transfer for those who prefer it.'}
        </p>
        <ul class="space-y-3 mb-8">
          {[
            isEl ? 'Άμεση πληρωμή με κάρτα ή τραπεζική μεταφορά' : isBg ? 'Незабавно плащане с карта чрез Stripe или банков превод' : isSr ? 'Тренутно плаћање картицом или банковни трансфер' : isTr ? 'Anında Stripe kart ödemesi veya banka transferi' : isRo ? 'Checkout instant cu cardul Stripe sau transfer bancar' : 'Instant Stripe card checkout or bank transfer',
            isEl ? 'Άμεση επικοινωνία με τον ιδιοκτήτη — χωρίς bots, χωρίς τηλεφωνικά κέντρα' : isBg ? 'Директна комуникация с домакина — без ботове, без кол центрове' : isSr ? 'Директна комуникација са домаћином — без ботова, без позивних центара' : isTr ? 'Ev sahibiyle doğrudan iletişim — bot yok, çağrı merkezi yok' : isRo ? 'Comunicare directă cu gazda — fără boți, fără call centre' : 'Direct communication with your host — no bots, no call centres',
            isEl ? 'Καλύτερη τιμή εγγυημένη — πάντα φθηνότερα από τις πλατφόρμες OTA' : isBg ? 'Гарантирана най-добра цена — винаги по-евтино от OTA платформите' : isSr ? 'Гарантована најбоља цена — увек јефтиније од OTA платформи' : isTr ? 'En iyi fiyat garantili — her zaman OTA platformlarından ucuz' : isRo ? 'Cel mai bun preț garantat — întotdeauna mai ieftin decât platformele OTA' : 'Best rate guaranteed — always cheaper than OTA platforms',
            isEl ? 'Ευέλικτες επιλογές ακύρωσης ανά ακίνητο' : isBg ? 'Гъвкави опции за анулиране за всеки имот' : isSr ? 'Флексибилне опције отказивања по некретнини' : isTr ? 'Mülk bazında esnek iptal seçenekleri' : isRo ? 'Opțiuni flexibile de anulare per proprietate' : 'Flexible cancellation options per property',
            isEl ? 'Αυτόνομο check-in ή προσωπική υποδοχή — εσείς επιλέγετε' : isBg ? 'Самостоятелно настаняване или лично посрещане — ваш избор' : isSr ? 'Самостални пријем или лично дочекивање — ваш избор' : isTr ? 'Kendi kendine giriş veya kişisel karşılama — tercihiniz' : isRo ? 'Self check-in sau primire personală — alegerea dumneavoastră' : 'Self check-in or personal welcome — your choice',
          ].map(item => (
            <li class="flex items-start gap-3 text-sm text-gray-600">
              <span class="text-[#c9a96e] font-bold mt-0.5 flex-shrink-0">✦</span>
              {item}
            </li>
          ))}
        </ul>
        <a href="/rentals" class="inline-block bg-[#1a1a2e] hover:bg-[#2d2d4e] text-white font-semibold px-7 py-3 rounded-xl text-sm transition-colors">
          {isEl ? 'Δείτε τις βίλες μας →' : isBg ? 'Разгледайте нашите вили →' : isSr ? 'Прегледајте наше виле →' : isTr ? 'Villalarımıza göz atın →' : isRo ? 'Răsfoiește vilele noastre →' : 'Browse our villas →'}
        </a>
      </div>
      <div class="order-1 lg:order-2">
        <div class="bg-gradient-to-br from-[#1a1a2e] to-[#0f3460] rounded-2xl aspect-square flex flex-col items-center justify-center gap-6 p-10">
          <div class="text-7xl">🏖️</div>
          <div class="grid grid-cols-2 gap-3 w-full">
            {[
              { icon: '💳', label: isEl ? 'Ασφαλής πληρωμή' : isBg ? 'Сигурно плащане' : isSr ? 'Сигурно плаћање' : isTr ? 'Güvenli ödeme' : isRo ? 'Checkout securizat' : 'Secure checkout' },
              { icon: '🌊', label: isEl ? 'Παραθαλάσσιες βίλες' : isBg ? 'Вили на плажа' : isSr ? 'Виле уз плажу' : isTr ? 'Plaj kenarı villalar' : isRo ? 'Vile pe plajă' : 'Beachside villas' },
              { icon: '🔑', label: isEl ? 'Αυτόνομο check-in' : isBg ? 'Самостоятелно настаняване' : isSr ? 'Самостални пријем' : isTr ? 'Kendi kendine giriş' : isRo ? 'Self check-in' : 'Self check-in' },
              { icon: '⭐', label: isEl ? 'Ποιότητα 5★' : isBg ? 'Качество 5★' : isSr ? 'Квалитет 5★' : isTr ? '5★ kalite' : isRo ? 'Calitate 5★' : '5★ quality' },
            ].map(f => (
              <div class="bg-white/10 rounded-xl p-3 text-center">
                <div class="text-xl mb-1">{f.icon}</div>
                <p class="text-white/70 text-xs font-medium">{f.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="border-t border-gray-100"></div>
  </div>

  <!-- Service 2: Property Management -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <div class="bg-gradient-to-br from-[#1a1a2e] to-[#0f3460] rounded-2xl aspect-square flex flex-col items-center justify-center gap-6 p-10">
          <div class="text-7xl">📊</div>
          <div class="grid grid-cols-2 gap-3 w-full">
            {[
              { icon: '📅', label: isEl ? 'Ημερολόγιο κρατήσεων' : isBg ? 'Календар за резервации' : isSr ? 'Календар резервација' : isTr ? 'Rezervasyon takvimi' : isRo ? 'Calendar rezervări' : 'Booking calendar' },
              { icon: '💶', label: isEl ? 'Παρακολούθηση εσόδων' : isBg ? 'Проследяване на приходи' : isSr ? 'Праћење прихода' : isTr ? 'Gelir takibi' : isRo ? 'Urmărire venituri' : 'Revenue tracking' },
              { icon: '💳', label: isEl ? 'Αυτόματες αποδόσεις' : isBg ? 'Автоматични плащания' : isSr ? 'Аутоматске исплате' : isTr ? 'Otomatik ödemeler' : isRo ? 'Plăți automate' : 'Auto payouts' },
              { icon: '🔔', label: isEl ? 'Ζωντανές ειδοποιήσεις' : isBg ? 'Известия на живо' : isSr ? 'Уживо обавештења' : isTr ? 'Canlı bildirimler' : isRo ? 'Alerte live' : 'Live alerts' },
            ].map(f => (
              <div class="bg-white/10 rounded-xl p-3 text-center">
                <div class="text-xl mb-1">{f.icon}</div>
                <p class="text-white/70 text-xs font-medium">{f.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div>
        <div class="inline-flex items-center gap-2 bg-[#1a1a2e]/5 rounded-full px-4 py-1.5 mb-6">
          <span class="text-[#c9a96e] text-sm font-semibold uppercase tracking-wider">{isEl ? 'Για Ιδιοκτήτες Ακινήτων' : isBg ? 'За Собственици на Имоти' : isSr ? 'За Власнике Некретнина' : isTr ? 'Mülk Sahipleri İçin' : isRo ? 'Pentru Proprietari' : 'For Property Owners'}</span>
        </div>
        <h2 class="text-3xl font-bold text-gray-900 mb-5 leading-snug">{isEl ? 'Πλήρης Διαχείριση Ακινήτου — Δικό σας, Βελτιστοποιημένο από εμάς' : isBg ? 'Пълно Управление на Имота — Ваш, Оптимизиран от Нас' : isSr ? 'Потпуно Управљање Некретнином — Ваша, Оптимизована од стране нас' : isTr ? 'Tam Mülk Yönetimi — Size Ait, Bizim Tarafımızdan Optimize Edilmiş' : isRo ? 'Management Complet al Proprietății — A Dumneavoastră, Optimizată de Noi' : 'Full Property Management — Owned by You, Optimised by Us'}</h2>
        <p class="text-gray-500 leading-relaxed mb-5">
          {isEl ? 'Το ακίνητό σας είναι μια επένδυση. Η πύλη ιδιοκτητών μας σας δίνει πλήρη ορατότητα και έλεγχο — ένας ιδιωτικός πίνακας ελέγχου όπου κάθε κράτηση, κάθε πληρωμή και κάθε αλληλεπίδραση με επισκέπτες είναι στα χέρια σας.' : isBg ? 'Вашият имот е актив. Нашият портал за собственици ви дава пълна видимост и контрол — личен контролен панел, където всяка резервация, всяко плащане и всяко взаимодействие с гости е на ваши ръце, в реално време.' : isSr ? 'Ваша некретнина је средство. Наш портал за власнике даје вам потпуну видљивост и контролу — приватна контролна табла где је свака резервација, свако плаћање и свака интеракција са гостима у вашим рукама, у реалном времену.' : isTr ? 'Mülkünüz bir varlıktır. Mülk sahibi portalımız size tam görünürlük ve kontrol sağlar — her rezervasyonun, her ödemenin ve her misafir etkileşiminin parmaklarınızın ucunda olduğu özel bir pano, gerçek zamanlı.' : isRo ? 'Proprietatea dumneavoastră este un activ. Portalul nostru pentru proprietari vă oferă vizibilitate și control complet — un tablou de bord privat unde fiecare rezervare, fiecare plată și fiecare interacțiune cu oaspeții sunt la îndemâna dumneavoastră, în timp real.' : 'Your property is an asset. Our owner portal gives you complete visibility and control — a private dashboard where every booking, every payment, and every guest interaction is at your fingertips, in real time.'}
        </p>
        <p class="text-gray-500 leading-relaxed mb-8">
          {isEl ? 'Από τη στιγμή που κάνει κράτηση ένας επισκέπτης έως ότου εκκαθαριστεί η πληρωμή του, είστε ενημερωμένοι. Ζωντανές ειδοποιήσεις, πίνακες εσόδων και διαφανές μητρώο αποδόσεων διασφαλίζουν ότι τίποτα δεν χάνεται.' : isBg ? 'От момента, в който гост резервира, до момента на изчистване на плащането му, вие сте информирани. Известия на живо, табла за приходи и прозрачен регистър на плащанията гарантират, че нищо не се изплъзва.' : isSr ? 'Од тренутка када гост резервише до тренутка када се плаћање обради, ви сте обавештени. Уживо обавештења, панели прихода и транспарентна евиденција исплата осигуравају да ништа не проклизне.' : isTr ? 'Bir misafirin rezervasyon yaptığı andan ödemenin gerçekleştiği ana kadar bilgilendirilirsiniz. Canlı bildirimler, gelir panoları ve şeffaf ödeme defteri hiçbir şeyin gözden kaçmamasını sağlar.' : isRo ? 'Din momentul în care un oaspete rezervă până în momentul în care plata se procesează, sunteți informat. Alerte de notificare live, tablouri de venituri și un registru transparent de plăți asigură că nimic nu scapă.' : 'From the moment a guest books to the moment their payment clears, you are informed. Live notification alerts, revenue dashboards, and a transparent payout ledger ensure nothing falls through the cracks.'}
        </p>
        <ul class="space-y-3 mb-8">
          {[
            isEl ? 'Ιδιωτικός πίνακας ιδιοκτήτη με ζωντανό ημερολόγιο κρατήσεων και ανάλυση εσόδων' : isBg ? 'Личен панел на собственика с жив календар за резервации и анализ на приходи' : isSr ? 'Приватна контролна табла власника са живим календаром резервација и аналитиком прихода' : isTr ? 'Canlı rezervasyon takvimi ve gelir analitiği ile özel mülk sahibi panosu' : isRo ? 'Tablou de bord privat cu calendar live de rezervări și analiză de venituri' : 'Private owner dashboard with live booking calendar and revenue analytics',
            isEl ? 'Αυτόματες αποδόσεις — το μερίδιό σας μεταφέρεται με κάθε κράτηση' : isBg ? 'Автоматизирани плащания чрез Stripe — вашият дял се прехвърля при всяка резервация' : isSr ? 'Аутоматске Stripe исплате — ваш удео пренесен са сваком резервацијом' : isTr ? 'Otomatik Stripe ödemeleri — her rezervasyonda payınız aktarılır' : isRo ? 'Plăți automate Stripe — partea dumneavoastră transferată la fiecare rezervare' : 'Automated Stripe payouts — your share transferred on every booking',
            isEl ? 'Πλήρες ιστορικό αποδόσεων: κερδισμένα, μεταφερθέντα, εκκρεμή — με μια ματιά' : isBg ? 'Пълна история на плащанията: спечелени, прехвърлени, чакащи — с един поглед' : isSr ? 'Потпуна историја исплата: зарађено, пренесено, на чекању — на prvi поглед' : isTr ? 'Tam ödeme geçmişi: kazanılan, aktarılan, bekleyen — bir bakışta' : isRo ? 'Istoric complet al plăților: câștigat, transferat, în așteptare — dintr-o privire' : 'Full payout history: earned, transferred, pending — at a glance',
