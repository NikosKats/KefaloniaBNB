---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getServiceClient } from '../../../lib/supabase.ts';

const { slug } = Astro.params;
const service = getServiceClient();
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://kefaloniabnb.com';
const lang = ((Astro.locals as any).lang ?? 'en') as string;
const isBg = lang === 'bg';
const isEl = lang === 'el';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';

const { data: restaurant } = await service
  .from('restaurants')
  .select('id, slug, name, city, cuisine_type, google_place_id, cover_photo')
  .eq('slug', slug)
  .eq('is_active', true)
  .single();

if (!restaurant) return Astro.redirect('/community/restaurants');

const googleReviewUrl = restaurant.google_place_id
  ? `https://search.google.com/local/writereview?placeid=${restaurant.google_place_id}`
  : null;

const googleSearchUrl = `https://www.google.com/maps/search/${encodeURIComponent(restaurant.name + ' ' + (restaurant.city ?? '') + ' Greece')}`;

const reserveUrl = `${siteUrl}/community/restaurants/${restaurant.slug}/reserve`;
const cuisineText = (restaurant.cuisine_type ?? []).join(', ');

const tEnjoyedMeal = isEl ? 'Σας άρεσε το γεύμα;' : isBg ? 'Хареса ли ви ястието?' : isSr ? 'Уживали сте у оброку?' : isTr ? 'Yemeğinizi beğendiniz mi?' : isRo ? 'V-a plăcut masa?' : 'Enjoyed your meal?';
const tReviewIntro = isEl ? 'Θα θέλαμε να μάθουμε για τη γαστρονομική σας εμπειρία. Η αξιολόγησή σας βοηθά άλλους να ανακαλύψουν υπέροχο φαγητό.' : isBg ? 'Ще се радваме да чуем за вашето кулинарно преживяване. Вашата рецензия помага на други посетители да открият страхотна храна в района.' : isSr ? 'Волели бисмо да чујемо о вашем кулинарском искуству. Ваша рецензија помаже другим посетиоцима.' : isTr ? 'Yemek deneyiminiz hakkında bilgi almak isteriz. Değerlendirmeniz diğer ziyaretçilere yardımcı olur.' : isRo ? 'Ne-ar plăcea să aflăm despre experiența dvs. culinară. Recenzia dvs. îi ajută pe alți vizitatori să descopere mâncare grozavă în zonă.' : "We'd love to hear about your dining experience. Your review helps other visitors discover great food in the area.";
const tReviewGoogle = isEl ? 'Αξιολόγηση στο Google' : isBg ? 'Оценете в Google' : isSr ? 'Оцените на Google-у' : isTr ? "Google'da Değerlendirin" : isRo ? 'Recenzie pe Google' : 'Review on Google';
const tFindGoogle = isEl ? 'Βρείτε μας στο Google Maps' : isBg ? 'Намерете ни в Google Maps' : isSr ? 'Пронађите нас на Google Maps' : isTr ? "Google Maps'te bulun" : isRo ? 'Găsiți-ne pe Google Maps' : 'Find us on Google Maps';
const tReserveTable = isEl ? 'Κράτηση τραπεζιού' : isBg ? 'Резервирайте маса' : isSr ? 'Резервишите сто' : isTr ? 'Masa Rezervasyonu' : isRo ? 'Rezervă o Masă' : 'Reserve a Table';
const tBrowseAll = isEl ? 'Δείτε όλα τα εστιατόρια →' : isBg ? 'Разгледайте всички ресторанти →' : isSr ? 'Прегледајте све ресторане →' : isTr ? 'Tüm restoranları görüntüle →' : isRo ? 'Vezi toate restaurantele →' : 'Browse all restaurants →';
const tDiscoverDining = isEl ? '— Ανακαλύψτε τα καλύτερα εστιατόρια της περιοχής' : isBg ? '— Открийте най-доброто хранене в района' : isSr ? '— Откријте најбоље ресторане у области' : isTr ? '— Bölgedeki en iyi restoranları keşfedin' : isRo ? '— Descoperiți cele mai bune restaurante din zonă' : '— Discover the best dining in the area';
---

<BaseLayout
  title={`Review ${restaurant.name}`}
  description={`Leave a review for ${restaurant.name} in ${restaurant.city ?? 'Greece'} — share your dining experience on kefaloniabnb.com or Google.`}
  noIndex={true}
>
  <div class="min-h-[70vh] flex items-center justify-center px-4 py-16">
    <div class="max-w-md w-full text-center">

      {restaurant.cover_photo ? (
        <img src={restaurant.cover_photo} alt={restaurant.name} class="w-20 h-20 rounded-2xl object-cover mx-auto mb-6" />
      ) : (
        <div class="w-16 h-16 bg-[#1a1a2e] rounded-2xl flex items-center justify-center mx-auto mb-6">
          <span class="text-white text-2xl">🍽️</span>
        </div>
      )}

      <h1 class="text-2xl font-bold text-gray-900 mb-2">{tEnjoyedMeal}</h1>
      <p class="text-gray-500 mb-1">{restaurant.name}</p>
      {restaurant.city && <p class="text-sm text-gray-400 mb-1">{restaurant.city}, Greece</p>}
      {cuisineText && <p class="text-xs text-gray-400 mb-8">{cuisineText}</p>}

      <p class="text-gray-600 mb-8">
        {tReviewIntro}
      </p>

      <div class="space-y-3">

        {/* Google Review — primary CTA */}
        {googleReviewUrl ? (
          <a
            href={googleReviewUrl}
            target="_blank"
            rel="noopener"
            class="flex items-center justify-center gap-3 w-full py-3.5 px-6 bg-white border-2 border-gray-200 rounded-2xl font-semibold text-gray-900 hover:border-blue-400 hover:shadow-md transition-all"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            {tReviewGoogle}
          </a>
        ) : (
          <a
            href={googleSearchUrl}
            target="_blank"
            rel="noopener"
            class="flex items-center justify-center gap-3 w-full py-3.5 px-6 bg-white border-2 border-gray-200 rounded-2xl font-semibold text-gray-900 hover:border-blue-400 hover:shadow-md transition-all"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            {tFindGoogle}
          </a>
        )}

        {/* Reserve a table */}
        <a
          href={reserveUrl}
          class="flex items-center justify-center gap-3 w-full py-3.5 px-6 bg-[#1a1a2e] text-white rounded-2xl font-semibold hover:bg-[#2d2d4e] transition-colors"
        >
          <span class="text-lg">📅</span>
          {tReserveTable}
        </a>

        {/* View restaurant */}
        <a
          href={`/community/restaurants`}
          class="block w-full py-3 text-sm text-gray-400 hover:text-gray-600 transition-colors"
        >
          {tBrowseAll}
        </a>
      </div>

      <div class="mt-12 pt-6 border-t border-gray-100">
        <p class="text-xs text-gray-400">
          <a href={siteUrl} class="font-semibold text-[#1a1a2e] hover:text-[#c9a96e] transition-colors">kefaloniabnb.com</a>
          {tDiscoverDining}
        </p>
      </div>

    </div>
  </div>
</BaseLayout>
