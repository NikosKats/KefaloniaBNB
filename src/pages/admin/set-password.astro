---
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Set Your Password – KefaloniaBNB</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
</head>
<body class="min-h-screen bg-[#1a1a2e] flex items-center justify-center px-4 font-['Inter']">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <div class="w-12 h-12 bg-[#c9a96e] rounded-xl flex items-center justify-center mx-auto mb-4">
        <span class="text-white font-bold text-xl">V</span>
      </div>
      <h1 class="text-white text-2xl font-bold">KefaloniaBNB</h1>
      <p class="text-gray-400 text-sm mt-1">Set your password</p>
    </div>

    <div id="error-banner" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm p-3 rounded-xl mb-4"></div>
    <div id="success-banner" class="hidden bg-green-500/10 border border-green-500/30 text-green-400 text-sm p-3 rounded-xl mb-4"></div>

    <div id="form-card" class="bg-white/5 border border-white/10 rounded-2xl p-8">
      <p class="text-gray-400 text-sm mb-6">Choose a password for your KefaloniaBNB account.</p>
      <form id="set-password-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1.5">New password</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="8"
            autocomplete="new-password"
            class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white text-sm outline-none focus:ring-2 focus:ring-[#c9a96e] focus:border-transparent placeholder-gray-600"
            placeholder="Minimum 8 characters"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1.5">Confirm password</label>
          <input
            type="password"
            id="confirm-password"
            name="confirm_password"
            required
            minlength="8"
            autocomplete="new-password"
            class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white text-sm outline-none focus:ring-2 focus:ring-[#c9a96e] focus:border-transparent placeholder-gray-600"
            placeholder="Repeat your password"
          />
        </div>
        <button
          type="submit"
          id="submit-btn"
          class="w-full bg-[#c9a96e] hover:bg-[#b8934a] text-white font-semibold py-3 rounded-xl text-sm transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Set password
        </button>
      </form>
    </div>

    <p class="text-center mt-4">
      <a href="/" class="text-gray-500 text-xs hover:text-gray-400 transition-colors">← Back to website</a>
    </p>
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    );

    const errorBanner  = document.getElementById('error-banner')!;
    const successBanner = document.getElementById('success-banner')!;
    const formCard     = document.getElementById('form-card')!;
    const form         = document.getElementById('set-password-form') as HTMLFormElement;
    const submitBtn    = document.getElementById('submit-btn') as HTMLButtonElement;

    function showError(msg: string) {
      errorBanner.textContent = msg;
      errorBanner.classList.remove('hidden');
      successBanner.classList.add('hidden');
    }

    // ── Step 1: exchange the recovery token from the URL hash ─────────────────
    // Supabase appends #access_token=...&refresh_token=...&type=recovery to the
    // redirectTo URL. We must call setSession() before the user can update their
    // password.

    async function init() {
      const hash = window.location.hash.slice(1); // strip leading '#'
      const params = new URLSearchParams(hash);
      const type = params.get('type');
      const accessToken = params.get('access_token');
      const refreshToken = params.get('refresh_token');
      const errorCode = params.get('error_code');
      const errorDesc = params.get('error_description');

      if (errorCode) {
        formCard.classList.add('hidden');
        showError(
          errorDesc
            ? decodeURIComponent(errorDesc.replace(/\+/g, ' '))
            : 'This invite link is invalid or has expired. Please ask the admin to send a new invite.',
        );
        return;
      }

      if (type !== 'recovery' || !accessToken || !refreshToken) {
        formCard.classList.add('hidden');
        showError('Invalid invite link. Please ask the admin to send a new invite.');
        return;
      }

      // Exchange the tokens so we have an active session for updateUser()
      const { error: sessionError } = await supabase.auth.setSession({
        access_token: accessToken,
        refresh_token: refreshToken,
      });

      if (sessionError) {
        formCard.classList.add('hidden');
        showError('This invite link has expired. Please ask the admin to send a new invite.');
        return;
      }

      // Clean the tokens from the URL bar without triggering a reload
      history.replaceState(null, '', window.location.pathname);
    }

    // ── Step 2: handle password form submission ───────────────────────────────
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBanner.classList.add('hidden');

      const password        = (document.getElementById('password') as HTMLInputElement).value;
      const confirmPassword = (document.getElementById('confirm-password') as HTMLInputElement).value;

      if (password !== confirmPassword) {
        showError('Passwords do not match.');
        return;
      }
      if (password.length < 8) {
        showError('Password must be at least 8 characters.');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Saving…';

      const { error } = await supabase.auth.updateUser({ password });

      if (error) {
        showError(error.message);
        submitBtn.disabled = false;
        submitBtn.textContent = 'Set password';
        return;
      }

      formCard.classList.add('hidden');
      successBanner.textContent = 'Password set! Redirecting to admin…';
      successBanner.classList.remove('hidden');

      setTimeout(() => { window.location.href = '/admin'; }, 1500);
    });

    init();
  </script>
</body>
</html>
