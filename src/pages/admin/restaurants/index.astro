---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getServiceClient } from '../../../lib/supabase.ts';

const service = getServiceClient();
const { data: restaurants } = await service
  .from('restaurants')
  .select('*')
  .order('created_at', { ascending: false });

// Fetch restaurant_owner profiles for assignment dropdown
const { data: restaurantOwners } = await service
  .from('profiles')
  .select('id, full_name, email')
  .eq('role', 'restaurant_owner')
  .order('full_name');

Astro.response.headers.set('Cache-Control', 'no-store');
---

<AdminLayout title="Restaurants">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-white">Restaurants</h1>
      <div class="flex gap-2">
        <button id="invite-owner-btn" class="bg-white/10 text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-white/20 border border-white/20">+ Invite Owner</button>
        <button id="add-btn" class="bg-[#c9a96e] text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-[#b89556]">+ Add Restaurant</button>
      </div>
    </div>

    {/* Invite Restaurant Owner Modal */}
    <div id="invite-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4">
      <div class="bg-[#1e1e3a] rounded-2xl p-6 w-full max-w-md shadow-2xl border border-white/10">
        <h3 class="font-semibold text-white mb-4">Invite Restaurant Owner</h3>
        <div class="space-y-3">
          <div>
            <label class="block text-xs text-gray-400 mb-1">Full name *</label>
            <input id="inv-name" type="text" class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]" placeholder="Restaurant owner name" />
          </div>
          <div>
            <label class="block text-xs text-gray-400 mb-1">Email *</label>
            <input id="inv-email" type="email" class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]" placeholder="owner@restaurant.com" />
          </div>
          <p class="text-xs text-gray-500">They'll receive a link to set their password and log in to manage reservations.</p>
        </div>
        <div id="invite-error" class="hidden mt-3 text-sm text-red-400"></div>
        <div id="invite-success" class="hidden mt-3 text-sm text-green-400"></div>
        <div class="flex gap-3 mt-5">
          <button id="invite-cancel" class="flex-1 px-4 py-2 border border-white/20 rounded-xl text-sm text-gray-300 hover:bg-white/5 transition-colors">Cancel</button>
          <button id="invite-submit" class="flex-1 bg-[#c9a96e] text-white font-semibold px-4 py-2 rounded-xl text-sm hover:bg-[#b89556] transition-colors">Send Invite</button>
        </div>
      </div>
    </div>

    <!-- Add/Edit form -->
    <div id="rest-form-wrap" class="hidden bg-white/5 rounded-xl border border-white/10 p-6">
      <h2 class="text-lg font-semibold text-white mb-4" id="form-title">Add Restaurant</h2>
      <form id="rest-form" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <input type="hidden" name="id" />
        <div>
          <label class="block text-xs text-gray-400 mb-1">Name *</label>
          <input type="text" name="name" required class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]" />
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">City</label>
          <input type="text" name="city" value="Keramoti" class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]" />
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Phone</label>
          <input type="text" name="phone" class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]" />
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Address</label>
          <input type="text" name="address" class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]" />
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Website</label>
          <input type="url" name="website" class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]" />
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Google Maps URL</label>
          <input type="url" name="google_maps_url" class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]" />
        </div>
        <div class="sm:col-span-2">
          <label class="block text-xs text-gray-400 mb-1">Photos</label>
          <p class="text-xs text-gray-500 mb-2">Save the restaurant first, then upload photos below.</p>
          <input type="hidden" name="cover_photo" />
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Price Range</label>
          <select name="price_range" class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]">
            <option value="" class="text-black">--</option>
            <option value="budget" class="text-black">€ Budget</option>
            <option value="moderate" class="text-black">€€ Moderate</option>
            <option value="upscale" class="text-black">€€€ Upscale</option>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label class="block text-xs text-gray-400 mb-1">Description (EN)</label>
          <textarea name="description" rows="2" class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e] resize-y"></textarea>
        </div>
        <div class="sm:col-span-2">
          <label class="block text-xs text-gray-400 mb-1">Description (EL)</label>
          <textarea name="description_el" rows="2" class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e] resize-y"></textarea>
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Cuisine (comma-separated)</label>
          <input type="text" name="cuisine_type" placeholder="seafood, greek, taverna" class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]" />
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Features (comma-separated)</label>
          <input type="text" name="features" placeholder="sea_view, outdoor_seating, delivery" class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]" />
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">TripAdvisor URL</label>
          <input type="url" name="tripadvisor_url" placeholder="https://tripadvisor.com/..." class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]" />
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Google Business URL</label>
          <input type="url" name="google_business_url" placeholder="https://g.co/..." class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]" />
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Facebook URL</label>
          <input type="url" name="facebook_url" placeholder="https://facebook.com/..." class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]" />
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Instagram URL</label>
          <input type="url" name="instagram_url" placeholder="https://instagram.com/..." class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]" />
        </div>
        <div class="flex items-center gap-4">
          <label class="flex items-center gap-2 text-sm text-gray-300">
            <input type="checkbox" name="is_partner" class="rounded" /> Partner
          </label>
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Restaurant Owner</label>
          <select name="owner_id" class="w-full bg-white/10 text-white px-3 py-2 rounded-lg border border-white/20 text-sm outline-none focus:border-[#c9a96e]">
            <option value="" class="text-black">-- No owner --</option>
            {(restaurantOwners ?? []).map((o: any) => (
              <option value={o.id} class="text-black">{o.full_name} ({o.email})</option>
            ))}
          </select>
        </div>
        <div class="sm:col-span-2 flex gap-2">
          <button type="submit" class="bg-[#c9a96e] text-white px-6 py-2 rounded-lg text-sm font-semibold hover:bg-[#b89556]">Save</button>
          <button type="button" id="cancel-btn" class="bg-white/10 text-gray-300 px-6 py-2 rounded-lg text-sm hover:bg-white/20">Cancel</button>
        </div>
      </form>
    </div>

    <!-- List -->
    {(!restaurants || restaurants.length === 0) ? (
      <div class="text-center py-16 text-gray-500">
        <p class="text-4xl mb-2">🍽️</p>
        <p>No restaurants yet</p>
      </div>
    ) : (
      <div class="space-y-3">
        {(restaurants ?? []).map((r: any) => (
          <div class="bg-white/5 rounded-xl border border-white/10 rest-row" data-id={r.id}
            data-json={JSON.stringify({ id: r.id, name: r.name, city: r.city, phone: r.phone ?? '', address: r.address ?? '', website: r.website ?? '', google_maps_url: r.google_maps_url ?? '', cover_photo: r.cover_photo ?? '', photo_urls: r.photo_urls ?? [], price_range: r.price_range ?? '', description: r.description ?? '', description_el: r.description_el ?? '', cuisine_type: (r.cuisine_type ?? []).join(', '), features: (r.features ?? []).join(', '), is_partner: r.is_partner, tripadvisor_url: r.tripadvisor_url ?? '', google_business_url: r.google_business_url ?? '', facebook_url: r.facebook_url ?? '', instagram_url: r.instagram_url ?? '' })}>
            <div class="p-4 flex items-center justify-between gap-4">
              <div class="flex items-center gap-3 min-w-0">
                {r.cover_photo ? (
                  <img src={r.cover_photo} alt={r.name} class="w-12 h-12 rounded-lg object-cover flex-shrink-0" />
                ) : (
                  <div class="w-12 h-12 rounded-lg bg-white/10 flex items-center justify-center text-xl flex-shrink-0">🍽️</div>
                )}
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span class="font-semibold text-white truncate">{r.name}</span>
                    {r.is_partner && <span class="text-xs bg-[#c9a96e]/20 text-[#c9a96e] px-1.5 py-0.5 rounded">Partner</span>}
                    {!r.is_active && <span class="text-xs bg-red-900/30 text-red-400 px-1.5 py-0.5 rounded">Inactive</span>}
                  </div>
                  <div class="text-xs text-gray-400 flex items-center gap-2">
                    <span>📍 {r.city ?? 'Keramoti'}</span>
                    {r.phone && <span>📞 {r.phone}</span>}
                    {r.cuisine_type?.length > 0 && <span>{r.cuisine_type.join(', ')}</span>}
                    <span class="text-gray-500">· {(r.photo_urls ?? []).length + (r.cover_photo ? 1 : 0)} photos</span>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                <button class="photos-btn text-xs text-blue-400 hover:underline" data-id={r.id}>Photos</button>
                <button class="edit-btn text-xs text-[#c9a96e] hover:underline" data-id={r.id}>Edit</button>
                <button class="toggle-btn text-xs text-gray-400 hover:text-white" data-id={r.id} data-active={r.is_active}>{r.is_active ? 'Deactivate' : 'Activate'}</button>
                <button class="del-btn text-xs text-red-400 hover:text-red-300" data-id={r.id}>Delete</button>
              </div>
            </div>

            {/* Photo manager panel (hidden) */}
            <div class="photos-panel hidden border-t border-white/10 p-4" data-id={r.id}>
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-sm font-semibold text-white">Photos</h3>
                <label class="upload-photo-label cursor-pointer bg-[#c9a96e] text-white px-3 py-1.5 rounded-lg text-xs font-medium hover:bg-[#b89556]">
                  + Upload Photo
                  <input type="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple class="hidden upload-photo-input" data-id={r.id} />
                </label>
              </div>
              <div class="upload-status text-xs text-gray-400 hidden mb-2" data-id={r.id}></div>
              <div class="photo-grid grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-2" data-id={r.id}>
                {r.cover_photo && (
                  <div class="relative group">
                    <img src={r.cover_photo} alt="Cover" class="w-full aspect-square object-cover rounded-lg" />
                    <span class="absolute top-1 left-1 bg-[#c9a96e] text-white text-[10px] px-1.5 py-0.5 rounded font-medium">Cover</span>
                    <button class="remove-photo-btn absolute top-1 right-1 bg-red-600/80 text-white w-5 h-5 rounded-full text-xs opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center" data-restaurant-id={r.id} data-url={r.cover_photo} data-type="cover">&times;</button>
                  </div>
                )}
                {(r.photo_urls ?? []).map((url: string, idx: number) => (
                  <div class="relative group">
                    <img src={url} alt={`Photo ${idx + 1}`} class="w-full aspect-square object-cover rounded-lg" />
                    <div class="absolute top-1 right-1 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                      <button class="set-cover-btn bg-[#c9a96e]/80 text-white w-5 h-5 rounded-full text-[10px] flex items-center justify-center" data-restaurant-id={r.id} data-url={url} title="Set as cover">★</button>
                      <button class="remove-photo-btn bg-red-600/80 text-white w-5 h-5 rounded-full text-xs flex items-center justify-center" data-restaurant-id={r.id} data-url={url} data-type="gallery">&times;</button>
                    </div>
                  </div>
                ))}
              </div>
              {!r.cover_photo && (r.photo_urls ?? []).length === 0 && (
                <p class="text-xs text-gray-500 text-center py-4">No photos yet. Upload some!</p>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</AdminLayout>

<script>
  const formWrap = document.getElementById('rest-form-wrap')!;
  const form = document.getElementById('rest-form') as HTMLFormElement;
  const formTitle = document.getElementById('form-title')!;

  document.getElementById('add-btn')?.addEventListener('click', () => {
    form.reset();
    (form.querySelector('[name="id"]') as HTMLInputElement).value = '';
    formTitle.textContent = 'Add Restaurant';
    formWrap.classList.remove('hidden');
  });

  document.getElementById('cancel-btn')?.addEventListener('click', () => {
    formWrap.classList.add('hidden');
  });

  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const row = (btn as HTMLElement).closest('.rest-row') as HTMLElement;
      const data = JSON.parse(row.dataset.json!);
      (form.querySelector('[name="id"]') as HTMLInputElement).value = data.id;
      (form.querySelector('[name="name"]') as HTMLInputElement).value = data.name;
      (form.querySelector('[name="city"]') as HTMLInputElement).value = data.city;
      (form.querySelector('[name="phone"]') as HTMLInputElement).value = data.phone;
      (form.querySelector('[name="address"]') as HTMLInputElement).value = data.address;
      (form.querySelector('[name="website"]') as HTMLInputElement).value = data.website;
      (form.querySelector('[name="google_maps_url"]') as HTMLInputElement).value = data.google_maps_url;
      (form.querySelector('[name="price_range"]') as HTMLSelectElement).value = data.price_range;
      (form.querySelector('[name="description"]') as HTMLTextAreaElement).value = data.description;
      (form.querySelector('[name="description_el"]') as HTMLTextAreaElement).value = data.description_el;
      (form.querySelector('[name="cuisine_type"]') as HTMLInputElement).value = data.cuisine_type;
      (form.querySelector('[name="features"]') as HTMLInputElement).value = data.features;
      (form.querySelector('[name="is_partner"]') as HTMLInputElement).checked = data.is_partner;
      (form.querySelector('[name="tripadvisor_url"]') as HTMLInputElement).value = data.tripadvisor_url;
      (form.querySelector('[name="google_business_url"]') as HTMLInputElement).value = data.google_business_url;
      (form.querySelector('[name="facebook_url"]') as HTMLInputElement).value = data.facebook_url;
      (form.querySelector('[name="instagram_url"]') as HTMLInputElement).value = data.instagram_url;
      (form.querySelector('[name="owner_id"]') as HTMLSelectElement).value = data.owner_id ?? '';
      formTitle.textContent = 'Edit Restaurant';
      formWrap.classList.remove('hidden');
      formWrap.scrollIntoView({ behavior: 'smooth' });
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const id = fd.get('id') as string;
    const body: Record<string, any> = {
      name: fd.get('name'), city: fd.get('city') || 'Keramoti',
      phone: fd.get('phone') || null, address: fd.get('address') || null,
      website: fd.get('website') || null, google_maps_url: fd.get('google_maps_url') || null,
      price_range: fd.get('price_range') || null,
      description: fd.get('description') || null, description_el: fd.get('description_el') || null,
      cuisine_type: (fd.get('cuisine_type') as string).split(',').map(s => s.trim()).filter(Boolean),
      features: (fd.get('features') as string).split(',').map(s => s.trim()).filter(Boolean),
      is_partner: !!(fd.get('is_partner')),
      tripadvisor_url: fd.get('tripadvisor_url') || null,
      google_business_url: fd.get('google_business_url') || null,
      facebook_url: fd.get('facebook_url') || null,
      instagram_url: fd.get('instagram_url') || null,
      owner_id: fd.get('owner_id') || null,
    };

    try {
      const url = id ? `/api/admin/restaurants/${id}` : '/api/admin/restaurants';
      const method = id ? 'PATCH' : 'POST';
      const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      if (res.ok) location.reload();
      else { const d = await res.json(); alert(d.error || 'Failed'); }
    } catch { alert('Error'); }
  });

  document.querySelectorAll('.toggle-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = (btn as HTMLElement).dataset.id;
      const isActive = (btn as HTMLElement).dataset.active === 'true';
      const res = await fetch(`/api/admin/restaurants/${id}`, {
        method: 'PATCH', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ is_active: !isActive }),
      });
      if (res.ok) location.reload();
    });
  });

  document.querySelectorAll('.del-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Delete this restaurant?')) return;
      const id = (btn as HTMLElement).dataset.id;
      const res = await fetch(`/api/admin/restaurants/${id}`, { method: 'DELETE' });
      if (res.ok) (btn as HTMLElement).closest('.rest-row')?.remove();
    });
  });

  // Toggle photos panel
  document.querySelectorAll('.photos-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = (btn as HTMLElement).dataset.id;
      const panel = document.querySelector(`.photos-panel[data-id="${id}"]`) as HTMLElement;
      panel?.classList.toggle('hidden');
    });
  });

  // Upload photos
  document.querySelectorAll('.upload-photo-input').forEach(input => {
    input.addEventListener('change', async (e) => {
      const el = e.target as HTMLInputElement;
      const id = el.dataset.id!;
      const files = el.files;
      if (!files || files.length === 0) return;

      const status = document.querySelector(`.upload-status[data-id="${id}"]`) as HTMLElement;
      status.classList.remove('hidden');

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        status.textContent = `Uploading ${i + 1}/${files.length}: ${file.name}...`;

        const fd = new FormData();
        fd.append('file', file);
        fd.append('restaurant_id', id);
        if (i === 0) {
          // Check if restaurant has no cover yet — first upload becomes cover
          const row = el.closest('.rest-row') as HTMLElement;
          const data = JSON.parse(row.dataset.json!);
          if (!data.cover_photo) fd.append('is_cover', 'true');
        }

        try {
          const res = await fetch('/api/admin/upload/restaurant-photo', { method: 'POST', body: fd });
          if (!res.ok) {
            const d = await res.json();
            status.textContent = `Failed: ${d.error || 'Upload error'}`;
            status.classList.add('text-red-400');
            return;
          }
        } catch {
          status.textContent = 'Network error';
          status.classList.add('text-red-400');
          return;
        }
      }

      status.textContent = `Uploaded ${files.length} photo(s). Refreshing...`;
      setTimeout(() => location.reload(), 500);
    });
  });

  // Set as cover
  document.querySelectorAll('.set-cover-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = (btn as HTMLElement).dataset.restaurantId!;
      const url = (btn as HTMLElement).dataset.url!;
      const res = await fetch(`/api/admin/restaurants/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ cover_photo: url }),
      });
      if (res.ok) location.reload();
    });
  });

  // Remove photo
  document.querySelectorAll('.remove-photo-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Remove this photo?')) return;
      const id = (btn as HTMLElement).dataset.restaurantId!;
      const url = (btn as HTMLElement).dataset.url!;
      const type = (btn as HTMLElement).dataset.type!;

      const row = (btn as HTMLElement).closest('.rest-row') as HTMLElement;
      const data = JSON.parse(row.dataset.json!);

      const updates: Record<string, any> = {};
      if (type === 'cover') {
        updates.cover_photo = null;
      } else {
        // Remove from photo_urls array
        const existing = data.cover_photo ? [] : []; // We need to get current photo_urls from the grid
        const allPhotoBtns = row.querySelectorAll('.remove-photo-btn[data-type="gallery"]');
        const urls: string[] = [];
        allPhotoBtns.forEach(b => {
          const u = (b as HTMLElement).dataset.url!;
          if (u !== url) urls.push(u);
        });
        updates.photo_urls = urls;
      }

      const res = await fetch(`/api/admin/restaurants/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(updates),
      });
      if (res.ok) location.reload();
    });
  });

  // ── Invite Restaurant Owner ───────────────────────────────────────────
  const inviteModal = document.getElementById('invite-modal')!;
  document.getElementById('invite-owner-btn')?.addEventListener('click', () => {
    inviteModal.classList.remove('hidden');
  });
  document.getElementById('invite-cancel')?.addEventListener('click', () => {
    inviteModal.classList.add('hidden');
  });
  document.getElementById('invite-submit')?.addEventListener('click', async () => {
    const name = (document.getElementById('inv-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('inv-email') as HTMLInputElement).value.trim();
    const errEl = document.getElementById('invite-error')!;
    const okEl = document.getElementById('invite-success')!;
    errEl.classList.add('hidden');
    okEl.classList.add('hidden');

    if (!name || !email) {
      errEl.textContent = 'Name and email are required';
      errEl.classList.remove('hidden');
      return;
    }

    try {
      const res = await fetch('/api/admin/restaurant-owners/invite', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ full_name: name, email }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed');

      okEl.innerHTML = `Owner created! ${data.invite_link ? `<br><a href="${data.invite_link}" target="_blank" class="underline">Copy invite link</a>` : 'They can log in via /admin/login'}`;
      okEl.classList.remove('hidden');
      setTimeout(() => location.reload(), 3000);
    } catch (err: any) {
      errEl.textContent = err.message;
      errEl.classList.remove('hidden');
    }
  });
</script>
