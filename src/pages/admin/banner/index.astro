---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getServiceClient } from '../../../lib/supabase.ts';

const profile = Astro.locals.profile;
if (!profile || profile.role !== 'super_admin') return Astro.redirect('/admin');

const service = getServiceClient();

// Fetch current banner + last 5 history
const { data: banners } = await service
  .from('site_banners')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(10);

const activeBanner = banners?.find((b) => b.is_active) ?? null;
const history = banners?.filter((b) => !b.is_active) ?? [];

const typeOptions = [
  { value: 'info',    label: 'Info',    color: 'bg-blue-500' },
  { value: 'warning', label: 'Warning', color: 'bg-amber-500' },
  { value: 'success', label: 'Success', color: 'bg-emerald-500' },
  { value: 'error',   label: 'Error / Urgent', color: 'bg-red-500' },
];
---

<AdminLayout title="Site Banner">

  <!-- Current banner preview -->
  {activeBanner && (
    <div id="live-preview" class={`mb-6 rounded-xl px-4 py-3 flex items-center justify-between gap-4 text-white text-sm font-medium
      ${activeBanner.type === 'warning' ? 'bg-amber-500' : activeBanner.type === 'success' ? 'bg-emerald-600' : activeBanner.type === 'error' ? 'bg-red-600' : 'bg-blue-600'}`}>
      <span>
        {activeBanner.message}
        {activeBanner.link_url && (
          <a href={activeBanner.link_url} class="ml-2 underline font-semibold">{activeBanner.link_text || 'Learn more'}</a>
        )}
      </span>
      <span class="text-white/70 text-xs shrink-0">Live on site ✓</span>
    </div>
  )}

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-5xl">

    <!-- Left: Create / edit form -->
    <div class="lg:col-span-2 space-y-4">

      <div class="bg-white rounded-2xl border border-gray-100 p-6">
        <h2 class="font-semibold text-gray-900 mb-4">{activeBanner ? 'Update banner' : 'Create banner'}</h2>

        <form id="banner-form" class="space-y-4">
          {activeBanner && <input type="hidden" id="banner-id" value={activeBanner.id} />}

          <!-- Type -->
          <div>
            <label class="block text-xs font-medium text-gray-600 mb-2">Type</label>
            <div class="flex flex-wrap gap-2" id="type-buttons">
              {typeOptions.map((opt) => (
                <button
                  type="button"
                  data-type={opt.value}
                  class={`type-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-white transition-opacity ${opt.color} ${activeBanner?.type === opt.value || (!activeBanner && opt.value === 'info') ? 'ring-2 ring-offset-1 ring-gray-900' : 'opacity-60 hover:opacity-90'}`}
                >
                  {opt.label}
                </button>
              ))}
            </div>
            <input type="hidden" id="banner-type" value={activeBanner?.type ?? 'info'} />
          </div>

          <!-- Message -->
          <div>
            <label class="block text-xs font-medium text-gray-600 mb-1">Message *</label>
            <textarea
              id="banner-message"
              rows="2"
              maxlength="300"
              placeholder="e.g. 🎉 Summer special — 15% off stays in July! Book now."
              class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#1a1a2e]/20 resize-none"
            >{activeBanner?.message ?? ''}</textarea>
            <p class="text-xs text-gray-400 mt-1">Max 300 characters</p>
          </div>

          <!-- Optional CTA -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-medium text-gray-600 mb-1">Link text (optional)</label>
              <input
                type="text"
                id="banner-link-text"
                value={activeBanner?.link_text ?? ''}
                placeholder="Book now"
                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#1a1a2e]/20"
              />
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-600 mb-1">Link URL (optional)</label>
              <input
                type="url"
                id="banner-link-url"
                value={activeBanner?.link_url ?? ''}
                placeholder="https://..."
                class="w-full px-3 py-2 text-sm border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#1a1a2e]/20"
              />
            </div>
          </div>

          <!-- Actions -->
          <div class="flex gap-3 pt-2">
            <button
              type="submit"
              id="save-btn"
              class="bg-[#1a1a2e] text-white px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-[#2d2d4e] transition-colors"
            >
              {activeBanner ? 'Update & keep live' : 'Publish banner'}
            </button>
            {activeBanner && (
              <button
                type="button"
                id="hide-btn"
                class="border border-gray-200 text-gray-600 px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-gray-50 transition-colors"
              >
                Hide banner
              </button>
            )}
            {activeBanner && (
              <button
                type="button"
                id="delete-btn"
                class="text-red-400 hover:text-red-600 px-3 py-2.5 text-sm transition-colors ml-auto"
              >
                Delete
              </button>
            )}
          </div>

          <div id="banner-msg" class="hidden text-xs font-medium"></div>
        </form>
      </div>

      <!-- Live preview -->
      <div class="bg-white rounded-2xl border border-gray-100 p-4">
        <p class="text-xs font-medium text-gray-500 mb-3">Preview</p>
        <div id="preview-bar" class="rounded-xl px-4 py-3 text-white text-sm font-medium bg-blue-600 flex items-center justify-between">
          <span id="preview-text">Your message will appear here</span>
          <button type="button" class="text-white/60 hover:text-white ml-4 text-lg leading-none">×</button>
        </div>
      </div>
    </div>

    <!-- Right: status + history -->
    <div class="space-y-4">

      <!-- Status card -->
      <div class="bg-white rounded-2xl border border-gray-100 p-5">
        <h3 class="font-semibold text-gray-900 text-sm mb-3">Status</h3>
        {activeBanner ? (
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse inline-block"></span>
            <span class="text-sm text-gray-700 font-medium">Banner is live</span>
          </div>
        ) : (
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-gray-300 inline-block"></span>
            <span class="text-sm text-gray-400">No active banner</span>
          </div>
        )}
        <p class="text-xs text-gray-400 mt-2">The banner appears at the top of every public page below the nav bar.</p>
      </div>

      <!-- History -->
      {history.length > 0 && (
        <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
          <div class="px-4 py-3 border-b border-gray-50">
            <h3 class="font-semibold text-gray-900 text-sm">Recent banners</h3>
          </div>
          <div class="divide-y divide-gray-50">
            {history.slice(0, 5).map((b) => (
              <div class="px-4 py-3 flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <p class="text-xs text-gray-700 line-clamp-2">{b.message}</p>
                  <span class={`inline-block mt-1 px-1.5 py-0.5 rounded text-[10px] font-medium text-white ${b.type === 'warning' ? 'bg-amber-500' : b.type === 'success' ? 'bg-emerald-500' : b.type === 'error' ? 'bg-red-500' : 'bg-blue-500'}`}>{b.type}</span>
                </div>
                <button
                  class="restore-btn text-xs text-[#1a1a2e] font-medium hover:text-[#c9a96e] transition-colors shrink-0"
                  data-id={b.id} data-message={b.message} data-type={b.type}
                  data-link-text={b.link_text ?? ''} data-link-url={b.link_url ?? ''}
                >
                  Restore
                </button>
              </div>
            ))}
          </div>
        </div>
      )}

    </div>
  </div>
</AdminLayout>

<script>
  const form      = document.getElementById('banner-form')!;
  const msgEl     = document.getElementById('banner-msg')!;
  const previewBar = document.getElementById('preview-bar')!;
  const previewText = document.getElementById('preview-text')!;
  const msgInput  = document.getElementById('banner-message') as HTMLTextAreaElement;
  const typeInput = document.getElementById('banner-type') as HTMLInputElement;
  const linkText  = document.getElementById('banner-link-text') as HTMLInputElement;
  const linkUrl   = document.getElementById('banner-link-url') as HTMLInputElement;

  const typeColors: Record<string, string> = {
    info: 'bg-blue-600', warning: 'bg-amber-500', success: 'bg-emerald-600', error: 'bg-red-600',
  };

  // Type buttons
  document.querySelectorAll('.type-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const t = (btn as HTMLElement).dataset.type!;
      typeInput.value = t;
      document.querySelectorAll('.type-btn').forEach((b) => {
        b.classList.remove('ring-2', 'ring-offset-1', 'ring-gray-900');
        b.classList.add('opacity-60');
      });
      btn.classList.add('ring-2', 'ring-offset-1', 'ring-gray-900');
      btn.classList.remove('opacity-60');
      updatePreview();
    });
  });

  // Live preview
  function updatePreview() {
    const msg = msgInput.value.trim() || 'Your message will appear here';
    const lt  = linkText.value.trim();
    const lu  = linkUrl.value.trim();
    previewText.textContent = msg + (lt && lu ? ' ' + lt : '');
    previewBar.className = `rounded-xl px-4 py-3 text-white text-sm font-medium flex items-center justify-between ${typeColors[typeInput.value] ?? 'bg-blue-600'}`;
  }

  msgInput.addEventListener('input', updatePreview);
  linkText.addEventListener('input', updatePreview);
  updatePreview();

  function showMsg(text: string, ok: boolean) {
    msgEl.textContent = text;
    msgEl.className = `text-xs font-medium ${ok ? 'text-emerald-600' : 'text-red-600'}`;
    msgEl.classList.remove('hidden');
    setTimeout(() => msgEl.classList.add('hidden'), 4000);
  }

  // Save / publish
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = (document.getElementById('banner-id') as HTMLInputElement)?.value;
    const body = {
      message: msgInput.value.trim(),
      type: typeInput.value,
      link_text: linkText.value.trim() || null,
      link_url: linkUrl.value.trim() || null,
    };
    if (!body.message) return showMsg('Message is required', false);

    const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
    saveBtn.disabled = true; saveBtn.textContent = 'Saving…';

    let res;
    if (id) {
      res = await fetch('/api/admin/banner', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, ...body }),
      });
    } else {
      res = await fetch('/api/admin/banner', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
    }

    const data = await res.json();
    if (res.ok) {
      showMsg('Banner saved and live!', true);
      setTimeout(() => location.reload(), 1000);
    } else {
      showMsg(data.error ?? 'Failed to save', false);
    }
    saveBtn.disabled = false; saveBtn.textContent = id ? 'Update & keep live' : 'Publish banner';
  });

  // Hide banner
  document.getElementById('hide-btn')?.addEventListener('click', async () => {
    const id = (document.getElementById('banner-id') as HTMLInputElement)?.value;
    if (!id) return;
    const res = await fetch('/api/admin/banner', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, is_active: false }),
    });
    if (res.ok) {
      (window as any).adminToast('⏸ Banner hidden', 'info');
      setTimeout(() => location.reload(), 1200);
    } else {
      (window as any).adminToast('❌ Failed to hide banner', 'error');
    }
  });

  // Delete banner
  document.getElementById('delete-btn')?.addEventListener('click', async () => {
    if (!confirm('Delete this banner permanently?')) return;
    const id = (document.getElementById('banner-id') as HTMLInputElement)?.value;
    if (!id) return;
    const res = await fetch('/api/admin/banner', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id }),
    });
    if (res.ok) {
      (window as any).adminToast('🗑 Banner deleted', 'info');
      setTimeout(() => location.reload(), 1200);
    } else {
      (window as any).adminToast('❌ Failed to delete banner', 'error');
    }
  });

  // Restore from history
  document.querySelectorAll('.restore-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const { id, message, type, linkText: lt, linkUrl: lu } = (btn as HTMLElement).dataset;
      const res = await fetch('/api/admin/banner', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, message, type, link_text: lt || null, link_url: lu || null, is_active: true }),
      });
      if (res.ok) {
        (window as any).adminToast('✅ Banner restored and live', 'success');
        setTimeout(() => location.reload(), 1200);
      } else {
        (window as any).adminToast('❌ Failed to restore banner', 'error');
      }
    });
  });
</script>
