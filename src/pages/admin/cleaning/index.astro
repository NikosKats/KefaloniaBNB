---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getServiceClient } from '../../../lib/supabase.ts';

const role = Astro.locals.profile?.role ?? '';
if (!['admin','super_admin'].includes(role)) {
  return Astro.redirect('/admin');
}

const service = getServiceClient();
const { data: jobs } = await service
  .from('cleaning_jobs')
  .select('*, listings(title,city), cleaner_profiles(id, bio, user_id)')
  .order('scheduled_date', { ascending: false })
  .limit(50);

// Fetch profiles separately (cleaner_profiles.user_id → auth.users, not public.profiles)
const cleanerUserIds = [...new Set((jobs ?? []).map((j: any) => j.cleaner_profiles?.user_id).filter(Boolean))];
const { data: cpProfiles } = cleanerUserIds.length > 0
  ? await service.from('profiles').select('id, full_name').in('id', cleanerUserIds)
  : { data: [] };
const profileByUserId = Object.fromEntries((cpProfiles ?? []).map((p: any) => [p.id, p]));
// Attach to jobs
const jobsWithNames = (jobs ?? []).map((j: any) => ({
  ...j,
  cleaner_name: j.cleaner_profiles?.user_id ? profileByUserId[j.cleaner_profiles.user_id]?.full_name ?? '—' : '—',
}));

const { data: openRequests } = await service
  .from('cleaning_requests')
  .select('*, listings(title,city)')
  .eq('status', 'open')
  .order('requested_date');

const { data: disputes } = await service
  .from('cleaning_disputes')
  .select('*, cleaning_jobs(id, listing_id, listings(title))')
  .eq('status', 'open');

const statusColors: Record<string, string> = {
  scheduled: 'bg-blue-100 text-blue-800',
  started: 'bg-yellow-100 text-yellow-800',
  completed: 'bg-purple-100 text-purple-800',
  approved: 'bg-emerald-100 text-emerald-800',
  disputed: 'bg-red-100 text-red-800',
  cancelled: 'bg-gray-100 text-gray-600',
};
---

<AdminLayout title="Cleaning Management">
  <!-- Stats row -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-2xl border border-gray-100 p-4">
      <p class="text-2xl font-bold text-gray-900">{openRequests?.length ?? 0}</p>
      <p class="text-xs text-gray-500 mt-1">Open Requests</p>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 p-4">
      <p class="text-2xl font-bold text-gray-900">{jobsWithNames.filter((j: any) => j.status === 'scheduled').length}</p>
      <p class="text-xs text-gray-500 mt-1">Scheduled Jobs</p>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 p-4">
      <p class="text-2xl font-bold text-gray-900">{jobsWithNames.filter((j: any) => j.status === 'completed').length}</p>
      <p class="text-xs text-gray-500 mt-1">Awaiting Approval</p>
    </div>
    <div class="bg-white rounded-2xl border border-red-100 p-4">
      <p class="text-2xl font-bold text-red-600">{disputes?.length ?? 0}</p>
      <p class="text-xs text-gray-500 mt-1">Open Disputes</p>
    </div>
  </div>

  <!-- Open Disputes -->
  {(disputes ?? []).length > 0 && (
    <div class="mb-8">
      <h2 class="text-sm font-semibold text-red-600 uppercase tracking-wide mb-3">Open Disputes</h2>
      <div class="space-y-3">
        {(disputes ?? []).map((d: any) => (
          <div class="bg-red-50 border border-red-200 rounded-xl p-4 flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-900">{(d.cleaning_jobs as any)?.listings?.title}</p>
              <p class="text-xs text-gray-500 mt-0.5">{d.reason?.slice(0, 80)}…</p>
            </div>
            <a href={`/admin/cleaning/disputes/${d.id}`} class="min-h-[44px] px-4 py-2.5 inline-flex items-center text-xs text-red-600 font-medium hover:text-red-800">Resolve →</a>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Open Requests -->
  {(openRequests ?? []).length > 0 && (
    <div class="mb-8">
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Open Requests</h2>
      <div class="space-y-3">
        {(openRequests ?? []).map((r: any) => (
          <div class="bg-white border border-gray-100 rounded-xl p-4 flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-900">{r.listings?.title}</p>
              <p class="text-xs text-gray-500">{r.listings?.city} · {r.requested_date}</p>
            </div>
            <a href={`/admin/cleaning/requests/${r.id}`} class="min-h-[44px] px-4 py-2.5 inline-flex items-center text-xs text-[#c9a96e] font-medium hover:opacity-80">View →</a>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- All Jobs -->
  <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">All Jobs</h2>

  <!-- Mobile card view -->
  <div class="lg:hidden space-y-3">
    {jobsWithNames.map((job: any) => (
      <div class="bg-white rounded-xl border border-gray-100 p-4">
        <div class="flex items-start justify-between mb-2">
          <div class="min-w-0 flex-1">
            <p class="font-medium text-gray-900">{job.listings?.title}</p>
            <p class="text-xs text-gray-400">{job.listings?.city}</p>
          </div>
          <span class={`px-2 py-1 rounded-full text-xs font-medium shrink-0 ml-2 ${statusColors[job.status] ?? 'bg-gray-100 text-gray-600'}`}>
            {job.status}
          </span>
        </div>
        <div class="grid grid-cols-3 gap-2 text-sm mb-3">
          <div>
            <p class="text-xs text-gray-400">Date</p>
            <p class="font-medium text-gray-600">{job.scheduled_date}</p>
          </div>
          <div>
            <p class="text-xs text-gray-400">Cleaner</p>
            <p class="font-medium text-gray-600">{job.cleaner_name}</p>
          </div>
          <div>
            <p class="text-xs text-gray-400">Price</p>
            <p class="font-medium text-gray-900">€{job.agreed_price}</p>
          </div>
        </div>
        <a href={`/admin/cleaning/jobs/${job.id}`} class="min-h-[44px] px-4 py-2.5 inline-flex items-center text-xs text-[#c9a96e] font-medium hover:opacity-80">View →</a>
      </div>
    ))}
    {jobsWithNames.length === 0 && (
      <div class="bg-white rounded-xl border border-gray-100 p-8 text-center text-gray-400 text-sm">No cleaning jobs yet.</div>
    )}
  </div>

  <!-- Desktop table view -->
  <div class="hidden lg:block bg-white rounded-2xl border border-gray-100 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-100">
          <th class="text-left p-4 text-xs font-medium text-gray-500">Property</th>
          <th class="text-left p-4 text-xs font-medium text-gray-500">Date</th>
          <th class="text-left p-4 text-xs font-medium text-gray-500">Cleaner</th>
          <th class="text-left p-4 text-xs font-medium text-gray-500">Price</th>
          <th class="text-left p-4 text-xs font-medium text-gray-500">Status</th>
          <th class="p-4"></th>
        </tr>
      </thead>
      <tbody>
        {jobsWithNames.map((job: any) => (
          <tr class="border-b border-gray-50 hover:bg-gray-50">
            <td class="p-4">
              <p class="font-medium text-gray-900">{job.listings?.title}</p>
              <p class="text-xs text-gray-400">{job.listings?.city}</p>
            </td>
            <td class="p-4 text-gray-600">{job.scheduled_date}</td>
            <td class="p-4 text-gray-600">{job.cleaner_name}</td>
            <td class="p-4 font-medium text-gray-900">€{job.agreed_price}</td>
            <td class="p-4">
              <span class={`px-2 py-1 rounded-full text-xs font-medium ${statusColors[job.status] ?? 'bg-gray-100 text-gray-600'}`}>
                {job.status}
              </span>
            </td>
            <td class="p-4">
              <a href={`/admin/cleaning/jobs/${job.id}`} class="text-xs text-[#c9a96e] font-medium">View →</a>
            </td>
          </tr>
        ))}
        {jobsWithNames.length === 0 && (
          <tr>
            <td colspan="6" class="p-8 text-center text-gray-400 text-sm">No cleaning jobs yet.</td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
