---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getServiceClient } from '../../../lib/supabase.ts';

if (!Astro.locals.session) return Astro.redirect('/admin/login');

const userId = Astro.locals.session.user.id;
const service = getServiceClient();

const { data: requests } = await service
  .from('cleaning_requests')
  .select('*, listings(title,city), cleaning_matches(id, proposed_price, is_accepted, cleaner_profiles(bio))')
  .eq('owner_id', userId)
  .order('requested_date', { ascending: false });

const { data: jobs } = await service
  .from('cleaning_jobs')
  .select('*, listings(title,city), cleaner_profiles(bio, profiles:user_id(full_name)), cleaning_payments(status)')
  .eq('owner_id', userId)
  .order('scheduled_date', { ascending: false });

// P&L: only count approved jobs where both sides are known
const approvedJobs = (jobs ?? []).filter((j: any) => j.status === 'approved');
const totalFeesCollected = approvedJobs.reduce((sum: number, j: any) => sum + (parseFloat(j.cleaning_fee_collected) || 0), 0);
const totalCleaning = approvedJobs.reduce((sum: number, j: any) => sum + (parseFloat(j.agreed_price) || 0), 0);
const netMargin = parseFloat((totalFeesCollected - totalCleaning).toFixed(2));
const hasPnl = approvedJobs.length > 0;

const statusColors: Record<string, string> = {
  scheduled: 'bg-blue-100 text-blue-800',
  started: 'bg-yellow-100 text-yellow-800',
  completed: 'bg-purple-100 text-purple-800',
  approved: 'bg-emerald-100 text-emerald-800',
  disputed: 'bg-red-100 text-red-800',
  cancelled: 'bg-gray-100 text-gray-600',
};

const reqStatusColors: Record<string, string> = {
  open: 'bg-blue-100 text-blue-800',
  matched: 'bg-yellow-100 text-yellow-800',
  confirmed: 'bg-emerald-100 text-emerald-800',
  cancelled: 'bg-gray-100 text-gray-600',
};

const ownerListingIds: string[] = Astro.locals.ownerListingIds ?? [];
---

<AdminLayout title="My Cleaning">
  <div class="flex justify-between items-center mb-6">
    <p class="text-sm text-gray-500">{jobs?.length ?? 0} jobs · {requests?.filter((r: any) => r.status === 'open').length ?? 0} open requests</p>
    {ownerListingIds.length > 0 && (
      <a href="/owner/cleaning/new" class="bg-[#1a1a2e] text-white font-semibold px-4 py-2 rounded-xl text-sm hover:bg-[#2d2d4e] transition-colors">
        + New Request
      </a>
    )}
  </div>

  <!-- Cleaning P&L Summary -->
  {hasPnl && (
    <div class="bg-white border border-gray-100 rounded-2xl p-5 mb-6 grid grid-cols-3 gap-4 text-center">
      <div>
        <p class="text-xs text-gray-400 mb-1">Fees collected from guests</p>
        <p class="text-xl font-bold text-gray-900">€{totalFeesCollected.toFixed(2)}</p>
      </div>
      <div>
        <p class="text-xs text-gray-400 mb-1">Cleaning costs paid</p>
        <p class="text-xl font-bold text-gray-900">€{totalCleaning.toFixed(2)}</p>
      </div>
      <div>
        <p class="text-xs text-gray-400 mb-1">Net margin</p>
        <p class={`text-xl font-bold ${netMargin >= 0 ? 'text-emerald-600' : 'text-red-500'}`}>
          {netMargin >= 0 ? '+' : ''}€{netMargin.toFixed(2)}
        </p>
      </div>
    </div>
  )}

  <!-- Jobs -->
  {(jobs ?? []).length > 0 && (
    <div class="mb-8">
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Jobs</h2>
      <div class="space-y-3">
        {(jobs ?? []).map((job: any) => {
          const payment = job.cleaning_payments?.[0];
          const isPaid = payment?.status === 'paid';
          const isCancelled = job.status === 'cancelled';
          return (
            <div class={`bg-white rounded-2xl border border-gray-100 p-5 transition-all ${isCancelled ? 'opacity-60' : 'hover:border-[#c9a96e]'}`}>
              <div class="flex items-start justify-between">
                <div class="flex-1 min-w-0">
                  <a href={`/owner/cleaning/jobs/${job.id}`} class="font-semibold text-gray-900 hover:text-[#c9a96e]">{job.listings?.title}</a>
                  <p class="text-xs text-gray-500 mt-0.5">{job.listings?.city} · {job.scheduled_date} at {job.scheduled_time}</p>
                  <p class="text-xs text-gray-500 mt-0.5">Cleaner: {job.cleaner_profiles?.profiles?.full_name ?? '—'}</p>
                </div>
                <div class="text-right ml-4 flex-shrink-0">
                  <span class={`px-2 py-1 rounded-full text-xs font-medium ${statusColors[job.status]}`}>{job.status}</span>
                  <p class="text-xs font-bold text-gray-900 mt-2">€{job.agreed_price}</p>
                </div>
              </div>

              {/* Action row */}
              {!isCancelled && (
                <div class="flex gap-2 mt-3 pt-3 border-t border-gray-50">
                  <a href={`/owner/cleaning/jobs/${job.id}`} class="text-xs font-medium text-gray-600 hover:text-gray-900 px-3 py-1.5 rounded-lg border border-gray-200 hover:border-gray-300 transition-colors">
                    View Details
                  </a>
                  {job.status === 'completed' && (
                    <button
                      class="approve-job-btn text-xs font-medium text-white bg-emerald-600 hover:bg-emerald-700 px-3 py-1.5 rounded-lg transition-colors"
                      data-job-id={job.id}
                      data-is-paid={String(isPaid)}
                      data-price={job.agreed_price}
                    >
                      {isPaid ? 'Approve & Release' : `Pay €${job.agreed_price} & Approve`}
                    </button>
                  )}
                  {job.status === 'scheduled' && !isPaid && (
                    <button
                      class="pay-job-btn text-xs font-medium text-white bg-[#1a1a2e] hover:bg-[#2d2d4e] px-3 py-1.5 rounded-lg transition-colors"
                      data-job-id={job.id}
                    >
                      Pay Now
                    </button>
                  )}
                  {job.status === 'scheduled' && (
                    <button
                      class="cancel-job-btn text-xs font-medium text-red-600 hover:text-red-800 border border-red-200 hover:border-red-300 px-3 py-1.5 rounded-lg transition-colors"
                      data-job-id={job.id}
                    >
                      Cancel
                    </button>
                  )}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  )}

  <!-- Requests -->
  {(requests ?? []).length > 0 && (
    <div class="mb-8">
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Requests</h2>
      <div class="space-y-3">
        {(requests ?? []).map((req: any) => {
          const bids = (req.cleaning_matches ?? []);
          const pendingBids = bids.filter((b: any) => b.is_accepted === null);
          const isCancelled = req.status === 'cancelled';
          return (
            <div class={`bg-white rounded-2xl border border-gray-100 p-5 transition-all ${isCancelled ? 'opacity-60' : 'hover:border-[#c9a96e]'}`}>
              <div class="flex items-start justify-between">
                <div class="flex-1 min-w-0">
                  <a href={`/owner/cleaning/requests/${req.id}`} class="font-semibold text-gray-900 hover:text-[#c9a96e]">{req.listings?.title}</a>
                  <p class="text-xs text-gray-500 mt-0.5">{req.listings?.city} · {req.requested_date}</p>
                  {req.notes && <p class="text-xs text-gray-400 mt-1 truncate">{req.notes}</p>}
                </div>
                <div class="text-right ml-4 flex-shrink-0">
                  <span class={`px-2 py-1 rounded-full text-xs font-medium ${reqStatusColors[req.status]}`}>{req.status}</span>
                  {!isCancelled && <p class="text-xs text-gray-500 mt-1">{bids.length} bid{bids.length !== 1 ? 's' : ''}</p>}
                </div>
              </div>

              {/* Action row */}
              {!isCancelled && (
                <div class="flex gap-2 mt-3 pt-3 border-t border-gray-50">
                  <a href={`/owner/cleaning/requests/${req.id}`} class="text-xs font-medium text-gray-600 hover:text-gray-900 px-3 py-1.5 rounded-lg border border-gray-200 hover:border-gray-300 transition-colors">
                    {pendingBids.length > 0 ? `View ${pendingBids.length} Bid${pendingBids.length !== 1 ? 's' : ''}` : 'View Details'}
                  </a>
                  {['open', 'matched'].includes(req.status) && (
                    <button
                      class="cancel-req-btn text-xs font-medium text-red-600 hover:text-red-800 border border-red-200 hover:border-red-300 px-3 py-1.5 rounded-lg transition-colors"
                      data-req-id={req.id}
                    >
                      Cancel
                    </button>
                  )}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  )}

  {(jobs ?? []).length === 0 && (requests ?? []).length === 0 && (
    <div class="text-center py-20 text-gray-400">
      <p class="text-4xl mb-3">🧹</p>
      <p>No cleaning requests yet.</p>
      {ownerListingIds.length > 0 && (
        <a href="/owner/cleaning/new" class="mt-4 inline-block text-sm text-[#c9a96e] font-medium hover:opacity-80">Create your first request →</a>
      )}
    </div>
  )}
</AdminLayout>

<script>
  // Cancel job
  document.querySelectorAll('.cancel-job-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Cancel this cleaning job?')) return;
      const jobId = (btn as HTMLElement).dataset.jobId;
      (btn as HTMLButtonElement).disabled = true;
      (btn as HTMLButtonElement).textContent = '…';
      const res = await fetch(`/api/cleaning/jobs/${jobId}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: 'cancelled' }),
      });
      if (res.ok) window.location.reload();
      else {
        const d = await res.json();
        alert(d.error ?? 'Failed to cancel');
        (btn as HTMLButtonElement).disabled = false;
        (btn as HTMLButtonElement).textContent = 'Cancel';
      }
    });
  });

  // Cancel request
  document.querySelectorAll('.cancel-req-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Cancel this cleaning request?')) return;
      const reqId = (btn as HTMLElement).dataset.reqId;
      (btn as HTMLButtonElement).disabled = true;
      (btn as HTMLButtonElement).textContent = '…';
      const res = await fetch(`/api/cleaning/requests/${reqId}/cancel`, { method: 'POST' });
      if (res.ok) window.location.reload();
      else {
        const d = await res.json();
        alert(d.error ?? 'Failed to cancel');
        (btn as HTMLButtonElement).disabled = false;
        (btn as HTMLButtonElement).textContent = 'Cancel';
      }
    });
  });

  // Pay for job (scheduled, unpaid)
  document.querySelectorAll('.pay-job-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const jobId = (btn as HTMLElement).dataset.jobId;
      (btn as HTMLButtonElement).disabled = true;
      (btn as HTMLButtonElement).textContent = 'Redirecting…';
      const res = await fetch(`/api/cleaning/jobs/${jobId}/checkout`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({}),
      });
      if (res.ok) {
        const { url } = await res.json();
        window.location.href = url;
      } else {
        const d = await res.json();
        alert(d.error ?? 'Payment failed');
        (btn as HTMLButtonElement).disabled = false;
        (btn as HTMLButtonElement).textContent = 'Pay Now';
      }
    });
  });

  // Approve job (completed)
  document.querySelectorAll('.approve-job-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const jobId = (btn as HTMLElement).dataset.jobId;
      const isPaid = (btn as HTMLElement).dataset.isPaid === 'true';
      (btn as HTMLButtonElement).disabled = true;

      if (isPaid) {
        (btn as HTMLButtonElement).textContent = 'Approving…';
        const res = await fetch(`/api/cleaning/jobs/${jobId}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: 'approved' }),
        });
        if (res.ok) window.location.reload();
        else {
          const d = await res.json();
          alert(d.error ?? 'Failed');
          (btn as HTMLButtonElement).disabled = false;
          (btn as HTMLButtonElement).textContent = 'Approve & Release';
        }
      } else {
        (btn as HTMLButtonElement).textContent = 'Redirecting…';
        const res = await fetch(`/api/cleaning/jobs/${jobId}/checkout`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({}),
        });
        if (res.ok) {
          const { url } = await res.json();
          window.location.href = url;
        } else {
          const d = await res.json();
          alert(d.error ?? 'Payment failed');
          (btn as HTMLButtonElement).disabled = false;
          (btn as HTMLButtonElement).textContent = `Pay & Approve`;
        }
      }
    });
  });
</script>
