---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getServiceClient } from '../../../../lib/supabase.ts';

if (!Astro.locals.session) return Astro.redirect('/admin/login');
const userId = Astro.locals.session.user.id;
const { id } = Astro.params;
const service = getServiceClient();

const { data: req } = await service
  .from('cleaning_requests')
  .select('*, listings(title,city,bedrooms,property_type,cleaning_fee)')
  .eq('id', id!)
  .eq('owner_id', userId)
  .single();

if (!req) return Astro.redirect('/owner/cleaning');

const { data: matches } = await service
  .from('cleaning_matches')
  .select('*, cleaner_profiles(id, bio, rating, review_count, languages, cleaner_service_areas(city,region))')
  .eq('request_id', id!)
  .order('proposed_price');
---

<AdminLayout title={`Request — ${(req as any).listings?.title}`}>
  <div class="max-w-2xl mx-auto space-y-6">
    <div>
      <h1 class="text-xl font-bold text-gray-900">{(req as any).listings?.title}</h1>
      <p class="text-sm text-gray-500">{(req as any).listings?.city} · Cleaning on {req.requested_date} between {req.earliest_time} – {req.latest_time}</p>
      {req.notes && <p class="text-sm text-gray-600 mt-2 bg-gray-50 rounded-xl p-3">{req.notes}</p>}
    </div>

    <div class="flex items-center gap-2">
      <span class={`px-3 py-1 rounded-full text-sm font-medium ${req.status === 'open' ? 'bg-blue-100 text-blue-800' : req.status === 'confirmed' ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-600'}`}>
        {req.status}
      </span>
      <span class="text-sm text-gray-500">{(matches ?? []).length} bid{(matches ?? []).length !== 1 ? 's' : ''} received</span>
    </div>

    {req.status === 'open' && (matches ?? []).length === 0 && (
      <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6 text-center">
        <p class="text-sm text-blue-700">Waiting for cleaners to submit bids…</p>
        <p class="text-xs text-blue-500 mt-1">You'll be notified when bids arrive.</p>
      </div>
    )}

    {(matches ?? []).length > 0 && (
      <div class="space-y-4">
        <h2 class="text-sm font-semibold text-gray-700">Bids</h2>
        {(matches ?? []).map((m: any) => {
          const cp = m.cleaner_profiles;
          const guestFee: number | null = (req as any).listings?.cleaning_fee ?? null;
          const bid: number = parseFloat(m.proposed_price);
          const margin: number | null = guestFee != null ? parseFloat((guestFee - bid).toFixed(2)) : null;
          return (
            <div class={`bg-white border rounded-2xl p-5 ${m.is_accepted ? 'border-emerald-300 bg-emerald-50/30' : m.is_accepted === false ? 'border-gray-100 opacity-60' : 'border-gray-200'}`}>
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    {cp?.rating && <span class="text-xs text-[#c9a96e] font-medium">★ {cp.rating} ({cp.review_count})</span>}
                    {m.is_accepted === true && <span class="text-xs bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full font-medium">Accepted</span>}
                    {m.is_accepted === false && <span class="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full">Declined</span>}
                  </div>
                  {cp?.bio && <p class="text-sm text-gray-600 mb-2">{cp.bio?.slice(0, 120)}</p>}
                  {m.proposed_time && <p class="text-xs text-gray-500">Proposed time: {m.proposed_time}</p>}
                  {m.message && <p class="text-sm text-gray-600 mt-1 italic">"{m.message}"</p>}
                </div>
                <div class="text-right ml-4 space-y-1">
                  <p class="text-xl font-bold text-gray-900">€{m.proposed_price}</p>
                  {guestFee != null && (
                    <p class="text-xs text-gray-400">Guest fee: €{guestFee}</p>
                  )}
                  {margin != null && (
                    <p class={`text-xs font-semibold ${margin >= 0 ? 'text-emerald-600' : 'text-red-500'}`}>
                      {margin >= 0 ? `+€${margin} margin` : `-€${Math.abs(margin)} out-of-pocket`}
                    </p>
                  )}
                  {req.status === 'open' && m.is_accepted === null && (
                    <button
                      class="accept-btn mt-2 bg-[#1a1a2e] text-white text-xs font-semibold px-4 py-2 rounded-xl hover:bg-[#2d2d4e] transition-colors"
                      data-match-id={m.id}
                    >
                      Accept Bid
                    </button>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    )}

    <!-- Cancel Request -->
    {['open', 'matched'].includes(req.status) && (
      <div class="border border-red-200 rounded-2xl p-4">
        <p class="text-xs text-gray-500 mb-2">Cancel this request if you no longer need cleaning. Any pending bids will be dismissed.</p>
        <button id="cancel-req-btn" class="text-sm font-medium text-red-600 hover:text-red-800 border border-red-300 px-4 py-2 rounded-xl hover:bg-red-50 transition-colors">
          Cancel Request
        </button>
      </div>
    )}

    <div class="pt-2">
      <a href="/owner/cleaning" class="text-sm text-gray-400 hover:text-gray-600">← Back to My Cleaning</a>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ requestId: req.id }}>
  document.querySelectorAll('.accept-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const matchId = btn.dataset.matchId;
      btn.disabled = true;
      btn.textContent = '…';
      const res = await fetch(`/api/cleaning/requests/${requestId}/accept`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ match_id: matchId }),
      });
      if (res.ok) {
        window.location.href = '/owner/cleaning';
      } else {
        const d = await res.json();
        alert(d.error ?? 'Failed to accept bid');
        btn.disabled = false;
        btn.textContent = 'Accept Bid';
      }
    });
  });

  document.getElementById('cancel-req-btn')?.addEventListener('click', async () => {
    if (!confirm('Cancel this cleaning request? All pending bids will be dismissed.')) return;
    const btn = document.getElementById('cancel-req-btn');
    btn.disabled = true;
    btn.textContent = 'Cancelling…';
    const res = await fetch(`/api/cleaning/requests/${requestId}/cancel`, {
      method: 'POST',
    });
    if (res.ok) window.location.href = '/owner/cleaning';
    else {
      const d = await res.json();
      alert(d.error ?? 'Failed to cancel request');
      btn.disabled = false;
      btn.textContent = 'Cancel Request';
    }
  });
</script>
