---
import BaseLayout from '../layouts/BaseLayout.astro';
import { type Lang } from '../i18n/translations.ts';
const lang = (Astro.locals.lang ?? 'en') as Lang;
const isEl = lang === 'el';
const isBg = lang === 'bg';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://kefaloniabnb.com';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Area Guide', item: `${siteUrl}/area-guide` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TouristDestination',
    name: 'Keramoti, Kefalonia, Greece',
    description: 'Keramoti is a coastal village in Northern Greece, known for its beach, ferry to Thassos island, and proximity to Kefalonia city.',
    url: `${siteUrl}/area-guide`,
    touristType: ['Beach', 'Family', 'Nature', 'Culture'],
    geo: { '@type': 'GeoCoordinates', latitude: 40.9716, longitude: 24.6736 },
  },
];

const highlights = [
  { icon: '☀️', label: 'Climate', value: '300+ sunny days/year' },
  { icon: '🏖️', label: 'Beach', value: '5 min walk' },
  { icon: '⛴️', label: 'Thassos ferry', value: '35 min away' },
  { icon: '🏛️', label: 'UNESCO site', value: 'Ancient Philippi' },
];

const beaches = [
  {
    name: 'Keramoti Beach',
    badge: '★ Most popular',
    badgeColor: 'bg-amber-100 text-amber-800',
    desc: 'A long, gently shelving sandy beach with crystal-clear shallow water — ideal for families. Sun-beds, beach bars and water sports in season.',
    icon: '🏖️',
  },
  {
    name: 'Aspri Ammos',
    badge: 'Quiet & natural',
    badgeColor: 'bg-emerald-100 text-emerald-800',
    desc: 'Secluded white-sand cove a short drive north. No facilities — bring a picnic and enjoy the solitude.',
    icon: '🌊',
  },
  {
    name: 'Thassos Beaches',
    badge: '35 min by ferry',
    badgeColor: 'bg-blue-100 text-blue-800',
    desc: 'The island of Thassos has world-class beaches — Marble Beach, Paradise, Golden Beach — all reachable by a short ferry ride.',
    icon: '⛴️',
  },
];

const experiences = [
  {
    category: 'Culture & History',
    icon: '🏛️',
    items: [
      { name: 'Ancient Philippi', detail: '40 min · UNESCO World Heritage', desc: 'One of Greece\'s most impressive archaeological sites — the city where Julius Caesar\'s assassins fought their final battle.' },
      { name: 'Kefalonia Old Town', detail: '35 min · Byzantine castle', desc: 'Wander the old quarter, visit the imposing Byzantine fortress and enjoy sweeping views over the port.' },
      { name: 'Xanthi Old Town', detail: '45 min · Traditional market', desc: 'A beautifully preserved Ottoman-era town with colourful mansions, a covered bazaar and great coffee culture.' },
    ],
  },
  {
    category: 'Nature & Outdoors',
    icon: '🌿',
    items: [
      { name: 'Nestos River Gorge', detail: '50 min · Kayaking & hiking', desc: 'A dramatic limestone gorge with emerald water, ideal for kayaking, birdwatching and riverside walks.' },
      { name: 'Nymphaea Lakes', detail: '30 min · Birdwatching', desc: 'A network of wetland lakes attracting hundreds of migratory bird species — a paradise for nature lovers.' },
      { name: 'Mount Kefalonia', detail: '1h · Hiking trails', desc: 'Several well-marked hiking trails with panoramic views of the Aegean and the Northern Greek coast.' },
    ],
  },
  {
    category: 'Food & Drink',
    icon: '🍽️',
    items: [
      { name: 'Seafood tavernas', detail: 'Keramoti port', desc: 'The port area has several exceptional seafood restaurants serving the day\'s catch — grilled octopus, sea bream and local mezedes.' },
      { name: 'Local wineries', detail: '45–60 min · Wine tasting', desc: 'Northern Greece has some of the country\'s finest wine regions. Several family wineries near Drama offer tours and tastings.' },
      { name: 'Kefalonia food scene', detail: '35 min · Wide choice', desc: 'From traditional ouzeries to modern restaurants, Kefalonia has an excellent dining scene centred around its lively waterfront.' },
    ],
  },
];

const dayTrips = [
  { dest: 'Thassos Island', dist: '35 min ferry', emoji: '🏝️', desc: 'Marble beaches, waterfalls, ancient ruins, mountain villages. A full-day island escape.' },
  { dest: 'Kefalonia City', dist: '35 min drive', emoji: '🏰', desc: 'Byzantine castle, vibrant waterfront, excellent restaurants, and a beautiful old town.' },
  { dest: 'Ancient Philippi', dist: '40 min drive', emoji: '🏛️', desc: 'UNESCO World Heritage Roman city with an impressive amphitheatre still used for summer festivals.' },
  { dest: 'Xanthi', dist: '45 min drive', emoji: '🕌', desc: 'Charming Ottoman-era old town, colourful timber houses, covered bazaar and great café culture.' },
  { dest: 'Drama & Springs', dist: '55 min drive', emoji: '🌊', desc: 'Scenic town built around natural springs, caves, local wine production and mountain scenery.' },
  { dest: 'Thessaloniki', dist: '2.5h drive', emoji: '🌆', desc: 'Greece\'s second city — Byzantine monuments, outstanding food scene, vibrant nightlife and beaches.' },
];

const gettingAround = [
  { icon: '🚗', title: 'By Car', desc: 'A rental car gives you the most flexibility. Free parking is available at all properties. The main roads are in excellent condition.' },
  { icon: '⛴️', title: 'Ferry to Thassos', desc: 'Ferries run every 30–60 min in summer from Keramoti port (5 min drive). Cars and bikes can board. Journey is 35 minutes.' },
  { icon: '🚌', title: 'KTEL Bus', desc: 'KTEL buses connect Keramoti to Kefalonia city several times daily. Kefalonia has onward connections to Thessaloniki and other cities.' },
  { icon: '✈️', title: 'Nearest Airports', desc: 'Kefalonia "Alexander the Great" Airport (KVA) — 25 min. Thessaloniki (SKG) — 2.5h. Both have international summer connections.' },
];
---

<BaseLayout
  title="Area Guide – Keramoti, Kefalonia & Northern Greece"
  description="Discover the best of Keramoti and Northern Greece: beaches, ferry to Thassos, ancient ruins, local food and day trips. Your complete destination guide."
  schema={schemas}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

    <!-- Hero -->
    <div class="text-center mb-14">
      <p class="text-[#c9a96e] font-semibold text-sm uppercase tracking-wider mb-2">{isEl ? 'Οδηγός Προορισμού' : isBg ? 'Пътеводител за дестинацията' : isSr ? 'Водич кроз дестинацију' : isTr ? 'Yöre Rehberi' : isRo ? 'Ghid de Destinație' : 'Destination Guide'}</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">{isEl ? 'Κεραμωτί & Βόρεια Ελλάδα' : isBg ? 'Keramoti & Северна Гърция' : isSr ? 'Keramoti & Северна Грчка' : isTr ? 'Keramoti & Kuzey Yunanistan' : isRo ? 'Keramoti & Grecia de Nord' : 'Keramoti & Northern Greece'}</h1>
      <p class="text-gray-500 max-w-2xl mx-auto leading-relaxed">{isEl ? 'Ένας κρυμμένος θησαυρός στην ακτή του Αιγαίου — παρθένες παραλίες, αρχαία ιστορία, εκδρομές σε νησί και αυθεντικός ελληνικός πολιτισμός, όλα σε εύκολη απόσταση.' : isBg ? 'Скрито съкровище по бреговете на Егейско море — девствени плажове, древна история, еднодневни екскурзии до острови и автентична гръцка култура, всичко в лесна досегаемост.' : isSr ? 'Скривени бисер на обали Егејског мора — нетакнуте плаже, древна историја, излети на острва и аутентична грчка култура, све на дохват руке.' : isTr ? 'Ege kıyısında gizli bir mücevher — bozulmamış plajlar, antik tarih, ada günübirlik gezileri ve otantik Yunan kültürü, hepsi kolayca ulaşılabilir mesafede.' : isRo ? 'O bijuterie ascunsă pe coasta Egee — plaje imaculate, istorie antică, excursii pe insulă și cultură greacă autentică, toate la îndemână.' : 'A hidden gem on the Aegean coast — pristine beaches, ancient history, island day trips and authentic Greek culture, all within easy reach.'}</p>
    </div>

    <!-- Highlights bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-16">
      {highlights.map((h) => (
        <div class="bg-white border border-gray-100 rounded-2xl p-4 text-center shadow-sm">
          <div class="text-2xl mb-1">{h.icon}</div>
          <p class="text-xs text-gray-400 mb-0.5">{
            h.label === 'Climate' ? (isEl ? 'Κλίμα' : isBg ? 'Климат' : isSr ? 'Клима' : isTr ? 'İklim' : isRo ? 'Climă' : h.label) :
            h.label === 'Beach' ? (isEl ? 'Παραλία' : isBg ? 'Плаж' : isSr ? 'Плажа' : isTr ? 'Plaj' : isRo ? 'Plajă' : h.label) :
            h.label === 'Thassos ferry' ? (isEl ? 'Φέρι για Θάσο' : isBg ? 'Ферибот до Thassos' : isSr ? 'Трајект до Thassos' : isTr ? 'Thassos feribotu' : isRo ? 'Feribot Thassos' : h.label) :
            h.label === 'UNESCO site' ? (isEl ? 'Μνημείο UNESCO' : isBg ? 'Обект на ЮНЕСКО' : isSr ? 'УНЕСКО локалитет' : isTr ? 'UNESCO alanı' : isRo ? 'Sit UNESCO' : h.label) :
            h.label
          }</p>
          <p class="font-semibold text-gray-900 text-sm">{
            h.value === '300+ sunny days/year' ? (isEl ? '300+ ηλιόλουστες μέρες/χρόνο' : isBg ? '300+ слънчеви дни/годишно' : isSr ? '300+ сунчаних дана/год.' : isTr ? 'Yılda 300+ güneşli gün' : isRo ? '300+ zile însorite/an' : h.value) :
            h.value === '5 min walk' ? (isEl ? '5 λεπτά με τα πόδια' : isBg ? '5 мин. пеша' : isSr ? '5 мин. пешке' : isTr ? '5 dk yürüyüş' : isRo ? '5 min pe jos' : h.value) :
            h.value === '35 min away' ? (isEl ? '35 λεπτά μακριά' : isBg ? 'На 35 мин.' : isSr ? '35 мин. удаљено' : isTr ? '35 dk uzakta' : isRo ? 'La 35 min' : h.value) :
            h.value === 'Ancient Philippi' ? (isEl ? 'Αρχαίοι Φίλιπποι' : isBg ? 'Древен Филипи' : isSr ? 'Антички Филипи' : isTr ? 'Antik Philippi' : isRo ? 'Philippi Antic' : h.value) :
            h.value
          }</p>
        </div>
      ))}
    </div>

    <div class="space-y-20">

      <!-- Beaches -->
      <section>
        <h2 class="text-2xl font-bold text-gray-900 mb-2 flex items-center gap-3">
          <span class="text-2xl">🏖️</span> {isEl ? 'Παραλίες' : isBg ? 'Плажове' : isSr ? 'Плаже' : isTr ? 'Plajlar' : isRo ? 'Plaje' : 'Beaches'}
        </h2>
        <p class="text-gray-500 mb-6">{isEl ? 'Η ακτογραμμή της Βόρειας Ελλάδας είναι ένα από τα καλύτερα κρυμμένα μυστικά της Ευρώπης — καθαρή, αραιοκατοικημένη και εντυπωσιακά όμορφη.' : isBg ? 'Крайбрежието на Северна Гърция е един от най-добре пазените секрети на Европа — чисто, непренаселено и зашеметяващо красиво.' : isSr ? 'Обала Северне Грчке је један од најбоље чуваних тајни Европе — чиста, ненасељена и задивљујуће лепа.' : isTr ? 'Kuzey Yunanistan\'ın kıyı şeridi Avrupa\'nın en iyi korunan sırlarından biridir — temiz, kalabalık olmayan ve etkileyici derecede güzel.' : isRo ? 'Litoralul Greciei de Nord este unul dintre cele mai bine păzite secrete ale Europei — curat, neaglomerat și impresionant de frumos.' : "Northern Greece's coastline is one of Europe's best-kept secrets — clean, uncrowded, and strikingly beautiful."}</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {beaches.map((b) => (
            <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm flex flex-col gap-3">
              <div class="flex items-start justify-between">
                <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center text-2xl shrink-0">{b.icon}</div>
                <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${b.badgeColor}`}>{
                  b.badge === '★ Most popular' ? (isEl ? '★ Πιο δημοφιλής' : isBg ? '★ Най-популярен' : isSr ? '★ Најпопуларнија' : isTr ? '★ En popüler' : isRo ? '★ Cea mai populară' : b.badge) :
                  b.badge === 'Quiet & natural' ? (isEl ? 'Ήσυχη & φυσική' : isBg ? 'Тих & природен' : isSr ? 'Тихо & природно' : isTr ? 'Sakin & doğal' : isRo ? 'Liniștită & naturală' : b.badge) :
                  b.badge === '35 min by ferry' ? (isEl ? '35 λεπτά με φέρι' : isBg ? '35 мин. с ферибот' : isSr ? '35 мин. трајектом' : isTr ? 'Feribotla 35 dk' : isRo ? '35 min cu feribotul' : b.badge) :
                  b.badge
                }</span>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 mb-1">{b.name}</h3>
                <p class="text-gray-500 text-sm leading-relaxed">{
                  b.name === 'Keramoti Beach' ? (isEl ? 'Μια μακριά αμμουδερή παραλία με κρυστάλλινα ρηχά νερά — ιδανική για οικογένειες. Ξαπλώστρες, beach bars και θαλάσσια σπορ εποχιακά.' : isBg ? 'Дълъг пясъчен плаж с кристално чиста плитка вода — идеален за семейства. Шезлонги, плажни барове и водни спортове в сезона.' : isSr ? 'Дуга пешчана плажа са кристално чистом плитком водом — идеална за породице. Лежаљке, плажни барови и водени спортови у сезони.' : isTr ? 'Kristal berraklığında sığ suları olan uzun, yavaş eğimli kumlu bir plaj — aileler için ideal. Sezonda şezlonglar, plaj barları ve su sporları mevcut.' : isRo ? 'O plajă lungă de nisip cu apă cristalină și puțin adâncă — ideală pentru familii. Șezlonguri, baruri de plajă și sporturi nautice în sezon.' : b.desc) :
                  b.name === 'Aspri Ammos' ? (isEl ? 'Απομονωμένος λευκός κολπίσκος λίγο βορειότερα. Χωρίς εγκαταστάσεις — φέρτε πικνίκ και απολαύστε την ησυχία.' : isBg ? 'Уединен залив с бял пясък на кратко разстояние на север. Без удобства — вземете пикник и се насладете на тишината.' : isSr ? 'Усамљена увала с белим песком мало северније. Без садржаја — понесите пикник и уживајте у тишини.' : isTr ? 'Biraz kuzeyde sessiz beyaz kumlu koy. Tesis yok — piknik götürün ve sessizliğin tadını çıkarın.' : isRo ? 'Un golf izolat cu nisip alb la scurt drum spre nord. Fără facilități — luați un picnic și bucurați-vă de liniște.' : b.desc) :
                  b.name === 'Thassos Beaches' ? (isEl ? 'Το νησί της Θάσου έχει παγκόσμιας κλάσης παραλίες — Παραλία Μαρμάρου, Παράδεισο, Χρυσή Αμμουδιά — όλες προσβάσιμες με σύντομο ταξίδι με φέρι.' : isBg ? 'Островът Thassos разполага с плажове от световна класа — Marble Beach, Paradise, Golden Beach — всички достъпни с кратък ферибот.' : isSr ? 'Острво Thassos има плаже светске класе — Marble Beach, Paradise, Golden Beach — све доступне кратким трајектом.' : isTr ? 'Thassos adası dünya standartlarında plajlara sahiptir — Marble Beach, Paradise, Golden Beach — hepsi kısa bir feribot yolculuğuyla ulaşılabilir.' : isRo ? 'Insula Thassos are plaje de clasă mondială — Marble Beach, Paradise, Golden Beach — toate accesibile cu o scurtă călătorie cu feribotul.' : b.desc) :
                  b.desc
                }</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Experiences by category -->
      {experiences.map((cat) => (
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-2 flex items-center gap-3">
            <span class="text-2xl">{cat.icon}</span> {
              cat.category === 'Culture & History' ? (isEl ? 'Πολιτισμός & Ιστορία' : isBg ? 'Култура & история' : isSr ? 'Култура & историја' : isTr ? 'Kültür & Tarih' : isRo ? 'Cultură & Istorie' : cat.category) :
              cat.category === 'Nature & Outdoors' ? (isEl ? 'Φύση & Υπαίθριο' : isBg ? 'Природа & активен отдих' : isSr ? 'Природа & активности' : isTr ? 'Doğa & Açık Hava' : isRo ? 'Natură & Aer liber' : cat.category) :
              cat.category === 'Food & Drink' ? (isEl ? 'Φαγητό & Ποτό' : isBg ? 'Храна & напитки' : isSr ? 'Храна & пиће' : isTr ? 'Yeme & İçme' : isRo ? 'Mâncare & Băuturi' : cat.category) :
              cat.category
            }
          </h2>
          <div class="space-y-3 mt-6">
            {cat.items.map((item) => (
              <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm flex flex-col sm:flex-row sm:items-start gap-4">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-1">
                    <h3 class="font-semibold text-gray-900">{
                      item.name === 'Kefalonia Old Town' ? (isEl ? 'Παλαιά Πόλη Καβάλας' : isBg ? 'Стар град Kefalonia' : isSr ? 'Стари град Kefalonia' : isTr ? 'Kefalonia Eski Şehir' : isRo ? 'Orașul Vechi Kefalonia' : item.name) :
                      item.name === 'Xanthi Old Town' ? (isEl ? 'Παλαιά Πόλη Ξάνθης' : isBg ? 'Стар град Ксанти' : isSr ? 'Стари град Ксанти' : isTr ? 'Xanthi Eski Şehir' : isRo ? 'Orașul Vechi Xanthi' : item.name) :
                      item.name === 'Nestos River Gorge' ? (isEl ? 'Φαράγγι Ποταμού Νέστου' : isBg ? 'Ждрело на река Места' : isSr ? 'Кланац реке Несtos' : isTr ? 'Nestos Nehri Kanyonu' : isRo ? 'Defileul Râului Nestos' : item.name) :
                      item.name === 'Mount Kefalonia' ? (isEl ? 'Βουνό Καβάλας' : isBg ? 'Планината край Kefalonia' : isSr ? 'Планина код Kefalonia' : isTr ? 'Kefalonia Dağı' : isRo ? 'Muntele Kefalonia' : item.name) :
                      item.name === 'Seafood tavernas' ? (isEl ? 'Ταβέρνες θαλασσινών' : isBg ? 'Таверни за морска храна' : isSr ? 'Таверне с морским плодовима' : isTr ? 'Deniz ürünleri tavernaları' : isRo ? 'Taverne cu fructe de mare' : item.name) :
                      item.name === 'Local wineries' ? (isEl ? 'Τοπικά οινοποιεία' : isBg ? 'Местни изби' : isSr ? 'Локалне винарије' : isTr ? 'Yerel şarap mahzenleri' : isRo ? 'Crame locale' : item.name) :
                      item.name === 'Kefalonia food scene' ? (isEl ? 'Γαστρονομία Καβάλας' : isBg ? 'Гастрономия на Kefalonia' : isSr ? 'Гастрономија Kefalonia' : isTr ? 'Kefalonia yeme içme sahnesi' : isRo ? 'Scena gastronomică Kefalonia' : item.name) :
                      item.name
                    }</h3>
                    <span class="text-xs text-[#c9a96e] font-medium bg-[#c9a96e]/10 px-2 py-0.5 rounded-full shrink-0">{
                      item.detail === '40 min · UNESCO World Heritage' ? (isEl ? '40 λεπτά · Παγκόσμια Κληρονομιά UNESCO' : isBg ? '40 мин. · Световно наследство на ЮНЕСКО' : isSr ? '40 мин. · УНЕСКО светска баштина' : isTr ? '40 dk · UNESCO Dünya Mirası' : isRo ? '40 min · Patrimoniu Mondial UNESCO' : item.detail) :
                      item.detail === '35 min · Byzantine castle' ? (isEl ? '35 λεπτά · Βυζαντινό κάστρο' : isBg ? '35 мин. · Византийска крепост' : isSr ? '35 мин. · Византијска тврђава' : isTr ? '35 dk · Bizans kalesi' : isRo ? '35 min · Castel bizantin' : item.detail) :
                      item.detail === '45 min · Traditional market' ? (isEl ? '45 λεπτά · Παραδοσιακή αγορά' : isBg ? '45 мин. · Традиционен пазар' : isSr ? '45 мин. · Традиционна пијаца' : isTr ? '45 dk · Geleneksel çarşı' : isRo ? '45 min · Piață tradițională' : item.detail) :
                      item.detail === '50 min · Kayaking & hiking' ? (isEl ? '50 λεπτά · Kayaking & πεζοπορία' : isBg ? '50 мин. · Каяк & туризъм' : isSr ? '50 мин. · Кајак & пешачење' : isTr ? '50 dk · Kano & yürüyüş' : isRo ? '50 min · Caiac & drumeții' : item.detail) :
                      item.detail === '30 min · Birdwatching' ? (isEl ? '30 λεπτά · Παρατήρηση πουλιών' : isBg ? '30 мин. · Наблюдение на птици' : isSr ? '30 мин. · Посматрање птица' : isTr ? '30 dk · Kuş gözlemi' : isRo ? '30 min · Observarea păsărilor' : item.detail) :
                      item.detail === '1h · Hiking trails' ? (isEl ? '1 ώρα · Μονοπάτια πεζοπορίας' : isBg ? '1 ч. · Туристически пътеки' : isSr ? '1 сат · Планинарске стазе' : isTr ? '1 saat · Yürüyüş parkurları' : isRo ? '1h · Trasee de drumeție' : item.detail) :
                      item.detail === 'Keramoti port' ? (isEl ? 'Λιμάνι Κεραμωτίου' : isBg ? 'Пристанище Keramoti' : isSr ? 'Лука Keramoti' : isTr ? 'Keramoti limanı' : isRo ? 'Portul Keramoti' : item.detail) :
