<script is:inline define:vars={{
  fullDescription: displayDescription,
}}>
  // Show more description
  const btn = document.getElementById('show-more-desc');
  const txt = document.getElementById('desc-text');
  if (btn && txt) {
    btn.addEventListener('click', () => {
      txt.textContent = fullDescription;
      btn.remove();
    });
  }

  // Message Host floating widget toggle
  const msgBtn   = document.getElementById('msg-host-btn');
  const msgPanel = document.getElementById('msg-host-panel');
  const iconChat  = document.getElementById('msg-icon-chat');
  const iconClose = document.getElementById('msg-icon-close');
  if (msgBtn && msgPanel) {
    msgBtn.addEventListener('click', function() {
      var open = !msgPanel.classList.contains('hidden');
      msgPanel.classList.toggle('hidden', open);
      iconChat.classList.toggle('hidden', !open);
      iconClose.classList.toggle('hidden', open);
    });
    // Close when clicking outside
    document.addEventListener('click', function(e) {
      if (!msgBtn.contains(e.target) && !msgPanel.contains(e.target)) {
        msgPanel.classList.add('hidden');
        iconChat.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });
  }
</script>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  // Fix default marker icon paths broken by bundlers
  import markerIcon2x from 'leaflet/dist/images/marker-icon-2x.png?url';
  import markerIcon   from 'leaflet/dist/images/marker-icon.png?url';
  import markerShadow from 'leaflet/dist/images/marker-shadow.png?url';
  delete (L.Icon.Default.prototype as any)._getIconUrl;
  L.Icon.Default.mergeOptions({ iconUrl: markerIcon, iconRetinaUrl: markerIcon2x, shadowUrl: markerShadow });

  const el = document.getElementById('listing-map') as HTMLElement | null;
  if (el) {
    const lat   = parseFloat(el.dataset.lat!);
    const lng   = parseFloat(el.dataset.lng!);
    const title = el.dataset.title ?? '';
    const map = L.map(el, { scrollWheelZoom: false }).setView([lat, lng], 16);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);
    L.marker([lat, lng]).addTo(map).bindPopup(`<strong>${title}</strong>`).openPopup();
  }
</script>

<!-- Listing view tracking -->
<script define:vars={{ listingId: listing.id }}>
  (() => {
    // Simple session ID to deduplicate rapid reloads
    let sid = sessionStorage.getItem('_vsid');
    if (!sid) { sid = Math.random().toString(36).slice(2); sessionStorage.setItem('_vsid', sid); }
    // Only track once per session per listing
    const key = `_v_${listingId}`;
    if (sessionStorage.getItem(key)) return;
    sessionStorage.setItem(key, '1');
    fetch('/api/track/view', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ listing_id: listingId, referrer: document.referrer || null, session_id: sid }),
      keepalive: true,
    }).catch(() => {});
  })();
</script>
