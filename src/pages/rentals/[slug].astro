---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/listing/Gallery.astro';
import AmenitiesGrid from '../../components/listing/AmenitiesGrid.astro';
import AvailabilityCalendar from '../../components/listing/AvailabilityCalendar.astro';
import BookingWidget from '../../components/listing/BookingWidget.astro';
import ReviewsSection from '../../components/listing/ReviewsSection.astro';
import StarRating from '../../components/shared/StarRating.astro';
import { formatPrice } from '../../lib/pricing.ts';
import { t, type Lang } from '../../i18n/translations.ts';
import type { ListingWithDetails, Review, BlockedDate, Season, Booking } from '../../types/index.ts';
import { getServiceClient } from '../../lib/supabase.ts';

const { slug } = Astro.params;
const lang = (Astro.locals.lang ?? 'en') as Lang;
const supabase = Astro.locals.supabase;
const service  = getServiceClient();
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? '';

// Fetch listing (include owner subscription status for direct-contact gating)
const { data: rawListing, error } = await supabase
  .from('listings')
  .select('*, listing_images(*), listing_amenities(amenities(*)), profiles:owner_id(subscription_active)')
  .eq('slug', slug)
  .eq('is_active', true)
  .single();

if (error || !rawListing) return Astro.redirect('/rentals');

const listing: ListingWithDetails = {
  ...rawListing,
  listing_images: rawListing.listing_images ?? [],
  amenities: (rawListing.listing_amenities ?? []).map((la: any) => la.amenities).filter(Boolean),
};

// Pick translated content, fallback to English
function localized(i18nMap: Record<string, string> | null, fallback: string): string {
  if (lang !== 'en' && i18nMap?.[lang]) return i18nMap[lang];
  return fallback ?? '';
}
const displayTitle       = localized(listing.title_i18n,       listing.title);
const displayTagline     = localized(listing.tagline_i18n,     listing.tagline ?? '');
const displayDescription = localized(listing.description_i18n, listing.description ?? '');
const displayHouseRules  = localized(listing.house_rules_i18n, listing.house_rules ?? '');

// Fetch seasons, blocked dates, bookings (for calendar)
const [seasonsRes, blockedRes, bookingsRes, reviewsRes] = await Promise.all([
  supabase.from('seasons').select('*').eq('listing_id', listing.id),
  service.from('blocked_dates').select('*').eq('listing_id', listing.id),
  service.from('bookings').select('check_in,check_out').eq('listing_id', listing.id).in('status', ['pending','confirmed']),
  supabase.from('reviews').select('*').eq('listing_id', listing.id).eq('is_published', true).order('created_at', { ascending: false }),
]);

const seasons: Season[] = seasonsRes.data ?? [];
const blocked: BlockedDate[] = blockedRes.data ?? [];
const bookings: Pick<Booking, 'check_in' | 'check_out'>[] = bookingsRes.data ?? [];
const reviews: Review[] = reviewsRes.data ?? [];

// Build unavailable ranges for calendar
const unavailableRanges = [
  ...bookings.map((b) => ({ start: b.check_in, end: b.check_out })),
  ...blocked.map((b) => ({ start: b.start_date, end: b.end_date })),
];

// URL params (from hero search form)
const checkIn  = Astro.url.searchParams.get('check_in') ?? '';
const checkOut = Astro.url.searchParams.get('check_out') ?? '';

const cover = listing.listing_images.find((i) => i.is_cover) ?? listing.listing_images[0];

// Schema.org
const listingUrl = `${siteUrl}/rentals/${listing.slug}`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'VacationRental',
    '@id': `${listingUrl}#rental`,
    name: listing.title,
    description: listing.description ?? listing.tagline ?? '',
    url: listingUrl,
    image: listing.listing_images.map((i) => i.url),
    address: {
      '@type': 'PostalAddress',
      streetAddress: listing.address ?? '',
      addressLocality: listing.city ?? 'Keramoti',
      addressRegion: listing.region ?? 'Kefalonia',
      postalCode: '64004',
      addressCountry: listing.country ?? 'GR',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: listing.latitude ?? 40.9716,
      longitude: listing.longitude ?? 24.6736,
    },
    numberOfRooms: listing.bedrooms,
    numberOfBathroomsTotal: listing.bathrooms ?? 1,
    floorSize: listing.area_sqm ? { '@type': 'QuantitativeValue', value: listing.area_sqm, unitCode: 'MTK' } : undefined,
    occupancy: { '@type': 'QuantitativeValue', maxValue: listing.max_guests },
    petsAllowed: listing.pet_friendly ?? false,
    checkinTime: listing.check_in_time ?? '15:00',
    checkoutTime: listing.check_out_time ?? '11:00',
    priceRange: `€${listing.base_price}/night`,
    offers: {
      '@type': 'Offer',
      url: listingUrl,
      priceCurrency: 'EUR',
      price: listing.base_price,
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: listing.base_price,
        priceCurrency: 'EUR',
        referenceQuantity: {
          '@type': 'QuantitativeValue',
          value: 1,
          unitCode: 'DAY',
        },
      },
      availability: 'https://schema.org/InStock',
    },
    amenityFeature: listing.amenities.map((a: any) => ({
      '@type': 'LocationFeatureSpecification',
      name: a.name,
      value: true,
    })),
    ...(listing.review_count > 0 && {
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: listing.avg_rating.toFixed(1),
        reviewCount: listing.review_count,
        bestRating: 5,
        worstRating: 1,
      },
    }),
    ...(reviews.length > 0 && {
      review: reviews.slice(0, 5).map((r: Review) => ({
        '@type': 'Review',
        reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 },
        author: { '@type': 'Person', name: r.guest_name },
        reviewBody: r.body,
      })),
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Rentals', item: `${siteUrl}/rentals` },
      { '@type': 'ListItem', position: 3, name: listing.title, item: listingUrl },
    ],
  },
];
---

<BaseLayout
  title={listing.meta_title ?? `${displayTitle} – Direct Booking`}
  description={listing.meta_description ?? displayTagline ?? displayDescription.slice(0, 160) ?? ''}
  ogImage={cover?.url}
  ogType="product"
  canonical={listingUrl}
  schema={schema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Breadcrumb -->
    <nav class="py-4 text-sm text-gray-400">
      <a href="/" class="hover:text-gray-700 transition-colors">{t(lang,'common.home')}</a>
      <span class="mx-2">/</span>
      <a href="/rentals" class="hover:text-gray-700 transition-colors">{t(lang,'common.rentals')}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-700">{displayTitle}</span>
    </nav>

    <!-- Title -->
    <div class="mb-4">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">{displayTitle}</h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
        {listing.review_count > 0 && (
          <div class="flex items-center gap-1.5">
            <StarRating rating={listing.avg_rating} size="sm" showNumber />
            <span>({listing.review_count} reviews)</span>
          </div>
        )}
        {listing.is_active && <span class="text-emerald-600 font-medium">{t(lang,'listing.available_badge')}</span>}
        <span>📍 {listing.city}, {listing.country}</span>
      </div>
    </div>

    <!-- Gallery -->
    <div class="mb-10">
      <Gallery images={listing.listing_images} title={displayTitle} />
    </div>

    <!-- Two-column layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 pb-20">

      <!-- Left: content -->
      <div class="lg:col-span-2 space-y-10">

        <!-- Key stats -->
        <div class="flex flex-wrap gap-6 py-6 border-b border-gray-100">
          {[
            { label: `${listing.max_guests} ${t(lang,'listing.guests_stat')}` },
            { label: `${listing.bedrooms} ${t(lang,'listing.bedrooms_stat')}` },
            { label: `${listing.beds} ${t(lang,'listing.beds_stat')}` },
            { label: `${listing.bathrooms} ${t(lang,'listing.baths_stat')}` },
            { label: listing.property_type.replace('_', ' ') },
          ].map((s) => (
            <div class="text-sm text-gray-600 font-medium">{s.label}</div>
          ))}
        </div>

        <!-- Highlights -->
        <div>
          <h2 class="text-xl font-bold text-gray-900 mb-4">{t(lang,'listing.highlights_title')}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {listing.amenities.slice(0, 6).map((a) => (
              <div class="flex items-start gap-3">
                <span class="text-2xl mt-0.5">{a.icon}</span>
                <div>
                  <p class="font-medium text-gray-900 text-sm">{a.label}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Description -->
        {displayDescription && (
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-4">{t(lang,'listing.about_prop')}</h2>
            <div class="text-gray-600 leading-relaxed whitespace-pre-line text-sm sm:text-base" id="desc-text">
              {displayDescription.length > 500 ? displayDescription.slice(0, 500) + '…' : displayDescription}
            </div>
            {displayDescription.length > 500 && (
              <button id="show-more-desc" class="mt-3 text-sm font-semibold text-[#1a1a2e] underline hover:text-[#c9a96e] transition-colors">
                {t(lang,'listing.show_more')}
              </button>
            )}
          </div>
        )}

        <!-- Amenities -->
        <div>
          <h2 class="text-xl font-bold text-gray-900 mb-6">{t(lang,'listing.amenities_title')}</h2>
          <AmenitiesGrid amenities={listing.amenities} />
        </div>

        <!-- Sleeping arrangements -->
        <div>
          <h2 class="text-xl font-bold text-gray-900 mb-4">{t(lang,'listing.sleeping')}</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            {Array.from({ length: listing.bedrooms }, (_, i) => (
              <div class="border border-gray-200 rounded-xl p-4">
                <p class="text-2xl mb-2">🛏️</p>
                <p class="font-medium text-sm text-gray-900">{t(lang,'listing.bedroom_label')} {i + 1}</p>
                <p class="text-xs text-gray-500">{t(lang,'listing.beds_range')}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Availability calendar -->
        <div id="availability">
          <h2 class="text-xl font-bold text-gray-900 mb-2">{t(lang,'listing.availability')}</h2>
          <p class="text-sm text-gray-500 mb-6">{t(lang,'listing.min_stay_label')}: {listing.min_nights} {t(lang,'widget.nights')}</p>
          <AvailabilityCalendar
            unavailableRanges={unavailableRanges}
            minNights={listing.min_nights}
            checkIn={checkIn}
            checkOut={checkOut}
          />
        </div>

        <!-- Reviews -->
        <div id="reviews">
          <h2 class="text-xl font-bold text-gray-900 mb-6">
            {listing.review_count > 0
              ? `${listing.review_count} ${listing.review_count !== 1 ? t(lang,'reviews.reviews_pl') : t(lang,'reviews.review')}`
              : t(lang,'listing.reviews_title')}
          </h2>
          <ReviewsSection reviews={reviews} avgRating={listing.avg_rating} reviewCount={listing.review_count} />
          {listing.review_count === 0 && (
            <p class="text-gray-400 text-sm">{t(lang,'listing.no_reviews_yet')}</p>
          )}
        </div>

        <!-- Map -->
        {(listing.latitude && listing.longitude) && (
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-2">{t(lang,'listing.location')}</h2>
            <div class="flex items-center justify-between mb-4">
              <p class="text-sm text-gray-500">{listing.address}, {listing.city}, {listing.country}</p>
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${listing.latitude},${listing.longitude}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-medium text-[#1a1a2e] hover:text-[#c9a96e] transition-colors whitespace-nowrap ml-4"
              >
                {t(lang,'listing.open_maps')} ↗
              </a>
            </div>
            <div
              id="listing-map"
              data-lat={listing.latitude}
              data-lng={listing.longitude}
              data-title={listing.title}
              class="w-full h-72 sm:h-96 rounded-2xl overflow-hidden border border-gray-200 shadow-sm"
              style="z-index:0"
            ></div>
          </div>
        )}

        <!-- House rules -->
        {displayHouseRules && (
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-4">{t(lang,'listing.house_rules')}</h2>
            <div class="bg-gray-50 rounded-2xl p-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                <div class="flex items-center gap-2 text-sm text-gray-700">
                  <span>🕒</span> {t(lang,'listing.checkin_from')} {listing.check_in_time}
                </div>
                <div class="flex items-center gap-2 text-sm text-gray-700">
                  <span>🕙</span> {t(lang,'listing.checkout_by')} {listing.check_out_time}
                </div>
              </div>
              <p class="text-sm text-gray-600 whitespace-pre-line">{displayHouseRules}</p>
            </div>
          </div>
        )}

        <!-- Cancellation policy -->
        <div>
          <h2 class="text-xl font-bold text-gray-900 mb-4">{t(lang,'listing.cancellation')}</h2>
          <div class="bg-gray-50 rounded-2xl p-6">
            <p class="font-semibold text-gray-900 mb-2 capitalize">{listing.cancellation_policy}</p>
            <p class="text-sm text-gray-600">{t(lang, 'cancel.' + listing.cancellation_policy)}</p>
          </div>
        </div>
      </div>

      <!-- Right: sticky booking widget -->
      <div class="lg:col-span-1 lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto lg:pr-1">
        <BookingWidget listing={listing} seasons={seasons} unavailableRanges={unavailableRanges} />

        <!-- Trust signals -->
        <div class="mt-6 space-y-3 text-sm text-gray-500">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            {t(lang,'listing.secure_pay')}
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {t(lang,'listing.free_cancel')}
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            {t(lang,'listing.confirm_email')}
          </div>
        </div>

      </div>
    </div>

    <!-- Mobile sticky book CTA -->
    <div class="lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 p-4 flex items-center justify-between gap-4">
      <div>
        <p class="font-bold text-gray-900">{formatPrice(listing.base_price)} <span class="text-gray-500 font-normal text-sm">{t(lang,'widget.per_night')}</span></p>
        {listing.review_count > 0 && (
          <div class="flex items-center gap-1">
            <StarRating rating={listing.avg_rating} size="sm" />
            <span class="text-xs text-gray-500">({listing.review_count})</span>
          </div>
        )}
      </div>
      <a href="#availability" class="bg-[#1a1a2e] text-white font-semibold px-6 py-3 rounded-xl text-sm hover:bg-[#2d2d4e] transition-colors">
        {t(lang,'listing.check_dates')}
      </a>
    </div>

    {/* Floating "Message Host" widget — shown only for subscribed owners with contact details set */}
    {(() => {
      const ownerSubscribed = (rawListing as any)?.profiles?.subscription_active === true;
      return ownerSubscribed && listing.host_messaging_visible && listing.host_phone && (listing.host_whatsapp || listing.host_viber || listing.host_telegram);
    })() && (() => {
      const phone = (listing.host_phone ?? '').replace(/[^+\d]/g, '');
      // Normalize to full international format (add GR country code if missing)
      const intlPhone = phone.startsWith('+') ? phone.slice(1) : phone.startsWith('30') ? phone : '30' + phone;
      const channels: { name: string; href: string; color: string; icon: string }[] = [];
      const _tMsgWA = lang === 'el' ? 'Μήνυμα στο WhatsApp' : lang === 'bg' ? 'Съобщение в WhatsApp' : lang === 'sr' ? 'Порука на WhatsApp' : lang === 'tr' ? "WhatsApp'ta mesaj" : 'Message on WhatsApp';
      const _tMsgViber = lang === 'el' ? 'Μήνυμα στο Viber' : lang === 'bg' ? 'Съобщение в Viber' : lang === 'sr' ? 'Порука на Viber' : lang === 'tr' ? "Viber'da mesaj" : 'Message on Viber';
      const _tMsgTelegram = lang === 'el' ? 'Μήνυμα στο Telegram' : lang === 'bg' ? 'Съобщение в Telegram' : lang === 'sr' ? 'Порука на Telegram' : lang === 'tr' ? "Telegram'da mesaj" : 'Message on Telegram';
      const _tMsgHost = lang === 'el' ? 'Μήνυμα στον οικοδεσπότη' : lang === 'bg' ? 'Съобщение до домакина' : lang === 'sr' ? 'Порука домаћину' : lang === 'tr' ? 'Ev sahibine mesaj' : 'Message the host';
      if (listing.host_whatsapp) channels.push({
        name: _tMsgWA,
        href: `https://wa.me/${intlPhone}?text=${encodeURIComponent(`Hi! I'm interested in your property "${listing.title}". Is it available?`)}`,
        color: 'bg-[#25D366] hover:bg-[#1ebe57]',
        icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`,
      });
      if (listing.host_viber) channels.push({
        name: _tMsgViber,
        href: `viber://chat?number=%2B${intlPhone}`,
        color: 'bg-[#7360F2] hover:bg-[#5f4dd4]',
        icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M11.4 0C9.473.028 5.333.344 3.02 2.467 1.302 4.187.567 6.747.467 9.907c-.1 3.16-.233 9.087 5.567 10.707h.007l-.007 2.46s-.04.993.617 1.193c.793.247 1.26-.51 2.02-1.327.42-.453.993-1.12 1.427-1.627 3.933.333 6.96-.427 7.307-.547.8-.273 5.327-.84 6.06-6.867.76-6.227-.367-10.16-2.4-11.913C19.277.533 15.2.027 13.267.007 12.84 0 12.16-.007 11.4 0zm.267 1.767c.7.007 1.307.02 1.68.04 1.667.02 5.32.447 6.8 1.907 1.613 1.4 2.58 4.94 1.92 10.147-.607 4.747-4.12 5.413-4.8 5.647-.287.1-2.94.76-6.28.573 0 0-2.487 3-3.267 3.787-.12.127-.267.18-.367.153-.14-.033-.18-.187-.173-.413l.033-4.107s-.007-.007 0 0c-4.94-1.32-4.653-6.34-4.58-9.073.073-2.727.667-4.967 2.133-6.413 1.98-1.78 5.56-2.22 6.9-2.247zm.853 3.02a.42.42 0 00-.42.433.42.42 0 00.42.42c1.107.013 2.093.453 2.853 1.2.76.747 1.207 1.8 1.267 2.94a.42.42 0 00.433.407h.013a.42.42 0 00.407-.433c-.067-1.333-.6-2.54-1.513-3.44a5.173 5.173 0 00-3.46-1.527zm-3.967.627c-.24-.007-.48.08-.72.307l-.007.007c-.56.52-.98 1.14-1.073 1.813-.007.02-.007.047-.007.073v.46a3.39 3.39 0 00.18.887l.02.073c.32.94.92 2.073 1.8 3.227l.02.027c1.147 1.5 2.727 3.013 4.773 4.02l.04.02.04.02a13.85 13.85 0 001.593.667c.727.247 1.36.347 1.92.307.333-.02.667-.093.98-.267a2.68 2.68 0 00.78-.647l.007-.007c.287-.353.487-.753.487-1.16 0-.273-.127-.5-.36-.627l-1.953-1.2a.91.91 0 00-.48-.147.77.77 0 00-.587.3l-.54.647c-.18.213-.393.193-.393.193l-.02.007c-2.007-.54-3.533-2.18-3.533-2.18s-.02-.22.193-.4l.647-.54c.193-.207.333-.42.3-.587a.828.828 0 00-.147-.48l-1.2-1.96c-.14-.227-.367-.367-.647-.36h-.033zm4.907.447a.42.42 0 00-.1.833 2.68 2.68 0 011.88.82c.487.507.767 1.18.78 1.887a.42.42 0 00.42.413h.007a.42.42 0 00.413-.427 3.573 3.573 0 00-1.04-2.507 3.573 3.573 0 00-2.36-1.02z"/></svg>`,
      });
