---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://kefaloniabnb.com';
const lang = (Astro.locals.lang ?? 'en') as string;
const isEl = lang === 'el';
const isBg = lang === 'bg';
const isSr = lang === 'sr';
const isTr = lang === 'tr';
const isRo = lang === 'ro';

const platformProblems = [
  {
    label: isEl ? 'Οι επισκέπτες πληρώνουν έως 14% επιπλέον' : isBg ? 'Гостите плащат до 14% повече' : isSr ? 'Гости плаћају до 14% више' : isTr ? 'Misafirler %14\'e kadar fazla öder' : isRo ? 'Oaspeții plătesc până la 14% în plus' : 'Guests pay up to 14% extra',
    desc:  isEl ? 'Προστίθεται στην ολοκλήρωση αγοράς. Οι επισκέπτες το βλέπουν, το αντιπαθούν και μερικές φορές ακυρώνουν.' : isBg ? 'Добавя се при плащане. Гостите го виждат, недоволстват и понякога отказват резервацията.' : isSr ? 'Додаје се при плаћању. Гости то виде, не воле и понекад отказују резервацију.' : isTr ? 'Ödeme sırasında eklenir. Misafirler bunu görür, hoşlanmaz ve bazen iptal eder.' : isRo ? 'Adăugat la checkout. Oaspeții o văd, o resimt și uneori anulează.' : 'Added at checkout. Guests see it, resent it, and sometimes cancel.',
  },
  {
    label: isEl ? 'Οι ιδιοκτήτες χάνουν έως 16%' : isBg ? 'Собствениците губят до 16%' : isSr ? 'Власници губе до 16%' : isTr ? 'Mülk sahipleri %16\'ya kadar kaybeder' : isRo ? 'Proprietarii pierd până la 16%' : 'Owners lose up to 16%',
    desc:  isEl ? 'Προμήθειες οικοδεσπότη σε κάθε πληρωμή — επιπλέον της χρέωσης επισκεπτών.' : isBg ? 'Такси за домакина при всяко плащане — в допълнение към таксата за госта.' : isSr ? 'Накнаде домаћина при свакој исплати — поврх накнаде за госта.' : isTr ? 'Her ödemede ev sahibi ücretleri — misafir ücretinin üstüne.' : isRo ? 'Taxe de gazdă la fiecare plată — pe lângă taxa pentru oaspeți.' : 'Host fees on every payout — on top of the guest fee.',
  },
  {
    label: isEl ? 'Επικοινωνείτε μέσω παρακολουθούμενης πλατφόρμας' : isBg ? 'Комуникирате чрез наблюдавана платформа' : isSr ? 'Комуницирате преко надгледане платформе' : isTr ? 'İzlenen bir platform üzerinden iletişim kuruyorsunuz' : isRo ? 'Comunicați prin intermediul unei platforme monitorizate' : 'You communicate through a monitored platform',
    desc:  isEl ? 'Χωρίς άμεση επαφή. Χωρίς WhatsApp. Χωρίς πραγματική σχέση με τους επισκέπτες σας.' : isBg ? 'Без директен контакт. Без WhatsApp. Без истинска връзка с вашите гости.' : isSr ? 'Без директног контакта. Без WhatsApp-а. Без праве везе са вашим гостима.' : isTr ? 'Doğrudan iletişim yok. WhatsApp yok. Misafirlerinizle gerçek bir ilişki yok.' : isRo ? 'Fără contact direct. Fără WhatsApp. Fără o relație reală cu oaspeții dvs.' : 'No direct contact. No WhatsApp. No real relationship with your guests.',
  },
  {
    label: isEl ? 'Μία κακή κριτική ρίχνει την κατάταξή σας' : isBg ? 'Една лоша рецензия срива класирането ви' : isSr ? 'Једна лоша рецензија урушава ваш рангирање' : isTr ? 'Bir kötü yorum sıralamanızı düşürür' : isRo ? 'O recenzie proastă vă distruge clasamentul' : 'One bad review tanks your ranking',
    desc:  isEl ? 'Ένας αλγόριθμος που δεν ελέγχετε αποφασίζει ποιος βλέπει την καταχώρισή σας.' : isBg ? 'Алгоритъм, който не контролирате, решава кой вижда обявата ви.' : isSr ? 'Алгоритам који не контролишете одлучује ко види ваш оглас.' : isTr ? 'Kontrol edemediğiniz bir algoritma ilanınızı kimin gördüğüne karar verir.' : isRo ? 'Un algoritm pe care nu-l controlați decide cine vă vede listarea.' : "An algorithm you don't control decides who sees your listing.",
  },
  {
    label: isEl ? 'Χωρίς τοπική γνώση, χωρίς τοπική υποστήριξη' : isBg ? 'Без местни познания, без местна подкрепа' : isSr ? 'Без локалног знања, без локалне подршке' : isTr ? 'Yerel bilgi yok, yerel destek yok' : isRo ? 'Fără cunoștințe locale, fără suport local' : 'No local knowledge, no local support',
    desc:  isEl ? `Είστε μία από εκατομμύρια καταχωρίσεις. Η Καβάλα δεν είναι αγορά προτεραιότητας γι' αυτούς.` : isBg ? 'Вие сте една от милиони обяви. Kefalonia не е приоритетен пазар за тях.' : isSr ? 'Један сте од милиона огласа. Кавала није приоритетно тржиште за њих.' : isTr ? 'Milyonlarca ilanın biriysiniz. Kefalonia onlar için öncelikli bir pazar değil.' : isRo ? 'Sunteți una din milioane de listări. Kefalonia nu este o piață prioritară pentru ei.' : "You're one of millions of listings. Kefalonia is not a priority market for them.",
  },
];

const agencyProblems = [
  {
    label: isEl ? '20–35% προμήθεια σε κάθε κράτηση' : isBg ? '20–35% комисионна от всяка резервация' : isSr ? '20–35% провизија на свакој резервацији' : isTr ? 'Her rezervasyonda %20–35 komisyon' : isRo ? '20–35% comision la fiecare rezervare' : '20–35% commission on every booking',
    desc:  isEl ? 'Εσείς δημιουργήσατε το ακίνητο. Αυτοί το εκμεταλλεύονται. Με έξοδά σας.' : isBg ? 'Вие изградихте имота. Те управляват бизнеса. За ваша сметка.' : isSr ? 'Ви сте изградили некретнину. Они воде посао. На ваш рачун.' : isTr ? 'Mülkü siz inşa ettiniz. İşi onlar yürütüyor. Sizin masrafınıza.' : isRo ? 'Dvs. ați construit proprietatea. Ei conduc afacerea. Pe cheltuiala dvs.' : 'You built the asset. They run the business. At your expense.',
  },
  {
    label: isEl ? 'Αυτοί αποφασίζουν τιμές, επισκέπτες και καθαρισμό' : isBg ? 'Те решават цените, гостите и почистването' : isSr ? 'Они одлучују о ценама, гостима и чишћењу' : isTr ? 'Fiyatları, misafirleri ve temizliği onlar belirler' : isRo ? 'Ei decid prețurile, oaspeții și curățenia' : 'They decide pricing, guests, and cleaning',
    desc:  isEl ? 'Το ακίνητό σας, οι κανόνες τους. Καμία ορατότητα στα τεκταινόμενα.' : isBg ? 'Вашият имот, техните правила. Никаква прозрачност за случващото се.' : isSr ? 'Ваша некретнина, њихова правила. Никаква видљивост у оно што се дешава.' : isTr ? 'Sizin mülkünüz, onların kuralları. Neler olduğuna dair hiçbir şeffaflık yok.' : isRo ? 'Proprietatea dvs., regulile lor. Fără vizibilitate asupra a ce se întâmplă.' : "Your property, their rules. No visibility into what's happening.",
  },
  {
    label: isEl ? 'Χωρίς άμεση επικοινωνία με επισκέπτες' : isBg ? 'Без директна комуникация с гостите' : isSr ? 'Без директне комуникације са гостима' : isTr ? 'Misafirlerle doğrudan iletişim yok' : isRo ? 'Fără comunicare directă cu oaspeții' : 'No direct guest communication',
    desc:  isEl ? "Δεν ξέρετε ποιος διαμένει στο ακίνητό σας." : isBg ? 'Не знаете кой отсяда в имота ви.' : isSr ? 'Не знате ко борави у вашој некретнини.' : isTr ? 'Mülkünüzde kimin kaldığını bilmiyorsunuz.' : isRo ? 'Nu știți cine stă în proprietatea dvs.' : "You don't know who's staying at your property.",
  },
  {
    label: isEl ? 'Χωρίς τεχνολογία — WhatsApp και υπολογιστικά φύλλα' : isBg ? 'Без технологии — WhatsApp и електронни таблици' : isSr ? 'Без технологије — WhatsApp и табеле' : isTr ? 'Teknoloji yok — WhatsApp ve tablolar' : isRo ? 'Fără tehnologie — WhatsApp și tabele' : 'No technology — WhatsApp and spreadsheets',
    desc:  isEl ? 'Χειροκίνητες διαδικασίες. Αργές απαντήσεις. Λάθη.' : isBg ? 'Ръчни процеси. Бавни отговори. Грешки.' : isSr ? 'Ручни процеси. Споре реакције. Грешке.' : isTr ? 'Manuel süreçler. Yavaş yanıtlar. Hatalar.' : isRo ? 'Procese manuale. Răspunsuri lente. Erori.' : 'Manual processes. Slow responses. Errors.',
  },
  {
    label: isEl ? 'Όταν είναι απασχολημένοι, το ακίνητό σας υποβαθμίζεται' : isBg ? 'Когато са заети, имотът ви е на заден план' : isSr ? 'Када су заузети, ваша некретнина је у другом плану' : isTr ? 'Meşgul olduklarında mülkünüz ikinci plana atılır' : isRo ? 'Când sunt ocupați, proprietatea dvs. este deprioritizată' : "When they're busy, your property is deprioritized",
    desc:  isEl ? 'Δεν είστε ο μοναδικός πελάτης τους. Η βίλα σας περιμένει στη σειρά.' : isBg ? 'Не сте единственият им клиент. Вилата ви чака на опашка.' : isSr ? 'Нисте им једини клијент. Ваша вила чека у реду.' : isTr ? 'Tek müşterileri siz değilsiniz. Villanız sırada bekliyor.' : isRo ? 'Nu sunteți singurul lor client. Vila dvs. așteaptă la rând.' : "You're not their only client. Your villa waits in line.",
  },
];

const comparisonRows = [
  { label: isEl ? 'Χρέωση κράτησης επισκέπτη' : isBg ? 'Такса за резервация от госта' : isSr ? 'Накнада за резервацију госта' : isTr ? 'Misafir rezervasyon ücreti' : isRo ? 'Taxă de rezervare oaspete' : 'Guest booking fee',              platforms: '~14%',      agency: '0%',         us: '0%',       highlight: true },
  { label: isEl ? 'Προμήθεια ιδιοκτήτη' : isBg ? 'Комисионна на собственика' : isSr ? 'Провизија власника' : isTr ? 'Mülk sahibi komisyonu' : isRo ? 'Comision proprietar' : 'Owner commission',                        platforms: 'up to 16%', agency: '20–35%',     us: '5%',       highlight: true },
  { label: isEl ? 'Ο ιδιοκτήτης ελέγχει τιμές' : isBg ? 'Собственикът контролира цените' : isSr ? 'Власник контролише цене' : isTr ? 'Mülk sahibi fiyatları kontrol eder' : isRo ? 'Proprietarul controlează prețurile' : 'Owner controls pricing',      platforms: '✓',         agency: '✗',          us: '✓',        highlight: false },
  { label: isEl ? 'Άμεση επαφή με επισκέπτη' : isBg ? 'Директен контакт с госта' : isSr ? 'Власник директно контактира госта' : isTr ? 'Mülk sahibi misafirle doğrudan iletişim kurar' : isRo ? 'Proprietarul contactează oaspetele direct' : 'Owner contacts guest directly',       platforms: '⚠ Limited', agency: '✗',          us: '✓ Direct', highlight: false },
  { label: isEl ? 'Ενσωματωμένη αγορά καθαρισμού' : isBg ? 'Вграден пазар за почистване' : isSr ? 'Уграђена берза услуга чишћења' : isTr ? 'Yerleşik temizlik pazaryeri' : isRo ? 'Piață de curățenie integrată' : 'Built-in cleaning marketplace', platforms: '✗',        agency: '✗',          us: '✓',        highlight: false },
  { label: isEl ? 'Αυτόματες πληρωμές' : isBg ? 'Автоматични плащания' : isSr ? 'Аутоматске исплате' : isTr ? 'Otomatik ödemeler' : isRo ? 'Plăți automate' : 'Automatic payouts',                             platforms: '✓',         agency: 'Manual',     us: '✓',        highlight: false },
  { label: isEl ? 'Χωρίς δεσμευτικό συμβόλαιο' : isBg ? 'Без обвързващ договор' : isSr ? 'Без обавезујућег уговора' : isTr ? 'Bağlayıcı sözleşme yok' : isRo ? 'Fără contract obligatoriu' : 'No lock-in contract',                 platforms: '✓',         agency: '✗',          us: '✓',        highlight: false },
  { label: isEl ? 'Επαληθευμένες καταχωρίσεις' : isBg ? 'Потвърдени от администратор обяви' : isSr ? 'Огласи верификовани од стране администратора' : isTr ? 'Yönetici onaylı ilanlar' : isRo ? 'Listări verificate de admin' : 'Admin-verified listings',  platforms: '✗',         agency: 'Sometimes',  us: '✓',        highlight: false },
  { label: isEl ? 'Τοπικός ειδικός Καβάλας' : isBg ? 'Местен специалист за Kefalonia' : isSr ? 'Локални стручњак за Кавалу' : isTr ? 'Yerel Kefalonia uzmanı' : isRo ? 'Specialist local Kefalonia' : 'Local Kefalonia specialist',           platforms: '✗',         agency: 'Sometimes',  us: '✓',        highlight: false },
  { label: isEl ? 'Αγορά προσφορών καθαριστών' : isBg ? 'Пазар за оферти от почистващи фирми' : isSr ? 'Берза понуда за услуге чишћења' : isTr ? 'Temizlikçi teklif pazaryeri' : isRo ? 'Piață de licitații pentru curățători' : 'Cleaner bidding marketplace', platforms: '✗',    agency: '✗',          us: '✓',        highlight: false },
];
---

<BaseLayout
  title={isEl ? 'Γιατί να Κλείσετε Απευθείας; | KefaloniaBNB' : isBg ? 'Защо да резервирате директно? | KefaloniaBNB' : isSr ? 'Зашто резервисати директно? | KefaloniaBNB' : isTr ? 'Neden Airbnb değil? | KefaloniaBNB' : isRo ? 'De ce să Rezervați Direct? | KefaloniaBNB' : 'Why Book Direct? | KefaloniaBNB'}
  description={isEl
    ? 'Οι πλατφόρμες OTA χρεώνουν επισκέπτες 14% και ιδιοκτήτες έως 16%. Δείτε γιατί η KefaloniaBNB είναι η καλύτερη επιλογή για Καβάλα & Κεραμωτή.'
    : isBg
    ? 'OTA платформите таксуват гостите с 14% и собствениците с до 16%. Местните агенции вземат 30% и вашия контрол. Вижте защо KefaloniaBNB е по-добрият избор за Kefalonia & Keramoti.'
    : isSr
    ? 'OTA платформе наплаћују гостима 14% и власницима до 16%. Локалне агенције узимају 30% и вашу контролу. Сазнајте зашто је KefaloniaBNB бољи избор за Кавалу и Керамоти.'
    : isTr
    ? 'OTA platformları misafirlerden %14, mülk sahiplerinden %16\'ya kadar ücret alır. Yerel acentalar %30 ve kontrolünüzü alır. KefaloniaBNB\'ın Kefalonia ve Keramoti için neden daha iyi bir seçim olduğunu görün.'
    : isRo
    ? 'Platformele OTA taxează oaspeții cu 14% și proprietarii cu până la 16%. Agențiile locale iau 30% și controlul dvs. Vedeți de ce KefaloniaBNB este alegerea mai bună pentru Kefalonia și Keramoti.'
    : 'OTA platforms charge guests 14% and owners up to 16%. Local agencies take 30% and your control. See why KefaloniaBNB is the better choice for Kefalonia & Keramoti.'}
>

  <!-- Hero -->
  <section class="bg-[#1a1a2e] text-white py-24 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-[#c9a96e] font-semibold text-sm uppercase tracking-widest mb-4">
        {isEl ? 'Η ειλικρινής σύγκριση' : isBg ? 'Честното сравнение' : isSr ? 'Поштено поређење' : isTr ? 'Dürüst karşılaştırma' : isRo ? 'Comparația sinceră' : 'The honest comparison'}
      </p>
      <h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-6">
        {isEl
          ? 'Πληρώνετε 30% για το προνόμιο να αγνοείστε.'
          : isBg
          ? 'Плащате 30% за привилегията да бъдете пренебрегнати.'
          : isSr
          ? 'Плаћате 30% за привилегију да будете игнорисани.'
          : isTr
          ? 'Görmezden gelinme ayrıcalığı için %30 ödüyorsunuz.'
          : isRo
          ? 'Plătiți 30% pentru privilegiul de a fi ignorați.'
          : "You're paying 30% for the privilege of being ignored."}
      </h1>
      <p class="text-white/60 text-lg leading-relaxed max-w-2xl mx-auto">
        {isEl
          ? 'Οι πλατφόρμες κράτησης χρεώνουν τους επισκέπτες έως 14% και τους ιδιοκτήτες έως 16%. Οι τοπικές εταιρείες παίρνουν το ακίνητό σας και το διαχειρίζονται με τον τρόπο τους. Καμία δεν σχεδιάστηκε για την Καβάλα.'
          : isBg
          ? 'Платформите за резервации таксуват гостите с до 14% и собствениците с до 16%. Местните агенции вземат имота ви и го управляват по своему. Нито едната е създадена за Kefalonia.'
          : isSr
          ? 'Платформе за резервације наплаћују гостима до 14% и власницима до 16%. Локалне агенције преузимају вашу некретнину и управљају њом на свој начин. Ниједна није направљена за Кавалу.'
          : isTr
          ? 'Rezervasyon platformları misafirlerden %14\'e kadar ve mülk sahiplerinden %16\'ya kadar ücret alır. Yerel acentalar mülkünüzü alır ve kendi bildikleri gibi yönetir. Hiçbiri Kefalonia için kurulmadı.'
          : isRo
          ? 'Platformele de rezervare taxează oaspeții cu până la 14% și proprietarii cu până la 16%. Agențiile locale vă preiau proprietatea și o administrează în felul lor. Niciuna nu a fost construită pentru Kefalonia.'
          : "Booking platforms charge guests up to 14% and owners up to 16%. Local agencies take your property and run it their way. Neither of them was built for Kefalonia."}
      </p>
    </div>
  </section>

  <!-- Problem: Platforms -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <div class="inline-flex items-center gap-2 bg-red-50 border border-red-100 rounded-full px-4 py-1.5 text-sm text-red-600 font-semibold mb-6">
            {isEl ? 'Το Πρόβλημα της Πλατφόρμας' : isBg ? 'Проблемът с платформите' : isSr ? 'Проблем платформи' : isTr ? 'Platform Sorunu' : isRo ? 'Problema Platformelor' : 'The Platform Problem'}
          </div>
          <h2 class="text-3xl font-bold text-gray-900 mb-4">
            {isEl ? 'Οι πλατφόρμες OTA είναι ένας φόρος σε κάθε κράτηση.' : isBg ? 'OTA платформите са данък върху всяка резервация.' : isSr ? 'OTA платформе су порез на сваку резервацију.' : isTr ? 'OTA platformları her rezervasyona uygulanan bir vergidir.' : isRo ? 'Platformele OTA sunt o taxă pe fiecare rezervare.' : 'OTA platforms are a tax on every booking.'}
          </h2>
          <p class="text-gray-500 text-lg mb-6 leading-relaxed">
            {isEl
              ? 'Κάθε φορά που ένας επισκέπτης κλείνει τη βίλα σας μέσω πλατφόρμας κράτησης, όλοι πληρώνουν — και η πλατφόρμα κρατά τη διαφορά.'
              : isBg
              ? 'Всеки път, когато гост резервира вилата ви чрез платформа, всички плащат — а платформата задържа разликата.'
              : isSr
              ? 'Сваки пут када гост резервише вашу вилу преко платформе, сви плаћају — а платформа задржава разлику.'
              : isTr
              ? 'Bir misafir platformdan her rezervasyon yaptığında herkes ödüyor — ve platform farkı cebe atıyor.'
              : isRo
              ? 'De fiecare dată când un oaspete rezervă vila dvs. printr-o platformă, toți plătesc — iar platforma păstrează diferența.'
              : 'Every time a guest books your villa through a booking platform, everyone pays — and the platform keeps the difference.'}
          </p>
          <ul class="space-y-4">
            {platformProblems.map(item => (
              <li class="flex gap-4">
                <span class="w-5 h-5 rounded-full bg-red-100 text-red-500 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">✕</span>
                <div>
                  <p class="font-semibold text-gray-900 text-sm">{item.label}</p>
                  <p class="text-gray-500 text-sm mt-0.5">{item.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Problem: Agencies -->
        <div>
          <div class="inline-flex items-center gap-2 bg-orange-50 border border-orange-100 rounded-full px-4 py-1.5 text-sm text-orange-600 font-semibold mb-6">
            {isEl ? 'Το Πρόβλημα της Εταιρείας' : isBg ? 'Проблемът с агенциите' : isSr ? 'Проблем агенција' : isTr ? 'Acenta Sorunu' : isRo ? 'Problema Agențiilor' : 'The Agency Problem'}
          </div>
          <h2 class="text-3xl font-bold text-gray-900 mb-4">
            {isEl
              ? 'Οι εταιρείες σας δίνουν «ησυχία» — και παίρνουν τα υπόλοιπα.'
              : isBg
