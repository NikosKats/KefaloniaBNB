---
import '../styles/global.css';
import Header from '../components/shared/Header.astro';
import Footer from '../components/shared/Footer.astro';
import { getServiceClient } from '../lib/supabase.ts';

// Fetch active banner (non-blocking — null if table doesn't exist yet)
let activeBanner: { message: string; type: string; link_text: string | null; link_url: string | null; id: string } | null = null;
try {
  const service = getServiceClient();
  const { data } = await service
    .from('site_banners')
    .select('id,message,type,link_text,link_url')
    .eq('is_active', true)
    .single();
  activeBanner = data ?? null;
} catch { /* table may not exist yet */ }

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  noIndex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Book directly with KefaloniaBNB — vacation rentals in Keramoti and Kefalonia, Greece. Best rates guaranteed.',
  ogImage,
  ogType = 'website',
  canonical,
  noIndex = false,
  schema,
} = Astro.props;

const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const isLoggedIn = !!Astro.locals.session;
const vapidKey = import.meta.env.PUBLIC_VAPID_KEY ?? '';

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://kefaloniabnb.com';
const resolvedCanonical = canonical ?? siteUrl + Astro.url.pathname;
const resolvedOgImage = ogImage ?? `${siteUrl}/og-default.jpg`;
const fullTitle = title.includes('KefaloniaBNB') ? title : `${title} | KefaloniaBNB`;

// PWA: determine manifest page key from current path for unique home screen names
const pwPath = Astro.url.pathname;
const manifestPage = pwPath.startsWith('/account/messages') ? 'messages'
  : pwPath.startsWith('/account/favorites') ? 'favorites'
  : pwPath.startsWith('/account/friends') ? 'friends'
  : pwPath.startsWith('/account/notifications') ? 'notifications'
  : pwPath.startsWith('/account') ? 'account'
  : pwPath.startsWith('/community') ? 'community'
  : pwPath.startsWith('/my-booking') ? 'bookings'
  : pwPath.startsWith('/rentals') ? 'rentals'
  : '';
const pwaTitle = manifestPage === 'messages' ? 'Kefalonia Messages'
  : manifestPage === 'favorites' ? 'Kefalonia Favorites'
  : manifestPage === 'friends' ? 'Kefalonia Friends'
  : manifestPage === 'notifications' ? 'Kefalonia Notifications'
  : manifestPage === 'account' ? 'My Account — Kefalonia'
  : manifestPage === 'community' ? 'Kefalonia Community'
  : manifestPage === 'bookings' ? 'My Bookings — Kefalonia'
  : manifestPage === 'rentals' ? 'KefaloniaBNB'
  : fullTitle;

// i18n
const currentLang = (Astro.locals.lang ?? 'en') as string;
const isEl = currentLang === 'el';
const isBg = currentLang === 'bg';
const isSr = currentLang === 'sr';
const isTr = currentLang === 'tr';
const isRo = currentLang === 'ro';
const LANG_TO_LOCALE: Record<string, string> = {
  en: 'en_US', el: 'el_GR', bg: 'bg_BG', ro: 'ro_RO', tr: 'tr_TR',
};
const ogLocale = LANG_TO_LOCALE[currentLang] ?? 'en_US';

// hreflang — all supported languages point to same path, differing only in ?lang= param
// x-default and en share the canonical (no ?lang= param)
const HREFLANG_LANGS = ['en', 'el', 'bg', 'ro', 'tr', 'sr'] as const;
const hreflangLinks = !noIndex
  ? HREFLANG_LANGS.map((l) => ({
      lang: l,
      href: l === 'en' ? resolvedCanonical : `${resolvedCanonical}?lang=${l}`,
    }))
  : [];
---

<!DOCTYPE html>
<html lang={currentLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#1a1a2e" />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />

  {noIndex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={resolvedCanonical} />

  <!-- hreflang — multi-language alternates -->
  {hreflangLinks.map((h) => (
    <link rel="alternate" hreflang={h.lang} href={h.href} />
  ))}
  {!noIndex && <link rel="alternate" hreflang="x-default" href={resolvedCanonical} />}

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={resolvedCanonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={resolvedOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:site_name" content="KefaloniaBNB" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={resolvedOgImage} />

  <!-- Favicon & PWA -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href={manifestPage ? `/api/manifest?page=${manifestPage}` : '/manifest.json'} />
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content={pwaTitle} />
  <meta name="mobile-web-app-capable" content="yes" />

  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />

  <slot name="head" />

  <!-- Google Analytics -->
  {import.meta.env.PUBLIC_GA_MEASUREMENT_ID && (
    <>
      <script is:inline define:vars={{ gaId: import.meta.env.PUBLIC_GA_MEASUREMENT_ID }}
        src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_MEASUREMENT_ID}`}
        async
      ></script>
      <script is:inline define:vars={{ gaId: import.meta.env.PUBLIC_GA_MEASUREMENT_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>
  )}

  <!-- Meta Pixel -->
  {import.meta.env.PUBLIC_META_PIXEL_ID && (
    <script is:inline define:vars={{ pixelId: import.meta.env.PUBLIC_META_PIXEL_ID }}>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
      document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', pixelId);
      fbq('track', 'PageView');
    </script>
  )}

  <!-- Geo meta -->
  <meta name="geo.region" content="GR-52" />
  <meta name="geo.placename" content="Keramoti, Kefalonia, Greece" />
  <meta name="geo.position" content="40.9716;24.6736" />
  <meta name="ICBM" content="40.9716, 24.6736" />

  <!-- Structured data -->
  {schemas.map((s) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  <script is:inline>
    // Dismiss banner — remember in sessionStorage so it stays gone until tab closes
    document.addEventListener('DOMContentLoaded', () => {
      const banner = document.getElementById('site-banner');
      const btn = document.getElementById('dismiss-banner');
      if (!banner) return;
      if (sessionStorage.getItem('banner-dismissed') === banner.dataset.id) {
        banner.remove();
        return;
      }
      btn?.addEventListener('click', () => {
        banner.style.transition = 'max-height 0.3s ease, opacity 0.3s ease';
        banner.style.opacity = '0';
        banner.style.maxHeight = '0';
        banner.style.overflow = 'hidden';
        setTimeout(() => banner.remove(), 300);
        sessionStorage.setItem('banner-dismissed', banner.dataset.id ?? '');
      });
    });
  </script>
</head>
<body class="bg-white text-gray-900 antialiased">
  {activeBanner && (
    <div
      id="site-banner"
      data-id={activeBanner.id}
      class={`relative flex items-center justify-center gap-3 px-4 py-2.5 text-sm font-medium text-white
        ${activeBanner.type === 'warning' ? 'bg-amber-500' : activeBanner.type === 'success' ? 'bg-emerald-600' : activeBanner.type === 'error' ? 'bg-red-600' : 'bg-blue-600'}`}
    >
      <span>
        {activeBanner.message}
        {activeBanner.link_url && (
          <a href={activeBanner.link_url} class="ml-2 underline underline-offset-2 font-semibold hover:no-underline">
            {activeBanner.link_text || (isEl ? 'Μάθετε περισσότερα' : isBg ? 'Научете повече' : isSr ? 'Сазнајте више' : isTr ? 'Daha fazla bilgi' : isRo ? 'Află mai mult' : 'Learn more')} →
          </a>
        )}
      </span>
      <button
        id="dismiss-banner"
        aria-label="Dismiss"
        class="absolute right-3 top-1/2 -translate-y-1/2 text-white/70 hover:text-white text-xl leading-none transition-colors"
      >×</button>
    </div>
  )}
  <Header />
  <main>
    <slot />
  </main>
  <Footer />

  <!-- Push notification prompt (shown once per device for logged-in users) -->
  {isLoggedIn && (
    <div id="push-prompt" class="hidden fixed bottom-4 left-4 right-4 sm:left-auto sm:right-4 sm:w-96 bg-white rounded-2xl shadow-2xl border border-gray-100 p-5 z-[60]">
      <div class="flex items-start gap-3">
        <div class="w-10 h-10 bg-[#1a1a2e] rounded-xl flex items-center justify-center flex-shrink-0">
          <span class="text-white text-sm font-bold">K</span>
        </div>
        <div class="flex-1">
          <h3 class="font-semibold text-gray-900 text-sm">{isEl ? 'Ενεργοποίηση Ειδοποιήσεων' : isBg ? 'Включване на известия' : isSr ? 'Укључи обавештења' : isTr ? 'Bildirimleri Etkinleştir' : isRo ? 'Activează Notificările' : 'Enable Notifications'}</h3>
          <p class="text-xs text-gray-500 mt-1">{isEl ? 'Λάβετε ειδοποιήσεις για μηνύματα, likes, σχόλια και αιτήματα φιλίας — ακόμα και όταν η εφαρμογή είναι κλειστή.' : isBg ? 'Получавайте известия за съобщения, харесвания, коментари и заявки за приятелство — дори когато приложението е затворено.' : isSr ? 'Примајте обавештења о порукама, лајковима, коментарима и захтевима за пријатељство — чак и када је апликација затворена.' : isTr ? 'Mesajlar, beğeniler, yorumlar ve arkadaşlık istekleri hakkında bildirim alın — uygulama kapalıyken bile.' : isRo ? 'Primiți notificări despre mesaje, aprecieri, comentarii și cereri de prietenie — chiar și când aplicația este închisă.' : 'Get notified about messages, likes, comments and friend requests — even when the app is closed.'}</p>
          <div class="flex gap-2 mt-3">
            <button id="push-enable" class="px-4 py-2 bg-[#1a1a2e] text-white text-xs font-semibold rounded-lg hover:bg-[#2d2d4e] transition-colors">{isEl ? 'Ενεργοποίηση' : isBg ? 'Включи' : isSr ? 'Укључи' : isTr ? 'Etkinleştir' : isRo ? 'Activează' : 'Enable'}</button>
            <button id="push-dismiss" class="px-4 py-2 text-xs text-gray-500 hover:text-gray-700 transition-colors">{isEl ? 'Όχι τώρα' : isBg ? 'Не сега' : isSr ? 'Не сада' : isTr ? 'Şimdi değil' : isRo ? 'Nu acum' : 'Not now'}</button>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- Service Worker & Push Subscription -->
  <script is:inline define:vars={{ vapidKey, isLoggedIn }}>
    // Register service worker
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').then(function(reg) {
        // Clear app icon badge when user opens the app
        if (navigator.clearAppBadge) navigator.clearAppBadge();
        if (reg.active) reg.active.postMessage({ type: 'CLEAR_BADGE' });
      }).catch(function() {});
    }

    // Push notification logic (only for logged-in users)
    if (isLoggedIn && 'PushManager' in window && 'Notification' in window && vapidKey) {
      var PUSH_DISMISSED_KEY = 'kefalonia_push_dismissed';
      var PUSH_SUBSCRIBED_KEY = 'kefalonia_push_subscribed';

      function showPushPrompt() {
        // Don't show if already subscribed, dismissed recently, or permission already granted/denied
        if (localStorage.getItem(PUSH_SUBSCRIBED_KEY)) return;
        var dismissed = localStorage.getItem(PUSH_DISMISSED_KEY);
        if (dismissed && Date.now() - parseInt(dismissed) < 7 * 86400000) return; // 7 days
        if (Notification.permission === 'granted' || Notification.permission === 'denied') return;

        var prompt = document.getElementById('push-prompt');
        if (prompt) {
          setTimeout(function() { prompt.classList.remove('hidden'); }, 3000); // Show after 3s
        }
      }

      function urlBase64ToUint8Array(base64String) {
        var padding = '='.repeat((4 - base64String.length % 4) % 4);
        var base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
        var rawData = atob(base64);
        var outputArray = new Uint8Array(rawData.length);
        for (var i = 0; i < rawData.length; ++i) outputArray[i] = rawData.charCodeAt(i);
        return outputArray;
      }

      async function subscribeToPush() {
        try {
          var permission = await Notification.requestPermission();
          if (permission !== 'granted') return;

          var reg = await navigator.serviceWorker.ready;
          var sub = await reg.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: urlBase64ToUint8Array(vapidKey),
          });

          var subJson = sub.toJSON();
          await fetch('/api/push/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              endpoint: subJson.endpoint,
              keys: { p256dh: subJson.keys.p256dh, auth: subJson.keys.auth },
            }),
          });

          localStorage.setItem(PUSH_SUBSCRIBED_KEY, '1');
          var prompt = document.getElementById('push-prompt');
          if (prompt) prompt.classList.add('hidden');
        } catch (e) {
          console.error('Push subscription failed:', e);
        }
      }

      // Auto-subscribe if permission already granted
      if (Notification.permission === 'granted' && !localStorage.getItem(PUSH_SUBSCRIBED_KEY)) {
        subscribeToPush();
      } else {
        showPushPrompt();
      }

      var enableBtn = document.getElementById('push-enable');
      var dismissBtn = document.getElementById('push-dismiss');
      if (enableBtn) enableBtn.addEventListener('click', subscribeToPush);
      if (dismissBtn) dismissBtn.addEventListener('click', function() {
        localStorage.setItem(PUSH_DISMISSED_KEY, String(Date.now()));
        var prompt = document.getElementById('push-prompt');
        if (prompt) prompt.classList.add('hidden');
      });
    }
  </script>
</body>
</html>
